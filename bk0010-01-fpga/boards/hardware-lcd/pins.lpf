# hardware-lcd PS/2: connector pin 5 CLOCK / pin 1 DATA, 10K pull-ups to +3V3.
LOCATE COMP "ps2_clock" SITE "2" ;
IOBUF PORT "ps2_clock" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 SLEWRATE=SLOW ;
LOCATE COMP "ps2_data" SITE "138" ;
IOBUF PORT "ps2_data" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
FREQUENCY PORT "clk_ext" 12 MHz ;
FREQUENCY NET "clk" 24 MHz ;
FREQUENCY NET "clk48" 48 MHz ;
FREQUENCY NET "video_clk" 64 MHz ;
FREQUENCY NET "machine/cpu_p" 24 MHz ;
# CPU negative-edge registers share cpu_p through their clock polarity mux.
# IS61WV102416BLL-10T, 24 MHz. Explicit conservative one-cycle I/O budgets.
# Read: FPGA launch <=10 ns + SRAM tAA <=10 ns + assumed PCB round-trip <=2 ns.
# The controller actually allows two access cycles and a full turnaround.
# DQ data/tri-state launch <=15 ns. A setup cycle leaves >=26.6 ns before
# WE assertion; a hold cycle leaves >=31.6 ns after WE deassertion.
# WE pulse >=73.3 ns (two clocks minus 10 ns skew); tPWE>=8, tSD>=6 ns.
# OE is off a full cycle before DQ ownership can change; tHZOE<=4 ns.
# Board flight-time budget is an assumption, not an oscilloscope measurement.
INPUT_SETUP PORT "sram_data[*]" INPUT_DELAY 22 NS HOLD 0 NS CLKNET "clk";
CLOCK_TO_OUT PORT "sram_address[*]" MAX 10 NS MIN 0 NS CLKNET "clk";
CLOCK_TO_OUT PORT "sram_data[*]" MAX 15 NS MIN 0 NS CLKNET "clk";
CLOCK_TO_OUT PORT "sram_ce_n" MAX 10 NS MIN 0 NS CLKNET "clk";
CLOCK_TO_OUT PORT "sram_oe_n" MAX 10 NS MIN 0 NS CLKNET "clk";
CLOCK_TO_OUT PORT "sram_we_n" MAX 10 NS MIN 0 NS CLKNET "clk";
CLOCK_TO_OUT PORT "sram_lb_n" MAX 10 NS MIN 0 NS CLKNET "clk";
CLOCK_TO_OUT PORT "sram_ub_n" MAX 10 NS MIN 0 NS CLKNET "clk";

# SD fast mode is 6 MHz (half-period 83.33 ns). Allow a conservative
# 14 ns card tOD + 2 ns PCB + 10 ns SCK output delay before MISO reaches us.
# MISO cannot change again until the following falling SCK, 83.33 ns later.
# Even with output/input skew, retain a conservative 10 ns hold budget.
# LPF HOLD is negated by TRACE: -10 gives the external +10 ns stable window.
INPUT_SETUP PORT "sd_miso" INPUT_DELAY 26 NS HOLD -10 NS CLKNET "clk";
CLOCK_TO_OUT PORT "sd_sck" MAX 10 NS MIN 0 NS CLKNET "clk";
CLOCK_TO_OUT PORT "sd_mosi" MAX 10 NS MIN 0 NS CLKNET "clk";
CLOCK_TO_OUT PORT "sd_cs_n" MAX 10 NS MIN 0 NS CLKNET "clk";
