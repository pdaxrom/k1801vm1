INPUT_SETUP PORT "sram_data[*]" INPUT_DELAY 22.000000 ns HOLD 0.000000 ns CLKNET "clk" ;
CLOCK_TO_OUT PORT "sram_address[*]" MAX 10.000000 ns MIN 0.000000 ns CLKNET "clk" ;
