; CP30 experimental FP11 control subset. FPS is private word zero.
; Placed only in CP29 holes: all integer/FIS words and entry labels stay put.
; Decoder enables these entries only with FP11_CONTROL=1, ROM_DECODE=1.
.org $0a1
FP_LDFPS_R:
    ALU PASSB, pair=AD, d=ZERO, b=T0, dst=RF, seq=PAGE, next=FP_WRITE_RD
.org $0ad
FP_WRITE_RD:
    WRITE, a=T0, b=RD, private=1, prefetch=0, target=FP_FINISH
.org $06b
FP_FINISH:
    ALU PASSA, seq=FETCH

.org $10e
FP_STFPS_R:
    ALU PASSB, pair=AD, d=ZERO, b=T0, dst=RF, seq=PAGE, next=FP_READ_RD
FP_READ_RD:
    READ, a=T0, private=1, prefetch=0, target=FP_STORE_RD
.org $1a9
FP_STORE_RD:
    ALU PASSB, pair=AD, d=MDR, b=RD, dst=RF, seq=FETCH

.org $116
FP_CFCC:
    ALU PASSB, pair=AD, d=ZERO, b=T0, dst=RF, seq=PAGE, next=FP_READ_CC
FP_READ_CC:
    READ, a=T0, private=1, prefetch=0, target=FP_COPY_CC
.org $1b3
FP_COPY_CC:
    ALU PASSB, pair=AD, d=MDR, b=T1, dst=RF, seq=PAGE, next=FP_MASK_CC
.org $126
FP_MASK_CC:
    ALU AND, a=T1, pair=AD, d=IMM, imm=15, b=T1, dst=RF
    ALU PASSB, pair=AD, d=PSW, b=T0, dst=RF, seq=PAGE, next=FP_MERGE_CC
.org $12e
FP_MERGE_CC:
    ALU BIC, a=T0, pair=AD, d=IMM, imm=15, b=T0, dst=RF
    ALU OR, a=T0, b=T1, flags=LOAD, seq=FETCH

.org $136
FP_SETF:
    ALU PASSB, pair=AD, d=ZERO, b=T0, dst=RF, seq=PAGE, next=FP_READ_F
FP_READ_F:
    READ, a=T0, private=1, prefetch=0, target=FP_COPY_F
.org $1cd
FP_COPY_F:
    ALU PASSB, pair=AD, d=MDR, b=T1, dst=RF, seq=PAGE, next=FP_CLEAR_D
.org $13e
FP_CLEAR_D:
    ALU BIC, a=T1, pair=AD, d=IMM, imm=128, b=T1, dst=RF
    WRITE, a=T0, b=T1, private=1, prefetch=0, target=FP_FINISH

.org $146
FP_SETI:
    ALU PASSB, pair=AD, d=ZERO, b=T0, dst=RF, seq=PAGE, next=FP_READ_I
FP_READ_I:
    READ, a=T0, private=1, prefetch=0, target=FP_COPY_I
.org $1ce
FP_COPY_I:
    ALU PASSB, pair=AD, d=MDR, b=T1, dst=RF, seq=PAGE, next=FP_CLEAR_L
.org $14e
FP_CLEAR_L:
    ALU BIC, a=T1, pair=AD, d=IMM, imm=64, b=T1, dst=RF
    WRITE, a=T0, b=T1, private=1, prefetch=0, target=FP_FINISH

.org $156
FP_SETD:
    ALU PASSB, pair=AD, d=ZERO, b=T0, dst=RF, seq=PAGE, next=FP_READ_D
FP_READ_D:
    READ, a=T0, private=1, prefetch=0, target=FP_COPY_D
.org $1cf
FP_COPY_D:
    ALU PASSB, pair=AD, d=MDR, b=T1, dst=RF, seq=PAGE, next=FP_SET_D
.org $15e
FP_SET_D:
    ALU OR, a=T1, pair=AD, d=IMM, imm=128, b=T1, dst=RF
    WRITE, a=T0, b=T1, private=1, prefetch=0, target=FP_FINISH

.org $166
FP_SETL:
    ALU PASSB, pair=AD, d=ZERO, b=T0, dst=RF, seq=PAGE, next=FP_READ_L
FP_READ_L:
    READ, a=T0, private=1, prefetch=0, target=FP_COPY_L
.org $1d9
FP_COPY_L:
    ALU PASSB, pair=AD, d=MDR, b=T1, dst=RF, seq=PAGE, next=FP_SET_L
.org $17e
FP_SET_L:
    ALU OR, a=T1, pair=AD, d=IMM, imm=64, b=T1, dst=RF
    WRITE, a=T0, b=T1, private=1, prefetch=0, target=FP_FINISH
