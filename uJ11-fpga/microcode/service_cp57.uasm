; CP57 resource gate. PDP-11 firmware runs in upper FRAM, not in this ROM.
; CPC/CPSW backing: upper physical 000100/000102 (octal), outside SEL vectors.
; Existing RF/ALU forms these addresses. No extra hardware address/data mux.
; Mode is set before the copies; firmware starts after both writes complete.
S_FP:
    JUMP, a=R7, service=ENTER, target=S_FP_VECTOR, prefetch=0
S_FP_VECTOR:
    alu PASSA, pair=DA, d=IMM, imm=8, b=T4, dst=RF
    JUMP, target=S_VECTOR, prefetch=0
S_ODT:
    JUMP, a=R7, service=ENTER, target=S_ODT_VECTOR, prefetch=0
S_ODT_VECTOR:
    alu PASSA, pair=DA, d=IMM, imm=120, b=T4, dst=RF
    JUMP, target=S_VECTOR, prefetch=0
S_VECTOR:
    alu PASSA, pair=DA, d=IMM, imm=64, b=T5, dst=RF
    WRITE, space=UPPER, a=T5, b=R7, target=S_SAVE_PSW, prefetch=0
S_SAVE_PSW:
    alu PASSA, pair=DA, d=PSW, b=T0, dst=RF
    alu PASSA, pair=DA, d=IMM, imm=66, b=T5, dst=RF
    WRITE, space=UPPER, a=T5, b=T0, target=S_VECTOR_READ, prefetch=0
S_VECTOR_READ:
    READ, a=T4, target=S_VECTOR_PC, prefetch=0
S_VECTOR_PC:
    alu PASSA, pair=DA, d=MDR, b=R7, dst=RF
    alu ADD, a=T4, pair=AD, d=TWO, b=T4, dst=RF
    READ, a=T4, target=S_VECTOR_PSW, prefetch=0
S_VECTOR_PSW:
    alu PASSA, pair=DA, d=MDR, flags=LOAD, seq=FETCH
S_START:
    alu PASSA, pair=DA, d=IMM, imm=64, b=T5, dst=RF
    READ, space=UPPER, a=T5, target=S_START_PC, prefetch=0
S_START_PC:
    alu PASSA, pair=DA, d=MDR, b=R7, dst=RF
    alu PASSA, pair=DA, d=IMM, imm=66, b=T5, dst=RF
    READ, space=UPPER, a=T5, target=S_START_PSW, prefetch=0
S_START_PSW:
    alu PASSA, pair=DA, d=MDR, flags=LOAD
    JUMP, service=LEAVE, target=S_DONE, prefetch=0
S_DONE:
    alu PASSA, seq=FETCH
S_RCPC:
    alu PASSA, pair=DA, d=IMM, imm=64, b=T5, dst=RF
    READ, space=UPPER, a=T5, target=S_R0, prefetch=0
S_RCPS:
    alu PASSA, pair=DA, d=IMM, imm=66, b=T5, dst=RF
    READ, space=UPPER, a=T5, target=S_R0, prefetch=0
S_WCPC:
    alu PASSA, pair=DA, d=IMM, imm=64, b=T5, dst=RF
    WRITE, space=UPPER, a=T5, b=R0, target=S_DONE, prefetch=0
S_WCPS:
    alu PASSA, pair=DA, d=IMM, imm=66, b=T5, dst=RF
    WRITE, space=UPPER, a=T5, b=R0, target=S_DONE, prefetch=0
S_R0:
    alu PASSA, pair=DA, d=MDR, b=R0, dst=RF, seq=FETCH
; Explicit uJ11 installation instructions, available in ordinary mode.
; No implicit R5 update: the loader controls its bounds and checksum in software.
S_UPPER_READ:
    READ, space=UPPER, a=R5, target=S_R0, prefetch=0
S_UPPER_WRITE:
    WRITE, space=UPPER, a=R5, b=R0, target=S_DONE, prefetch=0
S_CONFIG:
    JUMP, service=CONFIG, a=R0, target=S_DONE, prefetch=0
S_STATUS:
    alu PASSA, pair=DA, d=STATUS, b=R0, dst=RF, seq=FETCH
; HALT-only physical access complements logical MFUS/MTUS through the I/O page.
S_LOWER_READ:
    READ, space=LOWER, a=R5, target=S_R0, prefetch=0
S_LOWER_WRITE:
    WRITE, space=LOWER, a=R5, b=R0, target=S_DONE, prefetch=0
S_MFUS:
    READ, space=GUEST, a=R5, target=S_MFUS_INC, prefetch=0
S_MFUS_INC:
    alu ADD, a=R5, pair=AD, d=TWO, b=R5, dst=RF
    alu PASSA, pair=DA, d=MDR, b=R0, dst=RF, seq=FETCH
S_MTUS:
    alu SUB, a=R5, pair=AD, d=TWO, b=R5, dst=RF
    WRITE, space=GUEST, a=R5, b=R0, target=S_DONE, prefetch=0
S_RSEL:
    alu PASSA, pair=DA, d=STATUS, b=T0, dst=RF
    alu AND, a=T0, pair=AD, d=IMM, imm=128, b=R0, dst=RF, seq=FETCH
