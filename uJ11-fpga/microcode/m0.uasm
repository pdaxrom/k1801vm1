; CP20 candidate: HALT restart profile and peripheral RESET; one kernel register set, trace/RTT, IRQ and memory traps.
; Encoding v11: FETCH_A1, branch/SOB DISP, OPERAND/MOV writeback. No MMU.
; Filename retained from M0; exact 23-word M0 images live in synthesis archives.
; T0=source value, T1=destination EA, T2=destination/result, T3=EA scratch/old destination.
; Reset initializes the distributed RF through its single ordinary write port.
.org $000
RESET:
    alu PASSA, pair=DA, d=ZERO, b=R0, dst=RF
    alu PASSA, pair=DA, d=ZERO, b=R1, dst=RF
    alu PASSA, pair=DA, d=ZERO, b=R2, dst=RF
    alu PASSA, pair=DA, d=ZERO, b=R3, dst=RF
    alu PASSA, pair=DA, d=ZERO, b=R4, dst=RF
    alu PASSA, pair=DA, d=ZERO, b=R5, dst=RF
    alu PASSA, pair=DA, d=ZERO, b=R6, dst=RF
    alu PASSA, pair=DA, d=ZERO, b=R7, dst=RF
    alu PASSA, pair=DA, d=ZERO, b=T0, dst=RF
    alu PASSA, pair=DA, d=ZERO, b=T1, dst=RF
    alu PASSA, pair=DA, d=ZERO, b=T2, dst=RF
    alu PASSA, pair=DA, d=ZERO, b=T3, dst=RF
    alu PASSA, pair=DA, d=ZERO, b=T4, dst=RF
    alu PASSA, pair=DA, d=ZERO, b=T5, dst=RF
    alu PASSA, pair=DA, d=ZERO, b=T6, dst=RF
    alu PASSA, pair=DA, d=ZERO, b=T7, dst=RF
    JUMP, target=FETCH
.org $020
FETCH:
    FETCH
.org $080
JMP:
    CALL, target=DESTINATION_EA, prefetch=0
    alu PASSA, a=T1, b=R7, dst=RF, seq=FETCH
.org $088
JSR:
    CALL, target=DESTINATION_EA, prefetch=0
    alu SUB, a=R6, b=R6, pair=AD, d=TWO, dst=RF
    WRITE, a=R6, b=RS, target=JSR_LINK, prefetch=0
JSR_LINK:
    alu PASSA, a=R7, b=RS, dst=RF
    alu PASSA, a=T1, b=R7, dst=RF, seq=FETCH
.org $090
RTS:
    alu PASSA, a=RD, b=R7, dst=RF
    READ, a=R6, target=RTS_POP, prefetch=0
RTS_POP:
    alu ADD, a=R6, b=R6, pair=AD, d=TWO, dst=RF
    alu PASSA, pair=DA, d=MDR, b=RD, dst=RF, seq=FETCH
.org $098
SOB:
    alu SUB, a=RS, b=RS, pair=AD, d=ONE, dst=RF, seq=FETCH_A1
    alu SUB, a=R7, b=R7, pair=AD, d=DISP, dst=RF, seq=FETCH
.org $110
MOV_RR:
    alu PASSA, a=RS, b=RD, dst=MOV, flags=NZV, seq=FETCH
.org $120
CMP_RR:
    alu SUB, a=RS, b=RD, flags=NZVC, seq=FETCH
.org $160
ADD_RR:
    alu ADD, a=RS, b=RD, dst=OPERAND, flags=NZVC, seq=FETCH
.org $180
BR:
    alu ADD, a=R7, b=R7, pair=AD, d=DISP, dst=RF, seq=FETCH
.org $3ff
UNSUPPORTED:
    STOP

; Source mode 0 is sampled AFTER destination EA updates, as on DCJ11.
.org $030
CAPTURE_REGISTER_SOURCE:
    OR_MS, target=CAPTURE_TABLE, prefetch=0
.org $038
CAPTURE_TABLE:
    alu PASSA, a=RS, b=T0, dst=RF
    RETURN, prefetch=0
    RETURN, prefetch=0
    RETURN, prefetch=0
    RETURN, prefetch=0
    RETURN, prefetch=0
    RETURN, prefetch=0
    RETURN, prefetch=0

.org $118
MOV_EA:
    CALL, target=SOURCE_EA, prefetch=0
    CALL, target=DESTINATION_EA, prefetch=0
    CALL, target=CAPTURE_REGISTER_SOURCE, prefetch=0
    OR_MD, target=MOV_DESTINATION, prefetch=0
.org $128
CMP_EA:
    CALL, target=SOURCE_EA, prefetch=0
    CALL, target=DESTINATION_EA, prefetch=0
    CALL, target=CAPTURE_REGISTER_SOURCE, prefetch=0
    OR_MD, target=CMP_DESTINATION, prefetch=0
.org $168
ADD_EA:
    CALL, target=SOURCE_EA, prefetch=0
    CALL, target=DESTINATION_EA, prefetch=0
    CALL, target=CAPTURE_REGISTER_SOURCE, prefetch=0
    OR_MD, target=ADD_DESTINATION, prefetch=0

.org $200
SOURCE_EA:
    OR_MS, target=SOURCE_TABLE, prefetch=0
.org $208
SOURCE_TABLE:
    RETURN, prefetch=0
    JUMP, target=SOURCE_1, prefetch=0
    JUMP, target=SOURCE_2, prefetch=0
    JUMP, target=SOURCE_3, prefetch=0
    JUMP, target=SOURCE_4, prefetch=0
    JUMP, target=SOURCE_5, prefetch=0
    JUMP, target=SOURCE_6, prefetch=0
    JUMP, target=SOURCE_7, prefetch=0
.org $220
SOURCE_1:
    READ, a=RS, byte=IR, target=SOURCE_SAVE, prefetch=0
.org $224
SOURCE_2:
    READ, a=RS, byte=IR, stream=1, target=SOURCE_2_INC, fault_inc=1, prefetch=0
SOURCE_2_INC:
    alu ADD, a=RS, b=RS, pair=AD, d=STEP, dst=RF
    JUMP, target=SOURCE_SAVE, prefetch=0
.org $230
SOURCE_3:
    READ, a=RS, stream=1, target=SOURCE_3_INC, fault_inc=1, prefetch=0
SOURCE_3_INC:
    alu ADD, a=RS, b=RS, pair=AD, d=TWO, dst=RF
    JUMP, target=SOURCE_INDIRECT, prefetch=0
.org $238
SOURCE_4:
    alu SUB, a=RS, b=RS, pair=AD, d=STEP, dst=RF
    READ, a=RS, byte=IR, target=SOURCE_SAVE, prefetch=0
.org $240
SOURCE_5:
    alu SUB, a=RS, b=RS, pair=AD, d=TWO, dst=RF
    READ, a=RS, target=SOURCE_INDIRECT, prefetch=0
.org $248
SOURCE_6:
    READ, a=R7, stream=1, target=SOURCE_6_INC, prefetch=0
SOURCE_6_INC:
    alu ADD, a=R7, b=R7, pair=AD, d=TWO, dst=RF
    alu ADD, a=RS, b=T3, pair=AD, d=MDR, dst=RF
    READ, a=T3, byte=IR, target=SOURCE_SAVE, prefetch=0
.org $250
SOURCE_7:
    READ, a=R7, stream=1, target=SOURCE_7_INC, prefetch=0
SOURCE_7_INC:
    alu ADD, a=R7, b=R7, pair=AD, d=TWO, dst=RF
    alu ADD, a=RS, b=T3, pair=AD, d=MDR, dst=RF
    READ, a=T3, target=SOURCE_INDIRECT, prefetch=0
SOURCE_INDIRECT:
    alu PASSA, b=T3, pair=DA, d=MDR, dst=RF
    READ, a=T3, byte=IR, target=SOURCE_SAVE, prefetch=0
.org $260
SOURCE_SAVE:
    alu PASSA, b=T0, pair=DA, d=MDR, dst=RF
    RETURN, prefetch=0

; Destination EA does not read the final operand. MOV must never read its
; destination CSR. CMP/ADD read only in their execution routines below.
.org $280
DESTINATION_EA:
    OR_MD, target=DESTINATION_TABLE, prefetch=0
.org $288
DESTINATION_TABLE:
    RETURN ; source ready, destination is register: safe lookahead window
    JUMP, target=DESTINATION_1, prefetch=0
    JUMP, target=DESTINATION_2, prefetch=0
    JUMP, target=DESTINATION_3, prefetch=0
    JUMP, target=DESTINATION_4, prefetch=0
    JUMP, target=DESTINATION_5, prefetch=0
    JUMP, target=DESTINATION_6, prefetch=0
    JUMP, target=DESTINATION_7, prefetch=0
.org $2a0
DESTINATION_1:
    alu PASSA, a=RD, b=T1, dst=RF
    RETURN, prefetch=0
.org $2a4
DESTINATION_2:
    alu PASSA, a=RD, b=T1, dst=RF
    alu ADD, a=RD, b=RD, pair=AD, d=STEP, dst=RF
    RETURN, prefetch=0
.org $2a8
DESTINATION_3:
    READ, a=RD, stream=1, target=DESTINATION_3_INC, fault_inc=1, prefetch=0
DESTINATION_3_INC:
    alu ADD, a=RD, b=RD, pair=AD, d=TWO, dst=RF
    JUMP, target=DESTINATION_FROM_MDR, prefetch=0
.org $2b0
DESTINATION_4:
    alu SUB, a=RD, b=RD, pair=AD, d=STEP, dst=RF
    alu PASSA, a=RD, b=T1, dst=RF
    RETURN, prefetch=0
.org $2b4
DESTINATION_5:
    alu SUB, a=RD, b=RD, pair=AD, d=TWO, dst=RF
    READ, a=RD, target=DESTINATION_FROM_MDR, prefetch=0
.org $2b8
DESTINATION_6:
    READ, a=R7, stream=1, target=DESTINATION_6_INC, prefetch=0
DESTINATION_6_INC:
    alu ADD, a=R7, b=R7, pair=AD, d=TWO, dst=RF
    alu ADD, a=RD, b=T1, pair=AD, d=MDR, dst=RF
    RETURN, prefetch=0
.org $2c0
DESTINATION_7:
    READ, a=R7, stream=1, target=DESTINATION_7_INC, prefetch=0
DESTINATION_7_INC:
    alu ADD, a=R7, b=R7, pair=AD, d=TWO, dst=RF
    alu ADD, a=RD, b=T1, pair=AD, d=MDR, dst=RF
    READ, a=T1, target=DESTINATION_FROM_MDR, prefetch=0
.org $2c8
DESTINATION_FROM_MDR:
    alu PASSA, b=T1, pair=DA, d=MDR, dst=RF
    RETURN, prefetch=0

.org $300
MOV_DESTINATION:
    alu PASSA, a=T0, b=RD, dst=MOV, flags=NZV, seq=FETCH
    JUMP, target=MOV_MEMORY, prefetch=0
    JUMP, target=MOV_MEMORY, prefetch=0
    JUMP, target=MOV_MEMORY, prefetch=0
    JUMP, target=MOV_MEMORY, prefetch=0
    JUMP, target=MOV_MEMORY, prefetch=0
    JUMP, target=MOV_MEMORY, prefetch=0
    JUMP, target=MOV_MEMORY, prefetch=0
.org $310
MOV_MEMORY:
    WRITE, a=T1, byte=IR, b=T0, target=MOV_MEMORY_FLAGS, prefetch=0
MOV_MEMORY_FLAGS:
    alu PASSA, a=T0, flags=NZV, seq=FETCH
.org $320
CMP_DESTINATION:
    alu SUB, a=T0, b=RD, flags=NZVC, seq=FETCH
    JUMP, target=CMP_MEMORY, prefetch=0
    JUMP, target=CMP_MEMORY, prefetch=0
    JUMP, target=CMP_MEMORY, prefetch=0
    JUMP, target=CMP_MEMORY, prefetch=0
    JUMP, target=CMP_MEMORY, prefetch=0
    JUMP, target=CMP_MEMORY, prefetch=0
    JUMP, target=CMP_MEMORY, prefetch=0
.org $330
CMP_MEMORY:
    READ, a=T1, byte=IR, target=CMP_MEMORY_CAPTURE, prefetch=0
CMP_MEMORY_CAPTURE:
    alu PASSA, b=T2, pair=DA, d=MDR, dst=RF
    alu SUB, a=T0, b=T2, flags=NZVC, seq=FETCH
.org $340
ADD_DESTINATION:
    alu ADD, a=T0, b=RD, dst=OPERAND, flags=NZVC, seq=FETCH
    JUMP, target=ADD_MEMORY, prefetch=0
    JUMP, target=ADD_MEMORY, prefetch=0
    JUMP, target=ADD_MEMORY, prefetch=0
    JUMP, target=ADD_MEMORY, prefetch=0
    JUMP, target=ADD_MEMORY, prefetch=0
    JUMP, target=ADD_MEMORY, prefetch=0
    JUMP, target=ADD_MEMORY, prefetch=0
.org $350
ADD_MEMORY:
    READ, a=T1, byte=IR, target=ADD_MEMORY_CAPTURE, prefetch=0
ADD_MEMORY_CAPTURE:
    alu PASSA, b=T2, pair=DA, d=MDR, dst=RF
    alu PASSA, a=T2, b=T3, dst=RF
    alu ADD, a=T0, b=T2, dst=OPERAND
    WRITE, a=T1, byte=IR, b=T2, target=ADD_MEMORY_FLAGS, prefetch=0
ADD_MEMORY_FLAGS:
    ; Recompute from saved old destination; flags commit only after write ACK.
    alu ADD, a=T0, b=T3, flags=NZVC, seq=FETCH

.org $130
BIT_RR:
    alu AND, a=RS, b=RD, pair=AB, flags=NZV, seq=FETCH
.org $138
BIT_EA:
    CALL, target=SOURCE_EA, prefetch=0
    CALL, target=DESTINATION_EA, prefetch=0
    CALL, target=CAPTURE_REGISTER_SOURCE, prefetch=0
    OR_MD, target=BIT_DESTINATION, prefetch=0
.org $360
BIT_DESTINATION:
    alu AND, a=T0, b=RD, pair=AB, flags=NZV, seq=FETCH
    JUMP, target=BIT_MEMORY, prefetch=0
    JUMP, target=BIT_MEMORY, prefetch=0
    JUMP, target=BIT_MEMORY, prefetch=0
    JUMP, target=BIT_MEMORY, prefetch=0
    JUMP, target=BIT_MEMORY, prefetch=0
    JUMP, target=BIT_MEMORY, prefetch=0
    JUMP, target=BIT_MEMORY, prefetch=0
.org $370
BIT_MEMORY:
    READ, a=T1, byte=IR, target=BIT_MEMORY_CAPTURE, prefetch=0
BIT_MEMORY_CAPTURE:
    alu PASSA, b=T2, pair=DA, d=MDR, dst=RF
    alu AND, a=T0, b=T2, pair=AB, flags=NZV, seq=FETCH

.org $140
BIC_RR:
    alu BIC, a=RS, b=RD, pair=BA, dst=OPERAND, flags=NZV, seq=FETCH
.org $148
BIC_EA:
    CALL, target=SOURCE_EA, prefetch=0
    CALL, target=DESTINATION_EA, prefetch=0
    CALL, target=CAPTURE_REGISTER_SOURCE, prefetch=0
    OR_MD, target=BIC_DESTINATION, prefetch=0
.org $380
BIC_DESTINATION:
    alu BIC, a=T0, b=RD, pair=BA, dst=OPERAND, flags=NZV, seq=FETCH
    JUMP, target=BIC_MEMORY, prefetch=0
    JUMP, target=BIC_MEMORY, prefetch=0
    JUMP, target=BIC_MEMORY, prefetch=0
    JUMP, target=BIC_MEMORY, prefetch=0
    JUMP, target=BIC_MEMORY, prefetch=0
    JUMP, target=BIC_MEMORY, prefetch=0
    JUMP, target=BIC_MEMORY, prefetch=0
.org $390
BIC_MEMORY:
    READ, a=T1, byte=IR, target=BIC_MEMORY_CAPTURE, prefetch=0
BIC_MEMORY_CAPTURE:
    alu PASSA, b=T2, pair=DA, d=MDR, dst=RF
    alu BIC, a=T0, b=T2, pair=BA, dst=OPERAND
    WRITE, a=T1, byte=IR, b=T2, target=BIC_MEMORY_FLAGS, prefetch=0
BIC_MEMORY_FLAGS:
    alu PASSA, a=T2, flags=NZV, seq=FETCH

.org $150
BIS_RR:
    alu OR, a=RS, b=RD, pair=AB, dst=OPERAND, flags=NZV, seq=FETCH
.org $158
BIS_EA:
    CALL, target=SOURCE_EA, prefetch=0
    CALL, target=DESTINATION_EA, prefetch=0
    CALL, target=CAPTURE_REGISTER_SOURCE, prefetch=0
    OR_MD, target=BIS_DESTINATION, prefetch=0
.org $3a0
BIS_DESTINATION:
    alu OR, a=T0, b=RD, pair=AB, dst=OPERAND, flags=NZV, seq=FETCH
    JUMP, target=BIS_MEMORY, prefetch=0
    JUMP, target=BIS_MEMORY, prefetch=0
    JUMP, target=BIS_MEMORY, prefetch=0
    JUMP, target=BIS_MEMORY, prefetch=0
    JUMP, target=BIS_MEMORY, prefetch=0
    JUMP, target=BIS_MEMORY, prefetch=0
    JUMP, target=BIS_MEMORY, prefetch=0
.org $3b0
BIS_MEMORY:
    READ, a=T1, byte=IR, target=BIS_MEMORY_CAPTURE, prefetch=0
BIS_MEMORY_CAPTURE:
    alu PASSA, b=T2, pair=DA, d=MDR, dst=RF
    alu OR, a=T0, b=T2, pair=AB, dst=OPERAND
    WRITE, a=T1, byte=IR, b=T2, target=BIS_MEMORY_FLAGS, prefetch=0
BIS_MEMORY_FLAGS:
    alu PASSA, a=T2, flags=NZV, seq=FETCH

.org $1e0
SUB_RR:
    alu SUB, a=RS, b=RD, pair=BA, dst=OPERAND, flags=NZVC, seq=FETCH
.org $1e8
SUB_EA:
    CALL, target=SOURCE_EA, prefetch=0
    CALL, target=DESTINATION_EA, prefetch=0
    CALL, target=CAPTURE_REGISTER_SOURCE, prefetch=0
    OR_MD, target=SUB_DESTINATION, prefetch=0
.org $3c0
SUB_DESTINATION:
    alu SUB, a=T0, b=RD, pair=BA, dst=OPERAND, flags=NZVC, seq=FETCH
    JUMP, target=SUB_MEMORY, prefetch=0
    JUMP, target=SUB_MEMORY, prefetch=0
    JUMP, target=SUB_MEMORY, prefetch=0
    JUMP, target=SUB_MEMORY, prefetch=0
    JUMP, target=SUB_MEMORY, prefetch=0
    JUMP, target=SUB_MEMORY, prefetch=0
    JUMP, target=SUB_MEMORY, prefetch=0
.org $3d0
SUB_MEMORY:
    READ, a=T1, byte=IR, target=SUB_MEMORY_CAPTURE, prefetch=0
SUB_MEMORY_CAPTURE:
    alu PASSA, b=T2, pair=DA, d=MDR, dst=RF
    alu PASSA, a=T2, b=T3, dst=RF
    alu SUB, a=T0, b=T2, pair=BA, dst=OPERAND
    WRITE, a=T1, byte=IR, b=T2, target=SUB_MEMORY_FLAGS, prefetch=0
SUB_MEMORY_FLAGS:
    alu SUB, a=T0, b=T3, pair=BA, flags=NZVC, seq=FETCH

.org $0a0
CLR_REGISTER:
    alu PASSA, a=RD, b=RD, pair=DA, d=ZERO, dst=OPERAND, flags=NZVC, seq=FETCH
.org $0a2
CLR_SINGLE_EA:
    CALL, target=DESTINATION_EA, prefetch=0
    JUMP, target=CLR_SINGLE_MEMORY, prefetch=0

.org $0a4
COM_REGISTER:
    alu NOTA, a=RD, b=RD, pair=AB, d=ZERO, dst=OPERAND, flags=NZVC, seq=FETCH
.org $0a6
COM_SINGLE_EA:
    CALL, target=DESTINATION_EA, prefetch=0
    JUMP, target=COM_SINGLE_MEMORY, prefetch=0

.org $0a8
INC_REGISTER:
    alu ADD, a=RD, b=RD, pair=AD, d=ONE, dst=OPERAND, flags=NZV, seq=FETCH
.org $0aa
INC_SINGLE_EA:
    CALL, target=DESTINATION_EA, prefetch=0
    JUMP, target=INC_SINGLE_MEMORY, prefetch=0

.org $0ac
DEC_REGISTER:
    alu SUB, a=RD, b=RD, pair=AD, d=ONE, dst=OPERAND, flags=NZV, seq=FETCH
.org $0ae
DEC_SINGLE_EA:
    CALL, target=DESTINATION_EA, prefetch=0
    JUMP, target=DEC_SINGLE_MEMORY, prefetch=0

.org $0b0
NEG_REGISTER:
    alu SUB, a=RD, b=RD, pair=DA, d=ZERO, dst=OPERAND, flags=NZVC, seq=FETCH
.org $0b2
NEG_SINGLE_EA:
    CALL, target=DESTINATION_EA, prefetch=0
    JUMP, target=NEG_SINGLE_MEMORY, prefetch=0

.org $0b4
ADC_REGISTER:
    alu ADC, a=RD, b=RD, pair=AD, d=ZERO, dst=OPERAND, flags=NZVC, seq=FETCH
.org $0b6
ADC_SINGLE_EA:
    CALL, target=DESTINATION_EA, prefetch=0
    JUMP, target=ADC_SINGLE_MEMORY, prefetch=0

.org $0b8
SBC_REGISTER:
    alu SBC, a=RD, b=RD, pair=AD, d=ZERO, dst=OPERAND, flags=NZVC, seq=FETCH
.org $0ba
SBC_SINGLE_EA:
    CALL, target=DESTINATION_EA, prefetch=0
    JUMP, target=SBC_SINGLE_MEMORY, prefetch=0

.org $0bc
TST_REGISTER:
    alu PASSA, a=RD, b=RD, pair=AB, d=ZERO, flags=NZVC, seq=FETCH
.org $0be
TST_SINGLE_EA:
    CALL, target=DESTINATION_EA, prefetch=0
    JUMP, target=TST_SINGLE_MEMORY, prefetch=0

.org $0c0
ROR_REGISTER:
    alu ROR, a=RD, b=RD, pair=AB, d=ZERO, dst=OPERAND, flags=NZVC, seq=FETCH
.org $0c2
ROR_SINGLE_EA:
    CALL, target=DESTINATION_EA, prefetch=0
    JUMP, target=ROR_SINGLE_MEMORY, prefetch=0

.org $0c4
ROL_REGISTER:
    alu ROL, a=RD, b=RD, pair=AB, d=ZERO, dst=OPERAND, flags=NZVC, seq=FETCH
.org $0c6
ROL_SINGLE_EA:
    CALL, target=DESTINATION_EA, prefetch=0
    JUMP, target=ROL_SINGLE_MEMORY, prefetch=0

.org $0c8
ASR_REGISTER:
    alu ASR, a=RD, b=RD, pair=AB, d=ZERO, dst=OPERAND, flags=NZVC, seq=FETCH
.org $0ca
ASR_SINGLE_EA:
    CALL, target=DESTINATION_EA, prefetch=0
    JUMP, target=ASR_SINGLE_MEMORY, prefetch=0

.org $0cc
ASL_REGISTER:
    alu LSL, a=RD, b=RD, pair=AB, d=ZERO, dst=OPERAND, flags=NZVC, seq=FETCH
.org $0ce
ASL_SINGLE_EA:
    CALL, target=DESTINATION_EA, prefetch=0
    JUMP, target=ASL_SINGLE_MEMORY, prefetch=0

; Unary memory tails. READ preserves operand in MDR until the final flag commit.
.org $0d0
CLR_SINGLE_MEMORY:
    alu PASSA, b=T2, pair=DA, d=ZERO, dst=RF
    WRITE, a=T1, byte=IR, b=T2, target=CLR_SINGLE_FLAGS, prefetch=0
CLR_SINGLE_FLAGS:
    alu PASSA, pair=DA, d=ZERO, flags=NZVC, seq=FETCH
COM_SINGLE_MEMORY:
    READ, a=T1, byte=IR, target=COM_SINGLE_OPERAND, prefetch=0
COM_SINGLE_OPERAND:
    alu NOTA, b=T2, pair=DA, d=MDR, dst=OPERAND
    WRITE, a=T1, byte=IR, b=T2, target=COM_SINGLE_FLAGS, prefetch=0
COM_SINGLE_FLAGS:
    alu NOTA, b=T2, pair=DA, d=MDR, flags=NZVC, seq=FETCH
INC_SINGLE_MEMORY:
    READ, a=T1, byte=IR, target=INC_SINGLE_OPERAND, prefetch=0
INC_SINGLE_OPERAND:
    alu PASSA, b=T0, pair=DA, d=MDR, dst=RF
    alu ADD, a=T0, b=T2, pair=AD, d=ONE, dst=OPERAND
    WRITE, a=T1, byte=IR, b=T2, target=INC_SINGLE_FLAGS, prefetch=0
INC_SINGLE_FLAGS:
    alu ADD, a=T0, b=T2, pair=AD, d=ONE, flags=NZV, seq=FETCH
DEC_SINGLE_MEMORY:
    READ, a=T1, byte=IR, target=DEC_SINGLE_OPERAND, prefetch=0
DEC_SINGLE_OPERAND:
    alu PASSA, b=T0, pair=DA, d=MDR, dst=RF
    alu SUB, a=T0, b=T2, pair=AD, d=ONE, dst=OPERAND
    WRITE, a=T1, byte=IR, b=T2, target=DEC_SINGLE_FLAGS, prefetch=0
DEC_SINGLE_FLAGS:
    alu SUB, a=T0, b=T2, pair=AD, d=ONE, flags=NZV, seq=FETCH
NEG_SINGLE_MEMORY:
    READ, a=T1, byte=IR, target=NEG_SINGLE_OPERAND, prefetch=0
NEG_SINGLE_OPERAND:
    alu PASSA, b=T0, pair=DA, d=MDR, dst=RF
    alu SUB, a=T0, b=T2, pair=DA, d=ZERO, dst=OPERAND
    WRITE, a=T1, byte=IR, b=T2, target=NEG_SINGLE_FLAGS, prefetch=0
NEG_SINGLE_FLAGS:
    alu SUB, a=T0, b=T2, pair=DA, d=ZERO, flags=NZVC, seq=FETCH
ADC_SINGLE_MEMORY:
    READ, a=T1, byte=IR, target=ADC_SINGLE_OPERAND, prefetch=0
ADC_SINGLE_OPERAND:
    alu PASSA, b=T0, pair=DA, d=MDR, dst=RF
    alu ADC, a=T0, b=T2, pair=AD, d=ZERO, dst=OPERAND
    WRITE, a=T1, byte=IR, b=T2, target=ADC_SINGLE_FLAGS, prefetch=0
ADC_SINGLE_FLAGS:
    alu ADC, a=T0, b=T2, pair=AD, d=ZERO, flags=NZVC, seq=FETCH
SBC_SINGLE_MEMORY:
    READ, a=T1, byte=IR, target=SBC_SINGLE_OPERAND, prefetch=0
SBC_SINGLE_OPERAND:
    alu PASSA, b=T0, pair=DA, d=MDR, dst=RF
    alu SBC, a=T0, b=T2, pair=AD, d=ZERO, dst=OPERAND
    WRITE, a=T1, byte=IR, b=T2, target=SBC_SINGLE_FLAGS, prefetch=0
SBC_SINGLE_FLAGS:
    alu SBC, a=T0, b=T2, pair=AD, d=ZERO, flags=NZVC, seq=FETCH
TST_SINGLE_MEMORY:
    READ, a=T1, byte=IR, target=TST_SINGLE_OPERAND, prefetch=0
TST_SINGLE_OPERAND:
    alu PASSA, pair=DA, d=MDR, flags=NZVC, seq=FETCH
ROR_SINGLE_MEMORY:
    READ, a=T1, byte=IR, target=ROR_SINGLE_OPERAND, prefetch=0
ROR_SINGLE_OPERAND:
    alu ROR, b=T2, pair=DA, d=MDR, dst=OPERAND
    WRITE, a=T1, byte=IR, b=T2, target=ROR_SINGLE_FLAGS, prefetch=0
ROR_SINGLE_FLAGS:
    alu ROR, b=T2, pair=DA, d=MDR, flags=NZVC, seq=FETCH
ROL_SINGLE_MEMORY:
    READ, a=T1, byte=IR, target=ROL_SINGLE_OPERAND, prefetch=0
ROL_SINGLE_OPERAND:
    alu ROL, b=T2, pair=DA, d=MDR, dst=OPERAND
    WRITE, a=T1, byte=IR, b=T2, target=ROL_SINGLE_FLAGS, prefetch=0
ROL_SINGLE_FLAGS:
    alu ROL, b=T2, pair=DA, d=MDR, flags=NZVC, seq=FETCH
ASR_SINGLE_MEMORY:
    READ, a=T1, byte=IR, target=ASR_SINGLE_OPERAND, prefetch=0
ASR_SINGLE_OPERAND:
    alu ASR, b=T2, pair=DA, d=MDR, dst=OPERAND
    WRITE, a=T1, byte=IR, b=T2, target=ASR_SINGLE_FLAGS, prefetch=0
ASR_SINGLE_FLAGS:
    alu ASR, b=T2, pair=DA, d=MDR, flags=NZVC, seq=FETCH
ASL_SINGLE_MEMORY:
    READ, a=T1, byte=IR, target=ASL_SINGLE_OPERAND, prefetch=0
ASL_SINGLE_OPERAND:
    alu LSL, b=T2, pair=DA, d=MDR, dst=OPERAND
    WRITE, a=T1, byte=IR, b=T2, target=ASL_SINGLE_FLAGS, prefetch=0
ASL_SINGLE_FLAGS:
    alu LSL, b=T2, pair=DA, d=MDR, flags=NZVC, seq=FETCH

; Branch entry = $040 | {IR[15],IR[10:8]} << 2.
; Only existing single-flag CJUMP predicates; no compound hardware decoder.
; Pause speculation until the redirect decision, avoiding an abandoned FRAM word.
.org $044
BR_DIRECT:
    alu ADD, a=R7, b=R7, pair=AD, d=DISP, dst=RF, seq=FETCH
.org $048
BNE:
    CJUMP, cond=NOT_Z, target=BR, prefetch=0
    alu PASSA, seq=FETCH
.org $04c
BEQ:
    CJUMP, cond=Z, target=BR, prefetch=0
    alu PASSA, seq=FETCH
.org $050
BGE:
    CJUMP, cond=N, target=BR_N_EQ_V, prefetch=0
    CJUMP, cond=NOT_V, target=BR, prefetch=0
    alu PASSA, seq=FETCH
.org $054
BLT:
    CJUMP, cond=N, target=BR_N_NE_V, prefetch=0
    CJUMP, cond=V, target=BR, prefetch=0
    alu PASSA, seq=FETCH
.org $058
BGT:
    CJUMP, cond=Z, target=BR_NOT_TAKEN, prefetch=0
    CJUMP, cond=N, target=BR_N_EQ_V, prefetch=0
    CJUMP, cond=NOT_V, target=BR, prefetch=0
    alu PASSA, seq=FETCH
.org $05c
BLE:
    CJUMP, cond=Z, target=BR, prefetch=0
    CJUMP, cond=N, target=BR_N_NE_V, prefetch=0
    CJUMP, cond=V, target=BR, prefetch=0
    alu PASSA, seq=FETCH
.org $060
BPL:
    CJUMP, cond=NOT_N, target=BR, prefetch=0
    alu PASSA, seq=FETCH
.org $064
BMI:
    CJUMP, cond=N, target=BR, prefetch=0
    alu PASSA, seq=FETCH
.org $068
BHI:
    CJUMP, cond=C, target=BR_NOT_TAKEN, prefetch=0
    CJUMP, cond=NOT_Z, target=BR, prefetch=0
    alu PASSA, seq=FETCH
.org $06c
BLOS:
    CJUMP, cond=C, target=BR, prefetch=0
    CJUMP, cond=Z, target=BR, prefetch=0
    alu PASSA, seq=FETCH
.org $070
BVC:
    CJUMP, cond=NOT_V, target=BR, prefetch=0
    alu PASSA, seq=FETCH
.org $074
BVS:
    CJUMP, cond=V, target=BR, prefetch=0
    alu PASSA, seq=FETCH
.org $078
BCC:
    CJUMP, cond=NOT_C, target=BR, prefetch=0
    alu PASSA, seq=FETCH
.org $07c
BCS:
    CJUMP, cond=C, target=BR, prefetch=0
    alu PASSA, seq=FETCH
.org $18f
BR_NOT_TAKEN:
    alu PASSA, seq=FETCH
BR_N_EQ_V:
    CJUMP, cond=V, target=BR, prefetch=0
    alu PASSA, seq=FETCH
BR_N_NE_V:
    CJUMP, cond=NOT_V, target=BR, prefetch=0
    alu PASSA, seq=FETCH

; CP12 uses existing RF/Q shifts. No byte-swap mux or new ALU operation.
.org $1a0
MARK:
    alu ADD, a=R7, b=R6, pair=AD, d=DISP, dst=RF
    alu PASSA, a=R5, b=R7, dst=RF
    READ, a=R6, target=MARK_POP, prefetch=0
MARK_POP:
    alu ADD, a=R6, b=R6, pair=AD, d=TWO, dst=RF
    alu PASSA, pair=DA, d=MDR, b=R5, dst=RF, seq=FETCH
.org $1b0
SXT_REGISTER:
    CJUMP, cond=N, target=SXT_REGISTER_NEGATIVE, prefetch=0
    alu PASSA, pair=DA, d=ZERO, b=RD, dst=RF, flags=NZV, seq=FETCH
SXT_REGISTER_NEGATIVE:
    alu NOTA, pair=DA, d=ZERO, b=RD, dst=RF, flags=NZV, seq=FETCH
.org $1b4
SXT_MEMORY:
    CALL, target=DESTINATION_EA, prefetch=0
    CJUMP, cond=N, target=SXT_MEMORY_NEGATIVE, prefetch=0
    alu PASSA, pair=DA, d=ZERO, b=T0, dst=RF
    JUMP, target=MOV_MEMORY, prefetch=0
SXT_MEMORY_NEGATIVE:
    alu NOTA, pair=DA, d=ZERO, b=T0, dst=RF
    JUMP, target=MOV_MEMORY, prefetch=0
.org $1c0
SWAB_REGISTER:
    alu PASSA, a=RD, b=T0, dst=RF
    CALL, target=SWAB_COMMON, prefetch=0
    alu PASSA, a=T2, b=RD, dst=RF
    JUMP, target=SWAB_FLAGS, prefetch=0
.org $1c8
SWAB_MEMORY:
    CALL, target=DESTINATION_EA, prefetch=0
    READ, a=T1, target=SWAB_CAPTURE, prefetch=0
SWAB_CAPTURE:
    alu PASSA, pair=DA, d=MDR, b=T0, dst=RF
    CALL, target=SWAB_COMMON, prefetch=0
    WRITE, a=T1, b=T2, target=SWAB_FLAGS, prefetch=0
.org $1d0
SWAB_FLAGS:
    alu PASSA, pair=DA, d=IMM, imm=255, b=T3, dst=RF
    alu NOTA, a=T3, b=T3, dst=RF
    ; Old high byte is the new low byte: mask to FF00 for word N/Z, V=C=0.
    alu AND, a=T0, b=T3, flags=NZVC, seq=FETCH
.org $2d0
SWAB_COMMON:
    alu PASSA, a=T0, dst=Q
    alu PASSA, pair=DA, d=ZERO, b=T2, dst=RF
    alu PASSA, a=T2, b=T2, dst=RFQ_L
    alu PASSA, a=T2, b=T2, dst=RFQ_L
    alu PASSA, a=T2, b=T2, dst=RFQ_L
    alu PASSA, a=T2, b=T2, dst=RFQ_L
    alu PASSA, a=T2, b=T2, dst=RFQ_L
    alu PASSA, a=T2, b=T2, dst=RFQ_L
    alu PASSA, a=T2, b=T2, dst=RFQ_L
    alu PASSA, a=T2, b=T2, dst=RFQ_L
    alu OR, a=T2, b=T2, pair=AQ, dst=RF
    RETURN, prefetch=0


; First software-trap gate: one kernel register set, T=0. No IRQ or mode exchange.
; Existing v7 LOAD/KEEP operations stay word-sized even for EMT/TRAP opcodes.
.org $024
BPT:
    alu PASSA, pair=DA, d=IMM, imm=12, b=T4, dst=RF
    TRAP, target=TRAP_ENTRY, prefetch=0
.org $026
IOT:
    alu PASSA, pair=DA, d=IMM, imm=16, b=T4, dst=RF
    TRAP, target=TRAP_ENTRY, prefetch=0
.org $028
EMT:
    alu PASSA, pair=DA, d=IMM, imm=24, b=T4, dst=RF
    TRAP, target=TRAP_ENTRY, prefetch=0
.org $02a
TRAP:
    alu PASSA, pair=DA, d=IMM, imm=28, b=T4, dst=RF
    TRAP, target=TRAP_ENTRY, prefetch=0
.org $031
RTI:
    READ, a=R6, target=RTI_PC, prefetch=0
RTI_PC:
    alu PASSA, pair=DA, d=MDR, b=T3, dst=RF
    alu ADD, a=R6, b=R6, pair=AD, d=TWO, dst=RF
    READ, a=R6, target=RTI_PSW, prefetch=0
RTI_PSW:
    alu ADD, a=R6, b=R6, pair=AD, d=TWO, dst=RF
    alu PASSA, pair=DA, d=MDR, flags=LOAD
    alu PASSA, a=T3, b=R7, dst=RF, seq=FETCH, trace=RETURN
.org $3d6
TRAP_ENTRY:
    alu PASSA, pair=DA, d=PSW, b=T0, dst=RF
    alu PASSA, a=R7, b=T1, dst=RF
    alu ADD, a=T4, b=T4, pair=AD, d=TWO, dst=RF
    READ, a=T4, target=TRAP_PSW, prefetch=0
TRAP_PSW:
    alu PASSA, pair=DA, d=MDR, b=T2, dst=RF
    alu SUB, a=T4, b=T4, pair=AD, d=TWO, dst=RF
    READ, a=T4, target=TRAP_PC, prefetch=0
TRAP_PC:
    alu PASSA, pair=DA, d=MDR, b=T3, dst=RF
    alu PASSA, a=T2, flags=LOAD
    alu SUB, a=R6, b=R6, pair=AD, d=TWO, dst=RF
    WRITE, a=R6, b=T0, target=TRAP_PUSH_PC, prefetch=0
TRAP_PUSH_PC:
    alu SUB, a=R6, b=R6, pair=AD, d=TWO, dst=RF
    WRITE, a=R6, b=T1, target=TRAP_COMMIT, prefetch=0
TRAP_COMMIT:
    alu PASSA, a=T3, b=R7, dst=RF, seq=FETCH


; CP14 IRQ and WAIT, resolved vector captured in MDR at a boundary.
.org 0x012
WAIT_INSTRUCTION:
    WAIT, prefetch=0
IRQ_ENTRY:
    alu PASSA, pair=DA, d=MDR, b=T4, dst=RF
    TRAP, target=TRAP_ENTRY, prefetch=0

; SPL's low opcode bits select a constant, without an IR-to-PSW mux.
.org 0x1f0
SPL0:
    alu PASSA, pair=DA, d=IMM, imm=0, b=T4, dst=RF
    JUMP, target=SPL_APPLY, prefetch=0
SPL1:
    alu PASSA, pair=DA, d=IMM, imm=32, b=T4, dst=RF
    JUMP, target=SPL_APPLY, prefetch=0
SPL2:
    alu PASSA, pair=DA, d=IMM, imm=64, b=T4, dst=RF
    JUMP, target=SPL_APPLY, prefetch=0
SPL3:
    alu PASSA, pair=DA, d=IMM, imm=96, b=T4, dst=RF
    JUMP, target=SPL_APPLY, prefetch=0
SPL4:
    alu PASSA, pair=DA, d=IMM, imm=128, b=T4, dst=RF
    JUMP, target=SPL_APPLY, prefetch=0
SPL5:
    alu PASSA, pair=DA, d=IMM, imm=160, b=T4, dst=RF
    JUMP, target=SPL_APPLY, prefetch=0
SPL6:
    alu PASSA, pair=DA, d=IMM, imm=192, b=T4, dst=RF
    JUMP, target=SPL_APPLY, prefetch=0
SPL7:
    alu PASSA, pair=DA, d=IMM, imm=224, b=T4, dst=RF
    JUMP, target=SPL_APPLY, prefetch=0
.org 0x3e4
SPL_APPLY:
    alu PASSA, pair=DA, d=IMM, imm=224, b=T5, dst=RF
    alu NOTA, a=T5, b=T5, dst=RF
    alu AND, pair=DB, d=PSW, b=T5, dst=RF
    alu OR, a=T4, b=T5, flags=LOAD
    alu PASSA, seq=FETCH


; Invalid JMP register mode uses vector004 on DCJ11; reserved instructions,
; including invalid JSR mode0, use vector010. Missing ISA also traps here.
.org 0x040
INVALID_JMP:
    alu PASSA, pair=DA, d=IMM, imm=4, b=T4, dst=RF
    TRAP, target=TRAP_ENTRY, prefetch=0
ILLEGAL_INSTRUCTION:
    alu PASSA, pair=DA, d=IMM, imm=8, b=T4, dst=RF
    TRAP, target=TRAP_ENTRY, prefetch=0

; A failed memory word has no datapath, flag, IR or MDR side effects.
; Current architectural PC is stacked by the shared frame microcode.
.org 0x015
BUS_FAULT_ENTRY:
    alu PASSA, pair=DA, d=IMM, imm=4, b=T4, dst=RF
    TRAP, target=TRAP_ENTRY, prefetch=0

; Condition-code masks use direct IR[3:0] wiring into free page-one slots.
; This preserves constant-zero dispatch[9]; OR_MD then selects clear/set.
; IR[5:3] is 4/5 for clear, 6/7 for set. Mask bit 3 duplicates the ALU leaf.
; T/IPL stay unchanged, so flags LOAD may retire on this same edge.
.org $017
MFPT:
    alu PASSA, pair=DA, d=IMM, imm=5, b=R0, dst=RF, seq=FETCH
.org $210
CC_ROUTE_BASE:
    STOP ; unreachable for CC: IR[5] is always one
    STOP
    STOP
    STOP
CC_CLEAR_LOW:
    alu BIC, pair=DB, d=PSW, b=T4, flags=LOAD, seq=FETCH
CC_CLEAR_HIGH:
    alu BIC, pair=DB, d=PSW, b=T4, flags=LOAD, seq=FETCH
CC_SET_LOW:
    alu OR, pair=DB, d=PSW, b=T4, flags=LOAD, seq=FETCH
CC_SET_HIGH:
    alu OR, pair=DB, d=PSW, b=T4, flags=LOAD, seq=FETCH
.org $104
CC_MASK_0:
    alu PASSA, pair=DA, d=IMM, imm=0, b=T4, dst=RF
    OR_MD, target=CC_ROUTE_BASE
.org $10c
CC_MASK_1:
    alu PASSA, pair=DA, d=IMM, imm=1, b=T4, dst=RF
    OR_MD, target=CC_ROUTE_BASE
.org $114
CC_MASK_2:
    alu PASSA, pair=DA, d=IMM, imm=2, b=T4, dst=RF
    OR_MD, target=CC_ROUTE_BASE
.org $11c
CC_MASK_3:
    alu PASSA, pair=DA, d=IMM, imm=3, b=T4, dst=RF
    OR_MD, target=CC_ROUTE_BASE
.org $124
CC_MASK_4:
    alu PASSA, pair=DA, d=IMM, imm=4, b=T4, dst=RF
    OR_MD, target=CC_ROUTE_BASE
.org $12c
CC_MASK_5:
    alu PASSA, pair=DA, d=IMM, imm=5, b=T4, dst=RF
    OR_MD, target=CC_ROUTE_BASE
.org $134
CC_MASK_6:
    alu PASSA, pair=DA, d=IMM, imm=6, b=T4, dst=RF
    OR_MD, target=CC_ROUTE_BASE
.org $13c
CC_MASK_7:
    alu PASSA, pair=DA, d=IMM, imm=7, b=T4, dst=RF
    OR_MD, target=CC_ROUTE_BASE
.org $144
CC_MASK_8:
    alu PASSA, pair=DA, d=IMM, imm=8, b=T4, dst=RF
    OR_MD, target=CC_ROUTE_BASE
.org $14c
CC_MASK_9:
    alu PASSA, pair=DA, d=IMM, imm=9, b=T4, dst=RF
    OR_MD, target=CC_ROUTE_BASE
.org $154
CC_MASK_A:
    alu PASSA, pair=DA, d=IMM, imm=10, b=T4, dst=RF
    OR_MD, target=CC_ROUTE_BASE
.org $15c
CC_MASK_B:
    alu PASSA, pair=DA, d=IMM, imm=11, b=T4, dst=RF
    OR_MD, target=CC_ROUTE_BASE
.org $164
CC_MASK_C:
    alu PASSA, pair=DA, d=IMM, imm=12, b=T4, dst=RF
    OR_MD, target=CC_ROUTE_BASE
.org $16c
CC_MASK_D:
    alu PASSA, pair=DA, d=IMM, imm=13, b=T4, dst=RF
    OR_MD, target=CC_ROUTE_BASE
.org $174
CC_MASK_E:
    alu PASSA, pair=DA, d=IMM, imm=14, b=T4, dst=RF
    OR_MD, target=CC_ROUTE_BASE
.org $17c
CC_MASK_F:
    alu PASSA, pair=DA, d=IMM, imm=15, b=T4, dst=RF
    OR_MD, target=CC_ROUTE_BASE

; MFPS is a MOVB of the pre-update PSW low byte. Memory flags follow WRITE ACK.
.org $1d8
MFPS_REGISTER:
    alu PASSA, pair=DA, d=PSW, b=RD, dst=MOV, flags=NZV, seq=FETCH
.org $1da
MFPS_MEMORY:
    CALL, target=DESTINATION_EA, prefetch=0
    alu PASSA, pair=DA, d=PSW, b=T0, dst=RF
    JUMP, target=MOV_MEMORY, prefetch=0
; MTPS reads a byte operand, preserves T/high PSW, then exposes new IPL to IRQ.
.org $1a8
MTPS_REGISTER:
    alu PASSA, a=RD, b=T2, dst=RF, seq=PAGE, next=MTPS_APPLY
.org $1aa
MTPS_MEMORY:
    CALL, target=DESTINATION_EA, prefetch=0
    READ, a=T1, byte=IR, target=MTPS_CAPTURE, prefetch=0
MTPS_CAPTURE:
    alu PASSA, pair=DA, d=MDR, b=T2, dst=RF, seq=PAGE, next=MTPS_APPLY
.org $194
MTPS_APPLY:
    alu PASSA, pair=DA, d=IMM, imm=$ef, b=T4, dst=RF
    alu AND, a=T4, b=T2, dst=RF
    alu NOTA, a=T4, b=T4, dst=RF
    alu AND, pair=DB, d=PSW, b=T4, dst=RF
    alu OR, a=T2, b=T4, flags=LOAD
    alu PASSA, seq=FETCH


; HALT follows the project's DCJ11 restart profile, not complete hardware ODT.
.org $018
HALT_RESTART:
    TRAP, target=HALT_ENTRY, prefetch=0
.org $3e9
HALT_ENTRY:
    alu PASSA, pair=DA, d=PSW, b=T0, dst=RF
    alu SUB, a=R6, b=R6, pair=AD, d=TWO, dst=RF
    WRITE, a=R6, b=T0, target=HALT_PUSH_PC, prefetch=0
HALT_PUSH_PC:
    alu SUB, a=R6, b=R6, pair=AD, d=TWO, dst=RF
    WRITE, a=R6, b=R7, target=HALT_VECTOR, prefetch=0
HALT_VECTOR:
    alu PASSA, pair=DA, d=IMM, imm=4, b=T4, dst=RF
    READ, a=T4, target=HALT_CAPTURE, prefetch=0
HALT_CAPTURE:
    alu PASSA, pair=DA, d=MDR, b=T3, dst=RF
    alu PASSA, pair=DA, d=IMM, imm=$e0, flags=LOAD
    alu BIC, a=T3, pair=AD, d=ONE, b=R7, dst=RF, seq=FETCH

; Board peripherals are synchronous. Reset pulse, release/settle, then IRQ.
.org $021
RESET_BUS:
    JUMP, target=RESET_SETTLE, init=1, prefetch=0
RESET_SETTLE:
    alu PASSA
    alu PASSA, seq=FETCH

; CP22 fixes ASH destination capture: count EA precedes the register read.
; T4=value, T0=low-six-bit count, T6=sticky shift overflow. No new RTL state.
.org $019
ASH:
    CALL, target=DESTINATION_EA, prefetch=0
    alu PASSA, a=RS, b=T4, dst=RF
    OR_MD, target=ASH_OPERAND, prefetch=0
.org $218
ASH_OPERAND:
    alu PASSA, a=RD, b=T0, dst=RF, seq=PAGE, next=ASH_COUNT
    READ, a=T1, target=ASH_MDR
    READ, a=T1, target=ASH_MDR
    READ, a=T1, target=ASH_MDR
    READ, a=T1, target=ASH_MDR
    READ, a=T1, target=ASH_MDR
    READ, a=T1, target=ASH_MDR
    READ, a=T1, target=ASH_MDR
.org $262
ASH_COUNT:
    alu AND, a=T0, pair=AD, d=IMM, imm=63, b=T0, dst=RF, flags=NZVC
    CJUMP, cond=Z, target=ASH_RIGHT_DONE
    alu AND, a=T0, pair=AD, d=IMM, imm=32, flags=NZV
    CJUMP, cond=Z, target=ASH_LEFT_INIT
    alu SUB, a=T0, pair=DA, d=IMM, imm=64, b=T0, dst=RF
ASH_RIGHT_LOOP:
    alu ASR, a=T4, b=T4, dst=RF, flags=NZVC
    alu SUB, a=T0, pair=AD, d=ONE, b=T0, dst=RF, flags=NZV
    CJUMP, cond=NOT_Z, target=ASH_RIGHT_LOOP
ASH_RIGHT_DONE:
    alu PASSA, a=T4, b=RS, dst=RF, flags=NZV, seq=FETCH
ASH_LEFT_INIT:
    alu PASSA, pair=DA, d=ZERO, b=T6, dst=RF
ASH_LEFT_LOOP:
    alu LSL, a=T4, b=T4, dst=RF, flags=NZVC
    alu OR, a=T6, pair=AD, d=PSW, b=T6, dst=RF
    alu SUB, a=T0, pair=AD, d=ONE, b=T0, dst=RF, flags=NZV
    CJUMP, cond=NOT_Z, target=ASH_LEFT_LOOP
    alu PASSA, a=T4, flags=NZV
    alu AND, a=T6, pair=AD, d=TWO, b=T6, dst=RF
    alu OR, a=T6, pair=AD, d=PSW, flags=LOAD
    alu PASSA, a=T4, b=RS, dst=RF, seq=FETCH
.org $27f
ASH_MDR:
    alu PASSA, pair=DA, d=MDR, b=T0, dst=RF, seq=PAGE, next=ASH_COUNT

; CP22 ASHC: capture both destination words after count operand EA.
.org $01c
ASHC:
    CALL, target=DESTINATION_EA, prefetch=0
    alu PASSA, a=RS, b=T4, dst=RF
    alu PASSA, a=RS1, dst=Q
    OR_MD, target=ASHC_OPERAND, prefetch=0
.org $290
ASHC_OPERAND:
    alu PASSA, a=RD, b=T0, dst=RF, seq=PAGE, next=ASHC_COUNT
    READ, a=T1, target=ASHC_MDR
    READ, a=T1, target=ASHC_MDR
    READ, a=T1, target=ASHC_MDR
    READ, a=T1, target=ASHC_MDR
    READ, a=T1, target=ASHC_MDR
    READ, a=T1, target=ASHC_MDR
    READ, a=T1, target=ASHC_MDR
.org $2dc
ASHC_COUNT:
    alu PASSA, pair=DA, d=ZERO, b=T6, dst=RF
    alu AND, a=T0, pair=AD, d=IMM, imm=63, b=T0, dst=RF, flags=NZVC
    CJUMP, cond=Z, target=ASHC_COMMIT
    alu AND, a=T0, pair=AD, d=IMM, imm=32, flags=NZV
    CJUMP, cond=Z, target=ASHC_LEFT_LOOP
    alu SUB, a=T0, pair=DA, d=IMM, imm=64, b=T0, dst=RF
ASHC_RIGHT_LOOP:
    alu PASSB, pair=ZQ, b=T5, dst=RF
    alu LSR, a=T5, flags=NZVC
    alu PASSA, a=T4, b=T4, dst=RFQ_R
    alu SUB, a=T0, pair=AD, d=ONE, b=T0, dst=RF, flags=NZV
    CJUMP, cond=NOT_Z, target=ASHC_RIGHT_LOOP
    JUMP, target=ASHC_COMMIT
ASHC_LEFT_LOOP:
    alu LSL, a=T4, flags=NZVC
    alu PASSA, a=T4, b=T4, dst=RFQ_L
    alu OR, a=T6, pair=AD, d=PSW, b=T6, dst=RF
    alu SUB, a=T0, pair=AD, d=ONE, b=T0, dst=RF, flags=NZV
    CJUMP, cond=NOT_Z, target=ASHC_LEFT_LOOP
    alu AND, a=T6, pair=AD, d=TWO, b=T6, dst=RF
ASHC_COMMIT:
    alu PASSA, a=T4, b=RS, dst=RF
    alu PASSB, pair=ZQ, b=RS1, dst=RF
    ; NZ describe the shifted 32-bit value, before odd-Rs writeback aliases.
    alu PASSA, a=T4, flags=NZV
    alu PASSA, pair=DA, d=PSW, b=T7, dst=RF
    alu OR, a=T4, pair=AQ, flags=NZV
    alu PASSA, pair=DA, d=PSW, b=T5, dst=RF
    alu AND, a=T5, pair=AD, d=IMM, imm=4, b=T5, dst=RF
    alu BIC, a=T7, pair=AD, d=IMM, imm=4, b=T7, dst=RF
    alu OR, a=T5, b=T7, dst=RF
    alu OR, a=T7, b=T6, flags=LOAD, seq=FETCH
ASHC_MDR:
    alu PASSA, pair=DA, d=MDR, b=T0, dst=RF, seq=PAGE, next=ASHC_COUNT

; CP24 XOR: the source register is read after destination EA/read, as on J-11.
; Register mode bypasses EA; memory NZV commit only after the successful WRITE.
.org $02c
XOR_RR:
    alu XOR, a=RS, b=RD, dst=RF, flags=NZV, seq=FETCH
.org $02e
XOR_EA:
    CALL, target=DESTINATION_EA, prefetch=0
    READ, a=T1, target=XOR_MEMORY, prefetch=0
.org $094
XOR_MEMORY:
    alu XOR, a=RS, pair=AD, d=MDR, b=T2, dst=RF
    WRITE, a=T1, b=T2, target=BIS_MEMORY_FLAGS, prefetch=0

; CP25 MUL: signed 16x16 -> T4:Q, no hardware multiply or new state.
; Read the encoded S operand before the R operand (including EA side effects).
.org $062
MUL_REGISTER:
    alu PASSA, a=RD, b=T2, dst=RF
    JUMP, target=MUL_INIT
.org $066
MUL_MEMORY:
    CALL, target=DESTINATION_EA, prefetch=0
    READ, a=T1, target=MUL_MDR, prefetch=0
.org $082
MUL_MDR:
    alu PASSA, pair=DA, d=MDR, b=T2, dst=RF
    JUMP, target=MUL_INIT
.org $312
MUL_INIT:
    alu PASSA, a=RS, b=T0, dst=RF
    alu PASSA, a=RS, b=T3, dst=RF
    alu PASSA, pair=DA, d=ZERO, b=T4, dst=RF
    alu PASSA, pair=DA, d=ZERO, dst=Q
    alu PASSA, pair=DA, d=IMM, imm=16, b=T1, dst=RF
    alu PASSA, pair=DA, d=ZERO, b=T5, dst=RF
    alu PASSA, a=T2, flags=NZVC
    CJUMP, cond=NOT_N, target=MUL_LOOP
    alu NOTA, pair=DA, d=ZERO, b=T5, dst=RF
    JUMP, target=MUL_LOOP
.org $333
MUL_LOOP:
    alu PASSA, a=T4, b=T4, dst=RFQ_L
    alu LSL, a=T0, b=T0, dst=RF, flags=NZVC
    CJUMP, cond=NOT_C, target=MUL_NEXT_BIT
    alu ADD, a=T2, pair=AQ, dst=Q, flags=NZVC
    alu ADC, a=T5, b=T4, dst=RF
MUL_NEXT_BIT:
    alu SUB, a=T1, pair=AD, d=ONE, b=T1, dst=RF, flags=NZVC
    CJUMP, cond=NOT_Z, target=MUL_LOOP
    ; M * unsigned(R) - (R<0 ? M<<16 : 0), modulo 2^32.
    alu PASSA, a=T3, flags=NZVC
    CJUMP, cond=NOT_N, target=MUL_FLAGS
    alu SUB, a=T2, b=T4, pair=BA, dst=RF
    JUMP, target=MUL_FLAGS
.org $373
MUL_FLAGS:
    alu PASSB, pair=ZQ, b=T0, dst=RF, flags=NZVC
    alu PASSA, pair=DA, d=ZERO, b=T5, dst=RF
    CJUMP, cond=NOT_N, target=MUL_CARRY_COMPARE
    alu NOTA, pair=DA, d=ZERO, b=T5, dst=RF
MUL_CARRY_COMPARE:
    alu SUB, a=T4, b=T5, flags=NZVC
    alu PASSA, pair=DA, d=ZERO, b=T6, dst=RF
    CJUMP, cond=Z, target=MUL_NZ
    alu PASSA, pair=DA, d=ONE, b=T6, dst=RF
MUL_NZ:
    alu PASSA, a=T4, flags=NZVC
    alu PASSA, pair=DA, d=PSW, b=T7, dst=RF
    alu OR, a=T4, pair=AQ, flags=NZV
    alu PASSA, pair=DA, d=PSW, b=T5, dst=RF, seq=PAGE, next=MUL_COMMIT
.org $395
MUL_COMMIT:
    alu AND, a=T5, pair=AD, d=IMM, imm=4, b=T5, dst=RF
    alu BIC, a=T7, pair=AD, d=IMM, imm=4, b=T7, dst=RF
    alu OR, a=T5, b=T7, dst=RF
    alu OR, a=T6, b=T7, flags=LOAD
    alu PASSA, a=T4, b=RS, dst=RF
    alu PASSB, pair=ZQ, b=RS1, dst=RF, seq=FETCH

; CP26 DIV: unsigned restoring loop in T4:Q; signed operands/results at edges.
; T2=divisor magnitude, T0=dividend sign, T3=quotient sign, T1=count, T5=1.
; Fetch S before R and R|1. No architectural writes until success.
.org $072
DIV_REGISTER:
    alu PASSA, a=RD, b=T2, dst=RF
    JUMP, target=DIV_INIT
.org $076
DIV_MEMORY:
    CALL, target=DESTINATION_EA, prefetch=0
    READ, a=T1, target=DIV_MDR, prefetch=0
.org $07a
DIV_MDR:
    alu PASSA, pair=DA, d=MDR, b=T2, dst=RF
    JUMP, target=DIV_INIT
.org $181
DIV_INIT:
    alu PASSA, a=RS, b=T4, dst=RF
    alu PASSA, a=RS1, dst=Q
    alu PASSA, a=T4, b=T0, dst=RF
    alu PASSA, a=T2, b=T3, dst=RF
    alu XOR, a=T4, b=T3, dst=RF
    alu PASSA, a=T2, flags=NZVC
    CJUMP, cond=Z, target=DIV_ZERO
    CJUMP, cond=NOT_N, target=DIV_MAGNITUDE
    alu SUB, pair=ZB, b=T2, dst=RF
    JUMP, target=DIV_MAGNITUDE
.org $256
DIV_MAGNITUDE:
    alu PASSA, a=T4, flags=NZVC
    CJUMP, cond=NOT_N, target=DIV_NORMALIZED
    alu SUB, pair=ZQ, dst=Q, flags=NZVC
    alu SBC, pair=ZB, b=T4, dst=RF
DIV_NORMALIZED:
    alu SUB, a=T4, b=T2, flags=NZVC
    CJUMP, cond=NOT_C, target=DIV_OVERFLOW
    alu PASSA, pair=DA, d=IMM, imm=16, b=T1, dst=RF
    alu PASSA, pair=DA, d=ONE, b=T5, dst=RF
    JUMP, target=DIV_LOOP
.org $3b5
DIV_LOOP:
    alu PASSA, a=T4, b=T4, dst=RFQ_L
    alu SUB, a=T2, b=T4, pair=BA, dst=RF, flags=NZVC
    CJUMP, cond=C, target=DIV_RESTORE
    alu OR, a=T5, pair=AQ, dst=Q
    JUMP, target=DIV_NEXT_BIT
DIV_RESTORE:
    alu ADD, a=T2, b=T4, dst=RF
DIV_NEXT_BIT:
    alu SUB, a=T1, pair=AD, d=ONE, b=T1, dst=RF, flags=NZVC
    CJUMP, cond=NOT_Z, target=DIV_LOOP
    alu PASSA, a=T3, flags=NZVC
    CJUMP, cond=N, target=DIV_NEGATIVE_QUOTIENT
    JUMP, target=DIV_POSITIVE_QUOTIENT
.org $308
DIV_NEGATIVE_QUOTIENT:
    alu SUB, pair=ZQ, dst=Q, flags=NZVC
    CJUMP, cond=N, target=DIV_REMAINDER
    CJUMP, cond=Z, target=DIV_REMAINDER
    JUMP, target=DIV_OVERFLOW
DIV_POSITIVE_QUOTIENT:
    alu PASSB, pair=ZQ, flags=NZVC
    CJUMP, cond=N, target=DIV_OVERFLOW
    JUMP, target=DIV_REMAINDER
.org $328
DIV_REMAINDER:
    alu PASSA, a=T0, flags=NZVC
    CJUMP, cond=NOT_N, target=DIV_COMMIT
    alu SUB, pair=ZB, b=T4, dst=RF
DIV_COMMIT:
    alu PASSB, pair=ZQ, b=RS, dst=RF, flags=NZVC
    ; R must be even per DEC. For odd R the explicit SIMH-style extension
    ; leaves the remainder in the aliased R|1, flags still describe quotient.
    alu PASSA, a=T4, b=RS1, dst=RF, seq=FETCH
.org $348
DIV_OVERFLOW:
    alu PASSA, a=T3, flags=NZVC
    alu PASSA, pair=DA, d=TWO, b=T5, dst=RF
    CJUMP, cond=NOT_N, target=DIV_EXCEPTION_FLAGS
    alu PASSA, pair=DA, d=IMM, imm=10, b=T5, dst=RF
    JUMP, target=DIV_EXCEPTION_FLAGS
DIV_ZERO:
    alu PASSA, pair=DA, d=IMM, imm=7, b=T5, dst=RF
    JUMP, target=DIV_EXCEPTION_FLAGS
.org $368
DIV_EXCEPTION_FLAGS:
    alu PASSA, pair=DA, d=PSW, b=T6, dst=RF
    alu BIC, a=T6, pair=AD, d=IMM, imm=15, b=T6, dst=RF
    alu OR, a=T5, b=T6, flags=LOAD, seq=FETCH
