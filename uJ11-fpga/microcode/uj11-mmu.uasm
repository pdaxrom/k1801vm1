    OR_MD, target=MFPI_SOURCE, prefetch=0
.org $408
MFPI_SOURCE:
    alu PASSA, a=RD, b=T0, dst=RF, previous=1, seq=PAGE, next=MFPI_PUSH
    JUMP, target=MFPI_MEMORY, prefetch=0
    JUMP, target=MFPI_MEMORY, prefetch=0
    JUMP, target=MFPI_MEMORY, prefetch=0
    JUMP, target=MFPI_MEMORY, prefetch=0
