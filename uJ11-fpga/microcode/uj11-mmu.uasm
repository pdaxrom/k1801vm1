MFPI_MEMORY:
    READ, space=PREVIOUS_I, a=T1, target=MFPI_VALUE, prefetch=0
MFPI_VALUE:
    alu PASSA, pair=DA, d=MDR, b=T0, dst=RF
MFPI_PUSH:
    alu SUB, a=R6, b=R6, pair=AD, d=TWO, dst=RF, delta=1
    WRITE, a=R6, b=T0, target=MFPI_FLAGS, prefetch=0
MFPI_FLAGS:
    alu PASSA, a=T0, flags=NZV, seq=FETCH
.org $420
MTPI:
