    JUMP, target=MTPI_MEMORY, prefetch=0
    JUMP, target=MTPI_MEMORY, prefetch=0
    JUMP, target=MTPI_MEMORY, prefetch=0
    JUMP, target=MTPI_MEMORY, prefetch=0
    JUMP, target=MTPI_MEMORY, prefetch=0
