; CP37 lookup data path only: no translation, permission check or CPU CSR.
; Entry retains A4 in variant a, or VA page3 in selected d/e. Live RF is unchanged.
; Read kernel unified PAR/PDR into T6/T7, exercise word flags, restore PSW.
.org $1cd
MMU_ENTRY:
    alu PASSA, pair=DA, d=PSW, b=T5, dst=RF
    APR_READ, kind=PAR, target=APR_SAVE_PAR
APR_SAVE_PAR:
    alu PASSA, pair=DA, d=APR, b=T6, dst=RF, seq=PAGE, next=APR_READ_PDR
.org $1dd
APR_READ_PDR:
    APR_READ, kind=PDR, target=APR_SAVE_PDR
APR_SAVE_PDR:
    alu PASSA, pair=DA, d=APR, b=T7, dst=RF, flags=NZVC
    JUMP, target=MMU_ENTRY_RESTORE, prefetch=0
.org $32d
MMU_ENTRY_RESTORE:
    alu XOR, a=T6, b=T7, flags=NZVC
    alu PASSA, a=T5, flags=LOAD
    MMU_RETURN
