; CP35 context-preservation experiment, not an address translator.
; All nine words occupy previously unused slots in the production image.
; Preserve PSW through T5, deliberately change NZVC/T6, read original MDR
; through T7, then resume the intercepted FETCH/READ/WRITE. Never touch Q,
; T0..T4, architectural RF, MDR, IR or the ordinary CALL/RETURN link.
.org $1cd
MMU_ENTRY:
    alu PASSA, pair=DA, d=PSW, b=T5, dst=RF
    alu NOTA, a=T5, b=T6, dst=RF, flags=NZVC
    JUMP, target=MMU_ENTRY_CHECK, prefetch=0
.org $1dd
MMU_ENTRY_CHECK:
    alu XOR, a=T6, b=T6, dst=RF, flags=NZVC
    CJUMP, cond=Z, target=MMU_ENTRY_RESTORE, prefetch=0
    STOP
.org $32d
MMU_ENTRY_RESTORE:
    alu PASSA, a=T5, flags=LOAD
    alu PASSA, pair=DA, d=MDR, b=T7, dst=RF
    MMU_RETURN
