FP_INTEGER_POSITIVE:
    alu AND, a=T6, pair=AD, d=IMM, imm=32768, flags=NZVC, uflags=1
    CJUMP, cond=NOT_Z, uflags=1, target=FP_INTEGER_OVERFLOW, prefetch=0
