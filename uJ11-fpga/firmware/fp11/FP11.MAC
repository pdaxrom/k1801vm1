	.TITLE UJFP11
	.IDENT /00.01/
; CP68 control-only FP11 firmware. Absolute HALT FRAM, CP67 module ABI3.
; Seven mnemonics; LDFPS/STFPS accept only CPU register mode in this stage.
; Other 17xxxx encodings report FEC=2, honoring FID. No arithmetic yet.
	.ASECT
	.=40000
INIT:	JMP @#COLD
SIGN:	.WORD 125110,1
CPC=100
CPSW=102
FPSMSK=147757
	.MACRO JNE DST,?OK
	BEQ OK
	JMP DST
OK:
	.ENDM
	.MACRO JEQ DST,?OK
	BNE OK
	JMP DST
OK:
	.ENDM
; The generic walker owns its fault vector until we return RTS PC.
COLD:	.WORD 43
	BIT #400,R0
	BEQ CFAIL
	CMP @#122,#7000
	BNE CFAIL
	BIC #177770,R0
	MOV R0,R3
	MOV #IMMEND,R1
	MOV #<MEMEND-IMMEND>/2,R2
1$:	CLR (R1)
	TST (R1)+
	BNE CFAIL
	SOB R2,1$
	MOV #ENTER,@#10
	CMP @#10,#ENTER
	BNE CFAIL
	MOV #340,@#12
	CMP @#12,#340
	BNE CFAIL
; Ready is published last; preserve installed ODT/debug bits.
	MOV R3,R0
	BIS #2,R0
	.WORD 42
	CLR R0
	RTS PC
CFAIL:	MOV #1,R0
	RTS PC

; No use of the USER stack, even when its address is odd.
ENTER:	MOV R0,REGS
	MOV R1,REGS+2
	MOV R2,REGS+4
	MOV R3,REGS+6
	MOV R4,REGS+10
	MOV R5,REGS+12
	MOV SP,REGS+14
	MOV @#CPC,REGS+16
	MOV @#CPSW,REGS+20
	MOV #STKTOP,SP
	MOV @#4,OLDVEC
	MOV @#6,OLDVEC+2
	CLR INTRAP
	MOV #BUSERR,@#4
	MOV #340,@#6
; HALT entry supplies PC after the opcode. Decode its RAM word, without
; consuming an extension word or changing the saved architectural PC.
	MOV REGS+16,R5
	SUB #2,R5
	MOV R5,OPADDR
	.WORD 21
	MOV R0,OPCODE
	CMP R0,#170000
	BEQ CFCC
	CMP R0,#170001
	BEQ SETF
	CMP R0,#170002
	BEQ SETI
	CMP R0,#170011
	BEQ SETD
	CMP R0,#170012
	BEQ SETL
	MOV R0,R1
	BIC #7,R1
	BIC #177770,R0
	ASL R0
	ADD #REGS,R0
	CMP R1,#170100
	BEQ LDFPS
	CMP R1,#170200
	BEQ STFPS
	BR UNIMPL
CFCC:	MOV FPS,R0
	BIC #177760,R0
	BIC #17,REGS+20
	BIS R0,REGS+20
	BR RETURN
SETF:	BIC #200,FPS
	BR RETURN
SETI:	BIC #100,FPS
	BR RETURN
SETD:	BIS #200,FPS
	BR RETURN
SETL:	BIS #100,FPS
	BR RETURN
LDFPS:	MOV (R0),FPS
	BIC #<177777-FPSMSK>,FPS
	BR RETURN
STFPS:	MOV FPS,(R0)
	BR RETURN
; FEC/FEA are retained for a later STST implementation. Unimplemented valid
; instructions are explicitly outside this checkpoint's supported ISA.
UNIMPL:	MOV #2,FEC
	MOV OPADDR,FEA
	BIS #100000,FPS
	BIT #40000,FPS
	BNE RETURN
	MOV #244,TVEC
	BR TRAP
BUSERR:	TST INTRAP
	BNE FATAL
	MOV #4,TVEC
; Construct the usual unbanked CPU frame: PSW then PC, then read the vector.
; A fault during this construction is terminal, as with the base CPU.
TRAP:	MOV #1,INTRAP
	MOV REGS+14,R5
	MOV REGS+20,R0
	.WORD 31
	MOV REGS+16,R0
	.WORD 31
	MOV R5,REGS+14
	MOV TVEC,R5
	.WORD 21
	MOV R0,REGS+16
	.WORD 21
	MOV R0,REGS+20
RETURN:	MOV OLDVEC,@#4
	MOV OLDVEC+2,@#6
	MOV REGS+16,@#CPC
	MOV REGS+20,@#CPSW
	MOV REGS,R0
	MOV REGS+2,R1
	MOV REGS+4,R2
	MOV REGS+6,R3
	MOV REGS+10,R4
	MOV REGS+12,R5
	MOV REGS+14,SP
	.WORD 10
FATAL:	HALT
; Mutable state is excluded from the retained image checksum.
IMMEND:
FPS:	.BLKW 1
FEC:	.BLKW 1
FEA:	.BLKW 1
ACS:	.BLKW 24.
REGS:	.BLKW 9.
OLDVEC:	.BLKW 2
OPADDR:	.BLKW 1
OPCODE:	.BLKW 1
TVEC:	.BLKW 1
INTRAP:	.BLKW 1
STACK:	.BLKW 64.
STKTOP:
MEMEND:
	.END INIT
