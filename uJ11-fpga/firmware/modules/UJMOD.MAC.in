	.TITLE UJMOD
	.IDENT /03.00/
; Type-free retained module loader. DATA and status words are raw HALT FRAM.
; No initializer is executed here. Restart (without ESC) after installation.
	.MCALL .PRINT,.EXIT,.GTLIN,.LOOKUP,.READW,.CLOSE
	.ENABL LC
	.MACRO	JNE DST,?OK
	BEQ	OK
	JMP	DST
OK:
	.ENDM
	.MACRO	JEQ DST,?OK
	BNE	OK
	JMP	DST
OK:
	.ENDM
	.MACRO	JCS DST,?OK
	BCC	OK
	JMP	DST
OK:
	.ENDM
	.MACRO	JHI DST,?OK
	BLOS	OK
	JMP	DST
OK:
	.ENDM
	.MACRO	JLO DST,?OK
	BHIS	OK
	JMP	DST
OK:
	.ENDM

	.MACRO JCC DST,?OK
	BCS OK
	JMP DST
OK:
	.ENDM

HDBYT=512.
TABLE=7000
TEND=7100
HBASE=10
HLEN=12
HCS=14
	.PSECT LOAD,I,RW
START:	JSR PC,UPLOAD
	JCS NOHELP
	JSR PC,GETST
	JCS NOHELP
; CP67's cold walker leaves the table address as its ABI cookie in HALT 122.
	MOV #122,R5
	JSR PC,RDWORD
	JCS NOHELP
	CMP R0,#TABLE
	JNE NOHELP
	.GTLIN #LINE,#PROMPT
	MOV #LINE,R1
	MOV #STACMD,R2
	JSR PC,STREQ
	JEQ STATUS
	MOV #LINE,R1
	MOV #QUIT,R2
	JSR PC,STREQ
	JEQ EXIT
	CMPB LINE,#'O
	BNE 1$
	CMPB LINE+1,#'F
	BNE 1$
	CMPB LINE+2,#'F
	JEQ OFF
1$:	CMPB LINE,#'D
	BNE 2$
	CMPB LINE+1,#'E
	BNE 2$
	CMPB LINE+2,#'L
	JEQ OFF
2$:	JSR PC,NAME50
	JCC LOAD
	.PRINT #USAGE
	.EXIT
NOHELP:	.PRINT #UNSUP
	.EXIT
STREQ:	CMPB (R1)+,(R2)+
	BNE 1$
	TSTB -1(R1)
	BNE STREQ
1$:	RTS PC
NAME50:	TSTB	LINE
	BEQ	8$
	MOV	#LINE,R2
	MOV	#SPEC+2,R3
1$:	CLR	R1
	MOV	#3,R5
2$:	CLR	R4
	TSTB	(R2)
	BEQ	5$
	MOVB	(R2)+,R4
	CMP	R4,#'A
	BLO	3$
	CMP	R4,#'Z
	BHI	8$
	SUB	#100,R4
	BR	5$
3$:	CMP	R4,#'0
	BLO	8$
	CMP	R4,#'9
	BHI	8$
	SUB	#18.,R4
5$:	MOV	R1,R0
	MUL	#40.,R0
	ADD	R4,R1
	SOB	R5,2$
	MOV	R1,(R3)+
	CMP	R3,#SPEC+6
	BLO	1$
	TSTB	(R2)
	BNE	8$
	CLC
	RTS	PC
8$:	SEC
	RTS	PC

; All header/directory checks precede disabling live services or any write.
LOAD:	.LOOKUP #AREA,#0,#SPEC
	JCS OPNFAIL
	MOV R0,FLEN
	.READW #AREA,#0,#HEADER,#256.,#0
	JCS RDFAIL
	JSR PC,VALID
	JCS HDFAIL
	JSR PC,SELECT
	JCS TBFAIL
	CLR R0
	JSR PC,SETST
	JCS VRFAIL
	MOV SLOT,R5
	ADD #6,R5
	MOV #140402,R0
	JSR PC,PUTCHK
	JCS VRFAIL
	.PRINT #WRMSG
	CLR TOTAL
	MOV #1,BLOCK
	MOV HEADER+HLEN,LEFT
	MOV HEADER+HBASE,CURSOR
NXTBLK:	.READW #AREA,#0,#BUFFER,#256.,BLOCK
	JCS RDFAIL
	MOV #256.,R4
	CMP LEFT,R4
	BHIS 1$
	MOV LEFT,R4
1$:	MOV R4,COUNT
	MOV #BUFFER,R2
	MOV CURSOR,R5
COPY:	MOV R4,R0
	CMP R0,#10
	BLOS 3$
	MOV #10,R0
3$:	MOV R0,XCOUNT
	MOV R2,DESC+6
	MOV #7,DESC
	JSR PC,API
	JCS VRFAIL
	MOV XCOUNT,R3
4$:	ADD (R2)+,TOTAL
	ADD #2,R5
	DEC R4
	SOB R3,4$
	TST R4
	BNE COPY
	MOV R5,CURSOR
1$:	CMP R2,#BUFFER+HDBYT
	BHIS 2$
	TST (R2)+
	JNE CKFAIL
	BR 1$
2$:	SUB COUNT,LEFT
	INC BLOCK
	TST LEFT
	JNE NXTBLK
	CMP TOTAL,HEADER+HCS
	JNE CKFAIL
; Second complete checksum after all per-word readbacks, before publication.
	MOV HEADER+HBASE,R5
	MOV HEADER+HLEN,R4
	CLR R1
VERIFY:	MOV R4,R0
	CMP R0,#10
	BLOS 1$
	MOV #10,R0
1$:	MOV R0,XCOUNT
	MOV #5,DESC
	JSR PC,API
	JCS VRFAIL
	ADD R0,R1
	ADD XCOUNT,R5
	ADD XCOUNT,R5
	SUB XCOUNT,R4
	BNE VERIFY
	CMP R1,HEADER+HCS
	JNE CKFAIL
	MOV #HEADER+HBASE,R2
	MOV SLOT,R5
	MOV #3,R4
PUBLISH:	MOV (R2)+,R0
	JSR PC,PUTCHK
	JCS VRFAIL
	ADD #2,R5
	SOB R4,PUBLISH
; VALID is the LAST store: interrupted copies never become executable.
	MOV #140403,R0
	JSR PC,PUTCHK
	JCS VRFAIL
	.CLOSE #0
	.PRINT #DONE
	.EXIT
PUTCHK:	MOV R0,R3
	JSR PC,WRWORD
	BCS 1$
	JSR PC,RDWORD
	BCS 1$
	CMP R0,R3
	BNE 2$
	CLC
1$:	RTS PC
2$:	SEC
	RTS PC
RDWORD:	CLR	DESC
	BR	API
WRWORD:	MOV	#1,DESC
	BR	API
SETST:	MOV	#2,DESC
	BR	API
GETST:	MOV	#3,DESC
API:	MOV	R0,DESC+4
	MOV	R5,DESC+2
	MOV	R1,-(SP)
	MOV	R2,-(SP)
	MOV	R3,-(SP)
	MOV	R4,-(SP)
	MOV	R5,-(SP)
	MOV	#125061,R4
	MOV	#1000,R1
	CLR	R2
	MOV	#DESC,R5
	HALT
	MOV	R2,ERRFLG
	MOV	(SP)+,R5
	MOV	(SP)+,R4
	MOV	(SP)+,R3
	MOV	(SP)+,R2
	MOV	(SP)+,R1
; MOV changes N/Z, so save the status separately before restoring registers.
	TST	ERRFLG
	BNE	APIERR
	CLC
	RTS	PC
APIERR:	SEC
	RTS	PC
UPLOAD:	MOV	#HELPER,R5
	MOV	#1000,R1
	MOV	#125061,R4
	MOV	#HCNT,R3
1$:	MOV	#100,R2
	CMP	R3,R2
	BHIS	2$
	MOV	R3,R2
2$:	MOV	R3,-(SP)
	SUB	R2,(SP)
	HALT
	MOV	(SP)+,R3
	TST	R0
	BNE	APIERR
	TST	R3
	BNE	1$
	CLC
	RTS	PC
DESC:	.BLKW	4
ERRFLG:	.WORD	0


; R0 byte BASE, R1 word LENGTH -> R2 exclusive end. No table/system/I/O code.
RANGE:	BIT #1,R0
	BNE BADHDR
	CMP R0,#6000
	BLO BADHDR
	TST R1
	BEQ BADHDR
	MOV R1,R2
	ASL R2
	BCS BADHDR
	ADD R0,R2
	BCS BADHDR
	CMP R2,#160000
	BHI BADHDR
	CMP R0,#10000
	BHIS 1$
	CMP R2,#7000
	BHI BADHDR
1$:	CLC
	RTS PC
BADHDR:	SEC
	RTS PC
VALID:	CMP HEADER,#45125
	JNE BADHDR
	CMP HEADER+2,#30461
	JNE BADHDR
	CMP HEADER+4,#2
	JNE BADHDR
	CMP HEADER+6,#3
	JNE BADHDR
	MOV HEADER+HBASE,R0
	MOV HEADER+HLEN,R1
	JSR PC,RANGE
	JCS BADHDR
	MOV R2,NEWEND
	MOV #HEADER,R2
	MOV #16.,R3
	CLR R1
1$:	ADD (R2)+,R1
	SOB R3,1$
	TST R1
	JNE BADHDR
	MOV #HEADER+20,R2
2$:	TST (R2)+
	JNE BADHDR
	CMP R2,#HEADER+HDBYT
	BLO 2$
	MOV HEADER+HLEN,R0
	ASL R0
	ADD #511.,R0
	SWAB R0
	BIC #177400,R0
	CLC
	ROR R0
	INC R0
	CMP R0,FLEN
	JNE BADHDR
	CLC
	RTS PC
; Replace same BASE, otherwise first uncommitted slot. Disabled valid records
; still reserve their immutable extents. Duplicate bases/overlaps are errors.
SELECT:	MOV #-1,SLOT
	MOV #-1,FREESL
	MOV #TABLE,SCAN
SNEXT:	MOV SCAN,R5
	MOV #EBUF,R2
	MOV #4,R1
1$:	JSR PC,RDWORD
	BCS SBAD
	MOV R0,(R2)+
	ADD #2,R5
	SOB R1,1$
	MOV EBUF+6,R0
	BIC #16,R0
	CMP R0,#140401
	BEQ SVALID
	CMP FREESL,#-1
	BNE SSKIP
	MOV SCAN,FREESL
	BR SSKIP
SVALID:	MOV EBUF,R0
	CMP R0,HEADER+HBASE
	BNE SOTHER
	CMP SLOT,#-1
	BNE SBAD
	MOV SCAN,SLOT
	BR SSKIP
SOTHER:	MOV EBUF+2,R1
	JSR PC,RANGE
	BCS SBAD
	CMP R0,NEWEND
	BHIS SSKIP
	CMP R2,HEADER+HBASE
	BHI SBAD
SSKIP:	ADD #10,SCAN
	CMP SCAN,#TEND
	BLO SNEXT
	CMP SLOT,#-1
	BNE 1$
	MOV FREESL,SLOT
1$:	CMP SLOT,#-1
	BEQ SBAD
	CLC
	RTS PC
SBAD:	SEC
	RTS PC
; OFFn keeps the allocation but disables AUTO; DELn forgets a record. Neither
; erases the image. Live services are disabled before changing the directory.
OFF:	TSTB LINE+4
	BNE BADCLI
	MOVB LINE+3,R0
	SUB #'0,R0
	CMP R0,#7
	BHI BADCLI
	ASL R0
	ASL R0
	ASL R0
	ADD #TABLE+6,R0
	MOV R0,R5
	CLR R0
	JSR PC,SETST
	JCS VRFAIL
	CLR R0
	CMPB LINE,#'D
	BEQ OWRITE
	JSR PC,RDWORD
	JCS VRFAIL
	BIC #16,R0
	CMP R0,#140401
	BNE BADCLI
OWRITE:	JSR PC,PUTCHK
	JCS VRFAIL
	.PRINT #DONE
	.EXIT
BADCLI:	.PRINT #USAGE
	.EXIT
STATUS:	MOV #TABLE,SCAN
	MOV #'0,NUMBER
SLINE:	MOV #STAT,R1
	MOVB NUMBER,(R1)+
	MOVB #':,(R1)+
	MOV SCAN,R5
	MOV #4,R4
1$:	JSR PC,RDWORD
	JCS VRFAIL
	MOVB #' ,(R1)+
	JSR PC,OCTAL
	ADD #2,R5
	SOB R4,1$
	CLRB (R1)
	.PRINT #STAT
	ADD #10,SCAN
	INC NUMBER
	CMP SCAN,#TEND
	BLO SLINE
EXIT:	.EXIT
OCTAL:	MOV #6,R2
	MOV R0,R3
1$:	CLR R0
	ROL R3
	ROL R0
	CMP R2,#6
	BEQ 2$
	ROL R3
	ROL R0
	ROL R3
	ROL R0
2$:	ADD #'0,R0
	MOVB R0,(R1)+
	SOB R2,1$
	RTS PC
OPNFAIL:	MOV #OPNERR,R0
	BR FAIL
HDFAIL:	MOV #HDRERR,R0
	BR FAIL
TBFAIL:	MOV #TABERR,R0
	BR FAIL
RDFAIL:	MOV #READER,R0
	BR FAIL
VRFAIL:	MOV #VERERR,R0
	BR FAIL
CKFAIL:	MOV #CHKERR,R0
FAIL:	.PRINT
	.CLOSE #0
	.EXIT
SPEC:	.RAD50 /SY /
	.WORD 0,0
	.RAD50 /BIN/
AREA:	.BLKW 5
FLEN:	.WORD 0
NEWEND:	.WORD 0
SLOT:	.WORD 0
FREESL:	.WORD 0
SCAN:	.WORD 0
NUMBER:	.WORD 0
EBUF:	.BLKW 4
BLOCK:	.WORD 0
LEFT:	.WORD 0
COUNT:	.WORD 0
CURSOR:	.WORD 0
TOTAL:	.WORD 0
XCOUNT:	.WORD 0
STACMD:	.ASCIZ /STATUS/
QUIT:	.ASCIZ /EXIT/
PROMPT:	.ASCII /UJMOD> /
	.BYTE 200
USAGE:	.ASCIZ /?UJMOD-E-Use filename (1-6 letters or digits), STATUS, OFF0..7, DEL0..7, EXIT/
UNSUP:	.ASCIZ /?UJMOD-E-CP67 cold bootstrap required/
OPNERR:	.ASCIZ /?UJMOD-E-LOOKUP failed/
HDRERR:	.ASCIZ /?UJMOD-E-Invalid header or file length; directory unchanged/
TABERR:	.ASCIZ /?UJMOD-E-Directory full, invalid or overlapping; use STATUS and DELn/
WRMSG:	.ASCIZ /!UJMOD-I-WRITING; services disabled, record invalid/
READER:	.ASCIZ /?UJMOD-E-READ failed/
VERERR:	.ASCIZ /?UJMOD-E-FRAM verification failed/
CHKERR:	.ASCIZ /?UJMOD-E-Checksum or padding failed; record invalid/
DONE:	.ASCIZ /!UJMOD-I-DONE; long RESET without ESC initializes enabled modules/
	.EVEN
STAT:	.BLKB 34.
LINE:	.BLKB 82.
	.EVEN
HEADER:	.BLKW 256.
BUFFER:	.BLKW 256.
HELPER:
@@HELPER@@
HCNT=<.-HELPER>/2

	.END START
