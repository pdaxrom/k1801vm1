	.TITLE UJMOD
	.IDENT /04.00/
; Type-free retained module loader. DATA and status words are raw HALT FRAM.
; No initializer is executed here. Restart (without ESC) after installation.
	.MCALL .PRINT,.EXIT,.GTLIN,.LOOKUP,.READW,.CLOSE
	.ENABL LC
	.MACRO	JNE DST,?OK
	BEQ	OK
	JMP	DST
OK:
	.ENDM
	.MACRO	JEQ DST,?OK
	BNE	OK
	JMP	DST
OK:
	.ENDM
	.MACRO	JCS DST,?OK
	BCC	OK
	JMP	DST
OK:
	.ENDM
	.MACRO	JHI DST,?OK
	BLOS	OK
	JMP	DST
OK:
	.ENDM
	.MACRO	JLO DST,?OK
	BHIS	OK
	JMP	DST
OK:
	.ENDM

	.MACRO JCC DST,?OK
	BCS OK
	JMP DST
OK:
	.ENDM

HDBYT=512.
TABLE=7000
TEND=7100
HBASE=10
HLEN=12
HCS=14
HMEM=20
HORIG=22
HRELS=24
HRCS=26
ATABLE=7100
AMAGIC=110521
	.PSECT LOAD,I,RW
START:	JSR PC,UPLOAD
	JCS NOHELP
	JSR PC,GETST
	JCS NOHELP
; CP67's cold walker leaves the table address as its ABI cookie in HALT 122.
	MOV #122,R5
	JSR PC,RDWORD
	JCS NOHELP
	CMP R0,#TABLE
	JNE NOHELP
	.GTLIN #LINE,#PROMPT
	MOV #LINE,R1
	MOV #STACMD,R2
	JSR PC,STREQ
	JEQ STATUS
	MOV #LINE,R1
	MOV #QUIT,R2
	JSR PC,STREQ
	JEQ EXIT
	CMPB LINE,#'O
	BNE 1$
	CMPB LINE+1,#'N
	JEQ ON
	CMPB LINE+1,#'F
	BNE 1$
	CMPB LINE+2,#'F
	JEQ OFF
1$:	CMPB LINE,#'D
	BNE 2$
	CMPB LINE+1,#'E
	BNE 2$
	CMPB LINE+2,#'L
	JEQ OFF
2$:	JSR PC,NAME50
	JCC LOAD
	.PRINT #USAGE
	.EXIT
NOHELP:	.PRINT #UNSUP
	.EXIT
STREQ:	CMPB (R1)+,(R2)+
	BNE 1$
	TSTB -1(R1)
	BNE STREQ
1$:	RTS PC
NAME50:	TSTB	LINE
	BEQ	8$
	CMPB LINE,#40
	BEQ 8$
	CLR PMODE
	MOV	#LINE,R2
	MOV	#SPEC+2,R3
1$:	CLR	R1
	MOV	#3,R5
2$:	CLR	R4
	TSTB	(R2)
	BEQ	5$
	CMPB (R2),#40
	BEQ 5$
	MOVB	(R2)+,R4
	CMP	R4,#'A
	BLO	3$
	CMP	R4,#'Z
	BHI	8$
	SUB	#100,R4
	BR	5$
3$:	CMP	R4,#'0
	BLO	8$
	CMP	R4,#'9
	BHI	8$
	SUB	#18.,R4
5$:	MOV	R1,R0
	MUL	#40.,R0
	ADD	R4,R1
	SOB	R5,2$
	MOV	R1,(R3)+
	CMP	R3,#SPEC+6
	BLO	1$
	TSTB	(R2)
	BEQ 7$
	CMPB (R2)+,#40
	BNE 8$
6$:	CMPB (R2),#40
	BNE 4$
	INC R2
	BR 6$
4$:
	MOV R2,R1
	MOV #AUTOC,R2
	JSR PC,STREQ
	BNE 8$
	MOV #1,PMODE
7$:
	CLC
	RTS	PC
8$:	SEC
	RTS	PC

; All header/directory checks precede disabling live services or any write.
LOAD:	MOV #1,RESERV
	.LOOKUP #AREA,#0,#SPEC
	JCS OPNFAIL
	MOV R0,FLEN
	.READW #AREA,#0,#HEADER,#256.,#0
	JCS RDFAIL
	JSR PC,VALID
	JCS HDFAIL
	JSR PC,PLACE
	JCS TBFAIL
	JSR PC,SELECT
	JCS TBFAIL
	CLR R0
	JSR PC,SETST
	JCS VRFAIL
	MOV SLOT,R5
	ADD #6,R5
	MOV #140402,R0
	JSR PC,PUTCHK
	JCS VRFAIL
	.PRINT #WRMSG
	CLR TOTAL
	MOV #1,BLOCK
	MOV HEADER+HLEN,LEFT
	MOV HEADER+HBASE,CURSOR
NXTBLK:	.READW #AREA,#0,#BUFFER,#256.,BLOCK
	JCS RDFAIL
	MOV #256.,R4
	CMP LEFT,R4
	BHIS 1$
	MOV LEFT,R4
1$:	MOV R4,COUNT
	MOV #BUFFER,R2
	MOV CURSOR,R5
COPY:	MOV R4,R0
	CMP R0,#10
	BLOS 3$
	MOV #10,R0
3$:	MOV R0,XCOUNT
	MOV R2,DESC+6
	MOV #7,DESC
	JSR PC,API
	JCS VRFAIL
	MOV XCOUNT,R3
4$:	ADD (R2)+,TOTAL
	ADD #2,R5
	DEC R4
	SOB R3,4$
	TST R4
	BNE COPY
	MOV R5,CURSOR
1$:	CMP R2,#BUFFER+HDBYT
	BHIS 2$
	TST (R2)+
	JNE CKFAIL
	BR 1$
2$:	SUB COUNT,LEFT
	INC BLOCK
	TST LEFT
	JNE NXTBLK
	CMP TOTAL,HEADER+HCS
	JNE CKFAIL
; Second complete checksum after all per-word readbacks, before publication.
	JSR PC,IMGSUM
	JCS VRFAIL
	CMP R1,HEADER+HCS
	JNE CKFAIL
	CMP HEADER+4,#4
	BNE PUBBEG
	JSR PC,RELOCS
	JCS CKFAIL
PUBBEG:
	MOV #HEADER+HBASE,R2
	MOV SLOT,R5
	MOV #3,R4
PUBLISH:	MOV (R2)+,R0
	JSR PC,PUTCHK
	JCS VRFAIL
	ADD #2,R5
	SOB R4,PUBLISH
; Allocation sidecar is verified before publishing the ROM directory VALID.
	JSR PC,SAVEXT
	JCS VRFAIL
	MOV SLOT,R5
	ADD #6,R5
; VALID is the LAST store: interrupted copies never become executable.
	MOV #140403,R0
	JSR PC,PUTCHK
	JCS VRFAIL
	.CLOSE #0
	.PRINT #DONE
	.EXIT
; Sum retained immutable words without changing services or the directory.
; HEADER BASE/LENGTH have passed RANGE. R1=sum, C=transport error.
IMGSUM:
	MOV HEADER+HBASE,R5
	MOV HEADER+HLEN,R4
	CLR R1
VERIFY:	MOV R4,R0
	CMP R0,#10
	BLOS 1$
	MOV #10,R0
1$:	MOV R0,XCOUNT
	MOV #5,DESC
	JSR PC,API
	BCS SUMEND
	ADD R0,R1
	ADD XCOUNT,R5
	ADD XCOUNT,R5
	SUB XCOUNT,R4
	BNE VERIFY
	CLC
SUMEND:
	RTS PC
PUTCHK:	MOV R0,R3
	JSR PC,WRWORD
	BCS 1$
	JSR PC,RDWORD
	BCS 1$
	CMP R0,R3
	BNE 2$
	CLC
1$:	RTS PC
2$:	SEC
	RTS PC
RDWORD:	CLR	DESC
	BR	API
WRWORD:	MOV	#1,DESC
	BR	API
SETST:	MOV	#2,DESC
	BR	API
GETST:	MOV	#3,DESC
API:	MOV	R0,DESC+4
	MOV	R5,DESC+2
	MOV	R1,-(SP)
	MOV	R2,-(SP)
	MOV	R3,-(SP)
	MOV	R4,-(SP)
	MOV	R5,-(SP)
	MOV	#125061,R4
	MOV	#1000,R1
	CLR	R2
	MOV	#DESC,R5
	HALT
	MOV	R2,ERRFLG
	MOV	(SP)+,R5
	MOV	(SP)+,R4
	MOV	(SP)+,R3
	MOV	(SP)+,R2
	MOV	(SP)+,R1
; MOV changes N/Z, so save the status separately before restoring registers.
	TST	ERRFLG
	BNE	APIERR
	CLC
	RTS	PC
APIERR:	SEC
	RTS	PC
UPLOAD:	MOV	#HELPER,R5
	MOV	#1000,R1
	MOV	#125061,R4
	MOV	#HCNT,R3
1$:	MOV	#100,R2
	CMP	R3,R2
	BHIS	2$
	MOV	R3,R2
2$:	MOV	R3,-(SP)
	SUB	R2,(SP)
	HALT
	MOV	(SP)+,R3
	TST	R0
	BNE	APIERR
	TST	R3
	BNE	1$
	CLC
	RTS	PC
DESC:	.BLKW	4
ERRFLG:	.WORD	0


; R0 byte BASE, R1 word LENGTH -> R2 exclusive end. No table/system/I/O code.
RANGE:	BIT #1,R0
	BNE BADHDR
	CMP R0,#6000
	BLO BADHDR
	TST R1
	BEQ BADHDR
	MOV R1,R2
	ASL R2
	BCS BADHDR
	ADD R0,R2
	BCS BADHDR
	CMP R2,#160000
	BHI BADHDR
	CMP R0,#10000
	BHIS 1$
	CMP R2,#7000
	BHI BADHDR
1$:	CLC
	RTS PC
BADHDR:	SEC
	RTS PC
VALID:	CMP HEADER,#45125
	JNE BADHDR
	CMP HEADER+2,#30461
	JNE BADHDR
	CMP HEADER+4,#2
	BEQ 9$
	CMP HEADER+4,#3
	BEQ 9$
	CMP HEADER+4,#4
	JNE BADHDR
9$:
	CMP HEADER+6,#3
	JNE BADHDR
	MOV HEADER+HBASE,R0
	MOV HEADER+HLEN,R1
	JSR PC,RANGE
	JCS BADHDR
	MOV R2,NEWEND
	CMP HEADER+4,#2
	BEQ 8$
	MOV HEADER+HMEM,R1
	CMP R1,HEADER+HLEN
	JLO BADHDR
	JSR PC,RANGE
	JCS BADHDR
	MOV R2,NEWEND
8$:
	MOV #HEADER,R2
	MOV #16.,R3
	CLR R1
1$:	ADD (R2)+,R1
	SOB R3,1$
	TST R1
	JNE BADHDR
	MOV #HEADER+20,R2
	CMP HEADER+4,#2
	BEQ 2$
	ADD #2,R2
	CMP HEADER+4,#4
	BNE 2$
	CMP HEADER+HORIG,#1000
	JNE BADHDR
	CMP HEADER+HRELS,HEADER+HLEN
	JHI BADHDR
	ADD #6,R2
2$:	TST (R2)+
	JNE BADHDR
	CMP R2,#HEADER+HDBYT
	BLO 2$
	MOV HEADER+HLEN,R0
	ADD #255.,R0
	SWAB R0
	BIC #177400,R0
	INC R0
	CMP HEADER+4,#4
	BNE 3$
	MOV HEADER+HRELS,R1
	ADD #127.,R1
	ASH #-7,R1
	ADD R1,R0
3$:
	CMP R0,FLEN
	JNE BADHDR
	CLC
	RTS PC
; AUTO searches the main pool using complete allocations. Disabled VALID
; modules still occupy RAM. Each collision advances to the end of that module.
PLACE:	TST PMODE
	BEQ PLGOOD
	CMP HEADER+4,#4
	BNE PLBAD
	MOV #10000,HEADER+HBASE
PLTRY:	MOV HEADER+HBASE,R0
	MOV HEADER+HMEM,R1
	JSR PC,RANGE
	BCS PLBAD
	MOV R2,NEWEND
	MOV #TABLE,SCAN
PLNEXT:
	MOV SCAN,R5
	MOV #EBUF,R2
	MOV #4,R4
PLREAD:
	JSR PC,RDWORD
	BCS PLBAD
	MOV R0,(R2)+
	ADD #2,R5
	SOB R4,PLREAD
	BIC #16,R0
	CMP R0,#140401
	BNE PLSKIP
	MOV EBUF,R0
	MOV EBUF+2,R1
	JSR PC,RANGE
	BCS PLBAD
	JSR PC,EXTENT
	BCS PLBAD
	CMP EBUF,NEWEND
	BHIS PLSKIP
	CMP R2,HEADER+HBASE
	BLOS PLSKIP
	MOV R2,HEADER+HBASE
	BR PLTRY
PLSKIP:	ADD #10,SCAN
	CMP SCAN,#TEND
	BLO PLNEXT
PLGOOD:	CLC
	RTS PC
PLBAD:	SEC
	RTS PC
; Canonical image is already copied and verified, with VALID clear. Apply
; DEC LINK /R pairs from subsequent file blocks. No init runs in this program.
RELOCS:
	MOV HEADER+HBASE,DELTA
	SUB #1000,DELTA
	MOV HEADER+HRELS,RLEFT
	MOV #-1,RLAST
	CLR RCSUM
	MOV HEADER+HCS,TOTAL
RLNEXT:	TST RLEFT
	BEQ RLDONE
	.READW #AREA,#0,#BUFFER,#256.,BLOCK
	BCS RLBAD
	MOV #128.,COUNT
	CMP RLEFT,COUNT
	BHIS 1$
	MOV RLEFT,COUNT
1$:	JSR PC,RELBLK
	BCS RLBAD
	INC BLOCK
	SUB COUNT,RLEFT
	BR RLNEXT
RLDONE:	CMP RCSUM,HEADER+HRCS
	BNE RLBAD
	JSR PC,IMGSUM
	BCS RLBAD
	CMP R1,TOTAL
	BNE RLBAD
	MOV R1,HEADER+HCS
	CLC
	RTS PC
; One block, COUNT <=128 pairs. Validate offsets, original values, padding;
; maintain RLAST/RCSUM/TOTAL across blocks. No duplicate/double relocation.
RELBLK:	MOV #BUFFER,R2
	MOV COUNT,R4
	BEQ RLPAD
RLPAIR:	MOV (R2)+,R0
	ADD R0,RCSUM
	MOV R0,RTYPE
	BIC #100000,R0
	CMP R0,HEADER+HLEN
	BHIS RLBAD
	CMP RLAST,#-1
	BEQ 1$
	CMP R0,RLAST
	BLOS RLBAD
1$:	MOV R0,RLAST
	ASL R0
	ADD HEADER+HBASE,R0
	MOV R0,R5
	JSR PC,RDWORD
	BCS RLBAD
	CMP R0,(R2)
	BNE RLBAD
	ADD (R2)+,RCSUM
	SUB R0,TOTAL
	TST RTYPE
	BMI 2$
	ADD DELTA,R0
	BR 3$
2$:	SUB DELTA,R0
3$:	ADD R0,TOTAL
	JSR PC,PUTCHK
	BCS RLBAD
	SOB R4,RLPAIR
RLPAD:	CMP R2,#BUFFER+HDBYT
	BHIS RLOK
	TST (R2)+
	BNE RLBAD
	BR RLPAD
RLOK:	CLC
	RTS PC
RLBAD:	SEC
	RTS PC
; Replace same BASE, otherwise first uncommitted slot. Disabled valid records
; still reserve their immutable extents. Duplicate bases/overlaps are errors.
SELECT:	MOV #-1,SLOT
	MOV #-1,FREESL
	MOV #TABLE,SCAN
SNEXT:	MOV SCAN,R5
	MOV #EBUF,R2
	MOV #4,R1
1$:	JSR PC,RDWORD
	BCS SBAD
	MOV R0,(R2)+
	ADD #2,R5
	SOB R1,1$
	MOV EBUF+6,R0
	BIC #16,R0
	CMP R0,#140401
	BEQ SVALID
	CMP FREESL,#-1
	BNE SSKIP
	MOV SCAN,FREESL
	BR SSKIP
SVALID:	MOV EBUF,R0
	CMP R0,HEADER+HBASE
	BNE SOTHER
	CMP SLOT,#-1
	BNE SBAD
	MOV SCAN,SLOT
	BR SSKIP
SOTHER:	MOV EBUF+2,R1
	JSR PC,RANGE
	BCS SBAD
	JSR PC,EXTENT
	BCS SBAD
	MOV EBUF,R0
	CMP R0,NEWEND
	BHIS SSKIP
	CMP R2,HEADER+HBASE
	BHI SBAD
SSKIP:	ADD #10,SCAN
	CMP SCAN,#TEND
	BLO SNEXT
	CMP SLOT,#-1
	BNE 1$
	MOV FREESL,SLOT
1$:	CMP SLOT,#-1
	BEQ SBAD
	CLC
	RTS PC
SBAD:	SEC
	RTS PC
; EBUF=directory entry, SCAN=slot, R2=immutable end. Return R2=full end.
; A missing/stale/torn sidecar reserves the remainder of its pool on LOAD;
; this never invents a zero-sized BSS for a legacy module. ON does not allocate
; new memory and retains legacy immutable-only checks when metadata is absent.
EXTENT:
	MOV R2,IMGEND
	MOV SCAN,R5
	SUB #TABLE,R5
	ASL R5
	ADD #ATABLE,R5
	MOV #MBUF,R2
	MOV #10,R4
	CLR MSUM
EXTGET:
	JSR PC,RDWORD
	BCS EXTERR
	MOV R0,(R2)+
	ADD R0,MSUM
	ADD #2,R5
	SOB R4,EXTGET
	TST MSUM
	BNE EXTMIS
	CMP MBUF,#AMAGIC
	BNE EXTMIS
	CMP MBUF+12,#3
	BNE EXTMIS
	TST MBUF+14
	BNE EXTMIS
	CMP MBUF+2,EBUF
	BNE EXTMIS
	CMP MBUF+4,EBUF+2
	BNE EXTMIS
	CMP MBUF+6,EBUF+4
	BNE EXTMIS
	MOV MBUF+10,R1
	CMP R1,EBUF+2
	BLO EXTMIS
	MOV EBUF,R0
	JSR PC,RANGE
	BCC EXTOK
EXTMIS:
	MOV IMGEND,R2
	TST RESERV
	BEQ EXTOK
	MOV #7000,R2
	CMP EBUF,#10000
	BLO EXTOK
	MOV #160000,R2
EXTOK:	CLC
	RTS PC
EXTERR:	SEC
	RTS PC
; Persist full allocation, bound to BASE/LENGTH/CHECKSUM. No ROM changes.
SAVEXT:
	MOV SLOT,R5
	SUB #TABLE,R5
	ASL R5
	ADD #ATABLE,R5
	MOV R5,MPTR
	CLR R0
	JSR PC,PUTCHK
	BCS EXTERR
	CMP HEADER+4,#2
	BEQ EXTOK
	MOV #AMAGIC,MBUF
	MOV HEADER+HBASE,MBUF+2
	MOV HEADER+HLEN,MBUF+4
	MOV HEADER+HCS,MBUF+6
	MOV HEADER+HMEM,MBUF+10
	MOV #3,MBUF+12
	CLR MBUF+14
	MOV #MBUF,R2
	MOV #7,R4
	CLR R0
EXTSUM:
	ADD (R2)+,R0
	SOB R4,EXTSUM
	NEG R0
	MOV R0,MBUF+16
	MOV #MBUF+2,R2
	MOV #7,R4
	MOV MPTR,R5
	ADD #2,R5
EXTPUT:
	MOV (R2)+,R0
	JSR PC,PUTCHK
	BCS EXTERR
	ADD #2,R5
	SOB R4,EXTPUT
	MOV MPTR,R5
	MOV #AMAGIC,R0
	JSR PC,PUTCHK
	RTS PC
; ONn verifies the retained image without opening an SD file. Validation
; failures preserve both the directory and the live ready/debug bits.
ON:	TSTB LINE+3
	JNE BADCLI
	MOVB LINE+2,R0
	JSR PC,SLOTNO
	JCS BADCLI
	JSR PC,ENABLE
	BCS ENFAIL
	.PRINT #DONE
	.EXIT
; R0=ASCII slot digit -> R5=entry address, C=bad digit.
SLOTNO:
	SUB #'0,R0
	CMP R0,#7
	BHI SLOTBD
	ASL R0
	ASL R0
	ASL R0
	ADD #TABLE,R0
	MOV R0,R5
	CLC
	RTS PC
SLOTBD:	SEC
	RTS PC
; Callable validation/publication entry, R5=directory entry address.
ENABLE:
	CLR RESERV
	MOV R5,ONADDR
	MOV #HEADER+HBASE,R2
	MOV #4,R4
ONREAD:
	JSR PC,RDWORD
	BCS ENBAD
	MOV R0,(R2)+
	ADD #2,R5
	SOB R4,ONREAD
	BIC #16,R0
	CMP R0,#140401
	BNE ENBAD
	MOV HEADER+HBASE,R0
	MOV HEADER+HLEN,R1
	JSR PC,RANGE
	BCS ENBAD
	MOV ONADDR,SCAN
	MOV #HEADER+HBASE,R1
	MOV #EBUF,R3
	MOV #4,R4
ONCOPY:
	MOV (R1)+,(R3)+
	SOB R4,ONCOPY
	JSR PC,EXTENT
	BCS ENBAD
	MOV R2,NEWEND
	JSR PC,SELECT
	BCS ENBAD
	CMP SLOT,ONADDR
	BNE ENBAD
	JSR PC,IMGSUM
	BCS ENBAD
	CMP R1,HEADER+HCS
	BNE ENBAD
	MOV ONADDR,R5
	ADD #6,R5
	JSR PC,RDWORD
	BCS ENBAD
; Already enabled is a verified no-op, preserving services and boot results.
	BIT #2,R0
	BNE ENGOOD
	MOV #140403,R0
	JSR PC,PUTCHK
	RTS PC
ENGOOD:	CLC
	RTS PC
ENBAD:	SEC
	RTS PC
ENFAIL:	.PRINT #ENAERR
	.EXIT
; OFFn keeps allocation; DELn forgets a record. Validate before SETST.
OFF:	TSTB LINE+4
	BNE BADCLI
	MOVB LINE+3,R0
	JSR PC,SLOTNO
	BCS BADCLI
	ADD #6,R5
	CLR R0
	CMPB LINE,#'D
	BEQ OWRITE
	JSR PC,RDWORD
	JCS VRFAIL
	BIC #16,R0
	CMP R0,#140401
	BNE BADCLI
OWRITE:
	MOV R0,OFFVAL
	CLR R0
	JSR PC,SETST
	JCS VRFAIL
	MOV OFFVAL,R0
	JSR PC,PUTCHK
	JCS VRFAIL
	.PRINT #DONE
	.EXIT
BADCLI:	.PRINT #USAGE
	.EXIT
STATUS:	MOV #TABLE,SCAN
	MOV #'0,NUMBER
SLINE:	MOV #STAT,R1
	MOVB NUMBER,(R1)+
	MOVB #':,(R1)+
	MOV SCAN,R5
	MOV #4,R4
1$:	JSR PC,RDWORD
	JCS VRFAIL
	MOVB #' ,(R1)+
	JSR PC,OCTAL
	ADD #2,R5
	SOB R4,1$
	CLRB (R1)
	.PRINT #STAT
	ADD #10,SCAN
	INC NUMBER
	CMP SCAN,#TEND
	BLO SLINE
EXIT:	.EXIT
OCTAL:	MOV #6,R2
	MOV R0,R3
1$:	CLR R0
	ROL R3
	ROL R0
	CMP R2,#6
	BEQ 2$
	ROL R3
	ROL R0
	ROL R3
	ROL R0
2$:	ADD #'0,R0
	MOVB R0,(R1)+
	SOB R2,1$
	RTS PC
OPNFAIL:	MOV #OPNERR,R0
	BR FAIL
HDFAIL:	MOV #HDRERR,R0
	BR FAIL
TBFAIL:	MOV #TABERR,R0
	BR FAIL
RDFAIL:	MOV #READER,R0
	BR FAIL
VRFAIL:	MOV #VERERR,R0
	BR FAIL
CKFAIL:	MOV #CHKERR,R0
FAIL:	.PRINT
	.CLOSE #0
	.EXIT
SPEC:	.RAD50 /SY /
	.WORD 0,0
	.RAD50 /BIN/
AREA:	.BLKW 5
FLEN:	.WORD 0
NEWEND:	.WORD 0
SLOT:	.WORD 0
FREESL:	.WORD 0
SCAN:	.WORD 0
NUMBER:	.WORD 0
EBUF:	.BLKW 4
ONADDR:	.WORD 0
PMODE:	.WORD 0
DELTA:	.WORD 0
RLEFT:	.WORD 0
RLAST:	.WORD 0
RCSUM:	.WORD 0
RTYPE:	.WORD 0
OFFVAL:	.WORD 0
RESERV:	.WORD 0
IMGEND:	.WORD 0
MSUM:	.WORD 0
MPTR:	.WORD 0
MBUF:	.BLKW 10
BLOCK:	.WORD 0
LEFT:	.WORD 0
COUNT:	.WORD 0
CURSOR:	.WORD 0
TOTAL:	.WORD 0
XCOUNT:	.WORD 0
STACMD:	.ASCIZ /STATUS/
QUIT:	.ASCIZ /EXIT/
AUTOC:	.ASCIZ /AUTO/
PROMPT:	.ASCII /UJMOD> /
	.BYTE 200
USAGE:	.ASCIZ /?UJMOD-E-Use filename [AUTO], STATUS, ON0..7, OFF0..7, DEL0..7, EXIT/
ENAERR:	.ASCIZ /?UJMOD-E-Enable rejected: invalid record, overlap, checksum or readback/
UNSUP:	.ASCIZ /?UJMOD-E-CP67 cold bootstrap required/
OPNERR:	.ASCIZ /?UJMOD-E-LOOKUP failed/
HDRERR:	.ASCIZ /?UJMOD-E-Invalid header or file length; directory unchanged/
TABERR:	.ASCIZ /?UJMOD-E-Directory full, invalid or overlapping; use STATUS and DELn/
WRMSG:	.ASCIZ /!UJMOD-I-WRITING; services disabled, record invalid/
READER:	.ASCIZ /?UJMOD-E-READ failed/
VERERR:	.ASCIZ /?UJMOD-E-FRAM verification failed/
CHKERR:	.ASCIZ /?UJMOD-E-Checksum or padding failed; record invalid/
DONE:	.ASCIZ /!UJMOD-I-DONE; long RESET without ESC initializes enabled modules/
	.EVEN
STAT:	.BLKB 34.
LINE:	.BLKB 82.
	.EVEN
HEADER:	.BLKW 256.
BUFFER:	.BLKW 256.
HELPER:
@@HELPER@@
HCNT=<.-HELPER>/2

	.END START
