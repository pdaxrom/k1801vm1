        .TITLE SDIOP
        .ASECT
        .=004000
SDDATA=177500
SDCONT=177502
STATUS=177504
BSTAT=003700
SCRC=003702
MCRC=003704
COUNT=003706
BYTES=003710
LBA=003712
; Direct boot remains compatible with storage cards without a menu flag.
START:  MOV #004000,SP
WAIT:   MOV @#STATUS,R0
        BPL WAIT
        BIT #040000,R0
        BNE FAILED
        MOV R0,@#BSTAT
        BIT #020000,R0
        BEQ BOOT
        MOV #2,R0
        MOV #100000,R4
        JSR PC,READSE
        TST @#SCRC
        BNE BADMEN
        CMP @#100000,#045125 ; UJ
        BNE BADMEN
        CMP @#100002,#030461 ; 11
        BNE BADMEN
        CMP @#100004,#042515 ; ME
        BNE BADMEN
        CMP @#100006,#052516 ; NU
        BNE BADMEN
        CMP @#100012,#100000
        BNE BADMEN
        CMP @#100016,#1
        BNE BADMEN
        MOV @#100010,R2
        BEQ BADMEN
        CMP R2,#20
        BHI BADMEN
        MOV R2,@#COUNT
        SWAB R2
        ASL R2
        MOV R2,@#BYTES
        MOV @#100014,@#MCRC
        MOV #3,@#LBA
        MOV #100000,R4
NEXT:   MOV @#LBA,R0
        JSR PC,READSE
        INC @#LBA
        DEC @#COUNT
        BNE NEXT
        MOV #100000,R4
        MOV @#BYTES,R2
        CLR R5
SUM:    MOVB (R4)+,R3
        JSR PC,CRC
        SOB R2,SUM
        CMP R5,@#MCRC
        BNE BADMEN
        JMP @#100000
BADMEN: MOV #11,R0
        BR FAILED
BOOT:   MOV @#BSTAT,R0
        BIC #177770,R0
        MOV #177440,R1
        MOV R0,10(R1)
        MOV #3,(R1)
PACK:   TSTB (R1)
        BPL PACK
        TST (R1)
        BMI FAILED
        MOV #177000,2(R1)
        CLR 4(R1)
        CLR 6(R1)
        CLR 20(R1)
        MOV #21,(R1)
READ:   TSTB (R1)
        BPL READ
        TST (R1)
        BMI FAILED
        MOV #002000,SP
        CLR R2
        CLR R3
        MOV #002020,R4
        CLR R5
        MOV #7,@#SDCONT
        CLR PC
FAILED: MOV R0,@#157774
        MOV @#STATUS,@#157776
        MOV #3,@#SDCONT
        HALT
        BR FAILED
; LBA R0 (only 2..18), destination R4; all other registers are scratch.
; Verify every SD data CRC and retain the sector CRC for the menu header.
READSE: MOV #SDDATA,R1
        MOV #2,2(R1)
        MOV #121,(R1)
        CLR (R1)
        CLR (R1)
        CLR (R1)
        MOV R0,(R1)
        MOV #1,(R1)
        MOV #20,R2
R1WAIT: MOV (R1),R0
        BIT #200,R0
        BEQ R1DONE
        SOB R2,R1WAIT
        BR IOFAIL
R1DONE: TST R0
        BNE IOFAIL
        CLR R2
TOKEN:  MOV (R1),R0
        CMP R0,#376
        BEQ DATA
        CMP R0,#377
        BNE IOFAIL
        SOB R2,TOKEN
        BR IOFAIL
DATA:   MOV #1000,R2
        CLR R5
BYTE:   MOV (R1),R3
        MOVB R3,(R4)+
        JSR PC,CRC
        SOB R2,BYTE
        MOV R5,@#SCRC
        MOV (R1),R3
        JSR PC,CRC
        MOV (R1),R3
        JSR PC,CRC
        TST R5
        BNE IOFAIL
        MOV #3,2(R1)
        MOV (R1),R3
        RTS PC
IOFAIL: MOV #12,R0
        JMP FAILED
; CRC16-CCITT, R5 accumulator, low byte R3; preserves R1/R2/R4.
CRC:    SWAB R3
        BIC #377,R3
        XOR R3,R5
        MOV #8.,R0
        MOV #010041,R3
CRCBIT: ASL R5
        BCC CRCNXT
        XOR R3,R5
CRCNXT: SOB R0,CRCBIT
        RTS PC
IMEND:
        .END START
