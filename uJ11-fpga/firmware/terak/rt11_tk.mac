; Native TERAK text console for RT-11 V5 RMON.
; Install at vector 164, the real TERAK output-emulator interrupt.
; Reading EDB acknowledges the output latch; the standard RT-11 TTOINT
; at vector 64 continues to manage its own queue and interrupt enable.
; No FPGA terminal, framebuffer allocation, or added guest registers.
; The primary BIOS loads the font through the native VCR font aperture.

	.PSECT	RMON
	.ENABL	LSB
TKISR:: MOV	R0,-(SP)
	MOV	R1,-(SP)
	MOV	R2,-(SP)
	MOV	R3,-(SP)
	MOV	R4,-(SP)
	MOV	@#177566,R0
	BIC	#177600,R0
	TST	TKINIT
	BEQ	.+6
	JMP	10$
	INC	TKINIT
	MOV	#7,@#177744
	CLR	@#177742
	MOV	#160000,TKPOS
	MOV	#160000,R1
	MOV	#3072.,R2
5$:	MOVB	#40,(R1)+
	SOB	R2,5$
10$:	MOV	TKPOS,R1
	MOVB	TKCHAR,@R1
	TST	TKESC
	BNE	.+6
	JMP	40$
	CMP	TKESC,#2
	BNE	.+6
	JMP	20$
	CMP	TKESC,#3
	BNE	.+6
	JMP	30$
	CLR	TKESC
	CMPB	R0,#'Y
	BEQ	.+6
	JMP	11$
	MOV	#2,TKESC
	JMP	90$
11$:	CMPB	R0,#'H
	BEQ	.+6
	JMP	12$
	MOV	#160000,TKPOS
	JMP	90$
12$:	CMPB	R0,#'A
	BEQ	.+6
	JMP	13$
	CMP	TKPOS,#160200
	BHIS	.+6
	JMP	90$
	SUB	#200,TKPOS
	JMP	90$
13$:	CMPB	R0,#'B
	BNE	.+6
	JMP	60$
	CMPB	R0,#'C
	BNE	.+6
	JMP	51$
	CMPB	R0,#'D
	BNE	.+6
	JMP	55$
	CMPB	R0,#'J
	BNE	.+6
	JMP	70$
	CMPB	R0,#'K
	BEQ	.+6
	JMP	90$
	MOV	TKPOS,R2
	BIS	#177,R2
	INC	R2
	JMP	75$
20$:	SUB	#40,R0
	CMP	R0,#24.
	BLO	.+6
	JMP	25$
	SWAB	R0
	ASR	R0
	ADD	#160000,R0
	MOV	R0,TKPOS
25$:	MOV	#3,TKESC
	JMP	90$
30$:	CLR	TKESC
	SUB	#40,R0
	CMP	R0,#80.
	BLO	.+6
	JMP	90$
	ADD	R0,TKPOS
	JMP	90$
40$:	CMPB	R0,#33
	BEQ	.+6
	JMP	41$
	INC	TKESC
	JMP	90$
41$:	CMPB	R0,#15
	BEQ	.+6
	JMP	42$
	BIC	#177,TKPOS
	JMP	90$
42$:	CMPB	R0,#12
	BNE	.+6
	JMP	60$
	CMPB	R0,#10
	BNE	.+6
	JMP	55$
	CMPB	R0,#11
	BEQ	.+6
	JMP	43$
	ADD	#10,TKPOS
	BIC	#7,TKPOS
	JMP	52$
43$:	CMPB	R0,#14
	BEQ	.+6
	JMP	44$
	MOV	#160000,TKPOS
	JMP	70$
44$:	CMPB	R0,#40
	BHIS	.+6
	JMP	90$
	CMPB	R0,#177
	BNE	.+6
	JMP	90$
	MOVB	R0,@R1
51$:	INC	TKPOS
52$:	MOV	TKPOS,R1
	BIC	#177600,R1
	CMP	R1,#80.
	BHIS	.+6
	JMP	90$
	BIC	#177,TKPOS
	JMP	60$
55$:	BIT	#177,TKPOS
	BNE	.+6
	JMP	90$
	DEC	TKPOS
	JMP	90$
60$:	ADD	#200,TKPOS
	CMP	TKPOS,#166000
	BHIS	.+6
	JMP	90$
	SUB	#200,TKPOS
	MOV	#160000,R1
	MOV	#160200,R2
	MOV	#2944.,R3
65$:	MOVB	(R2)+,(R1)+
	SOB	R3,65$
	MOV	#128.,R3
66$:	MOVB	#40,(R1)+
	SOB	R3,66$
	JMP	90$
70$:	MOV	#166000,R2
75$:	MOV	TKPOS,R1
76$:	MOVB	#40,(R1)+
	CMP	R1,R2
	BHIS	.+6
	JMP	76$
90$:	MOV	TKPOS,R1
	MOVB	@R1,TKCHAR
	MOVB	#177,@R1
	MOV	(SP)+,R4
	MOV	(SP)+,R3
	MOV	(SP)+,R2
	MOV	(SP)+,R1
	MOV	(SP)+,R0
	RTI
TKPOS:	.WORD	160000
TKCHAR:	.WORD	40
TKESC:	.WORD	0
TKINIT:	.WORD	0
	.DSABL	LSB
