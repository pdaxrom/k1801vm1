	.TITLE UJODT
	.IDENT /01.00/
; CP64 software debugger. All addresses/numbers are octal unless dotted.
; Absolute HALT-FRAM module, loaded with the unchanged ABI2 UJLOAD.
	.ASECT
	.=10000
ODT:	JMP @#ENTER
ACTV:	JMP @#ENABLE
SIGN:	.WORD 125064,1
	.MACRO JNE DST,?OK
	BEQ OK
	JMP DST
OK:
	.ENDM
	.MACRO JEQ DST,?OK
	BNE OK
	JMP DST
OK:
	.ENDM
	.MACRO JCS DST,?OK
	BCC OK
	JMP DST
OK:
	.ENDM
	.MACRO JCC DST,?OK
	BCS OK
	JMP DST
OK:
	.ENDM
	.MACRO JHI DST,?OK
	BLOS OK
	JMP DST
OK:
	.ENDM
	.MACRO JLO DST,?OK
	BHIS OK
	JMP DST
OK:
	.ENDM
CPC=100
CPSW=102
RCSR=177560
RBUF=177562
TCSR=177564
TBUF=177566
PANEL=166000
; Invoked ONLY after UJON has checked code checksum, wrapper and common ABI.
; No stack and no calls, so the caller's RT-11 context cannot become ODT's.
ENABLE:	.WORD 43
	BIT #400,R0
	BEQ ENFAIL
	BIT #1,R0
	BEQ ENFAIL
	BIC #177774,R0
	.WORD 42
	MOV #ENTER,@#110
	CMP @#110,#ENTER
	BNE ENFAIL
	MOV #340,@#112
	CMP @#112,#340
	BNE ENFAIL
	BIS #4,R0
	.WORD 42
	CLR R2
	BR ENEXIT
ENFAIL:	MOV #1,R2
ENEXIT:	MOV #312,@#4
	.WORD 10
; Both the normal HALT wrapper and the dedicated debug vector enter here.
ENTER:	MOV R0,REGS
	MOV R1,REGS+2
	MOV R2,REGS+4
	MOV R3,REGS+6
	MOV R4,REGS+10
	MOV R5,REGS+12
	MOV SP,REGS+14
	MOV #STKTOP,SP
	MOV @#CPC,REGS+16
	MOV @#CPSW,REGS+20
	.WORD 43
	MOV R0,META
	BIC #10,R0
	.WORD 42
	MOV #ODERR,@#4
	CLR RECOV
	CLR OUTMOD
	TST OVACT
	BNE ENSKIP
	CLR RHEAD
	CLR RTAIL
	CLR RCOUNT
	CLR RXBAD
	CLR RXDROP
	CLR LINLEN
	CLR BADLIN
ENSKIP:
	MOV @#RCSR,SAVRX
	MOV @#TCSR,SAVTX
	BIC #100,@#RCSR
	CLR @#TCSR
	TST RADIX
	BNE 1$
	MOV #10,RADIX
1$:	TST OVACT
	JEQ ENFULL
	JSR PC,OVBACK
ENFULL:	JSR PC,PNTAKE
	TST OVWHY
	BEQ ENMSG
	MOV OVWHY,R0
	JSR PC,TXSTR
	JSR PC,NEWLIN
	CLR OVWHY
ENMSG:
	JSR PC,BEGIN
	MOV #STOPMSG,R0
	JSR PC,STR
	BIT #20,META
	BEQ 2$
	MOV #DEBUGM,R0
	BR 3$
2$:	MOV #HALTM,R0
3$:	JSR PC,STR
	BIT #40,META
	BEQ 4$
	MOV #WAITM,R0
	JSR PC,STR
4$:	JSR PC,OUTPUT
	JSR PC,ALLREG
	MOV REGS+16,DADDR
	JSR PC,DISONE
	MOV #2,VIEW
	TST STEPS
	BEQ PROMPT
	DEC STEPS
	BEQ PROMPT
	TST RCOUNT
	BNE PROMPT
	BIT #40,META
	BNE PROMPT
	JMP STEPIT
PROMPT:	MOV #STKTOP,SP
	CLR STEPS
	MOV #PROM,R0
	JSR PC,TXSTR
MAIN:	JSR PC,DBPOLL
	JSR PC,ASCAN
	JSR PC,PNPOLL
	JSR PC,RXPOLL
	JSR PC,RXGET
	BCS MAIN
	CMP R0,#33
	BEQ CANCEL
	CMP R0,#3
	BEQ CANCEL
	CMP R0,#12
	BEQ MAIN
	CMP R0,#15
	BEQ LINEOK
	CMP R0,#10
	BEQ BACKSP
	CMP R0,#177
	BEQ BACKSP
	CMP R0,#40
	BLO MAIN
	CMP R0,#176
	BHI MAIN
	CMP LINLEN,#62.
	BHIS TOOLNG
	MOV #LINE,R1
	ADD LINLEN,R1
	MOVB R0,(R1)
	INC LINLEN
	JSR PC,TXCHR
	BR MAIN
TOOLNG:	MOV #1,BADLIN
	BR MAIN
BACKSP:	TST LINLEN
	BEQ MAIN
	DEC LINLEN
	MOV #ERASE,R0
	JSR PC,TXSTR
	BR MAIN
CANCEL:	TST PANEDIT
	BEQ 1$
	MOV #ASMBUF,R0
	MOV #RESULT,R1
2$:	MOVB (R0)+,(R1)+
	BNE 2$
1$:	CLR PANEDIT
	CLR OVACT
	CLR RCOUNT
	CLR RHEAD
	CLR RTAIL
	CLR RXDROP
	CLR LINLEN
	CLR BADLIN
	CLR RXBAD
	JSR PC,PNEW
	JSR PC,NEWLIN
	JMP PROMPT
LINEOK:	JSR PC,NEWLIN
	TST PANEDIT
	BNE BUSY
	MOV #LINE,R1
	ADD LINLEN,R1
	CLRB (R1)
	CLR LINLEN
	TST RXBAD
	BNE LINERR
	TST BADLIN
	BNE LINERR
	JSR PC,PARSE
	JCS SYNTAX
	JMP COMMAND
BUSY:	CLR LINLEN
	MOV #BUSYM,R0
	JMP ERROR
LINERR:	CLR RXBAD
	CLR BADLIN
	MOV #OVERM,R0
	BR ERROR
SYNTAX:	MOV #SYNTM,R0
ERROR:	JSR PC,BEGIN
	JSR PC,STR
	JSR PC,OUTPUT
	JMP PROMPT
; A complete command is parsed before any side effect. Up to three numbers.
PARSE:	MOV #LINE,R1
	JSR PC,SKIP
	MOVB (R1)+,R0
	BEQ PFAIL
	JSR PC,UPCASE
	MOV R0,CMD
	CLR CMDORG
	CLR NARG
	MOV #ARGS,R3
PNEXT:	JSR PC,SKIP
	TSTB (R1)
	BEQ PDONE
	CMP NARG,#4
	BHIS PFAIL
	CLR R2
	CLR R5
PDIG:	MOVB (R1),R0
	BEQ PEND
	CMP R0,#40
	BEQ PEND
	JSR PC,UPCASE
	SUB #60,R0
	BCS PFAIL
	CMP R0,#11
	BLOS 1$
	SUB #7,R0
	CMP R0,#12
	BLO PFAIL
1$:	CMP R0,RADIX
	BHIS PFAIL
	MOV R0,-(SP)
	MOV R2,R0
	MOV RADIX,R4
	CMP R4,#10
	BEQ 2$
	ASL R0
	BCS PPOP
2$:	ASL R0
	BCS PPOP
	ASL R0
	BCS PPOP
	ASL R0
	BCS PPOP
	ADD (SP)+,R0
	BCS PFAIL
	MOV R0,R2
	INC R1
	INC R5
	BR PDIG
PPOP:	TST (SP)+
PFAIL:	SEC
	RTS PC
PEND:	TST R5
	BEQ PFAIL
	MOV R2,(R3)+
	INC NARG
	BR PNEXT
PDONE:	CLC
	RTS PC
SKIP:	CMPB (R1),#40
	BEQ 1$
	CMPB (R1),#11
	BNE 2$
1$:	INC R1
	BR SKIP
2$:	RTS PC
UPCASE:	CMP R0,#141
	BLO 1$
	CMP R0,#172
	BHI 1$
	SUB #40,R0
1$:	RTS PC
COMMAND:	JSR PC,PNECHO
	MOV #CMDS,R1
1$:	MOV (R1)+,R0
	BEQ SYNTAX
	CMP R0,CMD
	BEQ 2$
	ADD #2,R1
	BR 1$
2$:	JMP @(R1)
NOARGS:	TST NARG
	BEQ 1$
	JMP SYNTAX
1$:	RTS PC
HELP:	JSR PC,NOARGS
	MOV #HELPM,R0
	JSR PC,TXSTR
	JMP PROMPT
OCTAL:	JSR PC,NOARGS
	MOV #10,RADIX
	JMP REGSIN
HEX:	JSR PC,NOARGS
	MOV #20,RADIX
	JMP REGSIN
REGCMD:	CMP NARG,#2
	JHI SYNTAX
	TST NARG
	BEQ REGSIN
	CMP ARGS,#10
	JHI SYNTAX
	MOV ARGS,RSEL
	CLR VIEW
	MOV ARGS,R2
	ASL R2
	CMP NARG,#2
	BNE 2$
	MOV REGS(R2),OLDVAL
	MOV ARGS+2,REGS(R2)
	CMP R2,#16
	BNE 1$
	JSR PC,CLEARW
1$:	JSR PC,BEGIN
	MOV #OLDM,R0
	JSR PC,STR
	MOV OLDVAL,R0
	JSR PC,NUM
	MOV #NEWM,R0
	JSR PC,STR
	MOV REGS(R2),R0
	JSR PC,NUM
	JSR PC,OUTPUT
2$:	JSR PC,ONEREG
	JMP PROMPT
REGSIN:	CLR VIEW
	CLR RSEL
	JSR PC,ALLREG
	CLR R2
	BIS #2,OUTMOD
	JSR PC,ONEREG
	BIC #2,OUTMOD
	JMP PROMPT
ALLREG:	MOV OUTMOD,-(SP)
	BIS #1,OUTMOD
	CLR R2
1$:	JSR PC,ONEREG
	ADD #2,R2
	CMP R2,#22
	BLO 1$
	MOV (SP)+,OUTMOD
	RTS PC
ONEREG:	JSR PC,BEGIN
	CMP R2,#20
	BEQ 1$
	MOV #122,R0
	JSR PC,CHAR
	MOV R2,R0
	ASR R0
	ADD #60,R0
	JSR PC,CHAR
	BR 2$
1$:	MOV #PSWM,R0
	JSR PC,STR
2$:	MOV #75,R0
	JSR PC,CHAR
	MOV REGS(R2),R0
	JSR PC,NUM
	CMP R2,#20
	BNE 5$
	MOV #FLAGM,R0
	JSR PC,STR
	MOV #30,R3
3$:	MOV REGS+20,R0
	ASH #-4,R0
	BIC #177776,R0
	ADD #60,R0
	JSR PC,CHAR
	MOV #IPLM,R0
	JSR PC,STR
	MOV REGS+20,R0
	ASH #-5,R0
	BIC #177770,R0
	ADD #60,R0
	JSR PC,CHAR
	MOV #NZVCM,R0
	JSR PC,STR
	MOV #10,R3
4$:	MOV #60,R0
	BIT R3,REGS+20
	BEQ 6$
	INC R0
6$:	JSR PC,CHAR
	ASR R3
	BNE 4$
5$:	JSR PC,OUTPUT
	RTS PC
; Normal memory views never touch the I/O page. MFUS/MTUS address USER RAM.
MEMCMD:	CLR BYTEM
	BR MEMGO
BYTCMD:	MOV #1,BYTEM
MEMGO:	JSR PC,RANGE
	JCS SYNTAX
	MOV #1,VIEW
	MOV BYTEM,VBYTE
MEMLOP:	MOV ADDR,MSEL
	JSR PC,READAT
	JCS MEMERR
	MOV R0,VALUE
	JSR PC,BEGIN
	MOV ADDR,R0
	JSR PC,NUM
	MOV #COLON,R0
	JSR PC,STR
	MOV VALUE,R0
	JSR PC,NUM
	JSR PC,OUTPUT
	JSR PC,PABORT
	JSR PC,NEXTAT
	SOB R2,MEMLOP
	JMP PROMPT
RANGE:	CMP NARG,#1
	BLO 9$
	CMP NARG,#2
	BHI 9$
	MOV ARGS,ADDR
	MOV #1,R2
	CMP NARG,#1
	BEQ 1$
	MOV ARGS+2,R2
1$:	TST R2
	BEQ 9$
	CMP R2,#20
	BHI 9$
	MOV ADDR,R0
	TST BYTEM
	BNE 2$
	BIT #1,R0
	BNE 9$
2$:	MOV R2,R1
	TST BYTEM
	BNE 3$
	ASL R1
3$:	ADD R1,R0
	BCS 9$
	CMP R0,#160000
	BHI 9$
	CLC
	RTS PC
9$:	SEC
	RTS PC
NEXTAT:	INC ADDR
	TST BYTEM
	BNE 1$
	INC ADDR
1$:	RTS PC
WRDCMD:	CLR BYTEM
	BR WRITE
BYWCMD:	MOV #1,BYTEM
WRITE:	CMP NARG,#2
	JNE SYNTAX
	MOV ARGS+2,VALUE
	TST BYTEM
	BEQ 1$
	CMP VALUE,#377
	JHI SYNTAX
1$:	MOV #1,NARG
	JSR PC,RANGE
	JCS SYNTAX
	JSR PC,READAT
	JCS MEMERR
	MOV R0,OLDVAL
	MOV #1,VIEW
	MOV ADDR,MSEL
	MOV BYTEM,VBYTE
	JSR PC,WRITEA
	JCS MEMERR
	JSR PC,READAT
	JCS MEMERR
	CMP R0,VALUE
	JNE MEMERR
	JSR PC,BEGIN
	MOV ADDR,R0
	JSR PC,NUM
	MOV #COLON,R0
	JSR PC,STR
	MOV OLDVAL,R0
	JSR PC,NUM
	MOV #NEWM,R0
	JSR PC,STR
	MOV VALUE,R0
	JSR PC,NUM
	JSR PC,OUTPUT
	JMP PROMPT
; Read one word/byte; preserve all caller registers other than R0.
READAT:	MOV R5,-(SP)
	MOV ADDR,R5
	BIC #1,R5
	MOV #RDFAIL,RECOV
	.WORD 21
	CLR RECOV
	TST BYTEM
	BEQ 2$
	BIT #1,ADDR
	BEQ 1$
	SWAB R0
1$:	BIC #177400,R0
2$:	MOV (SP)+,R5
	CLC
	RTS PC
RDFAIL:	CLR RECOV
	MOV (SP)+,R5
	SEC
	RTS PC
WRITEA:	MOV R5,-(SP)
	MOV R1,-(SP)
	MOV ADDR,R5
	BIC #1,R5
	MOV #WRFAIL,RECOV
	TST BYTEM
	BEQ 2$
	.WORD 21
	SUB #2,R5
	MOV VALUE,R1
	BIT #1,ADDR
	BNE 1$
	BIC #377,R0
	BIS R1,R0
	BR 3$
1$:	SWAB R1
	BIC #177400,R0
	BIS R1,R0
	BR 3$
2$:	MOV VALUE,R0
3$:	ADD #2,R5
	.WORD 31
	CLR RECOV
	MOV (SP)+,R1
	MOV (SP)+,R5
	CLC
	RTS PC
WRFAIL:	CLR RECOV
	MOV (SP)+,R1
	MOV (SP)+,R5
	SEC
	RTS PC
MEMERR:	MOV #MEMM,R0
	JMP ERROR
ODERR:	TST RECOV
	BEQ 1$
	JMP @RECOV
1$:	MOV #STKTOP,SP
	CLR STEPS
	CLR OVACT
	CLR HHOLD
	CLR OUTMOD
	MOV #FAULTM,R0
	JMP ERROR
DISCMD:	MOV #2,VIEW
	CMP NARG,#2
	JHI SYNTAX
	MOV #1,DCOUNT
	TST NARG
	BEQ 1$
	JSR PC,HINIT
	MOV ARGS,DADDR
	CMP NARG,#2
	BNE 1$
	MOV ARGS+2,DCOUNT
1$:	TST DCOUNT
	JEQ SYNTAX
	CMP DCOUNT,#20
	JHI SYNTAX
	BIT #1,DADDR
	JNE SYNTAX
	CMP DADDR,#160000
	BHIS MEMERR
2$:	JSR PC,DISONE
	JSR PC,PABORT
	TST DERROR
	BNE 3$
	MOV DNEXT,DADDR
	DEC DCOUNT
	BNE 2$
3$:	JMP PROMPT
STEPC:	CMP NARG,#1
	JHI SYNTAX
	MOV #1,STEPS
	TST NARG
	BEQ STEPIT
	MOV ARGS,STEPS
	TST STEPS
	JEQ SYNTAX
	CMP STEPS,#100
	JHI SYNTAX
STEPIT:	MOV #14,EXOP
	MOV #STEPM,R0
	BR LEAVE
CONT:	JSR PC,NOARGS
	CLR OVACT
	MOV #10,EXOP
	MOV #CONTM,R0
	BR LEAVE
GO:	CMP NARG,#1
	JNE SYNTAX
	BIT #1,ARGS
	JNE SYNTAX
	CMP ARGS,#160000
	BLO 8$
	JMP SYNTAX
8$:
	MOV ARGS,REGS+16
	JSR PC,CLEARW
	MOV #10,EXOP
	MOV #GOM,R0
LEAVE:	JSR PC,BEGIN
	JSR PC,STR
	JSR PC,OUTPUT
	JSR PC,TXWAIT
; TX ready means the holding register is empty, not that the shifter is idle.
; 4096 SOB iterations take at least 4096 clocks, > 10*257 UART clocks.
	MOV #10000,R1
1$:	SOB R1,1$
	JSR PC,PNBACK
RESTIO:
	MOV SAVRX,R0
	BIC #177677,R0
	MOV R0,@#RCSR
	MOV SAVTX,R0
	BIC #177676,R0
	MOV R0,@#TCSR
	MOV REGS+16,@#CPC
	MOV REGS+20,@#CPSW
	MOV META,R0
	BIC #10,R0
	.WORD 42
	MOV #312,@#4
	CMP EXOP,#14
	BEQ RESTEP
RESTRT:	MOV REGS,R0
	MOV REGS+2,R1
	MOV REGS+4,R2
	MOV REGS+6,R3
	MOV REGS+10,R4
	MOV REGS+12,R5
	MOV REGS+14,SP
	.WORD 10
RESTEP:	MOV REGS,R0
	MOV REGS+2,R1
	MOV REGS+4,R2
	MOV REGS+6,R3
	MOV REGS+10,R4
	MOV REGS+12,R5
	MOV REGS+14,SP
	.WORD 14
CLEARW:	BIC #140,META
	RTS PC
; Bounded rendering: all output goes through the same cached result line.
BEGIN:	MOV #RESULT,R4
	RTS PC
CHAR:	CMP R4,#RESULT+190.
	BHIS 1$
	MOVB R0,(R4)+
1$:	CLRB (R4)
	RTS PC
STR:	MOV R0,-(SP)
	MOV R1,-(SP)
	MOV R0,R1
1$:	MOVB (R1)+,R0
	BEQ 2$
	JSR PC,CHAR
	BR 1$
2$:	MOV (SP)+,R1
	MOV (SP)+,R0
	RTS PC
NUM:	MOV R0,-(SP)
	MOV R1,-(SP)
	MOV R2,-(SP)
	MOV R3,-(SP)
	MOV #NUMBUF+6,R1
	MOV #6,R2
	MOV #-3,R3
	CMP RADIX,#10
	BEQ 1$
	MOV #4,R2
	MOV #-4,R3
1$:	MOV R0,-(SP)
	BIC #177760,R0
	CMP RADIX,#10
	BNE 2$
	BIC #10,R0
2$:	MOVB DIGITS(R0),-(R1)
	MOV (SP)+,R0
	CLC
	ROR R0
	CLC
	ROR R0
	CLC
	ROR R0
	CMP R3,#-3
	BEQ 3$
	CLC
	ROR R0
3$:	SOB R2,1$
	MOV R1,R0
	JSR PC,STR
	MOV (SP)+,R3
	MOV (SP)+,R2
	MOV (SP)+,R1
	MOV (SP)+,R0
	RTS PC
OUTPUT:	MOV R0,-(SP)
	BIT #2,OUTMOD
	BNE 1$
	MOV #RESULT,R0
	JSR PC,TXSTR
	JSR PC,NEWLIN
1$:	BIT #1,OUTMOD
	BNE 2$
	JSR PC,PNEW
2$:
	MOV (SP)+,R0
	RTS PC
NEWLIN:	MOV R0,-(SP)
	MOV #15,R0
	JSR PC,TXCHR
	MOV #12,R0
	JSR PC,TXCHR
	MOV (SP)+,R0
	RTS PC
TXSTR:	MOV R0,-(SP)
	MOV R1,-(SP)
	MOV R0,R1
1$:	MOVB (R1)+,R0
	BEQ 2$
	JSR PC,TXCHR
	BR 1$
2$:	MOV (SP)+,R1
	MOV (SP)+,R0
	RTS PC
TXCHR:	JSR PC,TXWAIT
	MOVB R0,@#TBUF
	RTS PC
TXWAIT:	JSR PC,RXPOLL
	TSTB @#TCSR
	BPL TXWAIT
	RTS PC
; Polling RX is serviced during printing; IRQs belong to the stopped guest.
RXPOLL:	TSTB @#RCSR
	BPL 9$
	MOV R0,-(SP)
	MOV R1,-(SP)
	MOV @#RCSR,R1
	MOV @#RBUF,R0
	BIT #170000,R1
	BNE RXLOSS
	TST RXDROP
	BEQ 1$
	CMP R0,#15
	BNE RXDONE
	CLR RXDROP
1$:	CMP RCOUNT,#64.
	BHIS RXLOSS
	MOV RTAIL,R1
	MOVB R0,RING(R1)
	INC RTAIL
	BIC #177700,RTAIL
	INC RCOUNT
	BR RXDONE
9$:	RTS PC
; Lose the whole queued stream on overrun. Wait for a NEW clean CR before
; accepting commands; an older queued CR cannot validate a truncated suffix.
RXLOSS:	MOV #1,RXBAD
	MOV #1,BADLIN
	MOV #1,RXDROP
	CLR LINLEN
	CLR RHEAD
	CLR RTAIL
	CLR RCOUNT
RXDONE:	MOV (SP)+,R1
	MOV (SP)+,R0
	RTS PC
RXGET:	TST RCOUNT
	BEQ 1$
	MOV RHEAD,R1
	MOVB RING(R1),R0
	BIC #177400,R0
	INC RHEAD
	BIC #177700,RHEAD
	DEC RCOUNT
	CLC
	RTS PC
1$:	SEC
	RTS PC
DBPOLL:	.WORD 43
	BIT #10,R0
	BEQ 1$
	MOV META,R0
	BIC #10,R0
	.WORD 42
	JMP CANCEL
1$:	RTS PC
PABORT:	MOV R0,-(SP)
	MOV R1,-(SP)
	JSR PC,RXPOLL
	TST RCOUNT
	BEQ 2$
	MOV RHEAD,R1
	CMPB RING(R1),#3
	BEQ 1$
	CMPB RING(R1),#33
	BNE 2$
1$:	JSR PC,RXGET
	JMP CANCEL
2$:	MOV (SP)+,R1
	MOV (SP)+,R0
	RTS PC
CMDS:	.WORD 'H,HELP,'R,REGCMD,'M,MEMCMD,'B,BYTCMD,'W,WRDCMD
	.WORD 'V,BYWCMD,'D,DISCMD,'S,STEPC,'C,CONT,'G,GO
	.WORD 'O,OCTAL,'X,HEX,'K,KEYCMD,'<,SCLEFT,'>,SCRGHT
	.WORD 'A,AUTOC,'L,DPREV,'N,DNXCMD,'T,OVCMD,0
DIGITS:	.ASCIZ /0123456789ABCDEF/
STOPMSG:	.ASCIZ /UJ11 ODT CP65: /
DEBUGM:	.ASCIZ /DEBUG/
HALTM:	.ASCIZ /HALT (PC IS AFTER HALT)/
WAITM:	.ASCIZ / WAIT/
PSWM:	.ASCIZ /PSW/
IPLM:	.ASCIZ / IPL=/
FLAGM:	.ASCIZ / T=/
NZVCM:	.ASCIZ / NZVC=/
COLON:	.ASCIZ /: /
OLDM:	.ASCIZ /OLD=/
NEWM:	.ASCIZ / -> /
PROM:	.ASCIZ /ODT> /
ERASE:	.BYTE 10,40,10,0
BUSYM:	.ASCIZ /?PANEL EDIT ACTIVE; ESC CANCELS/
SYNTM:	.ASCIZ /?SYNTAX OR RANGE; H FOR HELP/
OVERM:	.ASCIZ /?INPUT OVERFLOW; COMMAND DISCARDED/
MEMM:	.ASCIZ /?MEMORY ACCESS OR READBACK FAILED/
FAULTM:	.ASCIZ /?MONITOR FAULT; GUEST CONTEXT RETAINED/
STEPM:	.ASCIZ /STEP/
CONTM:	.ASCIZ /CONTINUE/
GOM:	.ASCIZ /GO/
HELPM:	.ASCII /R [0..7|8 [VALUE]]  REGISTERS; 8=PSW (OCT:10)/
	.BYTE 15,12
	.ASCII /M|B ADDR [COUNT]  WORD|BYTE READ (RAM ONLY)/
	.BYTE 15,12
	.ASCII /W|V ADDR VALUE  WORD|BYTE WRITE WITH READBACK/
	.BYTE 15,12
	.ASCII /D [ADDR [COUNT]]  DISASSEMBLE; S [COUNT] STEP/
	.BYTE 15,12
	.ASCII /C CONTINUE; G ADDR GO; O OCTAL; X HEX; ESC CANCEL/
	.BYTE 15,12
	.ASCII |< > SCROLL HDSP; K MEM PREV NEXT ENTER (CODES OCT 20..23)|
