; Software PDP-11 disassembly. Table is generated from explicit ISA encodings.
; No effective-address dereference: only opcode and up to two extension words.
DISONE:	MOV R0,-(SP)
	MOV R1,-(SP)
	MOV R2,-(SP)
	MOV R3,-(SP)
	MOV R5,-(SP)
	CLR DERROR
	CLR RAWCNT
	MOV DADDR,DNEXT
	JSR PC,BEGIN
	JSR PC,DGET
	BCS DUNREAD
	MOV R0,DINST
	MOV #DTAB,R5
DFIND:	MOV (R5)+,R1
	CMP R1,#177777
	BEQ DUNKNOWN
	MOV DINST,R0
	BIC R1,R0
	CMP R0,(R5)+
	BEQ DFOUND
	ADD #4,R5
	BR DFIND
DFOUND:	MOV (R5)+,R2
	MOV (R5),R0
	JSR PC,STR
	TST R2
	BEQ DFIN
	MOV #40,R0
	JSR PC,CHAR
	ASL R2
	JSR PC,@DFMTS(R2)
	BR DFIN
DUNKNOWN:	MOV #DWM,R0
	JSR PC,STR
	MOV DINST,R0
	JSR PC,NUM
	BR DFIN
DUNREAD:	MOV #DUNM,R0
	JSR PC,STR
DFIN:	TST DERROR
	BEQ DFREADY
	TST RAWCNT
	BEQ DFREADY
	JSR PC,BEGIN
	MOV #DWM,R0
	JSR PC,STR
	MOV DINST,R0
	JSR PC,NUM
DFREADY:	MOV #RESULT,R0
	MOV #ASMBUF,R1
1$:	MOVB (R0)+,(R1)+
	BNE 1$
	JSR PC,BEGIN
	MOV DADDR,R0
	JSR PC,NUM
	MOV #COLON,R0
	JSR PC,STR
	CLR R2
2$:	CMP R2,RAWCNT
	BHIS 3$
	MOV RAW(R2),R0
	JSR PC,NUM
	MOV #40,R0
	JSR PC,CHAR
	ADD #2,R2
	BR 2$
3$:	MOV #40,R0
	JSR PC,CHAR
	MOV #ASMBUF,R0
	JSR PC,STR
	TST DERROR
	BEQ 4$
	MOV #DEXM,R0
	JSR PC,STR
4$:	JSR PC,OUTPUT
	MOV (SP)+,R5
	MOV (SP)+,R3
	MOV (SP)+,R2
	MOV (SP)+,R1
	MOV (SP)+,R0
	RTS PC
DGET:	CMP DNEXT,#160000
	BHIS 9$
	BIT #1,DNEXT
	BNE 9$
	MOV DNEXT,ADDR
	CLR BYTEM
	JSR PC,READAT
	BCS 9$
	MOV R1,-(SP)
	MOV RAWCNT,R1
	CMP R1,#6
	BHIS 8$
	MOV R0,RAW(R1)
	ADD #2,RAWCNT
8$:	MOV (SP)+,R1
	ADD #2,DNEXT
	CLC
	RTS PC
9$:	INC DERROR
	CLR R0
	SEC
	RTS PC
DFMTS:	.WORD DNOT,DSINGLE,DDOUBL,DBR,DRONLY,DJSR,DEIS,DSOB,DIM6,DIM8,DIPL
DNOT:	RTS PC
DSINGLE:	MOV DINST,R0
	BIC #177700,R0
	BR DOPER
DDOUBL:	MOV DINST,R0
	ASH #-6,R0
	BIC #177700,R0
	JSR PC,DOPER
	MOV #54,R0
	JSR PC,CHAR
	MOV DINST,R0
	BIC #177700,R0
	BR DOPER
DBR:	MOV DINST,R0
	MOVB R0,R0
	ASL R0
	ADD DNEXT,R0
	JSR PC,NUM
	RTS PC
DRONLY:	MOV DINST,R3
	BIC #177770,R3
	JMP DREG
DJSR:	JSR PC,DRHIGH
	MOV #54,R0
	JSR PC,CHAR
	JMP DSINGLE
DEIS:	JSR PC,DSINGLE
	MOV #54,R0
	JSR PC,CHAR
DRHIGH:	MOV DINST,R3
	ASH #-6,R3
	BIC #177770,R3
	JMP DREG
DSOB:	JSR PC,DRHIGH
	MOV #54,R0
	JSR PC,CHAR
	MOV DINST,R0
	BIC #177700,R0
	ASL R0
	NEG R0
	ADD DNEXT,R0
	JSR PC,NUM
	RTS PC
DIM6:	MOV DINST,R0
	BIC #177700,R0
	BR DNUM
DIM8:	MOV DINST,R0
	BIC #177400,R0
	BR DNUM
DIPL:	MOV DINST,R0
	BIC #177770,R0
DNUM:	JSR PC,NUM
	RTS PC
DOPER:	MOV R0,R3
	BIC #177770,R3
	MOV R0,R2
	ASH #-3,R2
	BIC #177770,R2
	TST R2
	BEQ DREG
	CMP R2,#1
	BEQ DIND
	CMP R2,#4
	BLO DAUTO
	CMP R2,#6
	BHIS DIDX
	CMP R2,#5
	BNE 1$
	MOV #100,R0
	JSR PC,CHAR
1$:	MOV #55,R0
	JSR PC,CHAR
	BR DIND
DAUTO:	CMP R2,#3
	BNE 1$
	MOV #100,R0
	JSR PC,CHAR
1$:	CMP R3,#7
	BEQ DIMM
	JSR PC,DIND
	MOV #53,R0
	JSR PC,CHAR
	RTS PC
DIMM:	MOV #43,R0
	JSR PC,CHAR
	JSR PC,DGET
	JSR PC,NUM
	RTS PC
DIDX:	CMP R2,#7
	BNE 1$
	MOV #100,R0
	JSR PC,CHAR
1$:	JSR PC,DGET
	CMP R3,#7
	BNE 2$
	ADD DNEXT,R0
	JSR PC,NUM
	RTS PC
2$:	JSR PC,NUM
DIND:	MOV #50,R0
	JSR PC,CHAR
	JSR PC,DREG
	MOV #51,R0
	JSR PC,CHAR
	RTS PC
DREG:	MOV #122,R0
	JSR PC,CHAR
	MOV R3,R0
	ADD #60,R0
	JSR PC,CHAR
	RTS PC
DWM:	.ASCIZ /.WORD /
DUNM:	.ASCIZ /?UNREADABLE/
DEXM:	.ASCIZ / [EXTENSION UNAVAILABLE]/
	.EVEN
