; CP77: read-only FP11 software state. No FP instruction is executed here.
; Descriptor ABI v1 at HALT 060010, inside the verified FP module header.
; Service-ready and bounds prevent stale/off modules or I/O pointer access.
FPCHECK:	MOV R1,-(SP)
	CLR FPPTR
	CLR FPAC
	MOV #FPBAD,RECOV
	.WORD 43
	BIT #2,R0
	BEQ FPBAD
	CMP @#60004,#125110
	BNE FPBAD
	CMP @#60006,#2
	BNE FPBAD
	CMP @#60010,#125104
	BNE FPBAD
	CMP @#60012,#1
	BNE FPBAD
	MOV @#60014,R1
	BIT #1,R1
	BNE FPBAD
	CMP R1,#60022
	BLO FPBAD
	CMP R1,#157712
	BHI FPBAD
	CMP @#10,#60022
	BLO FPBAD
	CMP @#10,R1
	BHIS FPBAD
	MOV R1,R0
	ADD #6,R0
	CMP R0,@#60016
	BNE FPBAD
	ADD #60,R0
	CMP R0,@#60020
	BHI FPBAD
	CMP @#60020,#160000
	BHI FPBAD
	MOV (R1),FPLIVE
	MOV R1,FPPTR
	ADD #6,R1
	MOV R1,FPAC
	CLR RECOV
	MOV (SP)+,R1
	CLC
	RTS PC
FPBAD:	CLR RECOV
	MOV (SP)+,R1
	SEC
	RTS PC
FPERROR:	MOV #FPNONE,R0
	JMP ERROR
FPCMD:	CMP NARG,#1
	JHI SYNTAX
	TST NARG
	BEQ 1$
	CMP ARGS,#10
	JHI SYNTAX
1$:	JSR PC,FPCHECK
	JCS FPERROR
	MOV #4,VIEW
	TST NARG
	BEQ FPALL
	MOV ARGS,FSEL
	JSR PC,FPONE
	JMP PROMPT
FPALL:	MOV OUTMOD,-(SP)
	BIS #1,OUTMOD
	CLR FSEL
1$:	JSR PC,FPONE
	INC FSEL
	CMP FSEL,#11
	BLO 1$
	MOV (SP)+,OUTMOD
	CLR FSEL
	BIS #2,OUTMOD
	JSR PC,FPONE
	BIC #2,OUTMOD
	JMP PROMPT
FPONE:	JSR PC,BEGIN
	MOV FSEL,R2
	CMP R2,#6
	BHIS 2$
	MOV #FPACT,R0
	JSR PC,STR
	MOV R2,R0
	ADD #60,R0
	JSR PC,CHAR
	MOV #75,R0
	JSR PC,CHAR
	ASL R2
	ASL R2
	ASL R2
	ADD FPAC,R2
	MOV #4,R3
1$:	MOV (R2)+,R0
	JSR PC,NUM
	DEC R3
	BEQ 4$
	MOV #40,R0
	JSR PC,CHAR
	BR 1$
2$:	SUB #6,R2
	ASL R2
	MOV FPLABS(R2),R0
	JSR PC,STR
	MOV #75,R0
	JSR PC,CHAR
	ADD FPPTR,R2
	MOV (R2),R0
	JSR PC,NUM
	CMP FSEL,#6
	BNE 4$
	MOV #FPMODE,R0
	JSR PC,STR
	MOV #'F,R0
	BIT #200,FPLIVE
	BEQ 3$
	MOV #'D,R0
3$:	JSR PC,CHAR
	MOV #54,R0
	JSR PC,CHAR
	MOV #'I,R0
	BIT #100,FPLIVE
	BEQ 5$
	MOV #'L,R0
5$:	JSR PC,CHAR
4$:	JSR PC,OUTPUT
	RTS PC
FPFIRST:	CLR FSEL
	BR FPSHOW
FPNAV:	ADD R0,FSEL
	BPL 1$
	MOV #10,FSEL
1$:	CMP FSEL,#11
	BLO FPSHOW
	CLR FSEL
FPSHOW:	MOV FSEL,ARGS
	MOV #1,NARG
	MOV #'F,CMD
	JMP PCOM
; R2 is format, (R5) points to FI/DI/FL/DL/generic mnemonic pointers.
; Only stopped-PC decode uses the live FPS. Other addresses use generic DEC
; names: a memory listing cannot infer FPS through branches or LDFPS.
FPNAME:	CMP R2,#13.
	BHI 1$
	BIT #70,DINST
	BNE 1$
	MOV DINST,R0
	BIC #177770,R0
	CMP R0,#6
	BHIS 9$
1$:	MOV #10,R1
	CMP DADDR,REGS+16
	BNE 3$
	JSR PC,FPCHECK
	BCS 3$
	CLR R1
	BIT #200,FPLIVE
	BEQ 2$
	ADD #2,R1
2$:	BIT #100,FPLIVE
	BEQ 3$
	ADD #4,R1
3$:	ADD (R5),R1
	MOV (R1),R0
	CLC
	RTS PC
9$:	SEC
	RTS PC
DFSING:	BIT #70,DINST
	BNE 1$
	MOV DINST,R3
	BIC #177770,R3
	BR DFAC
1$:	JMP DSINGLE
DFLOAD:	JSR PC,DFSING
	JSR PC,DFCOM
	BR DFHIGH
DFSTOR:	JSR PC,DFHIGH
	JSR PC,DFCOM
	BR DFSING
DFSTI:	JSR PC,DFHIGH
	JSR PC,DFCOM
	JMP DSINGLE
DFLDI:	JSR PC,DSINGLE
	JSR PC,DFCOM
DFHIGH:	MOV DINST,R3
	ASH #-6,R3
	BIC #177774,R3
DFAC:	MOV #FPACT,R0
	JSR PC,STR
	MOV R3,R0
	ADD #60,R0
	JMP CHAR
DFCOM:	MOV #54,R0
	JMP CHAR
FPNONE:	.ASCIZ /?FP11 DEBUG STATE UNAVAILABLE/
FPACT:	.ASCIZ /AC/
FPMODE:	.ASCIZ / MODE=/
FPST:	.ASCIZ /FPS/
FPECT:	.ASCIZ /FEC/
FPEAT:	.ASCIZ /FEA/
	.EVEN
FPLABS:	.WORD FPST,FPECT,FPEAT
