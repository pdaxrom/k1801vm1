; CP65: software-only display timing and known instruction boundaries.
; Delays count full idle panel scans; neither KW11 nor guest IRQ state changes.
SCSTEP=32.
SCWAIT=240.
PNEW:	MOV R0,-(SP)
	MOV R1,-(SP)
	CLR SCROLL
	MOV #1,SCDIR
	MOV #SCWAIT,SCTIME
	MOV #RESULT,R1
1$:	TSTB (R1)+
	BNE 1$
	SUB #RESULT+17.,R1
	BPL 2$
	CLR R1
2$:	MOV R1,SCEND
	JSR PC,PNDRAW
	MOV (SP)+,R1
	MOV (SP)+,R0
	RTS PC
ASCAN:	TST PNEN
	BEQ 9$
	TST AUTOSC
	BEQ 9$
	TST SCEND
	BEQ 9$
	TST PANEDIT
	BNE 9$
	TST LINLEN
	BNE 9$
	TST RCOUNT
	BNE 9$
	TST KLAST
	BPL 9$
	DEC SCTIME
	BNE 9$
	ADD SCDIR,SCROLL
	MOV #SCSTEP,SCTIME
	TST SCROLL
	BEQ 1$
	CMP SCROLL,SCEND
	BNE 2$
1$:	NEG SCDIR
	MOV #SCWAIT,SCTIME
2$:	JSR PC,PNDRAW
9$:	RTS PC
AUTOC:	CMP NARG,#1
	JHI SYNTAX
	TST NARG
	BEQ 1$
	CMP ARGS,#1
	JHI SYNTAX
	MOV ARGS,AUTOSC
	BR 2$
1$:	MOV #1,R0
	XOR R0,AUTOSC
2$:	MOV #SCWAIT,SCTIME
	MOV #AUTOOF,R0
	TST AUTOSC
	BEQ 3$
	MOV #AUTOON,R0
3$:	JSR PC,TXSTR
	JSR PC,NEWLIN
	JMP PROMPT
AUTOON:	.ASCIZ /AUTO SCROLL ON/
AUTOOF:	.ASCIZ /AUTO SCROLL OFF/
	.EVEN
HINIT:	CLR HCNT
	CLR HPOS
	RTS PC
HTRACK:	TST HHOLD
	BNE 9$
	TST HCNT
	BEQ 3$
	MOV HPOS,R1
	ASL R1
	CMP DADDR,HIST(R1)
	BEQ 9$
	INC HPOS
	CMP HPOS,HCNT
	BHIS 1$
	ADD #2,R1
	CMP DADDR,HIST(R1)
	BEQ 9$
1$:	MOV HPOS,HCNT
	CMP HCNT,#32.
	BLO 3$
	MOV #HIST,R1
	MOV #31.,R2
2$:	MOV 2(R1),(R1)+
	SOB R2,2$
	DEC HCNT
3$:	MOV HCNT,HPOS
	MOV HCNT,R1
	ASL R1
	MOV DADDR,HIST(R1)
	INC HCNT
9$:	RTS PC
DPREV:	JSR PC,NOARGS
	TST HCNT
	BEQ 9$
	TST HPOS
	BEQ 9$
	DEC HPOS
	MOV HPOS,R1
	ASL R1
	MOV HIST(R1),DADDR
	BR DVIEW
9$:	MOV #HSTART,R0
	JMP ERROR
DNXCMD:	JSR PC,NOARGS
	TST HCNT
	JEQ MEMERR
	TST DERROR
	JNE MEMERR
	MOV DNEXT,DADDR
	CMP DADDR,#160000
	JHI MEMERR
	JEQ MEMERR
DVIEW:	MOV #2,VIEW
	JSR PC,DISONE
	MOV DNEXT,DADDR
	JMP PROMPT
HSTART:	.ASCIZ /HISTORY START; D ADDR TO CHOOSE AN EARLIER BOUNDARY/
	.EVEN
