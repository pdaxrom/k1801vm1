; STEP OVER without FPGA comparators or USER RAM patches. A JSR executes
; through bounded hardware STEP cycles until both return PC and SP match.
; CP63 STEP defers ordinary IRQ/trace; WAIT and HALT end this operation.
OVCMD:	CMP NARG,#1
	JHI SYNTAX
	MOV #4096.,OVLEFT
	TST NARG
	BEQ 1$
	TST ARGS
	JEQ SYNTAX
	MOV ARGS,OVLEFT
1$:	MOV REGS+16,DADDR
	BIT #1,DADDR
	JNE SYNTAX
	CMP DADDR,#160000
	JHI MEMERR
	JEQ MEMERR
	MOV #1,HHOLD
	MOV #3,OUTMOD
	JSR PC,DISONE
	CLR OUTMOD
	CLR HHOLD
	TST DERROR
	JNE MEMERR
	MOV DINST,R0
	BIC #777,R0
	CMP R0,#4000
	BNE OVONE
	BIT #70,DINST
	BEQ OVONE
	MOV DNEXT,OVPC
	MOV REGS+14,OVSP
	CLR OVCAN
	MOV #1,OVACT
	MOV #14,EXOP
	MOV #OVMSG,R0
	JMP LEAVE
OVONE:	CLR NARG
	JMP STEPC
; Called after saving the stepped guest context, before ordinary stop output.
; The input ring survives these entries so a queued cancellation is not lost.
OVBACK:	MOV #OVWAIT,R0
	BIT #40,META
	BNE OVEND
	MOV #OVHALT,R0
	BIT #20,META
	BEQ OVEND
	MOV #OVRET,R0
	CMP REGS+16,OVPC
	BNE 1$
	CMP REGS+14,OVSP
	BEQ OVEND
1$:	JSR PC,RXPOLL
	MOV #OVABRT,R0
	TST RCOUNT
	BNE OVEND
	.WORD 43
	BIT #10,R0
	BNE OVBUT
	TST PNEN
	BEQ 4$
	JSR PC,PNKEY
	CMP R0,#-1
	BNE 2$
	MOV #1,OVCAN
	BR 4$
2$:	TST R0
	BMI 4$
	TST OVCAN
	BEQ 4$
; Consume the cancelling press so ENTER cannot dispatch it as a new command.
	MOV R0,KLAST
	MOV R0,KCAND
	MOV #2,KCOUNT
	BR OVBUT
4$:	DEC OVLEFT
	BNE OVMORE
	MOV #OVLIM,R0
	BR OVEND
OVBUT:	MOV #OVABRT,R0
OVEND:	MOV R0,OVWHY
	CLR OVACT
	CLR STEPS
	RTS PC
OVMORE:	MOV #STKTOP,SP
	MOV #14,EXOP
	JSR PC,PNBACK
	JMP RESTIO
OVMSG:	.ASCIZ /STEP OVER (STEP LOOP; IRQ DEFERRED)/
OVRET:	.ASCIZ /OVER RETURN/
OVWAIT:	.ASCIZ /OVER STOP: WAIT/
OVHALT:	.ASCIZ /OVER STOP: HALT/
OVABRT:	.ASCIZ /OVER CANCELLED/
OVLIM:	.ASCIZ /OVER STEP LIMIT/
	.EVEN
