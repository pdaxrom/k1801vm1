; HALT panel frontend. Numeric key codes use the proven PNLDRV map;
; default function codes 20/21/22/23 are configurable with K on UART.
PNTAKE:	MOVB @#PANEL+1,SAVPN
	CLR PNEN
	TSTB SAVPN
	BMI 1$
	MOV #1,PNEN
; Keep press/debounce state across STEP entries. A still-held step key must
; be released before it can issue another command; DATA supplies cold state.
	JSR PC,PNINIT
	MOV #1,R0
	JSR PC,PNRGB
1$:	RTS PC
PNBACK:	TST PNEN
	BEQ 1$
	MOVB SAVPN,@#PANEL+1
1$:	RTS PC
PNDRAW:	TST PNEN
	BEQ 9$
	MOV R0,-(SP)
	MOV R1,-(SP)
	MOV R2,-(SP)
	MOV #RESULT,R1
	ADD SCROLL,R1
	MOV #SCREEN,R2
	MOV #16.,R0
1$:	TSTB (R1)
	BEQ 2$
	MOVB (R1)+,(R2)+
	SOB R0,1$
	BR 4$
2$:	MOVB #40,(R2)+
	SOB R0,2$
4$:	MOV #SCREEN,R0
	JSR PC,PNDISP
	MOV (SP)+,R2
	MOV (SP)+,R1
	MOV (SP)+,R0
9$:	RTS PC
; Two complete agreeing scans for both press and release; no key chords.
PNPOLL:	TST PNEN
	BEQ 9$
	JSR PC,PNKEY
	CMP R0,#-2
	BEQ 9$
	CMP R0,KCAND
	BEQ 1$
	MOV R0,KCAND
	CLR KCOUNT
	RTS PC
1$:	CMP KCOUNT,#2
	BHIS 9$
	INC KCOUNT
	CMP KCOUNT,#2
	BLO 9$
	CMP R0,KLAST
	BEQ 9$
	MOV R0,KLAST
	TST R0
	BMI 9$
	TST LINLEN
	BEQ 8$
	CMP R0,KEYS
	JNE 9$
	JMP CANCEL
8$:	JMP PNINPUT
9$:	RTS PC
PNINPUT:	CMP R0,KEYS
	JEQ PMEM
	TST PANEDIT
	JNE PEDIT
	CMP R0,KEYS+2
	JEQ PPREV
	CMP R0,KEYS+4
	JEQ PNEXTK
	CMP R0,KEYS+6
	JEQ PENTER
	CMP R0,#10
	BLO 9$
	CMP R0,#20
	BHIS 9$
	SUB #10,R0
	ASL R0
	JMP @HOTKEY(R0)
9$:
	RTS PC
PMEM:	CLR PANEDIT
	MOV #3,VIEW
	JMP PMENU
PPREV:	MOV #-1,R0
	BR PNAV
PNEXTK:	MOV #1,R0
PNAV:	CMP VIEW,#3
	BEQ 3$
	CMP VIEW,#2
	BNE 7$
	TST R0
	BPL 8$
	JMP PDISPR
8$:	JMP PDISNX
7$:
	TST VIEW
	BNE 2$
	ADD R0,RSEL
	BPL 1$
	MOV #10,RSEL
1$:	CMP RSEL,#11
	BLO PRSHOW
	CLR RSEL
	BR PRSHOW
2$:	TST VBYTE
	BNE 6$
	ASL R0
6$:	ADD R0,MSEL
	CMP MSEL,#160000
	BLO PMSHOW
	SUB R0,MSEL
	RTS PC
3$:	ADD R0,MENU
	BPL 4$
	MOV #7,MENU
4$:	CMP MENU,#10
	BLO PMENU
	CLR MENU
PMENU:	JSR PC,BEGIN
	MOV #MENUM,R0
	JSR PC,STR
	MOV MENU,R1
	ASL R1
	MOV MNAMES(R1),R0
	JSR PC,STR
	CLR SCROLL
	JSR PC,OUTPUT
	JMP PROMPT
PSCROL:	TST R0
	BMI 1$
; A short new result may leave old bytes beyond its terminator. Check every
; byte through the proposed window end, never probe beyond an earlier NUL.
	MOV #RESULT,R1
	MOV SCROLL,R2
	ADD #17.,R2
3$:	TSTB (R1)+
	BEQ 2$
	SOB R2,3$
	INC SCROLL
	BR 2$
1$:	TST SCROLL
	BEQ 2$
	DEC SCROLL
2$:	JSR PC,PNDRAW
	RTS PC
PENTER:	CMP VIEW,#3
	BEQ PACTION
	CMP VIEW,#2
	BNE 1$
	JMP PDISNX
1$:	MOV #1,PANEDIT
	BR PSTART
PACTION:	MOV MENU,R1
	ASL R1
	JMP @MACTS(R1)
PRSHOW:	CLR VIEW
	MOV RSEL,ARGS
	MOV #1,NARG
	MOV #'R,CMD
	JMP PCOM
PMSHOW:	MOV MSEL,ARGS
	MOV #1,NARG
	MOV #'M,CMD
	TST VBYTE
	BEQ PCOM
	MOV #'B,CMD
	JMP PCOM
PMADDR:	MOV #3,PANEDIT
	BR PSTART
PDADDR:	MOV #4,PANEDIT
	BR PSTART
PGADDR:	MOV #2,PANEDIT
; ASMBUF is idle while the numeric editor owns input. Preserve the previous
; visible result so ESC restores it instead of leaving a stale EDIT prompt.
PSTART:	MOV #RESULT,R0
	MOV #ASMBUF,R1
1$:	MOVB (R0)+,(R1)+
	BNE 1$
	CLR PVAL
	CLR PDIGS
	CLR SCROLL
	JMP PFORMAT
PSTEP:	CLR NARG
	MOV #'S,CMD
	JMP PCOM
PCONT:	CLR NARG
	MOV #'C,CMD
	JMP PCOM
PRADIX:	CLR NARG
	MOV #'O,CMD
	CMP RADIX,#10
	BNE PCOM
	MOV #'X,CMD
PCOM:	MOV #1,CMDORG
	JMP COMMAND
PEDIT:	CMP R0,KEYS+6
	JEQ PCONFM
	CMP R0,KEYS+2
	BEQ PBACK
	CMP R0,RADIX
	BHIS PNRET
	MOV PVAL,R1
	CMP RADIX,#10
	BEQ 1$
	ASL R1
	BCS PNRET
1$:	ASL R1
	BCS PNRET
	ASL R1
	BCS PNRET
	ASL R1
	BCS PNRET
	ADD R0,R1
	BCS PNRET
	MOV R1,PVAL
	INC PDIGS
	BR PFORMAT
PBACK:	TST PDIGS
	BEQ PNRET
	DEC PDIGS
	CLC
	ROR PVAL
	CLC
	ROR PVAL
	CLC
	ROR PVAL
	CMP RADIX,#10
	BEQ PFORMAT
	CLC
	ROR PVAL
PFORMAT:	JSR PC,BEGIN
	MOV #EDITM,R0
	JSR PC,STR
	MOV PVAL,R0
	JSR PC,NUM
	MOV #OCTM,R0
	CMP RADIX,#10
	BEQ 1$
	MOV #HEXM,R0
1$:	JSR PC,STR
	JSR PC,PNEW
9$:	RTS PC
PNRET:	RTS PC
PCONFM:	TST PDIGS
	BEQ 9$
	MOV #1,NARG
	MOV PVAL,ARGS
	CMP PANEDIT,#2
	BEQ 2$
	CMP PANEDIT,#3
	BEQ 3$
	CMP PANEDIT,#4
	BEQ 4$
	MOV #2,NARG
	MOV PVAL,ARGS+2
	TST VIEW
	BEQ 1$
	MOV MSEL,ARGS
	MOV #'W,CMD
	TST VBYTE
	BEQ 5$
	MOV #'V,CMD
	BR 5$
1$:	MOV RSEL,ARGS
	MOV #'R,CMD
	BR 5$
2$:	MOV #'G,CMD
	BR 5$
3$:	MOV #'M,CMD
	TST VBYTE
	BEQ 5$
	MOV #'B,CMD
	BR 5$
4$:	MOV #'D,CMD
5$:	CLR PANEDIT
	JMP PCOM
9$:	RTS PC
; UART equivalents for local navigation and function-key calibration.
SCLEFT:	JSR PC,NOARGS
	MOV #-1,R0
	JSR PC,PSCROL
	MOV #SCWAIT,SCTIME
	MOV #-1,SCDIR
	TST SCROLL
	BNE 1$
	NEG SCDIR
1$:
	JMP PROMPT
SCRGHT:	JSR PC,NOARGS
	MOV #1,R0
	JSR PC,PSCROL
	MOV #SCWAIT,SCTIME
	MOV #1,SCDIR
	CMP SCROLL,SCEND
	BLO 1$
	NEG SCDIR
1$:
	JMP PROMPT
KEYCMD:	CMP NARG,#4
	JNE SYNTAX
	CLR R2
1$:	MOV ARGS(R2),R0
	CMP R0,#20
	JLO SYNTAX
	CMP R0,#23
	JHI SYNTAX
	MOV R2,R3
2$:	TST R3
	BEQ 3$
	SUB #2,R3
	CMP R0,ARGS(R3)
	JEQ SYNTAX
	BR 2$
3$:	ADD #2,R2
	CMP R2,#10
	BLO 1$
	CLR R2
4$:	MOV ARGS(R2),KEYS(R2)
	ADD #2,R2
	CMP R2,#10
	BLO 4$
	MOV #KEYM,R0
	JMP ERROR
PNECHO:	TST CMDORG
	BEQ 9$
	CLR CMDORG
	JSR PC,BEGIN
	MOV #PNLM,R0
	JSR PC,STR
	MOV CMD,R0
	JSR PC,CHAR
	CLR R2
1$:	MOV R2,R1
	ASR R1
	CMP R1,NARG
	BHIS 2$
	MOV #40,R0
	JSR PC,CHAR
	MOV ARGS(R2),R0
	JSR PC,NUM
	ADD #2,R2
	BR 1$
2$:	JSR PC,OUTPUT
9$:	RTS PC
MENUM:	.ASCIZ /MENU /
EDITM:	.ASCIZ /EDIT /
OCTM:	.ASCIZ / O/
HEXM:	.ASCIZ / X/
PNLM:	.ASCIZ /[PANEL] /
KEYM:	.ASCIZ /FUNCTION KEYS SET: MEM PREV NEXT ENTER/
M0:	.ASCIZ /REGISTERS/
M1:	.ASCIZ /MEMORY ADDRESS/
M2:	.ASCIZ /DISASM ADDRESS/
M3:	.ASCIZ /STEP/
M4:	.ASCIZ /CONTINUE/
M5:	.ASCIZ /GO ADDRESS/
M6:	.ASCIZ |OCT/HEX|
	.EVEN
M7:	.ASCIZ |WORD/BYTE|
	.EVEN
MNAMES:	.WORD M0,M1,M2,M3,M4,M5,M6,M7
MACTS:	.WORD PRFIRST,PMADDR,PDADDR,PSTEP,PCONT,PGADDR,PRADIX,PTBYTE
PRFIRST:	CLR RSEL
	JMP PRSHOW
PDISPR:	MOV #'L,CMD
	BR PHOT
PDISNX:	MOV #'N,CMD
	BR PHOT
POVER:	MOV #'T,CMD
PHOT:	CLR NARG
	JMP PCOM
; Physical hex labels 8..F, only when no numeric editor owns input.
HOTKEY:	.WORD PSTEP,POVER,PRFIRST,PMADDR,PDADDR,PGADDR,PCONT,PRADIX
PTBYTE:	MOV #1,R0
	XOR R0,VBYTE
	TST VBYTE
	BNE 1$
	BIC #1,MSEL
1$:	JMP PMSHOW
