; CP66: HALT patches in explicitly selected USER RAM words. No USER BPT
; vector or stack is used. Vector 170 is hooked only while patches are live.
; Four persistent entries plus one temporary entry: address, original, state.
; State bit0 = defined, bit1 = patch may have been written (including faults).
BPNUM=4.
BPCMD:	TST NARG
	JEQ BPLIST
	JSR PC,BPARG
	JCS SYNTAX
	MOV ADDR,R0
	JSR PC,BPFIND
	TST R3
	BNE BPSHOW
	JSR PC,READAT
	JCS MEMERR
	TST R0
	JEQ BPERROR
	MOV R0,VALUE
	MOV #BPTAB,R3
	MOV #BPNUM,R2
1$:	TST 4(R3)
	BEQ 2$
	ADD #6,R3
	SOB R2,1$
	JMP BPERROR
2$:	MOV ADDR,(R3)
	MOV VALUE,2(R3)
	MOV #1,4(R3)
BPSHOW:	JSR PC,BEGIN
	MOV #BPLABL,R0
	JSR PC,STR
	MOV (R3),R0
	JSR PC,NUM
	MOV #40,R0
	JSR PC,CHAR
	MOV 2(R3),R0
	JSR PC,NUM
	JSR PC,OUTPUT
	JMP PROMPT
BPLIST:	MOV #BPTAB,R3
	MOV #BPNUM,R2
1$:	TST 4(R3)
	BEQ 2$
	JSR PC,BEGIN
	MOV #BPLABL,R0
	JSR PC,STR
	MOV (R3),R0
	JSR PC,NUM
	JSR PC,OUTPUT
2$:	ADD #6,R3
	SOB R2,1$
	JMP PROMPT
BPCLR:	CMP NARG,#1
	JHI SYNTAX
	JSR PC,BPDIS
	TST BPERR
	JNE BPERROR
	JSR PC,BPTCLR
	TST NARG
	BEQ 2$
	JSR PC,BPARG
	JCS SYNTAX
	MOV ADDR,R0
	JSR PC,BPFIND
	TST R3
	BEQ 3$
	CLR 4(R3)
	BR 3$
2$:	MOV #BPTAB,R3
	MOV #BPNUM,R2
1$:	CLR 4(R3)
	ADD #6,R3
	SOB R2,1$
3$:	MOV #BPCLRM,R0
	JMP ERROR
BPARG:	CMP NARG,#1
	BNE 9$
	MOV ARGS,ADDR
	CLR BYTEM
	BIT #1,ADDR
	BNE 9$
	CMP ADDR,#1000
	BLO 9$
	CMP ADDR,#160000
	BHIS 9$
	CLC
	RTS PC
9$:	SEC
	RTS PC
; Find a defined entry by R0. R0 preserved; R2/R3 clobbered, R3=0 if absent.
BPFIND:	MOV #BPTAB,R3
	MOV #BPNUM+1,R2
1$:	TST 4(R3)
	BEQ 2$
	CMP R0,(R3)
	BEQ 9$
2$:	ADD #6,R3
	SOB R2,1$
	CLR R3
9$:	RTS PC
; Restore only a word still equal to our HALT patch. Never overwrite changed
; guest code. Failed restorations retain their armed bit and block execution.
BPDIS:	CLR BPERR
	CMP @#170,#ENTER
	BNE 1$
	MOV #200,@#170
	CMP @#170,#200
	BEQ 1$
	INC BPERR
1$:	CLR BYTEM
	MOV #BPTAB,R3
	MOV #BPNUM+1,R2
2$:	BIT #2,4(R3)
	BEQ 7$
	MOV (R3),ADDR
	JSR PC,READAT
	BCS 8$
	TST R0
	BNE 6$
	MOV 2(R3),VALUE
	JSR PC,WRITEA
	BCS 8$
	JSR PC,READAT
	BCS 8$
	CMP R0,VALUE
	BNE 8$
5$:	BIC #2,4(R3)
	BR 7$
6$:	CMP R0,2(R3)
	BEQ 5$
	CLR 4(R3)
	MOV #1,BPERR
7$:	ADD #6,R3
	SOB R2,2$
	RTS PC
8$:	MOV #1,BPERR
	BR 7$
; Called before every START/STEP. A current-PC breakpoint is stepped once
; with all patches removed, then BPBACK either stops at another point or runs.
BPBEFO:	JSR PC,BPDIS
	TST BPERR
	BNE 9$
	TST BPRUN
	BNE 11$
	JSR PC,BPTCLR
11$:
	CLR BPPOST
	CMP EXOP,#14
	BEQ 8$
	MOV #BPTAB,R3
	MOV #BPNUM+1,R2
	CLR BPANY
1$:	TST 4(R3)
	BEQ 3$
	INC BPANY
	MOV (R3),ADDR
	JSR PC,READAT
	BCS 9$
	CMP R0,2(R3)
	BNE 7$
	CMP ADDR,REGS+16
	BNE 3$
	INC BPPOST
3$:	ADD #6,R3
	SOB R2,1$
	TST BPANY
	BEQ 8$
	.WORD 43
	BIC #177772,R0
	CMP R0,#5
	BNE 9$
	CMP @#170,#200
	BNE 9$
	CMP @#172,#340
	BNE 9$
	TST BPPOST
	BEQ 4$
	MOV #1,BPPOST
	MOV #14,EXOP
	BR 8$
4$:	MOV #BPTAB,R3
	MOV #BPNUM+1,R2
5$:	TST 4(R3)
	BEQ 6$
	MOV (R3),ADDR
	CLR VALUE
	BIS #2,4(R3)
	JSR PC,WRITEA
	BCS 9$
	JSR PC,READAT
	BCS 9$
	TST R0
	BNE 9$
6$:	ADD #6,R3
	SOB R2,5$
	MOV #ENTER,@#170
	CMP @#170,#ENTER
	BNE 9$
8$:	CLC
	RTS PC
7$:	CLR 4(R3)
9$:	JSR PC,BPDIS
	CLR BPPOST
	SEC
	RTS PC
; ENTER already saved all guest registers and CPC/CPSW, before touching UART.
BPBACK:	TST BPCONV
	BEQ 12$
	CLR BPCONV
; The artificial HALT was not a guest instruction. Its apparent T event
; must not become an extra guest trace on CONTINUE.
	BIC #100,META
	RTS PC
12$:	CLR BPAUTO
	CLR BPHIT
	CLR BPLOAD
	CLR BPWHY
	BIT #20,META
	BNE 3$
	CMP @#170,#ENTER
	BNE 4$
	MOV REGS+16,R0
	SUB #2,R0
	JSR PC,BPFIND
	TST R3
	BEQ 1$
	BIT #2,4(R3)
	BEQ 1$
	MOV R3,BPHIT
	MOV R0,REGS+16
	BR 4$
1$:	CMP REGS+10,#125061
	BNE 4$
	INC BPLOAD
	BR 4$
3$:	TST BPPOST
	BEQ 4$
	INC BPAUTO
	MOV REGS+16,R0
	JSR PC,BPFIND
	MOV R3,BPHIT
4$:	CLR BPPOST
	JSR PC,BPDIS
	TST BPERR
	BNE 8$
	TST BPLOAD
	JNE BPCHAIN
	MOV BPHIT,R3
	BEQ 6$
	CMP R3,#BPTEMP
	BLO 5$
	CMP BPRUN,#2
	BNE 5$
	CMP REGS+14,BPSP
	BEQ 5$
	MOV #1,BPAUTO
	BR 9$
5$:	MOV #BPHITM,BPWHY
	CMP R3,#BPTEMP
	BLO 7$
	MOV #BPTO,BPWHY
	CMP BPRUN,#2
	BNE 7$
	MOV #OVRET,BPWHY
	BR 7$
6$:	TST BPAUTO
	BNE 9$
7$:	CLR BPAUTO
	CLR BPRUN
	JSR PC,BPTCLR
9$:	TST BPHIT
	BEQ 11$
	BIT #20,META
	JEQ BPCVT
11$:	RTS PC
8$:	MOV #BPBAD,BPWHY
	BR 7$
; Convert a native patched HALT into a CP63 debug context without executing
; any USER opcode. Pending debug wins over IRQ/trace at the START boundary.
; This preserves ordinary CONTINUE/RTT trace semantics after restoring PC.
BPCVT:	MOV #1,BPCONV
	MOV REGS+16,@#CPC
	MOV REGS+20,@#CPSW
	MOV META,R0
	BIC #140,R0
	BIS #10,R0
	.WORD 42
	MOV #312,@#4
	MOV REGS,R0
	MOV REGS+2,R1
	MOV REGS+4,R2
	MOV REGS+6,R3
	MOV REGS+10,R4
	MOV REGS+12,R5
	MOV REGS+14,SP
	.WORD 10
; Loader-signature HALT must reach the exact old resident with original GPRs.
; Disarm before any such call, so a later UJLOAD cannot overwrite a live hook.
BPCHAIN:	CLR BPRUN
	JSR PC,BPTCLR
	MOV META,R0
	.WORD 42
	MOV #312,@#4
	MOV REGS,R0
	MOV REGS+2,R1
	MOV REGS+4,R2
	MOV REGS+6,R3
	MOV REGS+10,R4
	MOV REGS+12,R5
	MOV REGS+14,SP
	JMP @#200
BPMORE:	MOV #10,EXOP
	JSR PC,BPBEFO
	JCS BPERROR
	JMP RESTIO
BPRTO:	JSR PC,BPARG
	JCS SYNTAX
	CMP ADDR,REGS+16
	BEQ 1$
	MOV #1,BPRUN
	BR BPTSET
1$:	MOV #BPTO,R0
	JMP ERROR
; T without arguments uses IRQ-enabled RUN. Explicit T limit retains the
; bounded CP65 step loop as a separate, labelled compatibility operation.
BPOVER:	TST NARG
	JNE OVCMD
	MOV REGS+16,DADDR
	MOV #1,HHOLD
	MOV #3,OUTMOD
	JSR PC,DISONE
	CLR OUTMOD
	CLR HHOLD
	TST DERROR
	JNE MEMERR
	MOV DINST,R0
	BIC #777,R0
	CMP R0,#4000
	JNE OVONE
	BIT #70,DINST
	JEQ OVONE
	MOV DNEXT,ARGS
	MOV #1,NARG
	JSR PC,BPARG
	JCS SYNTAX
	MOV #2,BPRUN
	MOV REGS+14,BPSP
BPTSET:	MOV ADDR,-(SP)
; A previous temporary patch may still need restoration after a bus fault.
; Never replace its ownership record until cleanup has actually succeeded.
	JSR PC,BPDIS
	MOV (SP)+,ADDR
	TST BPERR
	JNE BPERROR
	JSR PC,READAT
	JCS BPERROR
	TST R0
	JEQ BPERROR
	MOV ADDR,BPTEMP
	MOV R0,BPTEMP+2
	MOV #1,BPTEMP+4
	MOV #10,EXOP
	MOV #BPRUNM,R0
	JMP LEAVE
BPERROR:	CLR BPRUN
	CLR BPPOST
	JSR PC,BPDIS
	JSR PC,BPTCLR
	MOV #BPBAD,R0
	JMP ERROR
BPTCLR:	BIT #2,BPTEMP+4
	BNE 1$
	CLR BPTEMP+4
1$:	RTS PC
BPLABL:	.ASCIZ /BP /
BPCLRM:	.ASCIZ /BREAKPOINTS CLEARED/
BPHITM:	.ASCIZ /BREAKPOINT/
BPTO:	.ASCIZ /RUN TO ADDRESS/
BPRUNM:	.ASCIZ /RUN (IRQ ENABLED; RESET TO STOP)/
BPBAD:	.ASCIZ |?BP RANGE/HALT/FULL/CHANGED/WRITE; CHECK MEMORY|
	.EVEN
