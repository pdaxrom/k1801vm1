; Full-matrix scan rejects more than one active intersection. No chords.
PNKEY:	MOV R1,-(SP)
	MOV R2,-(SP)
	MOV R3,-(SP)
	MOV R4,-(SP)
	MOV R5,-(SP)
	MOV #-1,R5
	CLR R2
	MOV #10,R3
1$:	MOV R3,R0
	BIS RGBRAW,R0
	JSR PC,PNLATC
	MOV @#PANEL,R4
	ASH #-4,R4
	BIC #177760,R4
	BEQ 4$
	TST R5
	BPL 8$
	MOV R4,R0
	DEC R0
	BIT R0,R4
	BNE 8$
	MOV R2,R1
2$:	INC R1
	ASR R4
	BNE 2$
	MOVB KEYMAP(R1),R5
	BIC #177400,R5
4$:	ADD #4,R2
	ASL R3
	CMP R3,#400
	BLO 1$
	MOV R5,R0
	BR 9$
8$:	MOV #-2,R0
9$:	MOV (SP)+,R5
	MOV (SP)+,R4
	MOV (SP)+,R3
	MOV (SP)+,R2
	MOV (SP)+,R1
	RTS PC
