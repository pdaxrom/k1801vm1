	.TITLE	UJCHEK
	.IDENT	/01.00/
; Exercise the test service files through actual HALT/FP11/SEL004/START.
; These test files do not implement ODT or FP11 arithmetic.
	.MCALL	.PRINT,.EXIT
	.PSECT	CHECK,I,RW
START:	.WORD	43
	BIC	#177774,R0
	CMP	R0,#3
	BNE	ERROR
	MOV	SP,SAVSP
	MOV	#12345,R0
	MOV	#54321,R1
	.WORD	0
	CMP	R0,#12345
	BNE	ERROR
	CMP	R1,#54321
	BNE	ERROR
	CMP	SP,SAVSP
	BNE	ERROR
	.WORD	170000
	CMP	R0,#12345
	BNE	ERROR
	CMP	R1,#54321
	BNE	ERROR
	CMP	SP,SAVSP
	BNE	ERROR
	.PRINT	#GOOD
	.EXIT
ERROR:	.PRINT	#BAD
	.EXIT
SAVSP:	.WORD	0
GOOD:	.ASCIZ	/!UJCHEK-I-HALT FP11 START PASS/
BAD:	.ASCIZ	/?UJCHEK-E-Context mismatch/
	.EVEN
	.END	START
