	.BYTE	006,111,111,051,036	; 9
	.BYTE	000,066,066,000,000	; :
	.BYTE	000,126,066,000,000	; ;
	.BYTE	000,010,024,042,101	; <
	.BYTE	024,024,024,024,024	; =
	.BYTE	101,042,024,010,000	; >
	.BYTE	002,001,121,011,006	; ?
	.BYTE	062,111,171,101,076	; @
	.BYTE	176,021,021,021,176	; A
	.BYTE	177,111,111,111,066	; B
	.BYTE	076,101,101,101,042	; C
	.BYTE	177,101,101,042,034	; D
	.BYTE	177,111,111,111,101	; E
	.BYTE	177,011,011,001,001	; F
	.BYTE	076,101,101,121,062	; G
	.BYTE	177,010,010,010,177	; H
	.BYTE	000,101,177,101,000	; I
	.BYTE	040,100,101,077,001	; J
