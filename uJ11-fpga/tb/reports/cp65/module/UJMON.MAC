	.TITLE UJODT
	.IDENT /01.00/
; CP64 software debugger. All addresses/numbers are octal unless dotted.
; Absolute HALT-FRAM module, loaded with the unchanged ABI2 UJLOAD.
	.ASECT
	.=10000
ODT:	JMP @#ENTER
ACTV:	JMP @#ENABLE
SIGN:	.WORD 125064,1
	.MACRO JNE DST,?OK
	BEQ OK
	JMP DST
OK:
	.ENDM
	.MACRO JEQ DST,?OK
	BNE OK
	JMP DST
OK:
	.ENDM
	.MACRO JCS DST,?OK
	BCC OK
	JMP DST
OK:
	.ENDM
	.MACRO JCC DST,?OK
	BCS OK
	JMP DST
OK:
	.ENDM
	.MACRO JHI DST,?OK
	BLOS OK
	JMP DST
OK:
	.ENDM
	.MACRO JLO DST,?OK
	BHIS OK
	JMP DST
OK:
	.ENDM
CPC=100
CPSW=102
RCSR=177560
RBUF=177562
TCSR=177564
TBUF=177566
PANEL=166000
; Invoked ONLY after UJON has checked code checksum, wrapper and common ABI.
; No stack and no calls, so the caller's RT-11 context cannot become ODT's.
ENABLE:	.WORD 43
	BIT #400,R0
	BEQ ENFAIL
	BIT #1,R0
	BEQ ENFAIL
	BIC #177774,R0
	.WORD 42
	MOV #ENTER,@#110
	CMP @#110,#ENTER
	BNE ENFAIL
	MOV #340,@#112
	CMP @#112,#340
	BNE ENFAIL
	BIS #4,R0
	.WORD 42
	CLR R2
	BR ENEXIT
ENFAIL:	MOV #1,R2
ENEXIT:	MOV #312,@#4
	.WORD 10
; Both the normal HALT wrapper and the dedicated debug vector enter here.
ENTER:	MOV R0,REGS
	MOV R1,REGS+2
	MOV R2,REGS+4
	MOV R3,REGS+6
	MOV R4,REGS+10
	MOV R5,REGS+12
	MOV SP,REGS+14
	MOV #STKTOP,SP
	MOV @#CPC,REGS+16
	MOV @#CPSW,REGS+20
	.WORD 43
	MOV R0,META
	BIC #10,R0
	.WORD 42
	MOV #ODERR,@#4
	CLR RECOV
	CLR OUTMOD
	TST OVACT
	BNE ENSKIP
	CLR RHEAD
	CLR RTAIL
	CLR RCOUNT
	CLR RXBAD
	CLR RXDROP
	CLR LINLEN
	CLR BADLIN
ENSKIP:
	MOV @#RCSR,SAVRX
	MOV @#TCSR,SAVTX
	BIC #100,@#RCSR
	CLR @#TCSR
	TST RADIX
	BNE 1$
	MOV #10,RADIX
1$:	TST OVACT
	JEQ ENFULL
	JSR PC,OVBACK
ENFULL:	JSR PC,PNTAKE
	TST OVWHY
	BEQ ENMSG
	MOV OVWHY,R0
	JSR PC,TXSTR
	JSR PC,NEWLIN
	CLR OVWHY
ENMSG:
	JSR PC,BEGIN
	MOV #STOPMSG,R0
	JSR PC,STR
	BIT #20,META
	BEQ 2$
	MOV #DEBUGM,R0
	BR 3$
2$:	MOV #HALTM,R0
3$:	JSR PC,STR
	BIT #40,META
	BEQ 4$
	MOV #WAITM,R0
	JSR PC,STR
4$:	JSR PC,OUTPUT
	JSR PC,ALLREG
	MOV REGS+16,DADDR
	JSR PC,DISONE
	MOV #2,VIEW
	TST STEPS
	BEQ PROMPT
	DEC STEPS
	BEQ PROMPT
	TST RCOUNT
	BNE PROMPT
	BIT #40,META
	BNE PROMPT
	JMP STEPIT
PROMPT:	MOV #STKTOP,SP
	CLR STEPS
	MOV #PROM,R0
	JSR PC,TXSTR
MAIN:	JSR PC,DBPOLL
	JSR PC,ASCAN
	JSR PC,PNPOLL
	JSR PC,RXPOLL
	JSR PC,RXGET
	BCS MAIN
	CMP R0,#33
	BEQ CANCEL
	CMP R0,#3
	BEQ CANCEL
	CMP R0,#12
	BEQ MAIN
	CMP R0,#15
	BEQ LINEOK
	CMP R0,#10
	BEQ BACKSP
	CMP R0,#177
	BEQ BACKSP
	CMP R0,#40
	BLO MAIN
	CMP R0,#176
	BHI MAIN
	CMP LINLEN,#62.
	BHIS TOOLNG
	MOV #LINE,R1
	ADD LINLEN,R1
	MOVB R0,(R1)
	INC LINLEN
	JSR PC,TXCHR
	BR MAIN
TOOLNG:	MOV #1,BADLIN
	BR MAIN
BACKSP:	TST LINLEN
	BEQ MAIN
	DEC LINLEN
	MOV #ERASE,R0
	JSR PC,TXSTR
	BR MAIN
CANCEL:	TST PANEDIT
	BEQ 1$
	MOV #ASMBUF,R0
	MOV #RESULT,R1
2$:	MOVB (R0)+,(R1)+
	BNE 2$
1$:	CLR PANEDIT
	CLR OVACT
	CLR RCOUNT
	CLR RHEAD
	CLR RTAIL
	CLR RXDROP
	CLR LINLEN
	CLR BADLIN
	CLR RXBAD
	JSR PC,PNEW
	JSR PC,NEWLIN
	JMP PROMPT
LINEOK:	JSR PC,NEWLIN
	TST PANEDIT
	BNE BUSY
	MOV #LINE,R1
	ADD LINLEN,R1
	CLRB (R1)
	CLR LINLEN
	TST RXBAD
	BNE LINERR
	TST BADLIN
	BNE LINERR
	JSR PC,PARSE
	JCS SYNTAX
	JMP COMMAND
BUSY:	CLR LINLEN
	MOV #BUSYM,R0
	JMP ERROR
LINERR:	CLR RXBAD
	CLR BADLIN
	MOV #OVERM,R0
	BR ERROR
SYNTAX:	MOV #SYNTM,R0
ERROR:	JSR PC,BEGIN
	JSR PC,STR
	JSR PC,OUTPUT
	JMP PROMPT
; A complete command is parsed before any side effect. Up to three numbers.
PARSE:	MOV #LINE,R1
	JSR PC,SKIP
	MOVB (R1)+,R0
	BEQ PFAIL
	JSR PC,UPCASE
	MOV R0,CMD
	CLR CMDORG
	CLR NARG
	MOV #ARGS,R3
PNEXT:	JSR PC,SKIP
	TSTB (R1)
	BEQ PDONE
	CMP NARG,#4
	BHIS PFAIL
	CLR R2
	CLR R5
PDIG:	MOVB (R1),R0
	BEQ PEND
	CMP R0,#40
	BEQ PEND
	JSR PC,UPCASE
	SUB #60,R0
	BCS PFAIL
	CMP R0,#11
	BLOS 1$
	SUB #7,R0
	CMP R0,#12
	BLO PFAIL
1$:	CMP R0,RADIX
	BHIS PFAIL
	MOV R0,-(SP)
	MOV R2,R0
	MOV RADIX,R4
	CMP R4,#10
	BEQ 2$
	ASL R0
	BCS PPOP
2$:	ASL R0
	BCS PPOP
	ASL R0
	BCS PPOP
	ASL R0
	BCS PPOP
	ADD (SP)+,R0
	BCS PFAIL
	MOV R0,R2
	INC R1
	INC R5
	BR PDIG
PPOP:	TST (SP)+
PFAIL:	SEC
	RTS PC
PEND:	TST R5
	BEQ PFAIL
	MOV R2,(R3)+
	INC NARG
	BR PNEXT
PDONE:	CLC
	RTS PC
SKIP:	CMPB (R1),#40
	BEQ 1$
	CMPB (R1),#11
	BNE 2$
1$:	INC R1
	BR SKIP
2$:	RTS PC
UPCASE:	CMP R0,#141
	BLO 1$
	CMP R0,#172
	BHI 1$
	SUB #40,R0
1$:	RTS PC
COMMAND:	JSR PC,PNECHO
	MOV #CMDS,R1
1$:	MOV (R1)+,R0
	BEQ SYNTAX
	CMP R0,CMD
	BEQ 2$
	ADD #2,R1
	BR 1$
2$:	JMP @(R1)
NOARGS:	TST NARG
	BEQ 1$
	JMP SYNTAX
1$:	RTS PC
HELP:	JSR PC,NOARGS
	MOV #HELPM,R0
	JSR PC,TXSTR
	JMP PROMPT
OCTAL:	JSR PC,NOARGS
	MOV #10,RADIX
	JMP REGSIN
HEX:	JSR PC,NOARGS
	MOV #20,RADIX
	JMP REGSIN
REGCMD:	CMP NARG,#2
	JHI SYNTAX
	TST NARG
	BEQ REGSIN
	CMP ARGS,#10
	JHI SYNTAX
	MOV ARGS,RSEL
	CLR VIEW
	MOV ARGS,R2
	ASL R2
	CMP NARG,#2
	BNE 2$
	MOV REGS(R2),OLDVAL
	MOV ARGS+2,REGS(R2)
	CMP R2,#16
	BNE 1$
	JSR PC,CLEARW
1$:	JSR PC,BEGIN
	MOV #OLDM,R0
	JSR PC,STR
	MOV OLDVAL,R0
	JSR PC,NUM
	MOV #NEWM,R0
	JSR PC,STR
	MOV REGS(R2),R0
	JSR PC,NUM
	JSR PC,OUTPUT
2$:	JSR PC,ONEREG
	JMP PROMPT
REGSIN:	CLR VIEW
	CLR RSEL
	JSR PC,ALLREG
	CLR R2
	BIS #2,OUTMOD
	JSR PC,ONEREG
	BIC #2,OUTMOD
	JMP PROMPT
ALLREG:	MOV OUTMOD,-(SP)
	BIS #1,OUTMOD
	CLR R2
1$:	JSR PC,ONEREG
	ADD #2,R2
	CMP R2,#22
	BLO 1$
	MOV (SP)+,OUTMOD
	RTS PC
ONEREG:	JSR PC,BEGIN
	CMP R2,#20
	BEQ 1$
	MOV #122,R0
	JSR PC,CHAR
	MOV R2,R0
	ASR R0
	ADD #60,R0
	JSR PC,CHAR
	BR 2$
1$:	MOV #PSWM,R0
	JSR PC,STR
2$:	MOV #75,R0
	JSR PC,CHAR
	MOV REGS(R2),R0
	JSR PC,NUM
	CMP R2,#20
	BNE 5$
	MOV #FLAGM,R0
	JSR PC,STR
	MOV #30,R3
3$:	MOV REGS+20,R0
	ASH #-4,R0
	BIC #177776,R0
	ADD #60,R0
	JSR PC,CHAR
	MOV #IPLM,R0
	JSR PC,STR
	MOV REGS+20,R0
	ASH #-5,R0
	BIC #177770,R0
	ADD #60,R0
	JSR PC,CHAR
	MOV #NZVCM,R0
	JSR PC,STR
	MOV #10,R3
4$:	MOV #60,R0
	BIT R3,REGS+20
	BEQ 6$
	INC R0
6$:	JSR PC,CHAR
	ASR R3
	BNE 4$
5$:	JSR PC,OUTPUT
	RTS PC
; Normal memory views never touch the I/O page. MFUS/MTUS address USER RAM.
MEMCMD:	CLR BYTEM
	BR MEMGO
BYTCMD:	MOV #1,BYTEM
MEMGO:	JSR PC,RANGE
	JCS SYNTAX
	MOV #1,VIEW
	MOV BYTEM,VBYTE
MEMLOP:	MOV ADDR,MSEL
	JSR PC,READAT
	JCS MEMERR
	MOV R0,VALUE
	JSR PC,BEGIN
	MOV ADDR,R0
	JSR PC,NUM
	MOV #COLON,R0
	JSR PC,STR
	MOV VALUE,R0
	JSR PC,NUM
	JSR PC,OUTPUT
	JSR PC,PABORT
	JSR PC,NEXTAT
	SOB R2,MEMLOP
	JMP PROMPT
RANGE:	CMP NARG,#1
	BLO 9$
	CMP NARG,#2
	BHI 9$
	MOV ARGS,ADDR
	MOV #1,R2
	CMP NARG,#1
	BEQ 1$
	MOV ARGS+2,R2
1$:	TST R2
	BEQ 9$
	CMP R2,#20
	BHI 9$
	MOV ADDR,R0
	TST BYTEM
	BNE 2$
	BIT #1,R0
	BNE 9$
2$:	MOV R2,R1
	TST BYTEM
	BNE 3$
	ASL R1
3$:	ADD R1,R0
	BCS 9$
	CMP R0,#160000
	BHI 9$
	CLC
	RTS PC
9$:	SEC
	RTS PC
NEXTAT:	INC ADDR
	TST BYTEM
	BNE 1$
	INC ADDR
1$:	RTS PC
WRDCMD:	CLR BYTEM
	BR WRITE
BYWCMD:	MOV #1,BYTEM
WRITE:	CMP NARG,#2
	JNE SYNTAX
	MOV ARGS+2,VALUE
	TST BYTEM
	BEQ 1$
	CMP VALUE,#377
	JHI SYNTAX
1$:	MOV #1,NARG
	JSR PC,RANGE
	JCS SYNTAX
	JSR PC,READAT
	JCS MEMERR
	MOV R0,OLDVAL
	MOV #1,VIEW
	MOV ADDR,MSEL
	MOV BYTEM,VBYTE
	JSR PC,WRITEA
	JCS MEMERR
	JSR PC,READAT
	JCS MEMERR
	CMP R0,VALUE
	JNE MEMERR
	JSR PC,BEGIN
	MOV ADDR,R0
	JSR PC,NUM
	MOV #COLON,R0
	JSR PC,STR
	MOV OLDVAL,R0
	JSR PC,NUM
	MOV #NEWM,R0
	JSR PC,STR
	MOV VALUE,R0
	JSR PC,NUM
	JSR PC,OUTPUT
	JMP PROMPT
; Read one word/byte; preserve all caller registers other than R0.
READAT:	MOV R5,-(SP)
	MOV ADDR,R5
	BIC #1,R5
	MOV #RDFAIL,RECOV
	.WORD 21
	CLR RECOV
	TST BYTEM
	BEQ 2$
	BIT #1,ADDR
	BEQ 1$
	SWAB R0
1$:	BIC #177400,R0
2$:	MOV (SP)+,R5
	CLC
	RTS PC
RDFAIL:	CLR RECOV
	MOV (SP)+,R5
	SEC
	RTS PC
WRITEA:	MOV R5,-(SP)
	MOV R1,-(SP)
	MOV ADDR,R5
	BIC #1,R5
	MOV #WRFAIL,RECOV
	TST BYTEM
	BEQ 2$
	.WORD 21
	SUB #2,R5
	MOV VALUE,R1
	BIT #1,ADDR
	BNE 1$
	BIC #377,R0
	BIS R1,R0
	BR 3$
1$:	SWAB R1
	BIC #177400,R0
	BIS R1,R0
	BR 3$
2$:	MOV VALUE,R0
3$:	ADD #2,R5
	.WORD 31
	CLR RECOV
	MOV (SP)+,R1
	MOV (SP)+,R5
	CLC
	RTS PC
WRFAIL:	CLR RECOV
	MOV (SP)+,R1
	MOV (SP)+,R5
	SEC
	RTS PC
MEMERR:	MOV #MEMM,R0
	JMP ERROR
ODERR:	TST RECOV
	BEQ 1$
	JMP @RECOV
1$:	MOV #STKTOP,SP
	CLR STEPS
	CLR OVACT
	CLR HHOLD
	CLR OUTMOD
	MOV #FAULTM,R0
	JMP ERROR
DISCMD:	MOV #2,VIEW
	CMP NARG,#2
	JHI SYNTAX
	MOV #1,DCOUNT
	TST NARG
	BEQ 1$
	JSR PC,HINIT
	MOV ARGS,DADDR
	CMP NARG,#2
	BNE 1$
	MOV ARGS+2,DCOUNT
1$:	TST DCOUNT
	JEQ SYNTAX
	CMP DCOUNT,#20
	JHI SYNTAX
	BIT #1,DADDR
	JNE SYNTAX
	CMP DADDR,#160000
	BHIS MEMERR
2$:	JSR PC,DISONE
	JSR PC,PABORT
	TST DERROR
	BNE 3$
	MOV DNEXT,DADDR
	DEC DCOUNT
	BNE 2$
3$:	JMP PROMPT
STEPC:	CMP NARG,#1
	JHI SYNTAX
	MOV #1,STEPS
	TST NARG
	BEQ STEPIT
	MOV ARGS,STEPS
	TST STEPS
	JEQ SYNTAX
	CMP STEPS,#100
	JHI SYNTAX
STEPIT:	MOV #14,EXOP
	MOV #STEPM,R0
	BR LEAVE
CONT:	JSR PC,NOARGS
	CLR OVACT
	MOV #10,EXOP
	MOV #CONTM,R0
	BR LEAVE
GO:	CMP NARG,#1
	JNE SYNTAX
	BIT #1,ARGS
	JNE SYNTAX
	CMP ARGS,#160000
	BLO 8$
	JMP SYNTAX
8$:
	MOV ARGS,REGS+16
	JSR PC,CLEARW
	MOV #10,EXOP
	MOV #GOM,R0
LEAVE:	JSR PC,BEGIN
	JSR PC,STR
	JSR PC,OUTPUT
	JSR PC,TXWAIT
; TX ready means the holding register is empty, not that the shifter is idle.
; 4096 SOB iterations take at least 4096 clocks, > 10*257 UART clocks.
	MOV #10000,R1
1$:	SOB R1,1$
	JSR PC,PNBACK
RESTIO:
	MOV SAVRX,R0
	BIC #177677,R0
	MOV R0,@#RCSR
	MOV SAVTX,R0
	BIC #177676,R0
	MOV R0,@#TCSR
	MOV REGS+16,@#CPC
	MOV REGS+20,@#CPSW
	MOV META,R0
	BIC #10,R0
	.WORD 42
	MOV #312,@#4
	CMP EXOP,#14
	BEQ RESTEP
RESTRT:	MOV REGS,R0
	MOV REGS+2,R1
	MOV REGS+4,R2
	MOV REGS+6,R3
	MOV REGS+10,R4
	MOV REGS+12,R5
	MOV REGS+14,SP
	.WORD 10
RESTEP:	MOV REGS,R0
	MOV REGS+2,R1
	MOV REGS+4,R2
	MOV REGS+6,R3
	MOV REGS+10,R4
	MOV REGS+12,R5
	MOV REGS+14,SP
	.WORD 14
CLEARW:	BIC #140,META
	RTS PC
; Bounded rendering: all output goes through the same cached result line.
BEGIN:	MOV #RESULT,R4
	RTS PC
CHAR:	CMP R4,#RESULT+190.
	BHIS 1$
	MOVB R0,(R4)+
1$:	CLRB (R4)
	RTS PC
STR:	MOV R0,-(SP)
	MOV R1,-(SP)
	MOV R0,R1
1$:	MOVB (R1)+,R0
	BEQ 2$
	JSR PC,CHAR
	BR 1$
2$:	MOV (SP)+,R1
	MOV (SP)+,R0
	RTS PC
NUM:	MOV R0,-(SP)
	MOV R1,-(SP)
	MOV R2,-(SP)
	MOV R3,-(SP)
	MOV #NUMBUF+6,R1
	MOV #6,R2
	MOV #-3,R3
	CMP RADIX,#10
	BEQ 1$
	MOV #4,R2
	MOV #-4,R3
1$:	MOV R0,-(SP)
	BIC #177760,R0
	CMP RADIX,#10
	BNE 2$
	BIC #10,R0
2$:	MOVB DIGITS(R0),-(R1)
	MOV (SP)+,R0
	CLC
	ROR R0
	CLC
	ROR R0
	CLC
	ROR R0
	CMP R3,#-3
	BEQ 3$
	CLC
	ROR R0
3$:	SOB R2,1$
	MOV R1,R0
	JSR PC,STR
	MOV (SP)+,R3
	MOV (SP)+,R2
	MOV (SP)+,R1
	MOV (SP)+,R0
	RTS PC
OUTPUT:	MOV R0,-(SP)
	BIT #2,OUTMOD
	BNE 1$
	MOV #RESULT,R0
	JSR PC,TXSTR
	JSR PC,NEWLIN
1$:	BIT #1,OUTMOD
	BNE 2$
	JSR PC,PNEW
2$:
	MOV (SP)+,R0
	RTS PC
NEWLIN:	MOV R0,-(SP)
	MOV #15,R0
	JSR PC,TXCHR
	MOV #12,R0
	JSR PC,TXCHR
	MOV (SP)+,R0
	RTS PC
TXSTR:	MOV R0,-(SP)
	MOV R1,-(SP)
	MOV R0,R1
1$:	MOVB (R1)+,R0
	BEQ 2$
	JSR PC,TXCHR
	BR 1$
2$:	MOV (SP)+,R1
	MOV (SP)+,R0
	RTS PC
TXCHR:	JSR PC,TXWAIT
	MOVB R0,@#TBUF
	RTS PC
TXWAIT:	JSR PC,RXPOLL
	TSTB @#TCSR
	BPL TXWAIT
	RTS PC
; Polling RX is serviced during printing; IRQs belong to the stopped guest.
RXPOLL:	TSTB @#RCSR
	BPL 9$
	MOV R0,-(SP)
	MOV R1,-(SP)
	MOV @#RCSR,R1
	MOV @#RBUF,R0
	BIT #170000,R1
	BNE RXLOSS
	TST RXDROP
	BEQ 1$
	CMP R0,#15
	BNE RXDONE
	CLR RXDROP
1$:	CMP RCOUNT,#64.
	BHIS RXLOSS
	MOV RTAIL,R1
	MOVB R0,RING(R1)
	INC RTAIL
	BIC #177700,RTAIL
	INC RCOUNT
	BR RXDONE
9$:	RTS PC
; Lose the whole queued stream on overrun. Wait for a NEW clean CR before
; accepting commands; an older queued CR cannot validate a truncated suffix.
RXLOSS:	MOV #1,RXBAD
	MOV #1,BADLIN
	MOV #1,RXDROP
	CLR LINLEN
	CLR RHEAD
	CLR RTAIL
	CLR RCOUNT
RXDONE:	MOV (SP)+,R1
	MOV (SP)+,R0
	RTS PC
RXGET:	TST RCOUNT
	BEQ 1$
	MOV RHEAD,R1
	MOVB RING(R1),R0
	BIC #177400,R0
	INC RHEAD
	BIC #177700,RHEAD
	DEC RCOUNT
	CLC
	RTS PC
1$:	SEC
	RTS PC
DBPOLL:	.WORD 43
	BIT #10,R0
	BEQ 1$
	MOV META,R0
	BIC #10,R0
	.WORD 42
	JMP CANCEL
1$:	RTS PC
PABORT:	MOV R0,-(SP)
	MOV R1,-(SP)
	JSR PC,RXPOLL
	TST RCOUNT
	BEQ 2$
	MOV RHEAD,R1
	CMPB RING(R1),#3
	BEQ 1$
	CMPB RING(R1),#33
	BNE 2$
1$:	JSR PC,RXGET
	JMP CANCEL
2$:	MOV (SP)+,R1
	MOV (SP)+,R0
	RTS PC
CMDS:	.WORD 'H,HELP,'R,REGCMD,'M,MEMCMD,'B,BYTCMD,'W,WRDCMD
	.WORD 'V,BYWCMD,'D,DISCMD,'S,STEPC,'C,CONT,'G,GO
	.WORD 'O,OCTAL,'X,HEX,'K,KEYCMD,'<,SCLEFT,'>,SCRGHT
	.WORD 'A,AUTOC,'L,DPREV,'N,DNXCMD,'T,OVCMD,0
DIGITS:	.ASCIZ /0123456789ABCDEF/
STOPMSG:	.ASCIZ /UJ11 ODT CP65: /
DEBUGM:	.ASCIZ /DEBUG/
HALTM:	.ASCIZ /HALT (PC IS AFTER HALT)/
WAITM:	.ASCIZ / WAIT/
PSWM:	.ASCIZ /PSW/
IPLM:	.ASCIZ / IPL=/
FLAGM:	.ASCIZ / T=/
NZVCM:	.ASCIZ / NZVC=/
COLON:	.ASCIZ /: /
OLDM:	.ASCIZ /OLD=/
NEWM:	.ASCIZ / -> /
PROM:	.ASCIZ /ODT> /
ERASE:	.BYTE 10,40,10,0
BUSYM:	.ASCIZ /?PANEL EDIT ACTIVE; ESC CANCELS/
SYNTM:	.ASCIZ /?SYNTAX OR RANGE; H FOR HELP/
OVERM:	.ASCIZ /?INPUT OVERFLOW; COMMAND DISCARDED/
MEMM:	.ASCIZ /?MEMORY ACCESS OR READBACK FAILED/
FAULTM:	.ASCIZ /?MONITOR FAULT; GUEST CONTEXT RETAINED/
STEPM:	.ASCIZ /STEP/
CONTM:	.ASCIZ /CONTINUE/
GOM:	.ASCIZ /GO/
HELPM:	.ASCII /R [0..7|8 [VALUE]]  REGISTERS; 8=PSW (OCT:10)/
	.BYTE 15,12
	.ASCII /M|B ADDR [COUNT]  WORD|BYTE READ (RAM ONLY)/
	.BYTE 15,12
	.ASCII /W|V ADDR VALUE  WORD|BYTE WRITE WITH READBACK/
	.BYTE 15,12
	.ASCII /D [ADDR [COUNT]]  DISASSEMBLE; S [COUNT] STEP/
	.BYTE 15,12
	.ASCII /C CONTINUE; G ADDR GO; O OCTAL; X HEX; ESC CANCEL/
	.BYTE 15,12
	.ASCII |< > SCROLL HDSP; K MEM PREV NEXT ENTER (CODES OCT 20..23)|
	.BYTE 15,12
	.ASCII /A [0|1] AUTO SCROLL; L PREVIOUS; N NEXT DISASSEMBLY/
	.BYTE 15,12
	.ASCII /T [LIMIT] STEP OVER JSR (SLOW STEP LOOP; IRQ DEFERRED)/
	.BYTE 15,12
	.ASCII /KEYS 8 STEP,9 OVER,A REGS,B MEM,C DISASM,D GO,E RUN,F OCT-HEX/
	.BYTE 15,12,0
	.EVEN
; DISASM.MAC and optional panel driver are inserted here by the builder.
; Software PDP-11 disassembly. Table is generated from explicit ISA encodings.
; No effective-address dereference: only opcode and up to two extension words.
DISONE:	MOV R0,-(SP)
	MOV R1,-(SP)
	MOV R2,-(SP)
	MOV R3,-(SP)
	MOV R5,-(SP)
	MOV DADDR,DCUR
	JSR PC,HTRACK
	CLR DERROR
	CLR RAWCNT
	MOV DADDR,DNEXT
	JSR PC,BEGIN
	JSR PC,DGET
	BCS DUNREAD
	MOV R0,DINST
	MOV #DTAB,R5
DFIND:	MOV (R5)+,R1
	CMP R1,#177777
	BEQ DUNKNOWN
	MOV DINST,R0
	BIC R1,R0
	CMP R0,(R5)+
	BEQ DFOUND
	ADD #4,R5
	BR DFIND
DFOUND:	MOV (R5)+,R2
	MOV (R5),R0
	JSR PC,STR
	TST R2
	BEQ DFIN
	MOV #40,R0
	JSR PC,CHAR
	ASL R2
	JSR PC,@DFMTS(R2)
	BR DFIN
DUNKNOWN:	MOV #DWM,R0
	JSR PC,STR
	MOV DINST,R0
	JSR PC,NUM
	BR DFIN
DUNREAD:	MOV #DUNM,R0
	JSR PC,STR
DFIN:	TST DERROR
	BEQ DFREADY
	TST RAWCNT
	BEQ DFREADY
	JSR PC,BEGIN
	MOV #DWM,R0
	JSR PC,STR
	MOV DINST,R0
	JSR PC,NUM
DFREADY:	MOV #RESULT,R0
	MOV #ASMBUF,R1
1$:	MOVB (R0)+,(R1)+
	BNE 1$
	JSR PC,BEGIN
	MOV DADDR,R0
	JSR PC,NUM
	MOV #COLON,R0
	JSR PC,STR
	CLR R2
2$:	CMP R2,RAWCNT
	BHIS 3$
	MOV RAW(R2),R0
	JSR PC,NUM
	MOV #40,R0
	JSR PC,CHAR
	ADD #2,R2
	BR 2$
3$:	MOV #40,R0
	JSR PC,CHAR
	MOV #ASMBUF,R0
	JSR PC,STR
	TST DERROR
	BEQ 4$
	MOV #DEXM,R0
	JSR PC,STR
4$:	JSR PC,OUTPUT
	MOV (SP)+,R5
	MOV (SP)+,R3
	MOV (SP)+,R2
	MOV (SP)+,R1
	MOV (SP)+,R0
	RTS PC
DGET:	CMP DNEXT,#160000
	BHIS 9$
	BIT #1,DNEXT
	BNE 9$
	MOV DNEXT,ADDR
	CLR BYTEM
	JSR PC,READAT
	BCS 9$
	MOV R1,-(SP)
	MOV RAWCNT,R1
	CMP R1,#6
	BHIS 8$
	MOV R0,RAW(R1)
	ADD #2,RAWCNT
8$:	MOV (SP)+,R1
	ADD #2,DNEXT
	CLC
	RTS PC
9$:	INC DERROR
	CLR R0
	SEC
	RTS PC
DFMTS:	.WORD DNOT,DSINGLE,DDOUBL,DBR,DRONLY,DJSR,DEIS,DSOB,DIM6,DIM8,DIPL
DNOT:	RTS PC
DSINGLE:	MOV DINST,R0
	BIC #177700,R0
	BR DOPER
DDOUBL:	MOV DINST,R0
	ASH #-6,R0
	BIC #177700,R0
	JSR PC,DOPER
	MOV #54,R0
	JSR PC,CHAR
	MOV DINST,R0
	BIC #177700,R0
	BR DOPER
DBR:	MOV DINST,R0
	MOVB R0,R0
	ASL R0
	ADD DNEXT,R0
	JSR PC,NUM
	RTS PC
DRONLY:	MOV DINST,R3
	BIC #177770,R3
	JMP DREG
DJSR:	JSR PC,DRHIGH
	MOV #54,R0
	JSR PC,CHAR
	JMP DSINGLE
DEIS:	JSR PC,DSINGLE
	MOV #54,R0
	JSR PC,CHAR
DRHIGH:	MOV DINST,R3
	ASH #-6,R3
	BIC #177770,R3
	JMP DREG
DSOB:	JSR PC,DRHIGH
	MOV #54,R0
	JSR PC,CHAR
	MOV DINST,R0
	BIC #177700,R0
	ASL R0
	NEG R0
	ADD DNEXT,R0
	JSR PC,NUM
	RTS PC
DIM6:	MOV DINST,R0
	BIC #177700,R0
	BR DNUM
DIM8:	MOV DINST,R0
	BIC #177400,R0
	BR DNUM
DIPL:	MOV DINST,R0
	BIC #177770,R0
DNUM:	JSR PC,NUM
	RTS PC
DOPER:	MOV R0,R3
	BIC #177770,R3
	MOV R0,R2
	ASH #-3,R2
	BIC #177770,R2
	TST R2
	BEQ DREG
	CMP R2,#1
	BEQ DIND
	CMP R2,#4
	BLO DAUTO
	CMP R2,#6
	BHIS DIDX
	CMP R2,#5
	BNE 1$
	MOV #100,R0
	JSR PC,CHAR
1$:	MOV #55,R0
	JSR PC,CHAR
	BR DIND
DAUTO:	CMP R2,#3
	BNE 1$
	MOV #100,R0
	JSR PC,CHAR
1$:	CMP R3,#7
	BEQ DIMM
	JSR PC,DIND
	MOV #53,R0
	JSR PC,CHAR
	RTS PC
DIMM:	MOV #43,R0
	JSR PC,CHAR
	JSR PC,DGET
	JSR PC,NUM
	RTS PC
DIDX:	CMP R2,#7
	BNE 1$
	MOV #100,R0
	JSR PC,CHAR
1$:	JSR PC,DGET
	CMP R3,#7
	BNE 2$
	ADD DNEXT,R0
	JSR PC,NUM
	RTS PC
2$:	JSR PC,NUM
DIND:	MOV #50,R0
	JSR PC,CHAR
	JSR PC,DREG
	MOV #51,R0
	JSR PC,CHAR
	RTS PC
DREG:	MOV #122,R0
	JSR PC,CHAR
	MOV R3,R0
	ADD #60,R0
	JSR PC,CHAR
	RTS PC
DWM:	.ASCIZ /.WORD /
DUNM:	.ASCIZ /?UNREADABLE/
DEXM:	.ASCIZ / [EXTENSION UNAVAILABLE]/
	.EVEN
; HALT panel frontend. Numeric key codes use the proven PNLDRV map;
; default function codes 20/21/22/23 are configurable with K on UART.
PNTAKE:	MOVB @#PANEL+1,SAVPN
	CLR PNEN
	TSTB SAVPN
	BMI 1$
	MOV #1,PNEN
; Keep press/debounce state across STEP entries. A still-held step key must
; be released before it can issue another command; DATA supplies cold state.
	JSR PC,PNINIT
	MOV #1,R0
	JSR PC,PNRGB
1$:	RTS PC
PNBACK:	TST PNEN
	BEQ 1$
	MOVB SAVPN,@#PANEL+1
1$:	RTS PC
PNDRAW:	TST PNEN
	BEQ 9$
	MOV R0,-(SP)
	MOV R1,-(SP)
	MOV R2,-(SP)
	MOV #RESULT,R1
	ADD SCROLL,R1
	MOV #SCREEN,R2
	MOV #16.,R0
1$:	TSTB (R1)
	BEQ 2$
	MOVB (R1)+,(R2)+
	SOB R0,1$
	BR 4$
2$:	MOVB #40,(R2)+
	SOB R0,2$
4$:	MOV #SCREEN,R0
	JSR PC,PNDISP
	MOV (SP)+,R2
	MOV (SP)+,R1
	MOV (SP)+,R0
9$:	RTS PC
; Two complete agreeing scans for both press and release; no key chords.
PNPOLL:	TST PNEN
	BEQ 9$
	JSR PC,PNKEY
	CMP R0,#-2
	BEQ 9$
	CMP R0,KCAND
	BEQ 1$
	MOV R0,KCAND
	CLR KCOUNT
	RTS PC
1$:	CMP KCOUNT,#2
	BHIS 9$
	INC KCOUNT
	CMP KCOUNT,#2
	BLO 9$
	CMP R0,KLAST
	BEQ 9$
	MOV R0,KLAST
	TST R0
	BMI 9$
	TST LINLEN
	BEQ 8$
	CMP R0,KEYS
	JNE 9$
	JMP CANCEL
8$:	JMP PNINPUT
9$:	RTS PC
PNINPUT:	CMP R0,KEYS
	JEQ PMEM
	TST PANEDIT
	JNE PEDIT
	CMP R0,KEYS+2
	JEQ PPREV
	CMP R0,KEYS+4
	JEQ PNEXTK
	CMP R0,KEYS+6
	JEQ PENTER
	CMP R0,#10
	BLO 9$
	CMP R0,#20
	BHIS 9$
	SUB #10,R0
	ASL R0
	JMP @HOTKEY(R0)
9$:
	RTS PC
PMEM:	CLR PANEDIT
	MOV #3,VIEW
	JMP PMENU
PPREV:	MOV #-1,R0
	BR PNAV
PNEXTK:	MOV #1,R0
PNAV:	CMP VIEW,#3
	BEQ 3$
	CMP VIEW,#2
	BNE 7$
	TST R0
	BPL 8$
	JMP PDISPR
8$:	JMP PDISNX
7$:
	TST VIEW
	BNE 2$
	ADD R0,RSEL
	BPL 1$
	MOV #10,RSEL
1$:	CMP RSEL,#11
	BLO PRSHOW
	CLR RSEL
	BR PRSHOW
2$:	TST VBYTE
	BNE 6$
	ASL R0
6$:	ADD R0,MSEL
	CMP MSEL,#160000
	BLO PMSHOW
	SUB R0,MSEL
	RTS PC
3$:	ADD R0,MENU
	BPL 4$
	MOV #7,MENU
4$:	CMP MENU,#10
	BLO PMENU
	CLR MENU
PMENU:	JSR PC,BEGIN
	MOV #MENUM,R0
	JSR PC,STR
	MOV MENU,R1
	ASL R1
	MOV MNAMES(R1),R0
	JSR PC,STR
	CLR SCROLL
	JSR PC,OUTPUT
	JMP PROMPT
PSCROL:	TST R0
	BMI 1$
; A short new result may leave old bytes beyond its terminator. Check every
; byte through the proposed window end, never probe beyond an earlier NUL.
	MOV #RESULT,R1
	MOV SCROLL,R2
	ADD #17.,R2
3$:	TSTB (R1)+
	BEQ 2$
	SOB R2,3$
	INC SCROLL
	BR 2$
1$:	TST SCROLL
	BEQ 2$
	DEC SCROLL
2$:	JSR PC,PNDRAW
	RTS PC
PENTER:	CMP VIEW,#3
	BEQ PACTION
	CMP VIEW,#2
	BNE 1$
	JMP PDISNX
1$:	MOV #1,PANEDIT
	BR PSTART
PACTION:	MOV MENU,R1
	ASL R1
	JMP @MACTS(R1)
PRSHOW:	CLR VIEW
	MOV RSEL,ARGS
	MOV #1,NARG
	MOV #'R,CMD
	JMP PCOM
PMSHOW:	MOV MSEL,ARGS
	MOV #1,NARG
	MOV #'M,CMD
	TST VBYTE
	BEQ PCOM
	MOV #'B,CMD
	JMP PCOM
PMADDR:	MOV #3,PANEDIT
	BR PSTART
PDADDR:	MOV #4,PANEDIT
	BR PSTART
PGADDR:	MOV #2,PANEDIT
; ASMBUF is idle while the numeric editor owns input. Preserve the previous
; visible result so ESC restores it instead of leaving a stale EDIT prompt.
PSTART:	MOV #RESULT,R0
	MOV #ASMBUF,R1
1$:	MOVB (R0)+,(R1)+
	BNE 1$
	CLR PVAL
	CLR PDIGS
	CLR SCROLL
	JMP PFORMAT
PSTEP:	CLR NARG
	MOV #'S,CMD
	JMP PCOM
PCONT:	CLR NARG
	MOV #'C,CMD
	JMP PCOM
PRADIX:	CLR NARG
	MOV #'O,CMD
	CMP RADIX,#10
	BNE PCOM
	MOV #'X,CMD
PCOM:	MOV #1,CMDORG
	JMP COMMAND
PEDIT:	CMP R0,KEYS+6
	JEQ PCONFM
	CMP R0,KEYS+2
	BEQ PBACK
	CMP R0,RADIX
	BHIS PNRET
	MOV PVAL,R1
	CMP RADIX,#10
	BEQ 1$
	ASL R1
	BCS PNRET
1$:	ASL R1
	BCS PNRET
	ASL R1
	BCS PNRET
	ASL R1
	BCS PNRET
	ADD R0,R1
	BCS PNRET
	MOV R1,PVAL
	INC PDIGS
	BR PFORMAT
PBACK:	TST PDIGS
	BEQ PNRET
	DEC PDIGS
	CLC
	ROR PVAL
	CLC
	ROR PVAL
	CLC
	ROR PVAL
	CMP RADIX,#10
	BEQ PFORMAT
	CLC
	ROR PVAL
PFORMAT:	JSR PC,BEGIN
	MOV #EDITM,R0
	JSR PC,STR
	MOV PVAL,R0
	JSR PC,NUM
	MOV #OCTM,R0
	CMP RADIX,#10
	BEQ 1$
	MOV #HEXM,R0
1$:	JSR PC,STR
	JSR PC,PNEW
9$:	RTS PC
PNRET:	RTS PC
PCONFM:	TST PDIGS
	BEQ 9$
	MOV #1,NARG
	MOV PVAL,ARGS
	CMP PANEDIT,#2
	BEQ 2$
	CMP PANEDIT,#3
	BEQ 3$
	CMP PANEDIT,#4
	BEQ 4$
	MOV #2,NARG
	MOV PVAL,ARGS+2
	TST VIEW
	BEQ 1$
	MOV MSEL,ARGS
	MOV #'W,CMD
	TST VBYTE
	BEQ 5$
	MOV #'V,CMD
	BR 5$
1$:	MOV RSEL,ARGS
	MOV #'R,CMD
	BR 5$
2$:	MOV #'G,CMD
	BR 5$
3$:	MOV #'M,CMD
	TST VBYTE
	BEQ 5$
	MOV #'B,CMD
	BR 5$
4$:	MOV #'D,CMD
5$:	CLR PANEDIT
	JMP PCOM
9$:	RTS PC
; UART equivalents for local navigation and function-key calibration.
SCLEFT:	JSR PC,NOARGS
	MOV #-1,R0
	JSR PC,PSCROL
	MOV #SCWAIT,SCTIME
	MOV #-1,SCDIR
	TST SCROLL
	BNE 1$
	NEG SCDIR
1$:
	JMP PROMPT
SCRGHT:	JSR PC,NOARGS
	MOV #1,R0
	JSR PC,PSCROL
	MOV #SCWAIT,SCTIME
	MOV #1,SCDIR
	CMP SCROLL,SCEND
	BLO 1$
	NEG SCDIR
1$:
	JMP PROMPT
KEYCMD:	CMP NARG,#4
	JNE SYNTAX
	CLR R2
1$:	MOV ARGS(R2),R0
	CMP R0,#20
	JLO SYNTAX
	CMP R0,#23
	JHI SYNTAX
	MOV R2,R3
2$:	TST R3
	BEQ 3$
	SUB #2,R3
	CMP R0,ARGS(R3)
	JEQ SYNTAX
	BR 2$
3$:	ADD #2,R2
	CMP R2,#10
	BLO 1$
	CLR R2
4$:	MOV ARGS(R2),KEYS(R2)
	ADD #2,R2
	CMP R2,#10
	BLO 4$
	MOV #KEYM,R0
	JMP ERROR
PNECHO:	TST CMDORG
	BEQ 9$
	CLR CMDORG
	JSR PC,BEGIN
	MOV #PNLM,R0
	JSR PC,STR
	MOV CMD,R0
	JSR PC,CHAR
	CLR R2
1$:	MOV R2,R1
	ASR R1
	CMP R1,NARG
	BHIS 2$
	MOV #40,R0
	JSR PC,CHAR
	MOV ARGS(R2),R0
	JSR PC,NUM
	ADD #2,R2
	BR 1$
2$:	JSR PC,OUTPUT
9$:	RTS PC
MENUM:	.ASCIZ /MENU /
EDITM:	.ASCIZ /EDIT /
OCTM:	.ASCIZ / O/
HEXM:	.ASCIZ / X/
PNLM:	.ASCIZ /[PANEL] /
KEYM:	.ASCIZ /FUNCTION KEYS SET: MEM PREV NEXT ENTER/
M0:	.ASCIZ /REGISTERS/
M1:	.ASCIZ /MEMORY ADDRESS/
M2:	.ASCIZ /DISASM ADDRESS/
M3:	.ASCIZ /STEP/
M4:	.ASCIZ /CONTINUE/
M5:	.ASCIZ /GO ADDRESS/
M6:	.ASCIZ |OCT/HEX|
	.EVEN
M7:	.ASCIZ |WORD/BYTE|
	.EVEN
MNAMES:	.WORD M0,M1,M2,M3,M4,M5,M6,M7
MACTS:	.WORD PRFIRST,PMADDR,PDADDR,PSTEP,PCONT,PGADDR,PRADIX,PTBYTE
PRFIRST:	CLR RSEL
	JMP PRSHOW
PDISPR:	MOV #'L,CMD
	BR PHOT
PDISNX:	MOV #'N,CMD
	BR PHOT
POVER:	MOV #'T,CMD
PHOT:	CLR NARG
	JMP PCOM
; Physical hex labels 8..F, only when no numeric editor owns input.
HOTKEY:	.WORD PSTEP,POVER,PRFIRST,PMADDR,PDADDR,PGADDR,PCONT,PRADIX
PTBYTE:	MOV #1,R0
	XOR R0,VBYTE
	TST VBYTE
	BNE 1$
	BIC #1,MSEL
1$:	JMP PMSHOW
; CP65: software-only display timing and known instruction boundaries.
; Delays count full idle panel scans; neither KW11 nor guest IRQ state changes.
SCSTEP=32.
SCWAIT=240.
PNEW:	MOV R0,-(SP)
	MOV R1,-(SP)
	CLR SCROLL
	MOV #1,SCDIR
	MOV #SCWAIT,SCTIME
	MOV #RESULT,R1
1$:	TSTB (R1)+
	BNE 1$
	SUB #RESULT+17.,R1
	BPL 2$
	CLR R1
2$:	MOV R1,SCEND
	JSR PC,PNDRAW
	MOV (SP)+,R1
	MOV (SP)+,R0
	RTS PC
ASCAN:	TST PNEN
	BEQ 9$
	TST AUTOSC
	BEQ 9$
	TST SCEND
	BEQ 9$
	TST PANEDIT
	BNE 9$
	TST LINLEN
	BNE 9$
	TST RCOUNT
	BNE 9$
	TST KLAST
	BPL 9$
	DEC SCTIME
	BNE 9$
	ADD SCDIR,SCROLL
	MOV #SCSTEP,SCTIME
	TST SCROLL
	BEQ 1$
	CMP SCROLL,SCEND
	BNE 2$
1$:	NEG SCDIR
	MOV #SCWAIT,SCTIME
2$:	JSR PC,PNDRAW
9$:	RTS PC
AUTOC:	CMP NARG,#1
	JHI SYNTAX
	TST NARG
	BEQ 1$
	CMP ARGS,#1
	JHI SYNTAX
	MOV ARGS,AUTOSC
	BR 2$
1$:	MOV #1,R0
	XOR R0,AUTOSC
2$:	MOV #SCWAIT,SCTIME
	MOV #AUTOOF,R0
	TST AUTOSC
	BEQ 3$
	MOV #AUTOON,R0
3$:	JSR PC,TXSTR
	JSR PC,NEWLIN
	JMP PROMPT
AUTOON:	.ASCIZ /AUTO SCROLL ON/
AUTOOF:	.ASCIZ /AUTO SCROLL OFF/
	.EVEN
HINIT:	CLR HCNT
	CLR HPOS
	RTS PC
HTRACK:	TST HHOLD
	BNE 9$
	TST HCNT
	BEQ 3$
	MOV HPOS,R1
	ASL R1
	CMP DADDR,HIST(R1)
	BEQ 9$
	INC HPOS
	CMP HPOS,HCNT
	BHIS 1$
	ADD #2,R1
	CMP DADDR,HIST(R1)
	BEQ 9$
1$:	MOV HPOS,HCNT
	CMP HCNT,#32.
	BLO 3$
	MOV #HIST,R1
	MOV #31.,R2
2$:	MOV 2(R1),(R1)+
	SOB R2,2$
	DEC HCNT
3$:	MOV HCNT,HPOS
	MOV HCNT,R1
	ASL R1
	MOV DADDR,HIST(R1)
	INC HCNT
9$:	RTS PC
DPREV:	JSR PC,NOARGS
	TST HCNT
	BEQ 9$
	TST HPOS
	BEQ 9$
	DEC HPOS
	MOV HPOS,R1
	ASL R1
	MOV HIST(R1),DADDR
	BR DVIEW
9$:	MOV #HSTART,R0
	JMP ERROR
DNXCMD:	JSR PC,NOARGS
	TST HCNT
	JEQ MEMERR
	TST DERROR
	JNE MEMERR
	MOV DNEXT,DADDR
	CMP DADDR,#160000
	JHI MEMERR
	JEQ MEMERR
DVIEW:	MOV #2,VIEW
	JSR PC,DISONE
	MOV DNEXT,DADDR
	JMP PROMPT
HSTART:	.ASCIZ /HISTORY START; D ADDR TO CHOOSE AN EARLIER BOUNDARY/
	.EVEN
; STEP OVER without FPGA comparators or USER RAM patches. A JSR executes
; through bounded hardware STEP cycles until both return PC and SP match.
; CP63 STEP defers ordinary IRQ/trace; WAIT and HALT end this operation.
OVCMD:	CMP NARG,#1
	JHI SYNTAX
	MOV #4096.,OVLEFT
	TST NARG
	BEQ 1$
	TST ARGS
	JEQ SYNTAX
	MOV ARGS,OVLEFT
1$:	MOV REGS+16,DADDR
	BIT #1,DADDR
	JNE SYNTAX
	CMP DADDR,#160000
	JHI MEMERR
	JEQ MEMERR
	MOV #1,HHOLD
	MOV #3,OUTMOD
	JSR PC,DISONE
	CLR OUTMOD
	CLR HHOLD
	TST DERROR
	JNE MEMERR
	MOV DINST,R0
	BIC #777,R0
	CMP R0,#4000
	BNE OVONE
	BIT #70,DINST
	BEQ OVONE
	MOV DNEXT,OVPC
	MOV REGS+14,OVSP
	CLR OVCAN
	MOV #1,OVACT
	MOV #14,EXOP
	MOV #OVMSG,R0
	JMP LEAVE
OVONE:	CLR NARG
	JMP STEPC
; Called after saving the stepped guest context, before ordinary stop output.
; The input ring survives these entries so a queued cancellation is not lost.
OVBACK:	MOV #OVWAIT,R0
	BIT #40,META
	BNE OVEND
	MOV #OVHALT,R0
	BIT #20,META
	BEQ OVEND
	MOV #OVRET,R0
	CMP REGS+16,OVPC
	BNE 1$
	CMP REGS+14,OVSP
	BEQ OVEND
1$:	JSR PC,RXPOLL
	MOV #OVABRT,R0
	TST RCOUNT
	BNE OVEND
	.WORD 43
	BIT #10,R0
	BNE OVBUT
	TST PNEN
	BEQ 4$
	JSR PC,PNKEY
	CMP R0,#-1
	BNE 2$
	MOV #1,OVCAN
	BR 4$
2$:	TST R0
	BMI 4$
	TST OVCAN
	BEQ 4$
; Consume the cancelling press so ENTER cannot dispatch it as a new command.
	MOV R0,KLAST
	MOV R0,KCAND
	MOV #2,KCOUNT
	BR OVBUT
4$:	DEC OVLEFT
	BNE OVMORE
	MOV #OVLIM,R0
	BR OVEND
OVBUT:	MOV #OVABRT,R0
OVEND:	MOV R0,OVWHY
	CLR OVACT
	CLR STEPS
	RTS PC
OVMORE:	MOV #STKTOP,SP
	MOV #14,EXOP
	JSR PC,PNBACK
	JMP RESTIO
OVMSG:	.ASCIZ /STEP OVER (STEP LOOP; IRQ DEFERRED)/
OVRET:	.ASCIZ /OVER RETURN/
OVWAIT:	.ASCIZ /OVER STOP: WAIT/
OVHALT:	.ASCIZ /OVER STOP: HALT/
OVABRT:	.ASCIZ /OVER CANCELLED/
OVLIM:	.ASCIZ /OVER STEP LIMIT/
	.EVEN
PANEL	= 166000
PANELO	= PANEL+1

PINDIN	= 1
PINCE	= 2
PINCLK	= 4
PINRS	= 10
PINBL	= 20
PINLAT	= 40
	.ASECT

;	Initialise the HCMS chain, turn the RGB LED off and clear all 16 digits.
PNINIT:
	MOV	R0,-(SP)
	MOV	#PINCE+PINRS+PINBL,R0
	MOVB	R0,SHADOW
	MOVB	SHADOW,@#PANELO
	MOV	#1000,R0
10$:	SOB	R0,10$
	JSR	PC,PNCMD
	CLR	R0
	JSR	PC,PNRGB
	MOV	#BLANKS,R0
	JSR	PC,PNDISP
	MOV	(SP)+,R0
	RTS	PC

;	Load Control Word 0 (0x4c) through all eight devices in the chain.
PNCMD:
	MOV	R0,-(SP)
	MOV	R1,-(SP)
	BISB	#PINCE+PINRS,SHADOW
	MOVB	SHADOW,@#PANELO
	BICB	#PINCE,SHADOW
	MOVB	SHADOW,@#PANELO
	MOV	#10,R1
	MOV	#114,R0
10$:	JSR	PC,SHBYTE
	SOB	R1,10$
	BISB	#PINCE,SHADOW
	MOVB	SHADOW,@#PANELO
	MOV	(SP)+,R1
	MOV	(SP)+,R0
	RTS	PC

;	Display 16 characters.  The downstream eight-character module is sent
;	first, matching the original HC1200 firmware and physical daisy chain.
PNDISP:
	MOV	R0,-(SP)
	MOV	R1,-(SP)
	MOV	R2,-(SP)
	MOV	R3,-(SP)
	MOV	R4,-(SP)
	MOV	R5,-(SP)
	BISB	#PINCE,SHADOW
	BICB	#PINRS,SHADOW
	MOVB	SHADOW,@#PANELO
	BICB	#PINCE,SHADOW
	MOVB	SHADOW,@#PANELO
	MOV	R0,R5
	ADD	#10,R5
	MOV	#10,R4
10$:	JSR	PC,PNCHAR
	SOB	R4,10$
	MOV	12(SP),R5	; PNCHAR uses R0; recover the saved buffer pointer
	MOV	#10,R4
20$:	JSR	PC,PNCHAR
	SOB	R4,20$
	BISB	#PINCE,SHADOW
	MOVB	SHADOW,@#PANELO
	BICB	#PINBL,SHADOW
	MOVB	SHADOW,@#PANELO
	MOV	(SP)+,R5
	MOV	(SP)+,R4
	MOV	(SP)+,R3
	MOV	(SP)+,R2
	MOV	(SP)+,R1
	MOV	(SP)+,R0
	RTS	PC

;	Send one 5-column glyph.  The compact font covers ASCII 040..137.
PNCHAR:
	MOVB	(R5)+,R1
	BIC	#177400,R1
	CMP	R1,#40
	BLO	10$
	CMP	R1,#137
	BHI	10$
	SUB	#40,R1
	BR	20$
10$:	CLR	R1
20$:	MOV	R1,R3
	ASL	R3
	ASL	R3
	ADD	R1,R3
	ADD	#FONT,R3
	MOV	#5,R2
30$:	MOVB	(R3)+,R0
	BIC	#177400,R0
	JSR	PC,SHBYTE
	SOB	R2,30$
	RTS	PC

;	Set RGB using an intuitive active-high mask.  The external register uses
;	active-low LED outputs, while its upper five bits select key columns.
PNRGB:
	MOV	R0,-(SP)
	BIC	#177770,R0
	COM	R0
	BIC	#177770,R0
	MOVB	R0,RGBRAW
	BIS	#370,R0
	JSR	PC,PNLATC
	MOV	(SP)+,R0
	RTS	PC

;	Scan the 4-by-5 keyboard.  The mapping is the one used by the original
;	HC1200 display module: 0..15 are hex keys and 16..19 are function keys.
; Full-matrix scan rejects more than one active intersection. No chords.
PNKEY:	MOV R1,-(SP)
	MOV R2,-(SP)
	MOV R3,-(SP)
	MOV R4,-(SP)
	MOV R5,-(SP)
	MOV #-1,R5
	CLR R2
	MOV #10,R3
1$:	MOV R3,R0
	BIS RGBRAW,R0
	JSR PC,PNLATC
	MOV @#PANEL,R4
	ASH #-4,R4
	BIC #177760,R4
	BEQ 4$
	TST R5
	BPL 8$
	MOV R4,R0
	DEC R0
	BIT R0,R4
	BNE 8$
	MOV R2,R1
2$:	INC R1
	ASR R4
	BNE 2$
	MOVB KEYMAP(R1),R5
	BIC #177400,R5
4$:	ADD #4,R2
	ASL R3
	CMP R3,#400
	BLO 1$
	MOV R5,R0
	BR 9$
8$:	MOV #-2,R0
9$:	MOV (SP)+,R5
	MOV (SP)+,R4
	MOV (SP)+,R3
	MOV (SP)+,R2
	MOV (SP)+,R1
	RTS PC
SHBYTE:
	MOV	R0,-(SP)
	MOV	R1,-(SP)
	MOV	#10,R1
10$:	ASLB	R0
	BCC	20$
	BISB	#PINDIN,SHADOW
	BR	30$
20$:	BICB	#PINDIN,SHADOW
30$:	MOVB	SHADOW,@#PANELO
	BISB	#PINCLK,SHADOW
	MOVB	SHADOW,@#PANELO
	BICB	#PINCLK,SHADOW
	MOVB	SHADOW,@#PANELO
	JSR	PC,RXPOLL
	SOB	R1,10$
	MOV	(SP)+,R1
	MOV	(SP)+,R0
	RTS	PC

;	Shift and latch the external RGB/keyboard register.  HCMS CE is forced
;	high so the shared DIN/CLK transitions cannot change display contents.
PNLATC:
	BISB	#PINCE,SHADOW
	MOVB	SHADOW,@#PANELO
	JSR	PC,SHBYTE
	BISB	#PINLAT,SHADOW
	MOVB	SHADOW,@#PANELO
	BICB	#PINLAT,SHADOW
	MOVB	SHADOW,@#PANELO
	RTS	PC
	.ASECT
