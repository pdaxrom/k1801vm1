	.TITLE UJTEST
	.IDENT /01.00/
; Deliberately odd guest SP and native-loader signature R4, for RTL debugger tests.
	.MCALL .PRINT,.EXIT,.LOOKUP,.READW,.CLOSE
	.PSECT TEST,I,RW
START:	MOV SP,OLDSP
	CLR DONE
	MOV #125061,R4
	MOV #1234,R0
	MOV #567,R1
	MOV #7654,R2
	MOV #3210,R3
	MOV #30000,R5
	SPL 7
	MOV #177777,SP
LOOP:	INC R1
	TST DONE
	BEQ LOOP
	MOV OLDSP,SP
	SPL 0
	.PRINT #PASSED
	.EXIT
OLDSP:	.WORD 0
DONE:	.WORD 0
PASSED:	.ASCIZ /!UJTEST-I-CONTEXT RESUMED/
	.EVEN
	.EVEN
OVCALL:	JSR PC,OVSUB
OVDONE:	NOP
	BR OVDONE
OVSUB:	INC R3
	JSR PC,OVSUB2
	INC R2
	RTS PC
OVSUB2:	INC R0
	RTS PC
; IRQ qualification: no synthetic CPU irq injection; use the board KW11-L.
WKCALL: JSR PC,WKTEST
WKDONE: NOP
        BR WKDONE
WKTEST: SPL 7
        MOV @#100,VECPC
        MOV @#102,VECPS
        MOV @#177546,LTCOLD
        CLR TICKS
        MOV #WKIRQ,@#100
        MOV #340,@#102
        MOV #100,@#177546
        SPL 0
        WAIT
        BR .-2
WOKEN:  SPL 7
        CLR @#177546
        MOV VECPC,@#100
        MOV VECPS,@#102
        MOV LTCOLD,@#177546
        SPL 0
        RTS PC
WKIRQ:  INC TICKS
; An interrupt just before WAIT must also skip it, avoiding a lost wakeup.
        MOV #WOKEN,(SP)
        RTI
VECPC:  .WORD 0
VECPS:  .WORD 0
LTCOLD: .WORD 0
TICKS:  .WORD 0
; Execute real RT-11 EMT/driver/SD reads with the temporary HALT hook live.
DKCALL: JSR PC,DKTEST
DKDONE: NOP
        BR DKDONE
DKTEST: CLR DKOK
        SPL 0
        .LOOKUP #AREA,#1,#SPEC
        BCS 9$
        .READW #AREA,#1,#BUFFER,#256.,#0
        BCS 8$
        CMP BUFFER,#045125
        BNE 8$
        CMP BUFFER+2,#030461
        BNE 8$
        INC DKOK
8$:     .CLOSE #1
9$:     RTS PC
DKOK:   .WORD 0
SPEC:   .RAD50 /SY ODT   BIN/
AREA:   .BLKW 5
BUFFER: .BLKW 256.
        .END START
