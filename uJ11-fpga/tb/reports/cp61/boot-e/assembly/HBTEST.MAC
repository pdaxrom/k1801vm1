	.TITLE	HBTEST
	.IDENT	/01.00/
; CP61 diagnostic: actual HALT-vector block calls under RT-11.
; This is not the ODT/FP11 file loader. The old ABI-1 UJLOAD is for CP60.
	.MCALL	.PRINT,.EXIT
	.PSECT	TEST,I,RW
START:	MOV	SP,SAVSP
	MOV	#BUFFER,R1
	MOV	#400,R2
	CLR	R0
FILL:	MOV	R0,(R1)+
	INC	R0
	SOB	R2,FILL
	MOV	#125061,R4
	MOV	#BUFFER,R5
	MOV	#40000,R1
; Four calls of 64 words. R1/R5 advance and R2 reaches zero each time.
	MOV	#100,R2
	HALT
	TST	R0
	BNE	ERROR
	MOV	#100,R2
	HALT
	TST	R0
	BNE	ERROR
	MOV	#100,R2
	HALT
	TST	R0
	BNE	ERROR
	MOV	#100,R2
	HALT
	TST	R0
	BNE	ERROR
	CMP	SP,SAVSP
	BNE	ERROR
	CMP	R5,#BUFFER+1000
	BNE	ERROR
	CMP	R1,#41000
	BNE	ERROR
	CMP	R4,#125061
	BNE	ERROR
	MOV	#BUFFER,R1
	MOV	#400,R2
	CLR	R0
CHECK:	CMP	R0,(R1)+
	BNE	ERROR
	INC	R0
	SOB	R2,CHECK
	.PRINT	#GOOD
	.EXIT
ERROR:	.PRINT	#BAD
	.EXIT
SAVSP:	.WORD	0
GOOD:	.ASCIZ	/!HBTEST-I-HALT COPY 512 BYTES PASS/
BAD:	.ASCIZ	/?HBTEST-E-Copy or context mismatch/
	.EVEN
BUFFER:	.BLKW	400
	.END	START
