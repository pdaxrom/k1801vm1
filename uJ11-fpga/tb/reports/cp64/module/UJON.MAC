	.TITLE UJON
	.IDENT /01.00/
; Enable only the exact matching, fully installed CP64 ODT on CP63 hardware.
; RT-11 file reading stays in the unchanged UJLOAD. No unchecked JMP into FRAM.
	.MCALL .PRINT,.EXIT
	.ENABL LC
IMMCNT=6756
IMMSUM=27151
ODFAIL=13330
	.MACRO JCS DST,?OK
	BCC OK
	JMP DST
OK:
	.ENDM
	.MACRO JNE DST,?OK
	BEQ OK
	JMP DST
OK:
	.ENDM
	.PSECT ACT,I,RW
START:	JSR PC,UPLOAD
	JCS FAIL
	MOV #4,DESC
	JSR PC,API
	JCS FAIL
	CMP R0,#125062
	JNE FAIL
	JSR PC,GETST
	JCS FAIL
	BIC #177376,R0
	CMP R0,#401
	JNE FAIL
	MOV #COMMON,R2
CHECK:	MOV (R2)+,R5
	BEQ SUM
	CLR DESC
	JSR PC,API
	JCS FAIL
	CMP R0,(R2)+
	JNE FAIL
	BR CHECK
SUM:	MOV #10000,R5
	MOV #IMMCNT,R4
	CLR R1
NEXT:	MOV #10,R0
	CMP R4,R0
	BHIS 1$
	MOV R4,R0
1$:	MOV R0,COUNT
	MOV #5,DESC
	JSR PC,API
	JCS FAIL
	ADD R0,R1
	SUB COUNT,R4
	ADD COUNT,R5
	ADD COUNT,R5
	TST R4
	BNE NEXT
	CMP R1,#IMMSUM
	BNE FAIL
; One explicit resident execute call; ENABLE verifies capability again,
; writes/readbacks the debug vector, and sets debug-enable last.
	MOV #125061,R4
	MOV #10004,R1
	CLR R2
	HALT
	TST R2
	BNE FAIL
	.PRINT #OKMSG
	.EXIT
FAIL:	.PRINT #BADMSG
	.EXIT
COUNT:	.WORD 0
COMMON:	.WORD 4,312,6,340,166,1700,164,2000
	.WORD 2000,12737,2002,ODFAIL,2004,4,2006,137,2010,10000
	.WORD 10010,125064,10012,1,0
OKMSG:	.ASCIZ /!UJON-I-CP64 DEBUG ENABLED; SHORT RESET ENTERS ODT/
BADMSG:	.ASCIZ /?UJON-E-CP63 OR MATCHING VERIFIED ODT UNAVAILABLE/
	.EVEN
GETST:	MOV	#3,DESC
API:	MOV	R0,DESC+4
	MOV	R5,DESC+2
	MOV	R1,-(SP)
	MOV	R2,-(SP)
	MOV	R3,-(SP)
	MOV	R4,-(SP)
	MOV	R5,-(SP)
	MOV	#125061,R4
	MOV	#1000,R1
	CLR	R2
	MOV	#DESC,R5
	HALT
	MOV	R2,ERRFLG
	MOV	(SP)+,R5
	MOV	(SP)+,R4
	MOV	(SP)+,R3
	MOV	(SP)+,R2
	MOV	(SP)+,R1
; MOV changes N/Z, so save the status separately before restoring registers.
	TST	ERRFLG
	BNE	APIERR
	CLC
	RTS	PC
APIERR:	SEC
	RTS	PC
UPLOAD:	MOV	#HELPER,R5
	MOV	#1000,R1
	MOV	#125061,R4
	MOV	#HCNT,R3
1$:	MOV	#100,R2
	CMP	R3,R2
	BHIS	2$
	MOV	R3,R2
2$:	MOV	R3,-(SP)
	SUB	R2,(SP)
	HALT
	MOV	(SP)+,R3
	TST	R0
	BNE	APIERR
	TST	R3
	BNE	1$
	CLC
	RTS	PC
DESC:	.BLKW	4
ERRFLG:	.WORD	0


HELPER:
	.WORD	13704,4,12737,1270,4,21,10003,21
	.WORD	10001,21,20327,4,101122,20327,4,1446
	.WORD	20327,3,1441,20327,2,1431,20327,1
	.WORD	101103,32701,1,1100,10105,5703,1411,20527
	.WORD	1000,103472,10003,41,40,20003,1065,457
	.WORD	20527,4,1002,10400,452,40,450,20027
	.WORD	3,101052,42,430,43,441,43,32700
	.WORD	3,1033,12737,177,320,12737,177640,322
	.WORD	12737,777,326,12737,1700,166,12737,2020
	.WORD	10,12737,340,12,12737,326,164,32700
	.WORD	1,1403,12737,2000,164,12700,125062,5002
	.WORD	12737,312,4,10,12702,1,771,20327
	.WORD	10,101372,5700,1770,20027,10,101365,32701
	.WORD	1,1362,20127,1000,103757,10002,6300,60100
	.WORD	103002,5700,1351,20327,7,1014,21,32700
	.WORD	1,1342,10004,60200,103737,60200,103735,20027
	.WORD	160000,101332,10105,5001,20327,10,1423,20327
	.WORD	5,1424,20327,6,1406,10501,10405,21
	.WORD	10504,10105,401,5000,10001,41,40,20001
	.WORD	1303,406,40,5700,1277,402,40,60001
	.WORD	62705,2,77237,10100,137,1256,0,0
	.WORD	0,0,0,0,0,0,0,0
	.WORD	0,0,0,0,0,0,0,0
	.WORD	0,0,0,0,0,0,0,0
	.WORD	0,0,0,0,0,0,0,0
	.WORD	0,0,0,0,0,0,0,0
	.WORD	0,0,0,0,0,0,0,0
	.WORD	0,0,0,0,0,0,0,0
	.WORD	12737,312,4,10
HCNT=<.-HELPER>/2

	.END START
