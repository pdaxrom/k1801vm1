	.TITLE FPTST
	.IDENT /00.03/
; CP70 RT-11 test: ODT steps F/D transfers, AC5, and preserved low halves.
; Redirect PC from LOOP to FINISH to validate memory and return to RT-11.
	.MCALL .PRINT,.EXIT
AC1=%1
AC2=%2
AC5=%5
	.PSECT TEST,I,RW
START:	.PRINT #HELLO
	SPL 7
	BR ENTRY
ENTRY:	SETD
LOADD:	LDD SOURCE,AC2
BANK:	STD AC2,AC5
SINGLE:	SETF
LOADF:	.WORD 172627,40200
STORE:	STF AC2,FRES
DOUBLE:	SETD
RESTOR:	STD AC2,DRES
COPY:	LDD AC5,AC1
SAVE:	STD AC1,BACK
LOOP:	BR .
FINISH:	CMP FRES,#40200
	BNE FAIL
	TST FRES+2
	BNE FAIL
	CMP DRES,#40200
	BNE FAIL
	TST DRES+2
	BNE FAIL
	CMP DRES+4,SOURCE+4
	BNE FAIL
	CMP DRES+6,SOURCE+6
	BNE FAIL
	MOV #SOURCE,R0
	MOV #BACK,R1
	MOV #4,R2
CHECK:	CMP (R0)+,(R1)+
	BNE FAIL
	SOB R2,CHECK
	SPL 0
	.PRINT #DONE
	.EXIT
FAIL:	SPL 0
	.PRINT #ERROR
	.EXIT
SOURCE:	.WORD 40600,12345,65432,23456
FRES:	.BLKW 2
DRES:	.BLKW 4
BACK:	.BLKW 4
HELLO:	.ASCIZ /!FPTST-I-TRANSFER TEST/
DONE:	.ASCIZ /!FPTST-I-RETURNED TO RT11/
ERROR:	.ASCIZ /?FPTST-E-STATE MISMATCH/
	.EVEN
	.END START
