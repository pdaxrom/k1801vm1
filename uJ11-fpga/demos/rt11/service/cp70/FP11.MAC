	.TITLE UJFP11
	.IDENT /00.03/
; CP70 FP11 control and F/D transfer firmware. Absolute HALT FRAM, CP67 module ABI3.
; LDFPS/STFPS/STST support all eight word addressing modes.
; LDF/LDD and STF/STD transfer AC or memory; no arithmetic/conversion yet.
	.ASECT
	.=40000
INIT:	JMP @#COLD
SIGN:	.WORD 125110,1
CPC=100
CPSW=102
FPSMSK=147757
	.MACRO JNE DST,?OK
	BEQ OK
	JMP DST
OK:
	.ENDM
	.MACRO JEQ DST,?OK
	BNE OK
	JMP DST
OK:
	.ENDM
; The generic walker owns its fault vector until we return RTS PC.
COLD:	.WORD 43
	BIT #400,R0
	BEQ CFAIL
	CMP @#122,#7000
	BNE CFAIL
	BIC #177770,R0
	MOV R0,R3
	MOV #IMMEND,R1
	MOV #<MEMEND-IMMEND>/2,R2
1$:	CLR (R1)
	TST (R1)+
	BNE CFAIL
	SOB R2,1$
	MOV #ENTER,@#10
	CMP @#10,#ENTER
	BNE CFAIL
	MOV #340,@#12
	CMP @#12,#340
	BNE CFAIL
; Ready is published last; preserve installed ODT/debug bits.
	MOV R3,R0
	BIS #2,R0
	.WORD 42
	CLR R0
	RTS PC
CFAIL:	MOV #1,R0
	RTS PC

; No use of the USER stack, even when its address is odd.
ENTER:	MOV R0,REGS
	MOV R1,REGS+2
	MOV R2,REGS+4
	MOV R3,REGS+6
	MOV R4,REGS+10
	MOV R5,REGS+12
	MOV SP,REGS+14
	MOV @#CPC,REGS+16
	MOV @#CPSW,REGS+20
	MOV #STKTOP,SP
	MOV @#4,OLDVEC
	MOV @#6,OLDVEC+2
	CLR INTRAP
	MOV #BUSERR,@#4
	MOV #340,@#6
; HALT entry supplies PC after the opcode. Decode its RAM word, without
; consuming an extension word or changing the saved architectural PC.
	MOV REGS+16,R5
	SUB #2,R5
	MOV R5,OPADDR
	.WORD 21
	MOV R0,OPCODE
	CMP R0,#170000
	BEQ CFCC
	CMP R0,#170001
	BEQ SETF
	CMP R0,#170002
	BEQ SETI
	CMP R0,#170011
	BEQ SETD
	CMP R0,#170012
	BEQ SETL
	MOV R0,R4
	BIC #77,R4
	CMP R4,#170100
	BEQ XFER
	CMP R4,#170200
	BEQ XFER
	CMP R4,#170300
	BEQ XFER
	BIC #300,R4
	CMP R4,#172400
	BEQ XFER
	CMP R4,#174000
	BEQ XFER
	JMP UNIMPL
CFCC:	MOV FPS,R0
	BIC #177760,R0
	BIC #17,REGS+20
	BIS R0,REGS+20
	JMP RETURN
SETF:	BIC #200,FPS
	JMP RETURN
SETI:	BIC #100,FPS
	JMP RETURN
SETD:	BIS #200,FPS
	JMP RETURN
SETL:	BIS #100,FPS
	JMP RETURN
; R1 addresses the saved CPU register, R2 is mode*2, R3 operand bytes.
; R0/R5 alone are clobbered by the inter-bank instructions.
XFER:	MOV OPCODE,R1
	BIC #177770,R1
	ASL R1
	ADD #REGS,R1
	MOV OPCODE,R2
	BIC #177707,R2
	ASR R2
	ASR R2
	MOV #2,R3
	BIT #7400,R4
	BNE FSET
	CMP R4,#170300
	BNE XD
	MOV #4,R3
	BR IMMLEN
FSET:	MOV OPCODE,R0
	BIC #177477,R0
	ASR R0
	ASR R0
	ASR R0
	ADD #ACS,R0
	MOV R0,ACPTR
	MOV #4,R3
	BIT #200,FPS
	BEQ FSIZE
	ASL R3
FSIZE:	MOV R3,FLEN
IMMLEN:	MOV OPCODE,R0
	BIC #177700,R0
	CMP R0,#27
	BNE XD
	MOV #2,R3
XD:	CLR CHGPTR
	MOV (R1),R5
	JMP @EATAB(R2)
EATAB:	.WORD REG,EA,EAINC,EAIND,EADEC,EADDEF,EAIDX,EAIDXD
REG:	BIT #7400,R4
	JNE FREG
	CMP R4,#170100
	BNE REGST
	MOV (R1),FPS
	BIC #<177777-FPSMSK>,FPS
	JMP RETURN
REGST:	MOV FPS,R0
	CMP R4,#170200
	BEQ REGSAV
	MOV FEC,R0
REGSAV:	MOV R0,(R1)
	JMP RETURN
EAINC:	MOV R5,R0
	ADD R3,R0
	JSR PC,CHANGE
	BR EA
EAIND:	MOV R5,R0
	ADD #2,R0
	JSR PC,CHANGE
	BR INDIRECT
EADEC:	SUB R3,R5
	MOV R5,R0
	JSR PC,CHANGE
	BR EA
EADDEF:	SUB #2,R5
	MOV R5,R0
	JSR PC,CHANGE
	BR INDIRECT
EAIDX:
EAIDXD:	MOV REGS+16,R5
	.WORD 21
; Failed extension read never reaches the PC update. Index R7 uses PC+2.
	MOV R5,REGS+16
	ADD (R1),R0
	MOV R0,R5
	CMP R2,#14
	BEQ EA
INDIRECT:
	.WORD 21
	MOV R0,R5
EA:	BIT #7400,R4
	JNE FMEM
	CMP R4,#170100
	BNE MEMST
	.WORD 21
	MOV R0,FPS
	BIC #<177777-FPSMSK>,FPS
	BR COMMIT
MEMST:	MOV FPS,R0
	CMP R4,#170200
	BEQ STORE1
	MOV FEC,R0
STORE1:	ADD #2,R5
	.WORD 31
	CMP R3,#4
	BNE COMMIT
	MOV FEA,R0
	ADD #4,R5
	.WORD 31
COMMIT:	JSR PC,UPD
	JMP RETURN
UPD:	TST CHGPTR
	BEQ URET
	MOV CHGVAL,@CHGPTR
URET:	RTS PC
; Match J11: R0-R6 autoupdates commit after all operand accesses succeed.
; PC changes are immediate, including an absolute/immediate pointer fetch.
CHANGE:	CMP R1,#REGS+16
	BNE PENDING
	MOV R0,(R1)
	RTS PC
PENDING:
	MOV R1,CHGPTR
	MOV R0,CHGVAL
	RTS PC
; Mode 0 names floating accumulators, not CPU registers. AC6/7 are illegal.
FREG:	MOV R1,R5
	SUB #REGS,R5
	CMP R5,#14
	JEQ UNIMPL
	CMP R5,#16
	JEQ UNIMPL
	ASL R5
	ASL R5
	ADD #ACS,R5
	MOV ACPTR,R1
	CMP R4,#172400
	BEQ FCOPY
	MOV R5,R0
	MOV R1,R5
	MOV R0,R1
	BR FCOPY
; Buffer all words before modifying AC/FPS. A later bus error leaves AC intact.
FMEM:	CMP R4,#174000
	BEQ FSTORE
	MOV #FBUF,R1
	CLR (R1)
	CLR 2(R1)
	CLR 4(R1)
	CLR 6(R1)
	MOV R3,R2
	ASR R2
FREAD:	.WORD 21
	MOV R0,(R1)+
	SOB R2,FREAD
; Undefined-variable detection applies to memory/immediate, not AC sources.
	MOV FBUF,R0
	BPL FLOAD
	BIT #77600,R0
	BNE FLOAD
	BIT #4000,FPS
	BEQ FLOAD
; Floating exceptions commit autoupdates even when FID suppresses the trap.
	JSR PC,UPD
	MOV #14,R0
	BR FPERR
FLOAD:	MOV #FBUF,R5
	MOV ACPTR,R1
FCOPY:	MOV FLEN,R2
	ASR R2
FCOPY1:	MOV (R5)+,(R1)+
	SOB R2,FCOPY1
	CMP R4,#174000
	BEQ COMMIT
; LDF changes FPS NZVC only; dirty zero is copied bit for bit, not normalized.
	BIC #17,FPS
	MOV @ACPTR,R0
	BPL FZERO
	BIS #10,FPS
FZERO:	BIT #77600,R0
	BNE COMMIT
	BIS #4,FPS
	BR COMMIT
FSTORE:	MOV ACPTR,R1
	MOV R3,R2
	ASR R2
	ADD #2,R5
FWRITE:	MOV (R1)+,R0
	.WORD 31
	ADD #4,R5
	SOB R2,FWRITE
	BR COMMIT
; Valid arithmetic opcodes remain explicitly outside this checkpoint's ISA.
UNIMPL:	MOV #2,R0
FPERR:	MOV R0,FEC
	MOV OPADDR,FEA
	BIS #100000,FPS
	BIT #40000,FPS
	JNE RETURN
	MOV #244,TVEC
	BR TRAP
BUSERR:	TST INTRAP
	BNE FATAL
	MOV #4,TVEC
; Construct the usual unbanked CPU frame: PSW then PC, then read the vector.
; A fault during this construction is terminal, as with the base CPU.
TRAP:	MOV #1,INTRAP
	MOV REGS+14,R5
	MOV REGS+20,R0
	.WORD 31
	MOV REGS+16,R0
	.WORD 31
	MOV R5,REGS+14
	MOV TVEC,R5
	.WORD 21
	MOV R0,REGS+16
	.WORD 21
	MOV R0,REGS+20
RETURN:	MOV OLDVEC,@#4
	MOV OLDVEC+2,@#6
	MOV REGS+16,@#CPC
	MOV REGS+20,@#CPSW
	MOV REGS,R0
	MOV REGS+2,R1
	MOV REGS+4,R2
	MOV REGS+6,R3
	MOV REGS+10,R4
	MOV REGS+12,R5
	MOV REGS+14,SP
	.WORD 10
FATAL:	HALT
; Mutable state is excluded from the retained image checksum.
IMMEND:
FPS:	.BLKW 1
FEC:	.BLKW 1
FEA:	.BLKW 1
ACS:	.BLKW 24.
REGS:	.BLKW 9.
OLDVEC:	.BLKW 2
OPADDR:	.BLKW 1
OPCODE:	.BLKW 1
TVEC:	.BLKW 1
INTRAP:	.BLKW 1
CHGPTR:	.BLKW 1
CHGVAL:	.BLKW 1
ACPTR:	.BLKW 1
FLEN:	.BLKW 1
FBUF:	.BLKW 4
STACK:	.BLKW 64.
STKTOP:
MEMEND:
	.END INIT
