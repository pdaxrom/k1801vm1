	.TITLE FPTST
	.IDENT /00.07/
; CP75: ODT steps MOD F/D; native checks include signed splitting.
	.MACRO JNE DST,?OK
	BEQ OK
	JMP DST
OK:
	.ENDM
	.MCALL .PRINT,.EXIT
AC0=%0
AC1=%1
AC2=%2
AC5=%5
	.PSECT TEST,I,RW
START:	.PRINT #HELLO
	SPL 7
	BR ENTRY
ENTRY:	SETD
LOAD:	LDD SOURCE,AC2
NEGATE:	NEGD AC2
ABSOL:	ABSD AC2
COMPAR:	CMPD SOURCE,AC2
CHECKT:	TSTD AC2
CLEAR:	CLRD AC5
ADDITION:	ADDD SOURCE,AC2
SUBTR:	SUBD SOURCE,AC2
MULTD:	MULD #2.0,AC2
DIVD2:	DIVD #2.0,AC2
SINGLE:	SETF
FCLEAR:	CLRF AC0
FADD:	ADDF #1.0,AC0
FMUL:	MULF #3.0,AC0
FDIV:	DIVF #3.0,AC0
FSUB:	SUBF #1.0,AC0
DOUBLE:	SETD
FPSSET:	LDFPS #44000
BADTST:	TSTF MINUS
STATUS:	STFPS RESULT
ERRORS:	STST ERR
MSETF:	SETF
MLOADF:	LDF #1.5,AC0
MODFF:	MODF #1.5,AC0
MSETD:	SETD
MLOADD:	LDD #1.5,AC0
MODDD:	MODD #1.5,AC0
MODODD:	MODD #2.0,AC1
LOOP:	BR .
FINISH:	CMP RESULT,#144014
	JNE FAIL
	CMP ERR,#14
	JNE FAIL
	CMP ERR+2,#BADTST
	JNE FAIL
	SETD
	STD AC2,BACK
	LDD AC5,AC0
	STD AC0,ZERO
	MOV #SOURCE,R0
	MOV #BACK,R1
	MOV #ZERO,R2
	MOV #4,R3
CHECK:	CMP (R0)+,(R1)+
	JNE FAIL
	TST (R2)+
	JNE FAIL
	SOB R3,CHECK
; Negative-zero memory is overwritten before the enabled UV exception.
	LDFPS #44000
	ABSF MINUS
	STFPS RESULT
	CMP RESULT,#144004
	JNE FAIL
	TST MINUS
	JNE FAIL
	TST MINUS+2
	JNE FAIL
; Rounded double 1/3, then divide-zero preserves all four AC words/NZVC.
	SETD
	LDD #1.0,AC0
	DIVD #3.0,AC0
	STD AC0,QUOT
	MOV #QUOT,R0
	MOV #THIRD,R1
	MOV #4,R2
QCHECK:	CMP (R0)+,(R1)+
	JNE FAIL
	SOB R2,QCHECK
	LDFPS #40203
DZ:	DIVD #0.0,AC0
	STFPS RESULT
	CMP RESULT,#140203
	JNE FAIL
	STST ERR
	CMP ERR,#4
	JNE FAIL
	CMP ERR+2,#DZ
	JNE FAIL
	STD AC0,QUOT
	MOV #QUOT,R0
	MOV #THIRD,R1
	MOV #4,R2
DCHECK:	CMP (R0)+,(R1)+
	JNE FAIL
	SOB R2,DCHECK
; Signed MOD: fraction -0.25, integer -2.0; both tails exactly zero.
	LDFPS #200
	LDD #1.5,AC0
	MODD #-1.5,AC0
	STD AC0,BACK
	STD AC1,ZERO
	CMP BACK,#137600
	JNE FAIL
	CMP ZERO,#140400
	JNE FAIL
	MOV #BACK+2,R0
	MOV #ZERO+2,R1
	MOV #3,R2
MCHECK:	TST (R0)+
	JNE FAIL
	TST (R1)+
	JNE FAIL
	SOB R2,MCHECK
	SPL 0
	.PRINT #DONE
	.EXIT
FAIL:	SPL 0
	.PRINT #BAD
	.EXIT
SOURCE:	.WORD 40200,12345,65432,23456
QUOT:	.BLKW 4
THIRD:	.WORD 37652,125252,125252,125253
MINUS:	.WORD 100123,4567
RESULT:	.WORD 0
ERR:	.BLKW 2
BACK:	.BLKW 4
ZERO:	.BLKW 4
HELLO:	.ASCIZ /!FPTST-I-F D ARITHMETIC TEST/
DONE:	.ASCIZ /!FPTST-I-RETURNED TO RT11/
BAD:	.ASCIZ /?FPTST-E-STATE MISMATCH/
	.EVEN
	.END START
