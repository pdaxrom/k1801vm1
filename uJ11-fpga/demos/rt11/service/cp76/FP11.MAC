	.TITLE UJFP11
	.IDENT /00.09/
; CP76 FP11-A firmware: conversions. Absolute HALT FRAM, CP67 module ABI3.
; LDFPS/STFPS/STST support all eight word addressing modes.
; Full documented FP11 instruction families; ordinary code in HALT FRAM.
	.ASECT
	.=40000
INIT:	JMP @#COLD
SIGN:	.WORD 125110,1
CPC=100
CPSW=102
FPSMSK=147757
	.MACRO JNE DST,?OK
	BEQ OK
	JMP DST
OK:
	.ENDM
	.MACRO JMI DST,?OK
	BPL OK
	JMP DST
OK:
	.ENDM
	.MACRO JGE DST,?OK
	BLT OK
	JMP DST
OK:
	.ENDM
	.MACRO JEQ DST,?OK
	BNE OK
	JMP DST
OK:
	.ENDM
; The generic walker owns its fault vector until we return RTS PC.
COLD:	.WORD 43
	BIT #400,R0
	BEQ CFAIL
	CMP @#122,#7000
	BNE CFAIL
	BIC #177770,R0
	MOV R0,R3
	MOV #IMMEND,R1
	MOV #<MEMEND-IMMEND>/2,R2
1$:	CLR (R1)
	TST (R1)+
	BNE CFAIL
	SOB R2,1$
	MOV #ENTER,@#10
	CMP @#10,#ENTER
	BNE CFAIL
	MOV #340,@#12
	CMP @#12,#340
	BNE CFAIL
; Ready is published last; preserve installed ODT/debug bits.
	MOV R3,R0
	BIS #2,R0
	.WORD 42
	CLR R0
	RTS PC
CFAIL:	MOV #1,R0
	RTS PC

; No use of the USER stack, even when its address is odd.
ENTER:	MOV R0,REGS
	MOV R1,REGS+2
	MOV R2,REGS+4
	MOV R3,REGS+6
	MOV R4,REGS+10
	MOV R5,REGS+12
	MOV SP,REGS+14
	MOV @#CPC,REGS+16
	MOV @#CPSW,REGS+20
	MOV #STKTOP,SP
	MOV @#4,OLDVEC
	MOV @#6,OLDVEC+2
	CLR INTRAP
	MOV #BUSERR,@#4
	MOV #340,@#6
; HALT entry supplies PC after the opcode. Decode its RAM word, without
; consuming an extension word or changing the saved architectural PC.
	MOV REGS+16,R5
	SUB #2,R5
	MOV R5,OPADDR
	.WORD 21
	MOV R0,OPCODE
	CMP R0,#170000
	BEQ CFCC
	CMP R0,#170001
	BEQ SETF
	CMP R0,#170002
	BEQ SETI
	CMP R0,#170011
	BEQ SETD
	CMP R0,#170012
	BEQ SETL
	MOV R0,R4
	BIC #77,R4
	CMP R4,#170100
	BEQ XFER
	CMP R4,#170200
	BEQ XFER
	CMP R4,#170300
	BEQ XFER
	CMP R4,#170400
	BEQ XFER
	CMP R4,#170500
	BEQ XFER
	CMP R4,#170600
	BEQ XFER
	CMP R4,#170700
	BEQ XFER
	BIC #300,R4
	CMP R4,#173400
	BEQ XFER
	CMP R4,#172400
	BEQ XFER
	CMP R4,#174000
	BEQ XFER
	CMP R4,#172000
	BEQ XFER
	CMP R4,#173000
	BEQ XFER
	CMP R4,#171000
	BEQ XFER
	CMP R4,#174400
	BEQ XFER
	CMP R4,#171400
	BEQ XFER
	CMP R4,#175000
	BHIS XFER
	JMP UNIMPL
CFCC:	MOV FPS,R0
	BIC #177760,R0
	BIC #17,REGS+20
	BIS R0,REGS+20
	JMP RETURN
SETF:	BIC #200,FPS
	JMP RETURN
SETI:	BIC #100,FPS
	JMP RETURN
SETD:	BIS #200,FPS
	JMP RETURN
SETL:	BIS #100,FPS
	JMP RETURN
; R1 addresses the saved CPU register, R2 is mode*2, R3 operand bytes.
; R0/R5 alone are clobbered by the inter-bank instructions.
XFER:	MOV OPCODE,R1
	BIC #177770,R1
	ASL R1
	ADD #REGS,R1
	MOV OPCODE,R2
	BIC #177707,R2
	ASR R2
	ASR R2
	MOV #2,R3
	CMP R4,#175000
	BLO XOLD
	JMP CSIZE
XOLD:	BIT #7400,R4
	BNE FSET
	CMP R4,#170300
	BNE XD
	MOV #4,R3
	BR IMMLEN
FSET:	MOV OPCODE,R0
	BIC #177477,R0
	ASR R0
	ASR R0
	ASR R0
	ADD #ACS,R0
	MOV R0,ACPTR
	MOV #4,R3
	BIT #200,FPS
	BEQ FSIZE
	ASL R3
FSIZE:	MOV R3,FLEN
IMMLEN:	MOV OPCODE,R0
	BIC #177700,R0
	CMP R0,#27
	BNE XD
	MOV #2,R3
XD:	CLR CHGPTR
	MOV (R1),R5
	JMP @EATAB(R2)
EATAB:	.WORD REG,EA,EAINC,EAIND,EADEC,EADDEF,EAIDX,EAIDXD
REG:	CMP R4,#175000
	BLO ROLD
	JMP CREG
ROLD:	BIT #7400,R4
	JNE FREG
	CMP R4,#170100
	BNE REGST
	MOV (R1),FPS
	BIC #<177777-FPSMSK>,FPS
	JMP RETURN
REGST:	MOV FPS,R0
	CMP R4,#170200
	BEQ REGSAV
	MOV FEC,R0
REGSAV:	MOV R0,(R1)
	JMP RETURN
EAINC:	MOV R5,R0
	ADD R3,R0
	JSR PC,CHANGE
	BR EA
EAIND:	MOV R5,R0
	ADD #2,R0
	JSR PC,CHANGE
	BR INDIRECT
EADEC:	SUB R3,R5
	MOV R5,R0
	JSR PC,CHANGE
	BR EA
EADDEF:	SUB #2,R5
	MOV R5,R0
	JSR PC,CHANGE
	BR INDIRECT
EAIDX:
EAIDXD:	MOV REGS+16,R5
	.WORD 21
; Failed extension read never reaches the PC update. Index R7 uses PC+2.
	MOV R5,REGS+16
	ADD (R1),R0
	MOV R0,R5
	CMP R2,#14
	BEQ EA
INDIRECT:
	.WORD 21
	MOV R0,R5
EA:	CMP R4,#175000
	BLO EAOLD
	JMP CMEM
EAOLD:	BIT #7400,R4
	JNE FMEM
	CMP R4,#170100
	BNE MEMST
	.WORD 21
	MOV R0,FPS
	BIC #<177777-FPSMSK>,FPS
	BR COMMIT
MEMST:	MOV FPS,R0
	CMP R4,#170200
	BEQ STORE1
	MOV FEC,R0
STORE1:	ADD #2,R5
	.WORD 31
	CMP R3,#4
	BNE COMMIT
	MOV FEA,R0
	ADD #4,R5
	.WORD 31
COMMIT:	JSR PC,UPD
	JMP RETURN
UPD:	TST CHGPTR
	BEQ URET
	MOV CHGVAL,@CHGPTR
URET:	RTS PC
; Match J11: R0-R6 autoupdates commit after all operand accesses succeed.
; PC changes are immediate, including an absolute/immediate pointer fetch.
CHANGE:	CMP R1,#REGS+16
	BNE PENDING
	MOV R0,(R1)
	RTS PC
PENDING:
	MOV R1,CHGPTR
	MOV R0,CHGVAL
	RTS PC
; Mode 0 names floating accumulators, not CPU registers. AC6/7 are illegal.
FREG:	MOV R1,R5
	SUB #REGS,R5
	CMP R5,#14
	BLO FRVALID
	JMP UNIMPL
FRVALID:	ASL R5
	ASL R5
	ADD #ACS,R5
	CMP R4,#174000
	BNE FRLOAD
	MOV R5,R1
	MOV ACPTR,R5
	BR FRCOPY
FRLOAD:	CMP R4,#172400
	BNE FREGIN
	MOV ACPTR,R1
; Both operands are validated ACs in HALT FRAM. Preserve the first source
; word for LDF flags; F mode must neither read nor overwrite the low half.
; No USER addressing side effects exist on this path, including self-copy.
FRCOPY:	MOV (R5)+,R0
	MOV R0,(R1)+
	MOV (R5)+,(R1)+
	BIT #200,FPS
	BEQ FRCEND
	MOV (R5)+,(R1)+
	MOV (R5),(R1)
FRCEND:	CMP R4,#174000
	BEQ FRRET
	JSR PC,SETCC
FRRET:	JMP RETURN
FREGIN:	MOV R5,EADDR
	JSR PC,ZBUF
	CMP R4,#170400
	JEQ FEXEC
	MOV #FBUF,R1
	MOV FLEN,R2
	ASR R2
FRIN:	MOV (R5)+,(R1)+
	SOB R2,FRIN
	JMP FEXEC
; Buffer all words before modifying AC/FPS. CLR never reads its destination.
FMEM:	MOV R5,EADDR
	CMP R4,#174000
	JEQ FSTORE
	JSR PC,ZBUF
	CMP R4,#170400
	JEQ FEXEC
	MOV #FBUF,R1
	MOV R3,R2
	ASR R2
FREAD:	.WORD 21
	MOV R0,(R1)+
	SOB R2,FREAD
; Undefined-variable detection applies to memory/immediate, not AC sources.
	MOV FBUF,R0
	BPL FEXEC
	BIT #77600,R0
	BNE FEXEC
	BIT #4000,FPS
	BEQ FEXEC
; FP11-A unary UV exceptions complete the operation first (DEC 1981
; pp. 320/334). Arithmetic/compare/load cancel before execution.
	CMP R4,#170600
	BEQ FUWR
	CMP R4,#170700
	BEQ FUWR
; TST retains the sign while setting flags (FP11-A manual 5.3.8).
	CMP R4,#172400
	BEQ FUVCC
	CMP R4,#170500
	BNE FUV
FUVCC:
	JSR PC,SETCC
FUV:	JSR PC,UPD
	MOV #14,R0
	JMP FPERR
FUWR:	JSR PC,ZBUF
	MOV #170610,R4
	JMP UWRITE
FEXEC:	CMP R4,#172000
	JEQ ARITH
	CMP R4,#173000
	JEQ ARITH
	CMP R4,#172400
	BEQ FLOAD
	CMP R4,#173400
	JEQ FCOMP
	CMP R4,#170500
	BEQ FFLAGS
	CMP R4,#170400
	BEQ UWRITE
	CMP R4,#171000
	JEQ ARITH
	CMP R4,#174400
	JEQ ARITH
	CMP R4,#171400
	JEQ ARITH
	BIT #77600,FBUF
	BNE USIGN
	JSR PC,ZBUF
	BR UWRITE
USIGN:	CMP R4,#170600
	BNE UNEG
	BIC #100000,FBUF
	BR UWRITE
UNEG:	MOV #100000,R0
	XOR R0,FBUF
UWRITE:	MOV EADDR,R5
	MOV #FBUF,R1
	MOV FLEN,R2
	ASR R2
	BIT #70,OPCODE
	BNE USTORE
URCOPY:	MOV (R1)+,(R5)+
	SOB R2,URCOPY
	BR FFLAGS
USTORE:	MOV R3,R2
	ASR R2
	JSR PC,WRITE
FFLAGS:	MOV FBUF,R0
	JSR PC,SETCC
	CMP R4,#170610
	JEQ FUV
	JMP COMMIT
FLOAD:	MOV #FBUF,R5
	MOV ACPTR,R1
FCOPY:	MOV FLEN,R2
	ASR R2
FCOPY1:	MOV (R5)+,(R1)+
	SOB R2,FCOPY1
	CMP R4,#174000
	JEQ COMMIT
	BR FFLAGS
FSTORE:	MOV ACPTR,R1
	MOV R3,R2
	ASR R2
	JSR PC,WRITE
	JMP COMMIT
; R5=USER destination, R1=HALT source, R2=word count. No FPS commit on fault.
WRITE:	ADD #2,R5
FWRITE:	MOV (R1)+,R0
	.WORD 31
	ADD #4,R5
	SOB R2,FWRITE
	RTS PC
ZBUF:	CLR FBUF
	CLR FBUF+2
	CLR FBUF+4
	CLR FBUF+6
	RTS PC
SETCC:	BIC #17,FPS
	TST R0
	BPL FZERO
	BIS #10,FPS
FZERO:	BIT #77600,R0
	BNE FCCRET
	BIS #4,FPS
FCCRET:	RTS PC
; Compare FSRC - AC, treating any zero exponent as exact zero. AC is only
; changed when both operands are zero; its low half is preserved in F mode.
FCOMP:	BIT #77600,FBUF
	BNE CSRC
	JSR PC,ZBUF
CSRC:	MOV ACPTR,R5
	BIT #77600,(R5)
	BNE CAC
	MOV #ZEROS,R5
CAC:	CLR R4
	MOV FBUF,R0
	BPL CSIGN
	MOV #10,R4
CSIGN:	MOV (R5),R1
	XOR R0,R1
	BMI CDONE
	MOV #FBUF,R1
	MOV FLEN,R2
	ASR R2
CLOOP:	CMP (R1)+,(R5)+
	BLO CLESS
	BHI CDONE
	SOB R2,CLOOP
	MOV #4,R4
	TST FBUF
	BNE CDONE
	MOV ACPTR,R1
	MOV FLEN,R2
	ASR R2
CZERO:	CLR (R1)+
	SOB R2,CZERO
	BR CDONE
CLESS:	MOV #10,R0
	XOR R0,R4
CDONE:	BIC #17,FPS
	BIS R4,FPS
	JMP COMMIT
ZEROS:	.WORD 0,0,0,0
; Two 64-bit integer mantissas in little-word order: hidden bit 62,
; seven low guard bits. The same width serves F and D; F ignores AC[31:0].
; No host floating arithmetic, FPGA additions or new microinstructions.
ARITH:	CLR AERR
	CLR AOVF
	MOV ACPTR,R5
	MOV #AMAN,R1
	JSR PC,UNPACK
	MOV R0,AEXP
	MOV R3,ASIGN
	MOV #FBUF,R5
	MOV #BMAN,R1
	JSR PC,UNPACK
	MOV R0,BEXP
	MOV R3,BSIGN
	CMP R4,#171000
	JEQ AMULT
	CMP R4,#174400
	JEQ ADIV
	CMP R4,#171400
	JEQ AMULT
	CMP R4,#173000
	BNE ASORT
	TST BEXP
	BEQ ASORT
	MOV #100000,R0
	XOR R0,BSIGN
ASORT:	CMP AEXP,BEXP
	BLO ASWAP
	BHI AREADY
	MOV #AMAN+10,R1
	MOV #BMAN+10,R2
	MOV #4,R3
ACMPL:	CMP -(R1),-(R2)
	BLO ASWAP
	BHI AREADY
	SOB R3,ACMPL
	BR AREADY
ASWAP:	MOV #AMAN,R1
	MOV #BMAN,R2
	MOV #4,R3
ASWPL:	MOV (R1),R0
	MOV (R2),(R1)+
	MOV R0,(R2)+
	SOB R3,ASWPL
	MOV AEXP,R0
	MOV BEXP,AEXP
	MOV R0,BEXP
	MOV ASIGN,R0
	MOV BSIGN,ASIGN
	MOV R0,BSIGN
AREADY:	TST AEXP
	JEQ AZERO
	TST BEXP
	JEQ APACK
	MOV AEXP,R2
	SUB BEXP,R2
	CMP R2,#64.
	JGE APACK
	TST R2
	BEQ ALIGNED
ASHIFT:	CLC
	ROR BMAN+6
	ROR BMAN+4
	ROR BMAN+2
	ROR BMAN
	SOB R2,ASHIFT
ALIGNED:	MOV ASIGN,R0
	MOV BSIGN,R1
	XOR R1,R0
	JMI ASUB
; Propagate each word's carry before adding the next source word.
	ADD BMAN,AMAN
	BCC AA1
	INC AMAN+2
	BNE AA1
	INC AMAN+4
	BNE AA1
	INC AMAN+6
AA1:	ADD BMAN+2,AMAN+2
	BCC AA2
	INC AMAN+4
	BNE AA2
	INC AMAN+6
AA2:	ADD BMAN+4,AMAN+4
	BCC AA3
	INC AMAN+6
AA3:	ADD BMAN+6,AMAN+6
	BR ACARRY
ASUB:	SUB BMAN,AMAN
	BCC AS1
	DEC AMAN+2
	CMP AMAN+2,#177777
	BNE AS1
	DEC AMAN+4
	CMP AMAN+4,#177777
	BNE AS1
	DEC AMAN+6
AS1:	SUB BMAN+2,AMAN+2
	BCC AS2
	DEC AMAN+4
	CMP AMAN+4,#177777
	BNE AS2
	DEC AMAN+6
AS2:	SUB BMAN+4,AMAN+4
	BCC AS3
	DEC AMAN+6
AS3:	SUB BMAN+6,AMAN+6
	MOV AMAN,R0
	BIS AMAN+2,R0
	BIS AMAN+4,R0
	BIS AMAN+6,R0
	JEQ AZERO
ANORM:	BIT #40000,AMAN+6
	BNE AROUND
	ASL AMAN
	ROL AMAN+2
	ROL AMAN+4
	ROL AMAN+6
	DEC AEXP
	BR ANORM
ACARRY:	TST AMAN+6
	BPL AROUND
	JSR PC,ARIGHT
	INC AEXP
AROUND:	BIT #40,FPS
	BNE APACK
	BIT #200,FPS
	BEQ AFROUND
	BIT #100,AMAN
	BEQ APACK
	ADD #200,AMAN
	ADC AMAN+2
	ADC AMAN+4
	ADC AMAN+6
	BR ARCARR
AFROUND:	BIT #100,AMAN+4
	BEQ APACK
	ADD #200,AMAN+4
	ADC AMAN+6
ARCARR:	TST AMAN+6
	BPL APACK
	JSR PC,ARIGHT
	INC AEXP
APACK:	MOV #7,R2
APSHFT:	JSR PC,ARIGHT
	SOB R2,APSHFT
	MOV AEXP,R0
	BIC #177400,R0
	ASH #7,R0
	BIS ASIGN,R0
	BIC #177600,AMAN+6
	BIS AMAN+6,R0
	MOV R0,FBUF
	MOV AMAN+4,FBUF+2
	MOV AMAN+2,FBUF+4
	MOV AMAN,FBUF+6
	CMP AEXP,#377
	BGT AOVER
	TST AEXP
	BGT ACOMIT
	BIT #2000,FPS
	BEQ AZERO
	MOV #12,AERR
	BR ACOMIT
AOVER:	MOV #2,AOVF
	BIT #1000,FPS
	BEQ AZERO
	MOV #10,AERR
	BR ACOMIT
AZERO:	JSR PC,ZBUF
ACOMIT:	MOV ACPTR,R1
	MOV #FBUF,R5
	MOV FLEN,R2
	ASR R2
ARES:	MOV (R5)+,(R1)+
	SOB R2,ARES
	MOV FBUF,R0
	JSR PC,SETCC
	BIS AOVF,FPS
	JSR PC,UPD
	MOV AERR,R0
	JNE FPERR
	JMP RETURN
ARIGHT:	CLC
	ROR AMAN+6
	ROR AMAN+4
	ROR AMAN+2
	ROR AMAN
	RTS PC
; Shift/add multiply retains seven guard bits. Each right shift discards
; only bits below the retained product, including after one normalization.
; PMAN is the product/quotient; operands remain private until ACOMIT.
AMULT:	TST AEXP
	JEQ MZERO
	TST BEXP
	JEQ MZERO
	ADD BEXP,AEXP
	SUB #128.,AEXP
	JSR PC,MDINIT
; BMAN becomes the unguarded 56-bit multiplier (24 bits in F mode).
	MOV #7,R2
MSHIFT:	JSR PC,BRIGHT
	SOB R2,MSHIFT
	MOV #56.,R4
	BIT #200,FPS
	BNE MLOOP
	MOV BMAN+4,BMAN
	MOV BMAN+6,BMAN+2
	CLR BMAN+4
	CLR BMAN+6
	MOV #24.,R4
MLOOP:	JSR PC,BRIGHT
	BCC MRIGHT
	ADD AMAN,PMAN
	BCC MA1
	INC PMAN+2
	BNE MA1
	INC PMAN+4
	BNE MA1
	INC PMAN+6
MA1:	ADD AMAN+2,PMAN+2
	BCC MA2
	INC PMAN+4
	BNE MA2
	INC PMAN+6
MA2:	ADD AMAN+4,PMAN+4
	BCC MA3
	INC PMAN+6
MA3:	ADD AMAN+6,PMAN+6
MRIGHT:	CLC
	ROR PMAN+6
	ROR PMAN+4
	ROR PMAN+2
	ROR PMAN
	SOB R4,MLOOP
	MOV #ANORM,R4
	BIT #400,OPCODE
	BEQ MDONE
	MOV #MNORM,R4
	BR MDONE
; DIV by exponent-zero source precedes dividend zero. No AC or NZVC write;
; successful EA autoupdates still commit, including when FID inhibits trap.
ADIV:	TST BEXP
	BNE DNONZ
	JSR PC,UPD
	MOV #4,R0
	JMP FPERR
DNONZ:	TST AEXP
	JEQ AZERO
	SUB BEXP,AEXP
	ADD #129.,AEXP
	JSR PC,MDINIT
	MOV #PMAN,R5
	MOV #63.,R4
	BIT #200,FPS
	BNE DLOOP
	ADD #4,R5
	MOV #31.,R4
; Restoring division: remainder < 2*divisor fits unsigned 64 bits. F builds
; the quotient in PMAN[63:32]; D uses all words. No premature rounding.
DLOOP:	ASL PMAN
	ROL PMAN+2
	ROL PMAN+4
	ROL PMAN+6
	MOV #AMAN+10,R1
	MOV #BMAN+10,R2
	MOV #4,R3
DCMPL:	CMP -(R1),-(R2)
	BLO DNEXT
	BHI DSUB
	SOB R3,DCMPL
DSUB:	SUB BMAN,AMAN
	BCC DS1
	DEC AMAN+2
	CMP AMAN+2,#177777
	BNE DS1
	DEC AMAN+4
	CMP AMAN+4,#177777
	BNE DS1
	DEC AMAN+6
DS1:	SUB BMAN+2,AMAN+2
	BCC DS2
	DEC AMAN+4
	CMP AMAN+4,#177777
	BNE DS2
	DEC AMAN+6
DS2:	SUB BMAN+4,AMAN+4
	BCC DS3
	DEC AMAN+6
DS3:	SUB BMAN+6,AMAN+6
	BIS #1,(R5)
DNEXT:	ASL AMAN
	ROL AMAN+2
	ROL AMAN+4
	ROL AMAN+6
	DEC R4
	BNE DLOOP
	MOV #ANORM,R4
MDONE:	MOV PMAN,AMAN
	MOV PMAN+2,AMAN+2
	MOV PMAN+4,AMAN+4
	MOV PMAN+6,AMAN+6
	JMP (R4)
MDINIT:	MOV BSIGN,R0
	XOR R0,ASIGN
	CLR PMAN
	CLR PMAN+2
	CLR PMAN+4
	CLR PMAN+6
	RTS PC
BRIGHT:	CLC
	ROR BMAN+6
	ROR BMAN+4
	ROR BMAN+2
	ROR BMAN
	RTS PC
; FP11-A MOD develops 48 exact F bits / 59 D product bits (DEC 1978
; table 5-2, DEC 1983 pp.147-149). Discard four CP74 guard positions
; BEFORE the optional normalization; F's exact product already has zeros.
MNORM:	BIC #17,AMAN
	BIT #40000,AMAN+6
	BNE MSPLIT
	ASL AMAN
	ROL AMAN+2
	ROL AMAN+4
	ROL AMAN+6
	DEC AEXP
MSPLIT:	CMP AEXP,#128.
	BGT MWHOLE
	JSR PC,MZINT
	JMP AROUND
MWHOLE:	MOV AMAN,BMAN
	MOV AMAN+2,BMAN+2
	MOV AMAN+4,BMAN+4
	MOV AMAN+6,BMAN+6
	MOV #152.,R0
	BIT #200,FPS
	BEQ MLIMIT
	ADD #32.,R0
MLIMIT:	CMP AEXP,R0
	BLE MMASK
; Product >= 2**L: integer is always chopped, fractional result is zero.
	JSR PC,MPINT
	JMP AZERO
MMASK:	MOV AEXP,R4
	SUB #128.,R4
	MOV #177777,PMAN
	MOV PMAN,PMAN+2
	MOV PMAN,PMAN+4
	MOV #77777,PMAN+6
MMLOOP:	CLC
	ROR PMAN+6
	ROR PMAN+4
	ROR PMAN+2
	ROR PMAN
	SOB R4,MMLOOP
; BMAN keeps the integer bits; AMAN keeps the fractional bits. Sources
; have already been buffered, including aliases with the second AC.
	MOV #AMAN,R1
	MOV #BMAN,R2
	MOV #PMAN,R3
	MOV #4,R4
MAND:	MOV (R3)+,R0
	BIC R0,(R2)+
	COM R0
	BIC R0,(R1)+
	SOB R4,MAND
	JSR PC,MPINT
	MOV AMAN,R0
	BIS AMAN+2,R0
	BIS AMAN+4,R0
	BIS AMAN+6,R0
	JEQ AZERO
	JMP ANORM
; Only MUL/MOD reach this zero shortcut. MOD also clears its integer AC.
MZERO:	BIT #400,OPCODE
	JEQ AZERO
	JSR PC,MZINT
	JMP AZERO
; Store a positive exact integer zero only for even destination AC.
MZINT:	BIT #100,OPCODE
	BNE MIRET
	MOV ACPTR,R1
	ADD #10,R1
	MOV FLEN,R2
	ASR R2
MZLOOP:	CLR (R1)+
	SOB R2,MZLOOP
MIRET:	RTS PC
; Pack BMAN WITHOUT rounding. Even when AC is odd (integer discarded),
; overflow sets FV/FEC. Fractional AC/FPS commit and trap happen later.
MPINT:	CMP AEXP,#377
	BLE MIPACK
	MOV #2,AOVF
	BIT #1000,FPS
	BEQ MZINT
	MOV #10,AERR
MIPACK:	BIT #100,OPCODE
	BNE MIRET
	MOV #7,R2
MISHFT:	JSR PC,BRIGHT
	SOB R2,MISHFT
	MOV AEXP,R0
	BIC #177400,R0
	ASH #7,R0
	BIS ASIGN,R0
	BIC #177600,BMAN+6
	BIS R0,BMAN+6
	MOV ACPTR,R1
	ADD #10,R1
	MOV #BMAN+10,R5
	MOV FLEN,R2
	ASR R2
MICOPY:	MOV -(R5),(R1)+
	SOB R2,MICOPY
	RTS PC
; CP76 conversion operand widths. R1/R2 retain the shared EA inputs.
; CLEN is actual USER operand length; FLEN is floating result width.
CSIZE:	CLR AERR
	CLR AOVF
	CLR BEXP
	MOV OPCODE,R0
	BIC #177477,R0
	ASR R0
	ASR R0
	ASR R0
	ADD #ACS,R0
	MOV R0,ACPTR
	MOV #4,FLEN
	BIT #200,FPS
	BEQ CTYPE
	MOV #10,FLEN
CTYPE:	CMP R4,#176000
	BEQ CSTSIZE
	CMP R4,#177400
	BEQ CLDSIZE
	CMP R4,#175400
	BEQ CISIZE
	CMP R4,#177000
	BNE CSHORT
CISIZE:	BIT #100,FPS
	BEQ CSHORT
	MOV #4,R3
	BR CSHORT
CSTSIZE:	MOV #14,R3
	SUB FLEN,R3
	MOV R3,FLEN
	BR CSHORT
CLDSIZE:	MOV #14,R3
	SUB FLEN,R3
CSHORT:	MOV OPCODE,R0
	BIC #177700,R0
	CMP R0,#27
	BNE CSIZED
	MOV #2,R3
CSIZED:	MOV R3,CLEN
	JMP XD
CREG:	MOV R1,EADDR
	CMP R4,#176000
	BEQ CRFLOAT
	CMP R4,#177400
	BEQ CRFLOAT
	JSR PC,ZBUF
	CMP R4,#175000
	JEQ CSTE
	CMP R4,#175400
	JEQ CSTI
	MOV (R1),FBUF
	JMP CEXEC
CRFLOAT:	MOV R1,R5
	SUB #REGS,R5
	CMP R5,#14
	BLO CRVALID
	JMP UNIMPL
CRVALID:	ASL R5
	ASL R5
	ADD #ACS,R5
	MOV R5,EADDR
	JSR PC,ZBUF
	CMP R4,#176000
	JEQ CSTF
	MOV CLEN,R2
	ASR R2
	MOV #FBUF,R1
CRREAD:	MOV (R5)+,(R1)+
	SOB R2,CRREAD
	JMP CEXEC
CMEM:	MOV R5,EADDR
	JSR PC,ZBUF
	CMP R4,#175000
	JEQ CSTE
	CMP R4,#175400
	JEQ CSTI
	CMP R4,#176000
	JEQ CSTF
	MOV #FBUF,R1
	MOV CLEN,R2
	ASR R2
CMREAD:	.WORD 21
	MOV R0,(R1)+
	SOB R2,CMREAD
	CMP R4,#177400
	BNE CEXEC
	MOV FBUF,R0
	BPL CEXEC
	BIT #77600,R0
	BNE CEXEC
	BIT #4000,FPS
	BEQ CEXEC
; DEC 1983 p143: flags reflect fetched -0 even when FIUV aborts LDC.
	JSR PC,SETCC
	JMP FUV
CEXEC:	CMP R4,#176400
	JEQ CLDE
	CMP R4,#177000
	JEQ CLDI
; LDC F/D: canonical zero; retain the fetched -0 sign in condition codes.
	BIT #77600,FBUF
	BNE CROUND
	TST FBUF
	BPL CZLOAD
	MOV #10,BEXP
CZLOAD:	JSR PC,ZBUF
	BR CROUND
CSTF:	JSR PC,CGETAC
	BIT #77600,FBUF
	BNE CROUND
	JSR PC,ZBUF
CROUND:	CMP FLEN,#4
	BNE CREADY
	BIT #40,FPS
	BNE CREADY
	TST FBUF+4
	BPL CREADY
	MOV FBUF,R0
	ADD #1,FBUF+2
	ADC FBUF
	MOV FBUF,R1
	XOR R1,R0
	BPL CREADY
	MOV #100000,R0
	XOR R0,FBUF
	MOV #2,AOVF
	BIT #1000,FPS
	BNE CROVF
	JSR PC,ZBUF
	BR CREADY
CROVF:	MOV #10,AERR
CREADY:	CMP R4,#176000
	BEQ CFSTORE
	MOV ACPTR,R5
	BR CFCOPY
CFSTORE:	MOV EADDR,R5
	BIT #70,OPCODE
	BEQ CFCOPY
	MOV #FBUF,R1
	MOV CLEN,R2
	ASR R2
	JSR PC,WRITE
	BR CFCOM
CFCOPY:	MOV #FBUF,R1
	MOV FLEN,R2
	ASR R2
CFCPLP:	MOV (R1)+,(R5)+
	SOB R2,CFCPLP
CFCOM:	MOV FBUF,R0
	JSR PC,SETCC
	BIS AOVF,FPS
	BIS BEXP,FPS
	JMP CFIN
; Copy the current precision AC into a zero-padded FBUF.
CGETAC:	MOV ACPTR,R5
	MOV #FBUF,R1
	MOV #2,R2
	BIT #200,FPS
	BEQ CGLOOP
	MOV #4,R2
CGLOOP:	MOV (R5)+,(R1)+
	SOB R2,CGLOOP
	RTS PC
CLDE:	MOV FBUF,BEXP
	JSR PC,CGETAC
	MOV BEXP,R0
	ADD #200,R0
	BIC #177400,R0
	ASH #7,R0
	BIC #77600,FBUF
	BIS R0,FBUF
	CMP BEXP,#177
	BGT CEOVER
	CMP BEXP,#177600
	BGT CEOK
	BIT #2000,FPS
	BEQ CEZERO
	MOV #12,AERR
	BR CEOK
CEOVER:	MOV #2,AOVF
	BIT #1000,FPS
	BEQ CEZERO
	MOV #10,AERR
	BR CEOK
CEZERO:	JSR PC,ZBUF
CEOK:	JMP ACOMIT
; Integer is left justified: short in FBUF, long in FBUF:FBUF+2.
CLDI:	CLR AMAN
	CLR AMAN+2
	MOV FBUF+2,AMAN+4
	MOV FBUF,AMAN+6
	MOV FBUF,ASIGN
	BIC #77777,ASIGN
	BEQ CIZTEST
	COM AMAN+4
	COM AMAN+6
	ADD #1,AMAN+4
	ADC AMAN+6
CIZTEST:	MOV AMAN+4,R0
	BIS AMAN+6,R0
	JEQ AZERO
	MOV #144.,AEXP
	BIT #100,FPS
	BEQ CINTN
	MOV #160.,AEXP
CINTN:	JSR PC,ARIGHT
	JMP ANORM
CSTE:	MOV @ACPTR,R0
	BIC #100177,R0
	ASH #-7,R0
	SUB #200,R0
	MOV R0,FBUF
	BR CICC
; Always chop the magnitude towards zero; the most negative integer fits.
CSTI:	MOV ACPTR,R5
	MOV #AMAN,R1
	JSR PC,UNPACK
	MOV R3,ASIGN
	CMP R0,#128.
	BLE CIZERO
	MOV #144.,R1
	BIT #100,FPS
	BEQ CILIMIT
	MOV #160.,R1
CILIMIT:	CMP R0,R1
	BGT CIERR
	MOV #191.,R4
	SUB R0,R4
CISHFT:	JSR PC,ARIGHT
	SOB R4,CISHFT
	BIT #100,FPS
	BNE CILONG
	MOV AMAN,R0
	TST ASIGN
	BEQ CIPOS
	CMP R0,#100000
	BHI CIERR
	BR CISIGN
CILONG:	MOV AMAN+2,R0
	TST ASIGN
	BEQ CIPOS
	CMP R0,#100000
	BHI CIERR
	BLO CISIGN
	TST AMAN
	BNE CIERR
	BR CISIGN
CIPOS:	TST R0
	BMI CIERR
CISIGN:	TST ASIGN
	BEQ CIPACK
	COM AMAN
	COM AMAN+2
	ADD #1,AMAN
	ADC AMAN+2
CIPACK:	MOV AMAN,FBUF
	BIT #100,FPS
	BEQ CICC
	MOV AMAN,FBUF+2
	MOV AMAN+2,FBUF
	BR CICC
CIERR:	MOV #1,BEXP
	BIT #400,FPS
	BEQ CIZERO
	MOV #6,AERR
CIZERO:	JSR PC,ZBUF
CICC:	TST FBUF
	BPL CIZFLAG
	BIS #10,BEXP
CIZFLAG:	MOV FBUF,R0
	BIS FBUF+2,R0
	BNE CISTORE
	BIS #4,BEXP
CISTORE:	MOV EADDR,R5
	BIT #70,OPCODE
	BNE CIMEM
	MOV FBUF,(R5)
	BR CICOM
CIMEM:	MOV #FBUF,R1
	MOV CLEN,R2
	ASR R2
	JSR PC,WRITE
; Both FPS and CPU NZVC commit only after all operand stores succeed.
CICOM:	BIC #17,REGS+20
	BIS BEXP,REGS+20
	BIC #17,FPS
	BIS BEXP,FPS
CFIN:	JSR PC,UPD
	MOV AERR,R0
	JNE FPERR
	JMP RETURN
; R5=raw operand, R1=64-bit output; returns R0=exponent, R3=sign.
; Exponent-zero encodings become exact positive zero before arithmetic.
UNPACK:	MOV (R5)+,R0
	MOV R0,R3
	BIC #77777,R3
	MOV R0,6(R1)
	BIC #177600,6(R1)
	BIS #200,6(R1)
	BIC #100177,R0
	ASH #-7,R0
	MOV (R5)+,4(R1)
	CLR 2(R1)
	CLR (R1)
	BIT #200,FPS
	BEQ UPZERO
	MOV (R5)+,2(R1)
	MOV (R5),(R1)
UPZERO:	TST R0
	BNE UPSHFT
	CLR (R1)
	CLR 2(R1)
	CLR 4(R1)
	CLR 6(R1)
	CLR R3
	RTS PC
UPSHFT:	MOV #7,R2
UPLOOP:	ASL (R1)
	ROL 2(R1)
	ROL 4(R1)
	ROL 6(R1)
	SOB R2,UPLOOP
	RTS PC
; Reserved controls and invalid AC6/AC7 encodings report illegal FP opcode.
UNIMPL:	MOV #2,R0
FPERR:	MOV R0,FEC
	MOV OPADDR,FEA
	BIS #100000,FPS
	BIT #40000,FPS
	JNE RETURN
	MOV #244,TVEC
	BR TRAP
BUSERR:	TST INTRAP
	BNE FATAL
	MOV #4,TVEC
; Construct the usual unbanked CPU frame: PSW then PC, then read the vector.
; A fault during this construction is terminal, as with the base CPU.
TRAP:	MOV #1,INTRAP
	MOV REGS+14,R5
	MOV REGS+20,R0
	.WORD 31
	MOV REGS+16,R0
	.WORD 31
	MOV R5,REGS+14
	MOV TVEC,R5
	.WORD 21
	MOV R0,REGS+16
	.WORD 21
	MOV R0,REGS+20
RETURN:	MOV OLDVEC,@#4
	MOV OLDVEC+2,@#6
	MOV REGS+16,@#CPC
	MOV REGS+20,@#CPSW
	MOV REGS,R0
	MOV REGS+2,R1
	MOV REGS+4,R2
	MOV REGS+6,R3
	MOV REGS+10,R4
	MOV REGS+12,R5
	MOV REGS+14,SP
	.WORD 10
FATAL:	HALT
; Mutable state is excluded from the retained image checksum.
IMMEND:
FPS:	.BLKW 1
FEC:	.BLKW 1
FEA:	.BLKW 1
ACS:	.BLKW 24.
REGS:	.BLKW 9.
OLDVEC:	.BLKW 2
OPADDR:	.BLKW 1
OPCODE:	.BLKW 1
TVEC:	.BLKW 1
INTRAP:	.BLKW 1
CHGPTR:	.BLKW 1
CHGVAL:	.BLKW 1
ACPTR:	.BLKW 1
FLEN:	.BLKW 1
CLEN:	.BLKW 1
EADDR:	.BLKW 1
FBUF:	.BLKW 4
AMAN:	.BLKW 4
BMAN:	.BLKW 4
PMAN:	.BLKW 4
AEXP:	.BLKW 1
BEXP:	.BLKW 1
ASIGN:	.BLKW 1
BSIGN:	.BLKW 1
AERR:	.BLKW 1
AOVF:	.BLKW 1
STACK:	.BLKW 64.
STKTOP:
MEMEND:
	.END INIT
