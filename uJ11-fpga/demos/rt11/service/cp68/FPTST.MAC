	.TITLE FPTST
	.IDENT /00.01/
; CP68 RT-11 test. The debugger steps the two FP opcodes at ENTRY, then
; redirects PC to FINISH so that RT-11's normal exit restores the monitor.
	.MCALL .PRINT,.EXIT
	.PSECT TEST,I,RW
START:	.PRINT #HELLO
	SPL 7
	BR ENTRY
ENTRY:	SETD
	SETL
	STFPS R1
	BR .
FINISH:	SPL 0
	.PRINT #DONE
	.EXIT
HELLO:	.ASCIZ /!FPTST-I-CONTROL TEST/
DONE:	.ASCIZ /!FPTST-I-RETURNED TO RT11/
	.EVEN
	.END START
