	.TITLE	UJLOAD
	.IDENT	/02.00/
; CP62 ABI2 loader. RT-11 file calls + HALT vector resident calls only.
; HALT helper is embedded here and copied into FRAM; no added FPGA ROM.
	.MCALL	.PRINT,.EXIT,.GTLIN,.LOOKUP,.READW,.CLOSE
	.ENABL	LC

	.MACRO	JNE DST,?OK
	BEQ	OK
	JMP	DST
OK:
	.ENDM
	.MACRO	JEQ DST,?OK
	BNE	OK
	JMP	DST
OK:
	.ENDM
	.MACRO	JCS DST,?OK
	BCC	OK
	JMP	DST
OK:
	.ENDM
	.MACRO	JHI DST,?OK
	BLOS	OK
	JMP	DST
OK:
	.ENDM
	.MACRO	JLO DST,?OK
	BHIS	OK
	JMP	DST
OK:
	.ENDM

HDBYT=512.
PAYSIZ=14			; header offsets (octal)
MEMSIZ=16
ENTRY=20
FAULT=22
CKSUM=24

	.PSECT	LOAD,I,RW
START:	JSR	PC,UPLOAD
	JCS	NOHELP
	MOV	#4,DESC
	JSR	PC,API
	BCS	NOHELP
	CMP	R0,#125062
	BNE	NOHELP
4$:	.GTLIN	#LINE,#PROMPT
	MOV	#CMDS,R4
5$:	MOV	(R4)+,R2
	BEQ	6$
	MOV	#LINE,R1
	JSR	PC,STREQ
	BEQ	7$
	TST	(R4)+
	BR	5$
7$:	JMP	@(R4)
6$:	JSR	PC,NAME50
	BCC	LOAD
	.PRINT	#USAGE
	.EXIT
NOHELP:	.PRINT	#UNSUP
	.EXIT
STREQ:	CMPB	(R1)+,(R2)+
	BNE	1$
	TSTB	-1(R1)
	BNE	STREQ
1$:	RTS	PC

; One to six uppercase letters/digits, no device or extension. SY: is
; resident; using a fixed .BIN extension also forbids raw-device LOOKUP.
NAME50:	TSTB	LINE
	BEQ	8$
	MOV	#LINE,R2
	MOV	#SPEC+2,R3
1$:	CLR	R1
	MOV	#3,R5
2$:	CLR	R4
	TSTB	(R2)
	BEQ	5$
	MOVB	(R2)+,R4
	CMP	R4,#'A
	BLO	3$
	CMP	R4,#'Z
	BHI	8$
	SUB	#100,R4
	BR	5$
3$:	CMP	R4,#'0
	BLO	8$
	CMP	R4,#'9
	BHI	8$
	SUB	#18.,R4
5$:	MOV	R1,R0
	MUL	#40.,R0
	ADD	R4,R1
	SOB	R5,2$
	MOV	R1,(R3)+
	CMP	R3,#SPEC+6
	BLO	1$
	TSTB	(R2)
	BNE	8$
	CLC
	RTS	PC
8$:	SEC
	RTS	PC

LOAD:	.LOOKUP #AREA,#0,#SPEC
	BCC	1$
	.PRINT	#OPNERR
	.EXIT
1$:	MOV	R0,FLEN
	.READW	#AREA,#0,#HEADER,#256.,#0
	JCS	RDFAIL
	JSR	PC,VALID
	JCS	HDFAIL
; VALID has set the fixed slot, vector, wrapper and ready mask.
; Until here errors preserve both old modules. From here target stays off
; after any readback/checksum/disk error or CTRL/C, including a cold reset.
	JSR	PC,GETST
	JCS	VRFAIL
	BIC	#177774,R0
	BIC	KIND,R0
	MOV	R0,OTHER
	BEQ	2$
	JSR	PC,CHKCOM
	JCS	ABFAIL
2$:	MOV	OTHER,R0
	JSR	PC,SETST
	JCS	VRFAIL
	.PRINT	#WRMSG
	CLR	TOTAL
	MOV	#1,BLOCK
	MOV	HEADER+PAYSIZ,LEFT
	MOV	BASE,CURSOR
NXTBLK:	.READW	#AREA,#0,#BUFFER,#256.,BLOCK
	JCS	RDFAIL
	MOV	#256.,R4
	CMP	LEFT,#HDBYT
	BHIS	1$
	MOV	LEFT,R4
	ASR	R4
1$:	MOV	R4,COUNT
	MOV	#BUFFER,R2
	MOV	CURSOR,R5
COPY:	MOV	R4,R0
	CMP	R0,#10
	BLOS	3$
	MOV	#10,R0
3$:	MOV	R0,XCOUNT
	MOV	R2,DESC+6
	MOV	#7,DESC
	JSR	PC,API
	JCS	VRFAIL
	MOV	XCOUNT,R3
4$:	ADD	(R2)+,TOTAL
	ADD	#2,R5
	DEC	R4
	SOB	R3,4$
	TST	R4
	BNE	COPY
	MOV	R5,CURSOR
; File padding must be zero and cannot hide a second payload.
1$:	CMP	R2,#BUFFER+HDBYT
	BHIS	2$
	TST	(R2)+
	JNE	CKFAIL
	BR	1$
2$:	MOV	COUNT,R0
	ASL	R0
	SUB	R0,LEFT
	INC	BLOCK
	TST	LEFT
	JNE	NXTBLK
	CMP	TOTAL,HEADER+CKSUM
	JNE	CKFAIL
; Zero all declared BSS/stack/scratch storage, including raw I/O backing.
	MOV	HEADER+MEMSIZ,R4
	SUB	HEADER+PAYSIZ,R4
	CLC
	ROR	R4
	BEQ	VERIFY
ZERO:	MOV	#6,R3
	JSR	PC,BLOCKIO
	TST	R4
	BNE	ZERO
; A second complete read catches corruption after the immediate word checks.
VERIFY:	MOV	BASE,R5
	MOV	HEADER+PAYSIZ,R4
	CLC
	ROR	R4
	CLR	R1
1$:	MOV	#5,R3
	JSR	PC,BLOCKIO
	ADD	R0,R1
	TST	R4
	BNE	1$
	CMP	R1,HEADER+CKSUM
	JNE	CKFAIL
	MOV	HEADER+MEMSIZ,R4
	SUB	HEADER+PAYSIZ,R4
	CLC
	ROR	R4
	BEQ	ZERODN
2$:	MOV	#10,R3
	JSR	PC,BLOCKIO
	TST	R4
	BNE	2$
ZERODN:
PUBWRP:	MOV	HEADER+FAULT,WRDATA+2
	MOV	HEADER+ENTRY,WRDATA+10
	MOV	#WRDATA,R2
	MOV	WRAP,R5
	MOV	#5,R4
1$:	MOV	(R2)+,R0
	JSR	PC,PUTCHK
	JCS	VRFAIL
	ADD	#2,R5
	SOB	R4,1$
; Permanent vectors select these wrappers only after SETST enables the slot.
COMMIT:	JSR	PC,GETST
	JCS	VRFAIL
	BIC	#177774,R0
	BIS	KIND,R0
	JSR	PC,SETST
	JCS	VRFAIL
	.CLOSE	#0
	CMP	KIND,#1
	BNE	1$
	.PRINT	#ODTOK
	.EXIT
1$:	.PRINT	#FPOK
	.EXIT
PUTCHK:	MOV	R0,R3
	JSR	PC,WRWORD
	JCS	VRFAIL
	JSR	PC,RDWORD
	JCS	VRFAIL
	CMP	R0,R3
	BNE	1$
	CLC
	RTS	PC
1$:	SEC
	RTS	PC
CHKCOM:	MOV	#COMMON,R2
	MOV	#5,R4
1$:	MOV	(R2)+,R5
	JSR	PC,RDWORD
	JCS	VRFAIL
	CMP	R0,(R2)+
	BNE	2$
	SOB	R4,1$
	CLC
	RTS	PC
2$:	SEC
	RTS	PC

; Bounded payload checksum/BSS operations, R4 words left, R5 raw address.
BLOCKIO:	MOV	R4,R0
	CMP	R0,#10
	BLOS	1$
	MOV	#10,R0
1$:	MOV	R0,XCOUNT
	MOV	R3,DESC
	JSR	PC,API
	JCS	VRFAIL
	SUB	XCOUNT,R4
	ADD	XCOUNT,R5
	ADD	XCOUNT,R5
	RTS	PC
XCOUNT:	.WORD	0
; Each HALT call preserves the loader's registers and uses a USER descriptor.
; The only raw instructions are inside HELPER, executing from HALT FRAM.
RDWORD:	CLR	DESC
	BR	API
WRWORD:	MOV	#1,DESC
	BR	API
SETST:	MOV	#2,DESC
	BR	API
GETST:	MOV	#3,DESC
API:	MOV	R0,DESC+4
	MOV	R5,DESC+2
	MOV	R1,-(SP)
	MOV	R2,-(SP)
	MOV	R3,-(SP)
	MOV	R4,-(SP)
	MOV	R5,-(SP)
	MOV	#125061,R4
	MOV	#1000,R1
	CLR	R2
	MOV	#DESC,R5
	HALT
	MOV	R2,ERRFLG
	MOV	(SP)+,R5
	MOV	(SP)+,R4
	MOV	(SP)+,R3
	MOV	(SP)+,R2
	MOV	(SP)+,R1
; MOV changes N/Z, so save the status separately before restoring registers.
	TST	ERRFLG
	BNE	APIERR
	CLC
	RTS	PC
APIERR:	SEC
	RTS	PC
UPLOAD:	MOV	#HELPER,R5
	MOV	#1000,R1
	MOV	#125061,R4
	MOV	#HCNT,R3
1$:	MOV	#100,R2
	CMP	R3,R2
	BHIS	2$
	MOV	R3,R2
2$:	MOV	R3,-(SP)
	SUB	R2,(SP)
	HALT
	MOV	(SP)+,R3
	TST	R0
	BNE	APIERR
	TST	R3
	BNE	1$
	CLC
	RTS	PC
DESC:	.BLKW	4
ERRFLG:	.WORD	0

; Header and exact RT-11 block extent. All range comparisons are unsigned;
; FP slot ends at physical 200000 octal (65536), not a 16-bit end pointer.
VALID:	CMP	HEADER,#45125
	JNE	BADHDR
	CMP	HEADER+2,#30461
	JNE	BADHDR
	CMP	HEADER+4,#1
	JNE	BADHDR
	CMP	HEADER+6,#2
	JNE	BADHDR
	MOV	HEADER+10,KIND
	CMP	KIND,#1
	BEQ	1$
	CMP	KIND,#2
	JNE	BADHDR
	MOV	#40000,BASE
	MOV	#140000,MAXMEM
	MOV	#2020,WRAP
	MOV	#10,VECT
	BR	2$
1$:	MOV	#10000,BASE
	MOV	#30000,MAXMEM
	MOV	#2000,WRAP
	MOV	#170,VECT
2$:	CMP	HEADER+12,BASE
	JNE	BADHDR
	MOV	HEADER+PAYSIZ,R0
	JEQ	BADHDR
	BIT	#1,R0
	JNE	BADHDR
	MOV	HEADER+MEMSIZ,R1
	BIT	#1,R1
	JNE	BADHDR
	CMP	R0,R1
	JHI	BADHDR
	CMP	R1,MAXMEM
	JHI	BADHDR
	MOV	#HEADER+ENTRY,R2
	MOV	#2,R3
3$:	MOV	(R2)+,R1
	BIT	#1,R1
	JNE	BADHDR
	CMP	R1,#160000
	BHIS	BADHDR
	SUB	BASE,R1
	JCS	BADHDR
	CMP	R1,R0
	BHIS	BADHDR
	SOB	R3,3$
; Header checksum is an independent modulo-65536 sum of its 16 words.
	MOV	#HEADER,R2
	MOV	#16.,R3
	CLR	R1
4$:	ADD	(R2)+,R1
	SOB	R3,4$
	TST	R1
	BNE	BADHDR
; Flags/reserved words and the remaining 480 header bytes must be zero.
	MOV	#HEADER+30,R2
5$:	TST	(R2)+
	BNE	BADHDR
	CMP	R2,#HEADER+HDBYT
	BLO	5$
	ADD	#511.,R0
	SWAB	R0
	BIC	#177400,R0
	CLC
	ROR	R0
	ADD	#1,R0
	CMP	R0,FLEN
	BNE	BADHDR
	CLC
	RTS	PC
BADHDR:	SEC
	RTS	PC

HDFAIL:	MOV	#HDRERR,R0
	BR	FAIL
ABFAIL:	MOV	#ABIERR,R0
	BR	FAIL
RDFAIL:	MOV	#READER,R0
	BR	FAIL
VRFAIL:	MOV	#VERERR,R0
	BR	FAIL
CKFAIL:	MOV	#CHKERR,R0
FAIL:	.PRINT
	.CLOSE	#0
	.EXIT
OFFODT:	MOV	#1,R1
	BR	OFF
OFFFP:	MOV	#2,R1
OFF:	JSR	PC,GETST
	JCS	VRFAIL
	BIC	#177774,R0
	BIC	R1,R0
	JSR	PC,SETST
	JCS	VRFAIL
STATUS:	JSR	PC,GETST
	JCS	VRFAIL
	MOVB	#'0,STAT+4
	MOVB	#'0,STAT+11.
	BIT	#1,R0
	BEQ	1$
	INCB	STAT+4
1$:	BIT	#2,R0
	BEQ	2$
	INCB	STAT+11.
2$:	.PRINT	#STAT
EXIT:	.EXIT

; The persistent boot gate owns HALT vector 170. ABI2 module return is
; JMP @000166 (module-return routine restores SEL004 before START).
COMMON:	.WORD	4,312,6,340,166,1700,10,2020,12,340
WRDATA:	.WORD	12737,0,4,137,0
CMDS:	.WORD	STACMD,STATUS,ODTOFF,OFFODT,FPOFF,OFFFP,QUIT,EXIT,0
SPEC:	.RAD50	/SY /
	.WORD	0,0
	.RAD50	/BIN/
AREA:	.BLKW	5
FLEN:	.WORD	0
KIND:	.WORD	0
BASE:	.WORD	0
MAXMEM:	.WORD	0
WRAP:	.WORD	0
VECT:	.WORD	0
OTHER:	.WORD	0
BLOCK:	.WORD	0
LEFT:	.WORD	0
COUNT:	.WORD	0
CURSOR:	.WORD	0
TOTAL:	.WORD	0
STACMD:	.ASCIZ	/STATUS/
ODTOFF:	.ASCIZ	/OFFODT/
FPOFF:	.ASCIZ	/OFFFP/
QUIT:	.ASCIZ	/EXIT/
PROMPT:	.ASCII	/UJLOAD> /
	.BYTE	200
USAGE:	.ASCIZ	/?UJLOAD-E-Use filename (1-6 letters or digits), STATUS, OFFODT, OFFFP, EXIT/
UNSUP:	.ASCIZ	/?UJLOAD-E-CP62 resident unavailable/
OPNERR:	.ASCIZ	/?UJLOAD-E-File not found or LOOKUP failed/
HDRERR:	.ASCIZ	/?UJLOAD-E-Invalid header or file length; old service preserved/
ABIERR:	.ASCIZ	/?UJLOAD-E-Common ABI mismatch; old service preserved/
WRMSG:	.ASCIZ	/!UJLOAD-I-WRITING; target disabled/
READER:	.ASCIZ	/?UJLOAD-E-READ failed/
VERERR:	.ASCIZ	/?UJLOAD-E-FRAM readback failed; target disabled/
CHKERR:	.ASCIZ	/?UJLOAD-E-Checksum or padding failed; target disabled/
ODTOK:	.ASCIZ	/!UJLOAD-I-ODT READY/
FPOK:	.ASCIZ	/!UJLOAD-I-FP11 READY/
STAT:	.ASCIZ	/ODT=0 FP11=0/
	.EVEN
LINE:	.BLKB	82.
	.EVEN
HEADER:	.BLKW	256.
BUFFER:	.BLKW	256.
; BEGIN GENERATED HELPER: firmware/cp62/loader.bin
HELPER:
	.WORD	13704,4,12737,1270,4,21,10003,21
	.WORD	10001,21,20327,4,101122,20327,4,1446
	.WORD	20327,3,1441,20327,2,1431,20327,1
	.WORD	101103,32701,1,1100,10105,5703,1411,20527
	.WORD	1000,103472,10003,41,40,20003,1065,457
	.WORD	20527,4,1002,10400,452,40,450,20027
	.WORD	3,101052,42,430,43,441,43,32700
	.WORD	3,1033,12737,177,320,12737,177640,322
	.WORD	12737,777,326,12737,1700,166,12737,2020
	.WORD	10,12737,340,12,12737,326,164,32700
	.WORD	1,1403,12737,2000,164,12700,125062,5002
	.WORD	12737,312,4,10,12702,1,771,20327
	.WORD	10,101372,5700,1770,20027,10,101365,32701
	.WORD	1,1362,20127,1000,103757,10002,6300,60100
	.WORD	103002,5700,1351,20327,7,1014,21,32700
	.WORD	1,1342,10004,60200,103737,60200,103735,20027
	.WORD	160000,101332,10105,5001,20327,10,1423,20327
	.WORD	5,1424,20327,6,1406,10501,10405,21
	.WORD	10504,10105,401,5000,10001,41,40,20001
	.WORD	1303,406,40,5700,1277,402,40,60001
	.WORD	62705,2,77237,10100,137,1256,0,0
	.WORD	0,0,0,0,0,0,0,0
	.WORD	0,0,0,0,0,0,0,0
	.WORD	0,0,0,0,0,0,0,0
	.WORD	0,0,0,0,0,0,0,0
	.WORD	0,0,0,0,0,0,0,0
	.WORD	0,0,0,0,0,0,0,0
	.WORD	0,0,0,0,0,0,0,0
	.WORD	12737,312,4,10
HCNT=<.-HELPER>/2
; END GENERATED HELPER
	.END	START
