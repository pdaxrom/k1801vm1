	.TITLE UJON
	.IDENT /01.00/
; Enable only the exact matching, fully installed CP64 ODT on CP63 hardware.
; RT-11 file reading stays in the unchanged UJLOAD. No unchecked JMP into FRAM.
	.MCALL .PRINT,.EXIT
	.ENABL LC
@@CONSTANTS@@
	.MACRO JCS DST,?OK
	BCC OK
	JMP DST
OK:
	.ENDM
	.MACRO JNE DST,?OK
	BEQ OK
	JMP DST
OK:
	.ENDM
	.PSECT ACT,I,RW
START:	JSR PC,UPLOAD
	JCS FAIL
	MOV #4,DESC
	JSR PC,API
	JCS FAIL
	CMP R0,#125062
	JNE FAIL
	JSR PC,GETST
	JCS FAIL
	BIC #177376,R0
	CMP R0,#401
	JNE FAIL
	MOV #COMMON,R2
CHECK:	MOV (R2)+,R5
	BEQ SUM
	CLR DESC
	JSR PC,API
	JCS FAIL
	CMP R0,(R2)+
	JNE FAIL
	BR CHECK
SUM:	MOV #10000,R5
	MOV #IMMCNT,R4
	CLR R1
NEXT:	MOV #10,R0
	CMP R4,R0
	BHIS 1$
	MOV R4,R0
1$:	MOV R0,COUNT
	MOV #5,DESC
	JSR PC,API
	JCS FAIL
	ADD R0,R1
	SUB COUNT,R4
	ADD COUNT,R5
	ADD COUNT,R5
	TST R4
	BNE NEXT
	CMP R1,#IMMSUM
	BNE FAIL
; One explicit resident execute call; ENABLE verifies capability again,
; writes/readbacks the debug vector, and sets debug-enable last.
	MOV #125061,R4
	MOV #10004,R1
	CLR R2
	HALT
	TST R2
	BNE FAIL
	.PRINT #OKMSG
	.EXIT
FAIL:	.PRINT #BADMSG
	.EXIT
COUNT:	.WORD 0
COMMON:	.WORD 4,312,6,340,166,1700,164,2000
	.WORD 2000,12737,2002,ODFAIL,2004,4,2006,137,2010,10000
	.WORD 10010,125064,10012,1,0
OKMSG:	.ASCIZ /!UJON-I-CP64 DEBUG ENABLED; SHORT RESET ENTERS ODT/
BADMSG:	.ASCIZ /?UJON-E-CP63 OR MATCHING VERIFIED ODT UNAVAILABLE/
	.EVEN
@@API@@
@@HELPER@@
	.END START
