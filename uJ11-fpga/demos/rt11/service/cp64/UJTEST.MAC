	.TITLE UJTEST
	.IDENT /01.00/
; Deliberately odd guest SP and native-loader signature R4, for RTL debugger tests.
	.MCALL .PRINT,.EXIT
	.PSECT TEST,I,RW
START:	MOV SP,OLDSP
	CLR DONE
	MOV #125061,R4
	MOV #1234,R0
	MOV #567,R1
	MOV #7654,R2
	MOV #3210,R3
	MOV #30000,R5
	SPL 7
	MOV #177777,SP
LOOP:	INC R1
	TST DONE
	BEQ LOOP
	MOV OLDSP,SP
	SPL 0
	.PRINT #PASSED
	.EXIT
OLDSP:	.WORD 0
DONE:	.WORD 0
PASSED:	.ASCIZ /!UJTEST-I-CONTEXT RESUMED/
	.EVEN
	.END START
