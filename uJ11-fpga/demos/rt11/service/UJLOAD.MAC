	.TITLE	UJLOAD
	.IDENT	/01.00/
; CP60 file loader. All file access uses RT-11, all upper RAM access uses
; CP58/CP59 UJRD/UJWR. ABI1: see docs/service-loader-cp60.md.
	.MCALL	.PRINT,.EXIT,.GTLIN,.LOOKUP,.READW,.CLOSE
	.ENABL	LC

	.MACRO	JNE DST,?OK
	BEQ	OK
	JMP	DST
OK:
	.ENDM
	.MACRO	JEQ DST,?OK
	BNE	OK
	JMP	DST
OK:
	.ENDM
	.MACRO	JCS DST,?OK
	BCC	OK
	JMP	DST
OK:
	.ENDM
	.MACRO	JHI DST,?OK
	BLOS	OK
	JMP	DST
OK:
	.ENDM
	.MACRO	JLO DST,?OK
	BHIS	OK
	JMP	DST
OK:
	.ENDM

UJRD=40
UJWR=41
UJCFG=42
UJSTAT=43
HDBYT=512.
PAYSIZ=14			; header offsets (octal)
MEMSIZ=16
ENTRY=20
FAULT=22
CKSUM=24

	.PSECT	LOAD,I,RW
START:	MOV	#1,PROBE
	MOV	@#10,OLDVEC
	MOV	@#12,OLDPS
	MOV	#NOABI,@#10
	MOV	#340,@#12
	.WORD	UJSTAT
	MOV	OLDVEC,@#10
	MOV	OLDPS,@#12
	TST	PROBE
	BNE	1$
	.PRINT	#UNSUP
	.EXIT
1$:	MOV	R0,R1
	BIC	#203,R1
	BNE	2$
	BIT	#2,R0
	BEQ	3$
	BIT	#200,R0
	BEQ	4$
2$:	.PRINT	#UNSUP
	.EXIT
3$:	BIT	#200,R0
	BEQ	2$
4$:	.GTLIN	#LINE,#PROMPT
	MOV	#CMDS,R4
5$:	MOV	(R4)+,R2
	BEQ	6$
	MOV	#LINE,R1
	JSR	PC,STREQ
	BEQ	7$
	TST	(R4)+
	BR	5$
7$:	JMP	@(R4)
6$:	JSR	PC,NAME50
	BCC	LOAD
	.PRINT	#USAGE
	.EXIT
NOABI:	CLR	PROBE
	RTI
STREQ:	CMPB	(R1)+,(R2)+
	BNE	1$
	TSTB	-1(R1)
	BNE	STREQ
1$:	RTS	PC

; One to six uppercase letters/digits, no device or extension. SY: is
; resident; using a fixed .BIN extension also forbids raw-device LOOKUP.
NAME50:	TSTB	LINE
	BEQ	8$
	MOV	#LINE,R2
	MOV	#SPEC+2,R3
1$:	CLR	R1
	MOV	#3,R5
2$:	CLR	R4
	TSTB	(R2)
	BEQ	5$
	MOVB	(R2)+,R4
	CMP	R4,#'A
	BLO	3$
	CMP	R4,#'Z
	BHI	8$
	SUB	#100,R4
	BR	5$
3$:	CMP	R4,#'0
	BLO	8$
	CMP	R4,#'9
	BHI	8$
	SUB	#18.,R4
5$:	MOV	R1,R0
	MUL	#40.,R0
	ADD	R4,R1
	SOB	R5,2$
	MOV	R1,(R3)+
	CMP	R3,#SPEC+6
	BLO	1$
	TSTB	(R2)
	BNE	8$
	CLC
	RTS	PC
8$:	SEC
	RTS	PC

LOAD:	.LOOKUP #AREA,#0,#SPEC
	BCC	1$
	.PRINT	#OPNERR
	.EXIT
1$:	MOV	R0,FLEN
	.READW	#AREA,#0,#HEADER,#256.,#0
	JCS	RDFAIL
	JSR	PC,VALID
	JCS	HDFAIL
; VALID has set the fixed slot, vector, wrapper and ready mask.
; Until here errors preserve both old modules. From here target stays off
; after any readback/checksum/disk error or CTRL/C, including a cold reset.
	.WORD	UJSTAT
	BIC	#177774,R0
	BIC	KIND,R0
	MOV	R0,OTHER
	BEQ	2$
	JSR	PC,CHKCOM
	JCS	ABFAIL
2$:	MOV	OTHER,R0
	.WORD	UJCFG
	.PRINT	#WRMSG
	CLR	TOTAL
	MOV	#1,BLOCK
	MOV	HEADER+PAYSIZ,LEFT
	MOV	BASE,CURSOR
NXTBLK:	.READW	#AREA,#0,#BUFFER,#256.,BLOCK
	JCS	RDFAIL
	MOV	#256.,R4
	CMP	LEFT,#HDBYT
	BHIS	1$
	MOV	LEFT,R4
	ASR	R4
1$:	MOV	R4,COUNT
	MOV	#BUFFER,R2
	MOV	CURSOR,R5
COPY:	MOV	(R2)+,R0
	MOV	R0,R3
	.WORD	UJWR
	.WORD	UJRD
	CMP	R0,R3
	JNE	VRFAIL
	ADD	R0,TOTAL
	ADD	#2,R5
	SOB	R4,COPY
	MOV	R5,CURSOR
; File padding must be zero and cannot hide a second payload.
1$:	CMP	R2,#BUFFER+HDBYT
	BHIS	2$
	TST	(R2)+
	JNE	CKFAIL
	BR	1$
2$:	MOV	COUNT,R0
	ASL	R0
	SUB	R0,LEFT
	INC	BLOCK
	TST	LEFT
	JNE	NXTBLK
	CMP	TOTAL,HEADER+CKSUM
	JNE	CKFAIL
; Zero all declared BSS/stack/scratch storage, including raw I/O backing.
	MOV	HEADER+MEMSIZ,R4
	SUB	HEADER+PAYSIZ,R4
	CLC
	ROR	R4
	BEQ	VERIFY
ZERO:	CLR	R0
	.WORD	UJWR
	.WORD	UJRD
	TST	R0
	JNE	VRFAIL
	ADD	#2,R5
	SOB	R4,ZERO
; A second complete read catches corruption after the immediate word checks.
VERIFY:	MOV	BASE,R5
	MOV	HEADER+PAYSIZ,R4
	CLC
	ROR	R4
	CLR	R1
1$:	.WORD	UJRD
	ADD	R0,R1
	ADD	#2,R5
	SOB	R4,1$
	CMP	R1,HEADER+CKSUM
	JNE	CKFAIL
	MOV	HEADER+MEMSIZ,R4
	SUB	HEADER+PAYSIZ,R4
	CLC
	ROR	R4
	BEQ	ZERODN
2$:	.WORD	UJRD
	TST	R0
	JNE	VRFAIL
	ADD	#2,R5
	SOB	R4,2$
ZERODN:	TST	OTHER
	BNE	PUBWRP
; Common fault dispatcher is installed only when no other module is ready.
	MOV	#COMMON,R2
	MOV	#6,R4
1$:	MOV	(R2)+,R5
	MOV	(R2)+,R0
	JSR	PC,PUTCHK
	JCS	VRFAIL
	SOB	R4,1$
PUBWRP:	MOV	HEADER+FAULT,WRDATA+2
	MOV	HEADER+ENTRY,WRDATA+10
	MOV	#WRDATA,R2
	MOV	WRAP,R5
	MOV	#5,R4
1$:	MOV	(R2)+,R0
	JSR	PC,PUTCHK
	JCS	VRFAIL
	ADD	#2,R5
	SOB	R4,1$
; Publish the module vector only after payload/BSS/wrapper readback.
	MOV	VECT,R5
	MOV	WRAP,R0
	JSR	PC,PUTCHK
	JCS	VRFAIL
	ADD	#2,R5
	MOV	#340,R0
	JSR	PC,PUTCHK
	JCS	VRFAIL
COMMIT:	.WORD	UJSTAT
	BIC	#177774,R0
	BIS	KIND,R0
	.WORD	UJCFG
	.CLOSE	#0
	CMP	KIND,#1
	BNE	1$
	.PRINT	#ODTOK
	.EXIT
1$:	.PRINT	#FPOK
	.EXIT
PUTCHK:	MOV	R0,R3
	.WORD	UJWR
	.WORD	UJRD
	CMP	R0,R3
	BNE	1$
	CLC
	RTS	PC
1$:	SEC
	RTS	PC
CHKCOM:	MOV	#COMMON,R2
	MOV	#5,R4
1$:	MOV	(R2)+,R5
	.WORD	UJRD
	CMP	R0,(R2)+
	BNE	2$
	SOB	R4,1$
	CLC
	RTS	PC
2$:	SEC
	RTS	PC

; Header and exact RT-11 block extent. All range comparisons are unsigned;
; FP slot ends at physical 200000 octal (65536), not a 16-bit end pointer.
VALID:	CMP	HEADER,#45125
	JNE	BADHDR
	CMP	HEADER+2,#30461
	JNE	BADHDR
	CMP	HEADER+4,#1
	JNE	BADHDR
	CMP	HEADER+6,#1
	JNE	BADHDR
	MOV	HEADER+10,KIND
	CMP	KIND,#1
	BEQ	1$
	CMP	KIND,#2
	JNE	BADHDR
	MOV	#40000,BASE
	MOV	#140000,MAXMEM
	MOV	#240,WRAP
	MOV	#10,VECT
	BR	2$
1$:	MOV	#400,BASE
	MOV	#37400,MAXMEM
	MOV	#220,WRAP
	MOV	#170,VECT
2$:	CMP	HEADER+12,BASE
	JNE	BADHDR
	MOV	HEADER+PAYSIZ,R0
	JEQ	BADHDR
	BIT	#1,R0
	JNE	BADHDR
	MOV	HEADER+MEMSIZ,R1
	BIT	#1,R1
	JNE	BADHDR
	CMP	R0,R1
	JHI	BADHDR
	CMP	R1,MAXMEM
	JHI	BADHDR
	MOV	#HEADER+ENTRY,R2
	MOV	#2,R3
3$:	MOV	(R2)+,R1
	BIT	#1,R1
	JNE	BADHDR
	CMP	R1,#160000
	BHIS	BADHDR
	SUB	BASE,R1
	JCS	BADHDR
	CMP	R1,R0
	BHIS	BADHDR
	SOB	R3,3$
; Header checksum is an independent modulo-65536 sum of its 16 words.
	MOV	#HEADER,R2
	MOV	#16.,R3
	CLR	R1
4$:	ADD	(R2)+,R1
	SOB	R3,4$
	TST	R1
	BNE	BADHDR
; Flags/reserved words and the remaining 480 header bytes must be zero.
	MOV	#HEADER+30,R2
5$:	TST	(R2)+
	BNE	BADHDR
	CMP	R2,#HEADER+HDBYT
	BLO	5$
	ADD	#511.,R0
	SWAB	R0
	BIC	#177400,R0
	CLC
	ROR	R0
	ADD	#1,R0
	CMP	R0,FLEN
	BNE	BADHDR
	CLC
	RTS	PC
BADHDR:	SEC
	RTS	PC

HDFAIL:	MOV	#HDRERR,R0
	BR	FAIL
ABFAIL:	MOV	#ABIERR,R0
	BR	FAIL
RDFAIL:	MOV	#READER,R0
	BR	FAIL
VRFAIL:	MOV	#VERERR,R0
	BR	FAIL
CKFAIL:	MOV	#CHKERR,R0
FAIL:	.PRINT
	.CLOSE	#0
	.EXIT
OFFODT:	MOV	#1,R1
	BR	OFF
OFFFP:	MOV	#2,R1
OFF:	.WORD	UJSTAT
	BIC	#177774,R0
	BIC	R1,R0
	.WORD	UJCFG
STATUS:	.WORD	UJSTAT
	MOVB	#'0,STAT+4
	MOVB	#'0,STAT+11.
	BIT	#1,R0
	BEQ	1$
	INCB	STAT+4
1$:	BIT	#2,R0
	BEQ	2$
	INCB	STAT+11.
2$:	.PRINT	#STAT
EXIT:	.EXIT

; Common vector at 004 -> 0200: JMP @0104; fallback at 0204 loops.
; The two entry wrappers select their fault handler without using R0-R6/SP.
COMMON:	.WORD	4,200,6,340,200,177,202,177700,204,777
	.WORD	104,204
WRDATA:	.WORD	12737,0,104,137,0
CMDS:	.WORD	STACMD,STATUS,ODTOFF,OFFODT,FPOFF,OFFFP,QUIT,EXIT,0
SPEC:	.RAD50	/SY /
	.WORD	0,0
	.RAD50	/BIN/
AREA:	.BLKW	5
OLDVEC:	.WORD	0
OLDPS:	.WORD	0
PROBE:	.WORD	0
FLEN:	.WORD	0
KIND:	.WORD	0
BASE:	.WORD	0
MAXMEM:	.WORD	0
WRAP:	.WORD	0
VECT:	.WORD	0
OTHER:	.WORD	0
BLOCK:	.WORD	0
LEFT:	.WORD	0
COUNT:	.WORD	0
CURSOR:	.WORD	0
TOTAL:	.WORD	0
STACMD:	.ASCIZ	/STATUS/
ODTOFF:	.ASCIZ	/OFFODT/
FPOFF:	.ASCIZ	/OFFFP/
QUIT:	.ASCIZ	/EXIT/
PROMPT:	.ASCII	/UJLOAD> /
	.BYTE	200
USAGE:	.ASCIZ	/?UJLOAD-E-Use filename (1-6 letters or digits), STATUS, OFFODT, OFFFP, EXIT/
UNSUP:	.ASCIZ	/?UJLOAD-E-Service instructions unavailable/
OPNERR:	.ASCIZ	/?UJLOAD-E-File not found or LOOKUP failed/
HDRERR:	.ASCIZ	/?UJLOAD-E-Invalid header or file length; old service preserved/
ABIERR:	.ASCIZ	/?UJLOAD-E-Common ABI mismatch; old service preserved/
WRMSG:	.ASCIZ	/!UJLOAD-I-WRITING; target disabled/
READER:	.ASCIZ	/?UJLOAD-E-READ failed/
VERERR:	.ASCIZ	/?UJLOAD-E-FRAM readback failed; target disabled/
CHKERR:	.ASCIZ	/?UJLOAD-E-Checksum or padding failed; target disabled/
ODTOK:	.ASCIZ	/!UJLOAD-I-ODT READY/
FPOK:	.ASCIZ	/!UJLOAD-I-FP11 READY/
STAT:	.ASCIZ	/ODT=0 FP11=0/
	.EVEN
LINE:	.BLKB	82.
	.EVEN
HEADER:	.BLKW	256.
BUFFER:	.BLKW	256.
	.END	START
