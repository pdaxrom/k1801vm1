	.TITLE FPTST
	.IDENT /00.05/
; CP73: ODT steps F/D arithmetic; native checks include unary UV completion.
	.MCALL .PRINT,.EXIT
AC0=%0
AC2=%2
AC5=%5
	.PSECT TEST,I,RW
START:	.PRINT #HELLO
	SPL 7
	BR ENTRY
ENTRY:	SETD
LOAD:	LDD SOURCE,AC2
NEGATE:	NEGD AC2
ABSOL:	ABSD AC2
COMPAR:	CMPD SOURCE,AC2
CHECKT:	TSTD AC2
CLEAR:	CLRD AC5
ADDITION:	ADDD SOURCE,AC2
SUBTR:	SUBD SOURCE,AC2
SINGLE:	SETF
FCLEAR:	CLRF AC0
FADD:	ADDF #1.0,AC0
FSUB:	SUBF #1.0,AC0
DOUBLE:	SETD
FPSSET:	LDFPS #44000
BADTST:	TSTF MINUS
STATUS:	STFPS RESULT
ERRORS:	STST ERR
LOOP:	BR .
FINISH:	CMP RESULT,#144014
	BNE FAIL
	CMP ERR,#14
	BNE FAIL
	CMP ERR+2,#BADTST
	BNE FAIL
	SETD
	STD AC2,BACK
	LDD AC5,AC0
	STD AC0,ZERO
	MOV #SOURCE,R0
	MOV #BACK,R1
	MOV #ZERO,R2
	MOV #4,R3
CHECK:	CMP (R0)+,(R1)+
	BNE FAIL
	TST (R2)+
	BNE FAIL
	SOB R3,CHECK
; Negative-zero memory is overwritten before the enabled UV exception.
	LDFPS #44000
	ABSF MINUS
	STFPS RESULT
	CMP RESULT,#144004
	BNE FAIL
	TST MINUS
	BNE FAIL
	TST MINUS+2
	BNE FAIL
	SPL 0
	.PRINT #DONE
	.EXIT
FAIL:	SPL 0
	.PRINT #BAD
	.EXIT
SOURCE:	.WORD 40200,12345,65432,23456
MINUS:	.WORD 100123,4567
RESULT:	.WORD 0
ERR:	.BLKW 2
BACK:	.BLKW 4
ZERO:	.BLKW 4
HELLO:	.ASCIZ /!FPTST-I-F D ARITHMETIC TEST/
DONE:	.ASCIZ /!FPTST-I-RETURNED TO RT11/
BAD:	.ASCIZ /?FPTST-E-STATE MISMATCH/
	.EVEN
	.END START
