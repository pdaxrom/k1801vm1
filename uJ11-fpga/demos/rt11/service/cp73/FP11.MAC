	.TITLE UJFP11
	.IDENT /00.06/
; CP73 FP11-A firmware: F/D add/subtract, seven guard bits. Absolute HALT FRAM, CP67 module ABI3.
; LDFPS/STFPS/STST support all eight word addressing modes.
; F/D CLR/TST/ABS/NEG/CMP/ADD/SUB; multiply/divide/conversion remain absent.
	.ASECT
	.=40000
INIT:	JMP @#COLD
SIGN:	.WORD 125110,1
CPC=100
CPSW=102
FPSMSK=147757
	.MACRO JNE DST,?OK
	BEQ OK
	JMP DST
OK:
	.ENDM
	.MACRO JMI DST,?OK
	BPL OK
	JMP DST
OK:
	.ENDM
	.MACRO JGE DST,?OK
	BLT OK
	JMP DST
OK:
	.ENDM
	.MACRO JEQ DST,?OK
	BNE OK
	JMP DST
OK:
	.ENDM
; The generic walker owns its fault vector until we return RTS PC.
COLD:	.WORD 43
	BIT #400,R0
	BEQ CFAIL
	CMP @#122,#7000
	BNE CFAIL
	BIC #177770,R0
	MOV R0,R3
	MOV #IMMEND,R1
	MOV #<MEMEND-IMMEND>/2,R2
1$:	CLR (R1)
	TST (R1)+
	BNE CFAIL
	SOB R2,1$
	MOV #ENTER,@#10
	CMP @#10,#ENTER
	BNE CFAIL
	MOV #340,@#12
	CMP @#12,#340
	BNE CFAIL
; Ready is published last; preserve installed ODT/debug bits.
	MOV R3,R0
	BIS #2,R0
	.WORD 42
	CLR R0
	RTS PC
CFAIL:	MOV #1,R0
	RTS PC

; No use of the USER stack, even when its address is odd.
ENTER:	MOV R0,REGS
	MOV R1,REGS+2
	MOV R2,REGS+4
	MOV R3,REGS+6
	MOV R4,REGS+10
	MOV R5,REGS+12
	MOV SP,REGS+14
	MOV @#CPC,REGS+16
	MOV @#CPSW,REGS+20
	MOV #STKTOP,SP
	MOV @#4,OLDVEC
	MOV @#6,OLDVEC+2
	CLR INTRAP
	MOV #BUSERR,@#4
	MOV #340,@#6
; HALT entry supplies PC after the opcode. Decode its RAM word, without
; consuming an extension word or changing the saved architectural PC.
	MOV REGS+16,R5
	SUB #2,R5
	MOV R5,OPADDR
	.WORD 21
	MOV R0,OPCODE
	CMP R0,#170000
	BEQ CFCC
	CMP R0,#170001
	BEQ SETF
	CMP R0,#170002
	BEQ SETI
	CMP R0,#170011
	BEQ SETD
	CMP R0,#170012
	BEQ SETL
	MOV R0,R4
	BIC #77,R4
	CMP R4,#170100
	BEQ XFER
	CMP R4,#170200
	BEQ XFER
	CMP R4,#170300
	BEQ XFER
	CMP R4,#170400
	BEQ XFER
	CMP R4,#170500
	BEQ XFER
	CMP R4,#170600
	BEQ XFER
	CMP R4,#170700
	BEQ XFER
	BIC #300,R4
	CMP R4,#173400
	BEQ XFER
	CMP R4,#172400
	BEQ XFER
	CMP R4,#174000
	BEQ XFER
	CMP R4,#172000
	BEQ XFER
	CMP R4,#173000
	BEQ XFER
	JMP UNIMPL
CFCC:	MOV FPS,R0
	BIC #177760,R0
	BIC #17,REGS+20
	BIS R0,REGS+20
	JMP RETURN
SETF:	BIC #200,FPS
	JMP RETURN
SETI:	BIC #100,FPS
	JMP RETURN
SETD:	BIS #200,FPS
	JMP RETURN
SETL:	BIS #100,FPS
	JMP RETURN
; R1 addresses the saved CPU register, R2 is mode*2, R3 operand bytes.
; R0/R5 alone are clobbered by the inter-bank instructions.
XFER:	MOV OPCODE,R1
	BIC #177770,R1
	ASL R1
	ADD #REGS,R1
	MOV OPCODE,R2
	BIC #177707,R2
	ASR R2
	ASR R2
	MOV #2,R3
	BIT #7400,R4
	BNE FSET
	CMP R4,#170300
	BNE XD
	MOV #4,R3
	BR IMMLEN
FSET:	MOV OPCODE,R0
	BIC #177477,R0
	ASR R0
	ASR R0
	ASR R0
	ADD #ACS,R0
	MOV R0,ACPTR
	MOV #4,R3
	BIT #200,FPS
	BEQ FSIZE
	ASL R3
FSIZE:	MOV R3,FLEN
IMMLEN:	MOV OPCODE,R0
	BIC #177700,R0
	CMP R0,#27
	BNE XD
	MOV #2,R3
XD:	CLR CHGPTR
	MOV (R1),R5
	JMP @EATAB(R2)
EATAB:	.WORD REG,EA,EAINC,EAIND,EADEC,EADDEF,EAIDX,EAIDXD
REG:	BIT #7400,R4
	JNE FREG
	CMP R4,#170100
	BNE REGST
	MOV (R1),FPS
	BIC #<177777-FPSMSK>,FPS
	JMP RETURN
REGST:	MOV FPS,R0
	CMP R4,#170200
	BEQ REGSAV
	MOV FEC,R0
REGSAV:	MOV R0,(R1)
	JMP RETURN
EAINC:	MOV R5,R0
	ADD R3,R0
	JSR PC,CHANGE
	BR EA
EAIND:	MOV R5,R0
	ADD #2,R0
	JSR PC,CHANGE
	BR INDIRECT
EADEC:	SUB R3,R5
	MOV R5,R0
	JSR PC,CHANGE
	BR EA
EADDEF:	SUB #2,R5
	MOV R5,R0
	JSR PC,CHANGE
	BR INDIRECT
EAIDX:
EAIDXD:	MOV REGS+16,R5
	.WORD 21
; Failed extension read never reaches the PC update. Index R7 uses PC+2.
	MOV R5,REGS+16
	ADD (R1),R0
	MOV R0,R5
	CMP R2,#14
	BEQ EA
INDIRECT:
	.WORD 21
	MOV R0,R5
EA:	BIT #7400,R4
	JNE FMEM
	CMP R4,#170100
	BNE MEMST
	.WORD 21
	MOV R0,FPS
	BIC #<177777-FPSMSK>,FPS
	BR COMMIT
MEMST:	MOV FPS,R0
	CMP R4,#170200
	BEQ STORE1
	MOV FEC,R0
STORE1:	ADD #2,R5
	.WORD 31
	CMP R3,#4
	BNE COMMIT
	MOV FEA,R0
	ADD #4,R5
	.WORD 31
COMMIT:	JSR PC,UPD
	JMP RETURN
UPD:	TST CHGPTR
	BEQ URET
	MOV CHGVAL,@CHGPTR
URET:	RTS PC
; Match J11: R0-R6 autoupdates commit after all operand accesses succeed.
; PC changes are immediate, including an absolute/immediate pointer fetch.
CHANGE:	CMP R1,#REGS+16
	BNE PENDING
	MOV R0,(R1)
	RTS PC
PENDING:
	MOV R1,CHGPTR
	MOV R0,CHGVAL
	RTS PC
; Mode 0 names floating accumulators, not CPU registers. AC6/7 are illegal.
FREG:	MOV R1,R5
	SUB #REGS,R5
	CMP R5,#14
	BLO FRVALID
	JMP UNIMPL
FRVALID:	ASL R5
	ASL R5
	ADD #ACS,R5
	CMP R4,#174000
	BNE FRLOAD
	MOV R5,R1
	MOV ACPTR,R5
	BR FRCOPY
FRLOAD:	CMP R4,#172400
	BNE FREGIN
	MOV ACPTR,R1
; Both operands are validated ACs in HALT FRAM. Preserve the first source
; word for LDF flags; F mode must neither read nor overwrite the low half.
; No USER addressing side effects exist on this path, including self-copy.
FRCOPY:	MOV (R5)+,R0
	MOV R0,(R1)+
	MOV (R5)+,(R1)+
	BIT #200,FPS
	BEQ FRCEND
	MOV (R5)+,(R1)+
	MOV (R5),(R1)
FRCEND:	CMP R4,#174000
	BEQ FRRET
	JSR PC,SETCC
FRRET:	JMP RETURN
FREGIN:	MOV R5,EADDR
	JSR PC,ZBUF
	CMP R4,#170400
	JEQ FEXEC
	MOV #FBUF,R1
	MOV FLEN,R2
	ASR R2
FRIN:	MOV (R5)+,(R1)+
	SOB R2,FRIN
	JMP FEXEC
; Buffer all words before modifying AC/FPS. CLR never reads its destination.
FMEM:	MOV R5,EADDR
	CMP R4,#174000
	JEQ FSTORE
	JSR PC,ZBUF
	CMP R4,#170400
	JEQ FEXEC
	MOV #FBUF,R1
	MOV R3,R2
	ASR R2
FREAD:	.WORD 21
	MOV R0,(R1)+
	SOB R2,FREAD
; Undefined-variable detection applies to memory/immediate, not AC sources.
	MOV FBUF,R0
	BPL FEXEC
	BIT #77600,R0
	BNE FEXEC
	BIT #4000,FPS
	BEQ FEXEC
; FP11-A unary UV exceptions complete the operation first (DEC 1981
; pp. 320/334). Arithmetic/compare/load cancel before execution.
	CMP R4,#170600
	BEQ FUWR
	CMP R4,#170700
	BEQ FUWR
; TST retains the sign while setting flags (FP11-A manual 5.3.8).
	CMP R4,#170500
	BNE FUV
	JSR PC,SETCC
FUV:	JSR PC,UPD
	MOV #14,R0
	JMP FPERR
FUWR:	JSR PC,ZBUF
	MOV #170610,R4
	JMP UWRITE
FEXEC:	CMP R4,#172000
	JEQ ARITH
	CMP R4,#173000
	JEQ ARITH
	CMP R4,#172400
	BEQ FLOAD
	CMP R4,#173400
	JEQ FCOMP
	CMP R4,#170500
	BEQ FFLAGS
	CMP R4,#170400
	BEQ UWRITE
	BIT #77600,FBUF
	BNE USIGN
	JSR PC,ZBUF
	BR UWRITE
USIGN:	CMP R4,#170600
	BNE UNEG
	BIC #100000,FBUF
	BR UWRITE
UNEG:	MOV #100000,R0
	XOR R0,FBUF
UWRITE:	MOV EADDR,R5
	MOV #FBUF,R1
	MOV FLEN,R2
	ASR R2
	BIT #70,OPCODE
	BNE USTORE
URCOPY:	MOV (R1)+,(R5)+
	SOB R2,URCOPY
	BR FFLAGS
USTORE:	MOV R3,R2
	ASR R2
	JSR PC,WRITE
FFLAGS:	MOV FBUF,R0
	JSR PC,SETCC
	CMP R4,#170610
	JEQ FUV
	JMP COMMIT
FLOAD:	MOV #FBUF,R5
	MOV ACPTR,R1
FCOPY:	MOV FLEN,R2
	ASR R2
FCOPY1:	MOV (R5)+,(R1)+
	SOB R2,FCOPY1
	CMP R4,#174000
	JEQ COMMIT
	BR FFLAGS
FSTORE:	MOV ACPTR,R1
	MOV R3,R2
	ASR R2
	JSR PC,WRITE
	JMP COMMIT
; R5=USER destination, R1=HALT source, R2=word count. No FPS commit on fault.
WRITE:	ADD #2,R5
FWRITE:	MOV (R1)+,R0
	.WORD 31
	ADD #4,R5
	SOB R2,FWRITE
	RTS PC
ZBUF:	CLR FBUF
	CLR FBUF+2
	CLR FBUF+4
	CLR FBUF+6
	RTS PC
SETCC:	BIC #17,FPS
	TST R0
	BPL FZERO
	BIS #10,FPS
FZERO:	BIT #77600,R0
	BNE FCCRET
	BIS #4,FPS
FCCRET:	RTS PC
; Compare FSRC - AC, treating any zero exponent as exact zero. AC is only
; changed when both operands are zero; its low half is preserved in F mode.
FCOMP:	BIT #77600,FBUF
	BNE CSRC
	JSR PC,ZBUF
CSRC:	MOV ACPTR,R5
	BIT #77600,(R5)
	BNE CAC
	MOV #ZEROS,R5
CAC:	CLR R4
	MOV FBUF,R0
	BPL CSIGN
	MOV #10,R4
CSIGN:	MOV (R5),R1
	XOR R0,R1
	BMI CDONE
	MOV #FBUF,R1
	MOV FLEN,R2
	ASR R2
CLOOP:	CMP (R1)+,(R5)+
	BLO CLESS
	BHI CDONE
	SOB R2,CLOOP
	MOV #4,R4
	TST FBUF
	BNE CDONE
	MOV ACPTR,R1
	MOV FLEN,R2
	ASR R2
CZERO:	CLR (R1)+
	SOB R2,CZERO
	BR CDONE
CLESS:	MOV #10,R0
	XOR R0,R4
CDONE:	BIC #17,FPS
	BIS R4,FPS
	JMP COMMIT
ZEROS:	.WORD 0,0,0,0
; Two 64-bit integer mantissas in little-word order: hidden bit 62,
; seven low guard bits. The same width serves F and D; F ignores AC[31:0].
; No host floating arithmetic, FPGA additions or new microinstructions.
ARITH:	CLR AERR
	CLR AOVF
	MOV ACPTR,R5
	MOV #AMAN,R1
	JSR PC,UNPACK
	MOV R0,AEXP
	MOV R3,ASIGN
	MOV #FBUF,R5
	MOV #BMAN,R1
	JSR PC,UNPACK
	MOV R0,BEXP
	MOV R3,BSIGN
	CMP R4,#173000
	BNE ASORT
	TST BEXP
	BEQ ASORT
	MOV #100000,R0
	XOR R0,BSIGN
ASORT:	CMP AEXP,BEXP
	BLO ASWAP
	BHI AREADY
	MOV #AMAN+10,R1
	MOV #BMAN+10,R2
	MOV #4,R3
ACMPL:	CMP -(R1),-(R2)
	BLO ASWAP
	BHI AREADY
	SOB R3,ACMPL
	BR AREADY
ASWAP:	MOV #AMAN,R1
	MOV #BMAN,R2
	MOV #4,R3
ASWPL:	MOV (R1),R0
	MOV (R2),(R1)+
	MOV R0,(R2)+
	SOB R3,ASWPL
	MOV AEXP,R0
	MOV BEXP,AEXP
	MOV R0,BEXP
	MOV ASIGN,R0
	MOV BSIGN,ASIGN
	MOV R0,BSIGN
AREADY:	TST AEXP
	JEQ AZERO
	TST BEXP
	JEQ APACK
	MOV AEXP,R2
	SUB BEXP,R2
	CMP R2,#64.
	JGE APACK
	TST R2
	BEQ ALIGNED
ASHIFT:	CLC
	ROR BMAN+6
	ROR BMAN+4
	ROR BMAN+2
	ROR BMAN
	SOB R2,ASHIFT
ALIGNED:	MOV ASIGN,R0
	MOV BSIGN,R1
	XOR R1,R0
	JMI ASUB
; Propagate each word's carry before adding the next source word.
	ADD BMAN,AMAN
	BCC AA1
	INC AMAN+2
	BNE AA1
	INC AMAN+4
	BNE AA1
	INC AMAN+6
AA1:	ADD BMAN+2,AMAN+2
	BCC AA2
	INC AMAN+4
	BNE AA2
	INC AMAN+6
AA2:	ADD BMAN+4,AMAN+4
	BCC AA3
	INC AMAN+6
AA3:	ADD BMAN+6,AMAN+6
	BR ACARRY
ASUB:	SUB BMAN,AMAN
	BCC AS1
	DEC AMAN+2
	CMP AMAN+2,#177777
	BNE AS1
	DEC AMAN+4
	CMP AMAN+4,#177777
	BNE AS1
	DEC AMAN+6
AS1:	SUB BMAN+2,AMAN+2
	BCC AS2
	DEC AMAN+4
	CMP AMAN+4,#177777
	BNE AS2
	DEC AMAN+6
AS2:	SUB BMAN+4,AMAN+4
	BCC AS3
	DEC AMAN+6
AS3:	SUB BMAN+6,AMAN+6
	MOV AMAN,R0
	BIS AMAN+2,R0
	BIS AMAN+4,R0
	BIS AMAN+6,R0
	JEQ AZERO
ANORM:	BIT #40000,AMAN+6
	BNE AROUND
	ASL AMAN
	ROL AMAN+2
	ROL AMAN+4
	ROL AMAN+6
	DEC AEXP
	BR ANORM
ACARRY:	TST AMAN+6
	BPL AROUND
	JSR PC,ARIGHT
	INC AEXP
AROUND:	BIT #40,FPS
	BNE APACK
	BIT #200,FPS
	BEQ AFROUND
	BIT #100,AMAN
	BEQ APACK
	ADD #200,AMAN
	ADC AMAN+2
	ADC AMAN+4
	ADC AMAN+6
	BR ARCARR
AFROUND:	BIT #100,AMAN+4
	BEQ APACK
	ADD #200,AMAN+4
	ADC AMAN+6
ARCARR:	TST AMAN+6
	BPL APACK
	JSR PC,ARIGHT
	INC AEXP
APACK:	MOV #7,R2
APSHFT:	JSR PC,ARIGHT
	SOB R2,APSHFT
	MOV AEXP,R0
	BIC #177400,R0
	ASH #7,R0
	BIS ASIGN,R0
	BIC #177600,AMAN+6
	BIS AMAN+6,R0
	MOV R0,FBUF
	MOV AMAN+4,FBUF+2
	MOV AMAN+2,FBUF+4
	MOV AMAN,FBUF+6
	CMP AEXP,#377
	BGT AOVER
	TST AEXP
	BGT ACOMIT
	BIT #2000,FPS
	BEQ AZERO
	MOV #12,AERR
	BR ACOMIT
AOVER:	MOV #2,AOVF
	BIT #1000,FPS
	BEQ AZERO
	MOV #10,AERR
	BR ACOMIT
AZERO:	JSR PC,ZBUF
ACOMIT:	MOV ACPTR,R1
	MOV #FBUF,R5
	MOV FLEN,R2
	ASR R2
ARES:	MOV (R5)+,(R1)+
	SOB R2,ARES
	MOV FBUF,R0
	JSR PC,SETCC
	BIS AOVF,FPS
	JSR PC,UPD
	MOV AERR,R0
	JNE FPERR
	JMP RETURN
ARIGHT:	CLC
	ROR AMAN+6
	ROR AMAN+4
	ROR AMAN+2
	ROR AMAN
	RTS PC
; R5=raw operand, R1=64-bit output; returns R0=exponent, R3=sign.
; Exponent-zero encodings become exact positive zero before arithmetic.
UNPACK:	MOV (R5)+,R0
	MOV R0,R3
	BIC #77777,R3
	MOV R0,6(R1)
	BIC #177600,6(R1)
	BIS #200,6(R1)
	BIC #100177,R0
	ASH #-7,R0
	MOV (R5)+,4(R1)
	CLR 2(R1)
	CLR (R1)
	BIT #200,FPS
	BEQ UPZERO
	MOV (R5)+,2(R1)
	MOV (R5),(R1)
UPZERO:	TST R0
	BNE UPSHFT
	CLR (R1)
	CLR 2(R1)
	CLR 4(R1)
	CLR 6(R1)
	CLR R3
	RTS PC
UPSHFT:	MOV #7,R2
UPLOOP:	ASL (R1)
	ROL 2(R1)
	ROL 4(R1)
	ROL 6(R1)
	SOB R2,UPLOOP
	RTS PC
; Remaining valid FP opcodes remain outside this checkpoint's ISA.
UNIMPL:	MOV #2,R0
FPERR:	MOV R0,FEC
	MOV OPADDR,FEA
	BIS #100000,FPS
	BIT #40000,FPS
	JNE RETURN
	MOV #244,TVEC
	BR TRAP
BUSERR:	TST INTRAP
	BNE FATAL
	MOV #4,TVEC
; Construct the usual unbanked CPU frame: PSW then PC, then read the vector.
; A fault during this construction is terminal, as with the base CPU.
TRAP:	MOV #1,INTRAP
	MOV REGS+14,R5
	MOV REGS+20,R0
	.WORD 31
	MOV REGS+16,R0
	.WORD 31
	MOV R5,REGS+14
	MOV TVEC,R5
	.WORD 21
	MOV R0,REGS+16
	.WORD 21
	MOV R0,REGS+20
RETURN:	MOV OLDVEC,@#4
	MOV OLDVEC+2,@#6
	MOV REGS+16,@#CPC
	MOV REGS+20,@#CPSW
	MOV REGS,R0
	MOV REGS+2,R1
	MOV REGS+4,R2
	MOV REGS+6,R3
	MOV REGS+10,R4
	MOV REGS+12,R5
	MOV REGS+14,SP
	.WORD 10
FATAL:	HALT
; Mutable state is excluded from the retained image checksum.
IMMEND:
FPS:	.BLKW 1
FEC:	.BLKW 1
FEA:	.BLKW 1
ACS:	.BLKW 24.
REGS:	.BLKW 9.
OLDVEC:	.BLKW 2
OPADDR:	.BLKW 1
OPCODE:	.BLKW 1
TVEC:	.BLKW 1
INTRAP:	.BLKW 1
CHGPTR:	.BLKW 1
CHGVAL:	.BLKW 1
ACPTR:	.BLKW 1
FLEN:	.BLKW 1
EADDR:	.BLKW 1
FBUF:	.BLKW 4
AMAN:	.BLKW 4
BMAN:	.BLKW 4
AEXP:	.BLKW 1
BEXP:	.BLKW 1
ASIGN:	.BLKW 1
BSIGN:	.BLKW 1
AERR:	.BLKW 1
AOVF:	.BLKW 1
STACK:	.BLKW 64.
STKTOP:
MEMEND:
	.END INIT
