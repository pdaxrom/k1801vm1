	.TITLE FPTST
	.IDENT /00.02/
; CP69 RT-11 test: ODT steps status memory operands and an inhibited FP error.
; Redirect PC from LOOP to FINISH to validate memory and return to RT-11.
	.MCALL .PRINT,.EXIT
	.PSECT TEST,I,RW
START:	.PRINT #HELLO
	SPL 7
	BR ENTRY
ENTRY:	SETD
	SETL
	STFPS STATUS
PTRSET:	MOV #BUF,R2
FPSSET:	LDFPS #40000
BADFP:	.WORD 170003
SAVE:	STST (R2)+
SHOW:	STFPS R1
LOOP:	BR .
FINISH:	CMP STATUS,#300
	BNE FAIL
	CMP BUF,#2
	BNE FAIL
	CMP BUF+2,#BADFP
	BNE FAIL
	CMP R2,#BUF+4
	BNE FAIL
	CMP R1,#140000
	BNE FAIL
	SPL 0
	.PRINT #DONE
	.EXIT
FAIL:	SPL 0
	.PRINT #ERROR
	.EXIT
STATUS:	.WORD 0
BUF:	.BLKW 2
HELLO:	.ASCIZ /!FPTST-I-CONTROL TEST/
DONE:	.ASCIZ /!FPTST-I-RETURNED TO RT11/
ERROR:	.ASCIZ /?FPTST-E-STATE MISMATCH/
	.EVEN
	.END START
