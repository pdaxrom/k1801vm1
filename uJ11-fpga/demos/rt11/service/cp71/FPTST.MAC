	.TITLE FPTST
	.IDENT /00.04/
; CP71: ODT steps unary/compare, including FP11-A TST flags before UV error.
	.MCALL .PRINT,.EXIT
AC0=%0
AC2=%2
AC5=%5
	.PSECT TEST,I,RW
START:	.PRINT #HELLO
	SPL 7
	BR ENTRY
ENTRY:	SETD
LOAD:	LDD SOURCE,AC2
NEGATE:	NEGD AC2
ABSOL:	ABSD AC2
COMPAR:	CMPD SOURCE,AC2
CHECKT:	TSTD AC2
CLEAR:	CLRD AC5
FPSSET:	LDFPS #44000
BADTST:	TSTF MINUS
STATUS:	STFPS RESULT
ERRORS:	STST ERR
LOOP:	BR .
FINISH:	CMP RESULT,#144014
	BNE FAIL
	CMP ERR,#14
	BNE FAIL
	CMP ERR+2,#BADTST
	BNE FAIL
	SETD
	STD AC2,BACK
	LDD AC5,AC0
	STD AC0,ZERO
	MOV #SOURCE,R0
	MOV #BACK,R1
	MOV #ZERO,R2
	MOV #4,R3
CHECK:	CMP (R0)+,(R1)+
	BNE FAIL
	TST (R2)+
	BNE FAIL
	SOB R3,CHECK
	SPL 0
	.PRINT #DONE
	.EXIT
FAIL:	SPL 0
	.PRINT #BAD
	.EXIT
SOURCE:	.WORD 40200,12345,65432,23456
MINUS:	.WORD 100123,4567
RESULT:	.WORD 0
ERR:	.BLKW 2
BACK:	.BLKW 4
ZERO:	.BLKW 4
HELLO:	.ASCIZ /!FPTST-I-UNARY COMPARE TEST/
DONE:	.ASCIZ /!FPTST-I-RETURNED TO RT11/
BAD:	.ASCIZ /?FPTST-E-STATE MISMATCH/
	.EVEN
	.END START
