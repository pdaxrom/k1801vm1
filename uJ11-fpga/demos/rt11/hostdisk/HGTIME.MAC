	.TITLE	HGTIME
	.IDENT	/01.00/
	.MCALL	.LOOKUP,.SPFUN,.CLOSE,.SDTTM,.PRINT,.EXIT
	.GLOBL	TMINIT,TMGET,CLKHZ

;	LOAD HG before RUN HGTIME. The handler returns a .SDTTM parameter block;
;	only a successful checksummed request is allowed to change system time.
	.PSECT	TIMCOD,I,RO
START:
	JSR	PC,TMINIT
	BCS	NOCLK
	.LOOKUP	#AREA,#0,#DEVICE
	BCS	NOHG
	.SPFUN	#AREA,#0,#200,#NEWTIM,#3,CLKHZ,#0
	BCS	BADHG
;	V5.03 accepts a nonnegative date; reject unusable date/time replies.
	TST	NEWTIM
	BLE	BADHG
;	Compute ticks/day as (hz * 60) * 1440; R0:R1 is the 32-bit limit.
	MOV	CLKHZ,R0
	MUL	#60.,R0
	MOV	R1,R0
	MUL	#1440.,R0
	CMP	NEWTIM+2,R0
	BHI	BADHG
	BLO	SETTIM
	CMP	NEWTIM+4,R1
	BHIS	BADHG
SETTIM:
	.SDTTM	#AREA,#NEWTIM
	.CLOSE	#0
	.PRINT	#DONE
	JSR	PC,TMGET
	.PRINT
	.EXIT
BADHG:
	.CLOSE	#0
	.PRINT	#HGERR
	BR	FAILED
NOHG:
	.PRINT	#HGLOAD
	BR	FAILED
NOCLK:
	.PRINT	#CLKERR
FAILED:
	BISB	#10,@#53
	.EXIT

	.PSECT	TIMDAT,D,RW
AREA:	.BLKW	6
NEWTIM:	.BLKW	3
DEVICE:	.RAD50	/HG /
	.WORD	0,0,0
DONE:	.ASCIZ	/!HGTIME-I-RT-11 SYSTEM DATE AND TIME SET FROM HOST/
HGERR:	.ASCIZ	/?HGTIME-F-TIME REQUEST FAILED; SYSTEM TIME UNCHANGED/
HGLOAD:	.ASCIZ	/?HGTIME-F-LOAD HG FIRST/
CLKERR:	.ASCIZ	/?HGTIME-F-NO MONITOR CLOCK/
	.EVEN
	.END	START
