	.TITLE	DSPDEM
	.IDENT	/01.00/
	.MCALL	.PRINT,.EXIT
	.GLOBL	PNINIT,PNDISP,PNRGB,PNKEY,PNWAIT

	.PSECT	DEMO,I,RO
START:
	.PRINT	#BANNER
	JSR	PC,PNINIT
	MOV	#2,R0		; green
	JSR	PC,PNRGB
	MOV	#MSGTAB,R4
10$:	MOV	(R4)+,R0
	BNE	20$
	MOV	#MSGTAB,R4
	BR	10$
20$:	JSR	PC,PNDISP
	MOV	#62,R0		; one second at 50 Hz
	JSR	PC,PNWAIT
	JSR	PC,PNKEY
	CMP	R0,#23		; physical ESC key
	BNE	10$
	CLR	R0
	JSR	PC,PNRGB
	MOV	#READY,R0
	JSR	PC,PNDISP
	.EXIT

BANNER:
	.ASCIZ	/DSPDEM: PRESS PANEL ESC TO EXIT/
	.EVEN
MSGTAB:
	.WORD	MSG1,MSG2,MSG3,MSG4,0
MSG1:	.ASCII	/HC1200 DISPLAY  /
MSG2:	.ASCII	/RT-11 V05.03    /
MSG3:	.ASCII	/LSI-11M AT WORK /
MSG4:	.ASCII	/PRESS ESC TO END/
READY:	.ASCII	/RT-11 READY     /
	.EVEN

	.END	START
