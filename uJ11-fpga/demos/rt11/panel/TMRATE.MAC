	.TITLE TMRATE
	.IDENT /01.00/
	.MCALL .GVAL,.GTIM,.PRINT,.TTINR,.EXIT
; Print the RMON configuration and 121 raw .GTIM snapshots, 50 ticks apart.
; The host measures arrival intervals; no date/time or hardware registers change.
; UART Q/ESC exits early. Link standalone with the native RT-11 tools.
	.PSECT CODE,I,RO
START:
	.GVAL #AREA,#300
	MOV R0,R4
	MOV #CFGEND,R2
	JSR PC,OCTAL
	.PRINT #CONFIG
	BIT #100000,R4
	BEQ DONE
	BIS #10100,@#44
	.GTIM #AREA,#TICKS
	MOV TICKS+2,LAST
	BR REPORT
LOOP:
	WAIT
	.TTINR
	BCS GET
	CMPB R0,#'q
	BEQ DONE
	CMPB R0,#'Q
	BEQ DONE
	CMPB R0,#33
	BEQ DONE
GET:
	.GTIM #AREA,#TICKS
	MOV TICKS+2,R0
	SUB LAST,R0
	CMP R0,#50.
	BLO LOOP
	MOV TICKS+2,LAST
REPORT:
	MOV TICKS,R0
	MOV #HIEND,R2
	JSR PC,OCTAL
	MOV TICKS+2,R0
	MOV #LOEND,R2
	JSR PC,OCTAL
	.PRINT #LINE
	DEC COUNT
	BNE LOOP
DONE:
	.EXIT
OCTAL:
	MOV #6,R3
10$:
	MOV R0,R1
	BIC #177770,R1
	ADD #60,R1
	MOVB R1,-(R2)
	CLC
	ROR R0
	CLC
	ROR R0
	CLC
	ROR R0
	SOB R3,10$
	RTS PC
	.PSECT DATA,D,RW
AREA:	.BLKW 2
TICKS:	.BLKW 2
LAST:	.WORD 0
COUNT:	.WORD 121.
CONFIG:	.ASCII /CFG 000000/
CFGEND:	.BYTE 0
LINE:	.ASCII /T 000000/
HIEND:	.ASCII / 000000/
LOEND:	.BYTE 0
	.EVEN
	.END START
