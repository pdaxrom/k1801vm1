FREQUENCY PORT "clk_ext" 12 MHz ;
FREQUENCY NET "clk" 50 MHz ;

# IS61WV102416BLL-10T at 50 MHz (20 ns period).
# IDLE launches address, SETUP launches OE, ACCESS1 waits, ACCESS2 captures.
# Capture is two cycles after OE: 10 ns output + 10 ns SRAM + 2 ns PCB.
# Thus DQ is valid 40-22=18 ns before the capture edge. Hold stays at zero;
# the extra read cycle does not relax any internal or hold constraint.
# WE is low for two cycles: >=30 ns with 10 ns pin skew, versus tPWE >=8 ns.
# DQ setup before WE rises >=45 ns (three cycles minus 15 ns output delay).
# Address/control and DQ hold are >=10 and >=5 ns. OE has a full release cycle.
# The 2 ns PCB budget is an assumption, not a measured board flight time.
INPUT_SETUP PORT "sram_data[*]" 18 NS HOLD 0 NS CLKNET "clk";
CLOCK_TO_OUT PORT "sram_address[*]" MAX 10 NS MIN 0 NS CLKNET "clk";
CLOCK_TO_OUT PORT "sram_data[*]" MAX 15 NS MIN 0 NS CLKNET "clk";
CLOCK_TO_OUT PORT "sram_ce_n" MAX 10 NS MIN 0 NS CLKNET "clk";
CLOCK_TO_OUT PORT "sram_oe_n" MAX 10 NS MIN 0 NS CLKNET "clk";
CLOCK_TO_OUT PORT "sram_we_n" MAX 10 NS MIN 0 NS CLKNET "clk";
CLOCK_TO_OUT PORT "sram_lb_n" MAX 10 NS MIN 0 NS CLKNET "clk";
CLOCK_TO_OUT PORT "sram_ub_n" MAX 10 NS MIN 0 NS CLKNET "clk";

# hardware-lcd PS/2: connector pin 5 CLOCK / pin 1 DATA, 10K pull-ups to +3V3.
LOCATE COMP "ps2_clock" SITE "2" ;
IOBUF PORT "ps2_clock" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 SLEWRATE=SLOW ;
LOCATE COMP "ps2_data" SITE "138" ;
IOBUF PORT "ps2_data" IO_TYPE=LVCMOS33 PULLMODE=NONE ;

FREQUENCY NET "video_clk" 64 MHz ;
BLOCK PATH FROM CELL "system_reset" TO CELL "system/bus/video/*" ;
BLOCK PATH FROM CELL "system/bus/video/line_toggle" TO CELL "system/bus/video/line_sync[0]" ;
BLOCK PATH FROM CELL "system/bus/video/line_done" TO CELL "system/bus/video/done_sync[0]" ;
BLOCK PATH FROM CELL "system/bus/video/underrun_toggle" TO CELL "system/bus/video/underrun_sync[0]" ;
BLOCK PATH FROM CELL "system/bus/video/field_toggle" TO CELL "system/bus/field_sync[0]" ;
# Synplify shares fill_bank with fill_row[0]; constrain the complete held bundle.
MAXDELAY FROM CELL "system/bus/video/fill_*" TO CELL "system/bus/video/current_*" 25 NS DATAPATH_ONLY ;

# Critical-source anchors from the qualified 50 MHz Terak 7C74 placement.
# Leave other control registers free for carry-chain packing; the gate
# verifies both fixed sites in the routed NCD.
LOCATE COMP "system/cpu/prepared_control[3]" SITE "R14C21A" ;
LOCATE COMP "system/bus/disk/bootstrap_ready" SITE "R12C28C" ;
