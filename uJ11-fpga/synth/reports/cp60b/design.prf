SCHEMATIC START ;
# map:  version Diamond (64-bit) 3.14.0.75.2 -- WARNING: Map write only section -- Sat Sep 12 15:52:26 2026

SYSCONFIG SDM_PORT=DISABLE SLAVE_SPI_PORT=DISABLE I2C_PORT=DISABLE MASTER_SPI_PORT=DISABLE COMPRESS_CONFIG=ON CONFIGURATION=CFG MY_ASSP=OFF ONE_TIME_PROGRAM=OFF CONFIG_SECURE=OFF MCCLK_FREQ=2.08 JTAG_PORT=DISABLE ENABLE_TRANSFR=DISABLE SHAREDEBRINIT=DISABLE MUX_CONFIGURATION_PORTS=ENABLE BACKGROUND_RECONFIG=OFF INBUF=ON ;
LOCATE COMP "gpio_key_row[0]" SITE "29" ;
LOCATE COMP "sd_cs_n" SITE "5" ;
LOCATE COMP "sd_miso" SITE "28" ;
LOCATE COMP "gpio_key_row[3]" SITE "1" ;
LOCATE COMP "gpio_key_row[2]" SITE "32" ;
LOCATE COMP "gpio_key_row[1]" SITE "30" ;
LOCATE COMP "gpio_reg_latch" SITE "20" ;
LOCATE COMP "gpio_blank" SITE "13" ;
LOCATE COMP "gpio_rs" SITE "11" ;
LOCATE COMP "gpio_clk" SITE "12" ;
LOCATE COMP "gpio_ce" SITE "14" ;
LOCATE COMP "gpio_din" SITE "16" ;
LOCATE COMP "gpio_msck" SITE "9" ;
LOCATE COMP "gpio_mcs" SITE "8" ;
LOCATE COMP "gpio_miso" SITE "10" ;
LOCATE COMP "gpio_mosi" SITE "17" ;
LOCATE COMP "tx" SITE "23" ;
LOCATE COMP "rx" SITE "25" ;
LOCATE COMP "res" SITE "4" ;
LOCATE COMP "sd_mosi" SITE "21" ;
LOCATE COMP "sd_sck" SITE "27" ;
FREQUENCY NET "clk" 31.824000 MHz ;
SCHEMATIC END ;
BLOCK RESETPATHS ;
BLOCK ASYNCPATHS ;
COMMERCIAL ;

# CP56-derived FRAM budgets, reused on each new routed design.
# OSCH nominal 29.56 MHz; internal STA >=31.824 MHz includes +5.5% and 2% jitter.
# PCB round trip <=2 ns, MOSI/CS versus SCK skew <=2 ns: assumptions, not measurements.
# Short SCK phase at 43/57 duty and full 2% period jitter is 13.147 ns.
# This is setup/hold timing; physical SCK pulse-width signoff is separate.
INPUT_SETUP PORT "gpio_miso" INPUT_DELAY 23 NS HOLD -2.2 NS CLKNET "clk";
CLOCK_TO_OUT PORT "gpio_msck" MAX 8 NS MIN 2.2 NS CLKNET "clk";
CLOCK_TO_OUT PORT "gpio_mosi" MAX 6.14 NS MIN -6.14 NS CLKNET "clk" CLKOUT PORT "gpio_msck";
CLOCK_TO_OUT PORT "gpio_mcs" MAX 1.14 NS MIN -1.14 NS CLKNET "clk" CLKOUT PORT "gpio_msck";
