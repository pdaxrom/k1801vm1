	.TITLE	RGBDEM
	.IDENT	/01.00/
	.MCALL	.PRINT,.EXIT
	.GLOBL	PNINIT,PNDISP,PNRGB,PNKEY,PNWAIT

	.PSECT	DEMO,I,RO
START:
	.PRINT	#BANNER
	JSR	PC,PNINIT
	MOV	#COLTAB,R4
10$:	MOV	(R4)+,R0
	BPL	20$
	MOV	#COLTAB,R4
	BR	10$
20$:	JSR	PC,PNRGB
	MOV	(R4)+,R0
	JSR	PC,PNDISP
	MOV	#31,R3		; half a second, checked every tick
30$:	MOV	#1,R0
	JSR	PC,PNWAIT
	JSR	PC,PNKEY
	CMP	R0,#23		; physical ESC key
	BEQ	40$
	SOB	R3,30$
	BR	10$
40$:	CLR	R0
	JSR	PC,PNRGB
	MOV	#STOP,R0
	JSR	PC,PNDISP
	.EXIT

BANNER:
	.ASCIZ	/RGBDEM: PRESS PANEL ESC TO EXIT/
	.EVEN
COLTAB:
	.WORD	1,RED
	.WORD	2,GREEN
	.WORD	4,BLUE
	.WORD	3,YELLOW
	.WORD	5,MAGENT
	.WORD	6,CYAN
	.WORD	7,WHITE
	.WORD	0,OFF
	.WORD	-1,0
RED:	.ASCII	/RGB: RED        /
GREEN:	.ASCII	/RGB: GREEN      /
BLUE:	.ASCII	/RGB: BLUE       /
YELLOW:	.ASCII	/RGB: YELLOW     /
MAGENT:	.ASCII	/RGB: MAGENTA    /
CYAN:	.ASCII	/RGB: CYAN       /
WHITE:	.ASCII	/RGB: WHITE      /
OFF:	.ASCII	/RGB: OFF        /
STOP:	.ASCII	/RGB DEMO STOPPED/
	.EVEN

	.END	START
