	.TITLE	KEYDEM
	.IDENT	/01.00/
	.MCALL	.PRINT,.EXIT
	.GLOBL	PNINIT,PNDISP,PNRGB,PNKEY,PNWAIT

	.PSECT	DEMO,I,RO
START:
	.PRINT	#BANNER
	JSR	PC,PNINIT
	MOV	#INTRO,R0
	JSR	PC,PNDISP
	MOV	#-1,R4		; last accepted key
10$:	JSR	PC,PNKEY
	CMP	R0,#-1
	BNE	20$
	MOV	#-1,R4		; arm again only after key release
	MOV	#1,R0
	JSR	PC,PNWAIT
	BR	10$
20$:	CMP	R0,R4
	BEQ	10$
	MOV	R0,R2
	MOV	#2,R0		; 40 ms debounce
	JSR	PC,PNWAIT
	JSR	PC,PNKEY
	CMP	R0,R2
	BNE	10$
	MOV	R2,R4
	CMP	R2,#23		; physical ESC key
	BEQ	50$
	MOV	R2,R0
	ASH	#-4,R0
	BIC	#177760,R0
	MOVB	HEX(R0),KEYBUF+5
	MOV	R2,R0
	BIC	#177760,R0
	MOVB	HEX(R0),KEYBUF+6
	MOV	R2,R0
	INC	R0
	BIC	#177770,R0
	BNE	30$
	MOV	#7,R0
30$:	JSR	PC,PNRGB
	MOV	#KEYBUF,R0
	JSR	PC,PNDISP
	BR	10$
50$:	CLR	R0
	JSR	PC,PNRGB
	MOV	#STOP,R0
	JSR	PC,PNDISP
	.EXIT

	.PSECT	DEMO,I,RO
BANNER:
	.ASCIZ	/KEYDEM: PRESS PANEL ESC TO EXIT/
	.EVEN
INTRO:	.ASCII	/PRESS PANEL KEY /
STOP:	.ASCII	/KEY DEMO STOPPED/
HEX:	.ASCII	/0123456789ABCDEF/

	.PSECT	DEMDAT,D,RW
KEYBUF:
	.ASCII	/KEY: 00         /
	.EVEN

	.END	START
