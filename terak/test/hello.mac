        .title hello

        .psect hello, abs

        . = 0200

start:
        mov #msg, r1          ; address of string
loop:
        movb (r1)+, r0         ; load byte
        beq end               ; zero terminator ends loop
        movb r0, @#177566       ; write to DL11 XBUF
        br loop
end:
        halt

msg:    .ascii /Hello!/<12><0>
